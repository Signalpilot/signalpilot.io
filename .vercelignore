# Vercel Hobby allows a maximum of 12 Vercel Functions per deployment for
# projects without a framework, where every file in api/ becomes one function.
# This repo has 34, so every deployment failed regardless of what changed.
#
# The social automation endpoints are excluded here rather than deleted: the
# crons that drove them are switched off, so nothing invokes them, but the code
# stays in git. Delete the line below to restore them on a Pro plan.
api/social/

# Authoring and tooling directories that are never served.
# NOTE: scripts/ and lib/ are required by the build command (npm run build ->
# node scripts/parse-content.js), so they must NOT be excluded here.
remotion/
pentarch-video-generator/
strategy-lab/
INSTAGRAM_CONTENT_HUB/
affiliate-outreach/
bug-reports/
bug-images/
