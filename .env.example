# === Polymarket Credentials ===
# Your private key (WITH 0x prefix). Export from:
#   - Email/Magic login: https://reveal.magic.link/polymarket
#   - MetaMask: Account Details > Export Private Key
PRIVATE_KEY=0xYourPrivateKeyHere

# Your PROXY WALLET address (NOT your EOA). Find it at:
#   polymarket.com > Settings > Wallet Address
FUNDER_ADDRESS=0xYourProxyWalletAddressHere

# Wallet type — MUST match how you created your Polymarket account:
#   0 = Fresh EOA (never logged into polymarket.com — rare, need token allowances)
#   1 = Email / Magic Link / Google login (most common)
#   2 = MetaMask / browser wallet (Gnosis Safe)
SIGNATURE_TYPE=1

# === Strategy Config ===
# Which strategies to run: arb, mm, latency (comma-separated)
ACTIVE_STRATEGIES=arb

# === Capital Allocation ===
# Maximum USDC to deploy across all strategies
MAX_CAPITAL_USDC=1000

# Per-strategy allocation (fractions of MAX_CAPITAL_USDC)
ARB_ALLOCATION=0.40
MM_ALLOCATION=0.40
LATENCY_ALLOCATION=0.20

# === Risk Management ===
# Maximum loss per day before kill switch triggers (fraction of capital)
MAX_DAILY_LOSS=0.05
# Maximum position size per market (fraction of capital)
MAX_POSITION_SIZE=0.10
# Stop loss per position (fraction of position value)
STOP_LOSS=0.15

# === Infrastructure (defaults are correct — don't change unless you know why) ===
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYGON_CHAIN_ID=137

# === Optional: Binance feed for latency arb ===
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@trade

# === Optional: Telegram alerts ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Mode ===
# true = paper trading (no real orders). START HERE.
# false = live trading (real money — be careful)
DRY_RUN=true
