int xShift = sp_labelOffset  // User-adjustable offset for labels
color noFill = color.new(color.black, 100)
getLabelSize() => 
    sp_labelSize == "Tiny" ? size.tiny : sp_labelSize == "Small" ? size.small : sp_labelSize == "Normal" ? size.normal : size.large
getLineStyle(string style) =>
    style == "Dashed" ? line.style_dashed : style == "Dotted" ? line.style_dotted : line.style_solid
// Dim a color by adding transparency (for line opacity control)
dimLineColor(color col) =>
    int currentTransp = math.round(color.t(col))
    int newTransp = math.min(100, currentTransp + sp_lineOpacity)
    color.new(col, newTransp)
// Format distance to fixed width (prevents table jumping)
formatDist(float val, string units) =>
    string numStr = str.tostring(math.abs(val), "#.#")
    // Pad to 6 chars minimum for stability
    int padLen = math.max(0, 6 - str.length(numStr))
    string padding = padLen >= 4 ? "    " : padLen >= 3 ? "   " : padLen >= 2 ? "  " : padLen >= 1 ? " " : ""
    padding + numStr + (units == "%" ? "%" : "")
