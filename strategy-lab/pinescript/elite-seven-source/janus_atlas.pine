var float fib1_price_1272 = na, var float fib1_price_1618 = na
var float fib2_price_236 = na, var float fib2_price_382 = na, var float fib2_price_500 = na
var float fib2_price_618 = na, var float fib2_price_786 = na, var float fib2_price_886 = na
var float fib2_price_1272 = na, var float fib2_price_1618 = na
// Draw fib helper - manages single line and label
drawSingleFib(line ln, label lb, bool enabled, float price, color col, string txt, string lineStyle, bool extendRight) =>
    line resultLn = ln
    label resultLb = lb
    bool shouldDraw = enabled and not na(price)
    
    if shouldDraw
        int lineStart = bar_index - 50  // Line starts 50 bars back
        int lineEnd = extendRight ? bar_index + 1 : bar_index + xShift + 2  // Ends at label or extends right
        
        if na(resultLn)
            resultLn := line.new(lineStart, price, lineEnd, price, xloc.bar_index, extendRight ? extend.right : extend.none, dimLineColor(col), getLineStyle(lineStyle), 1)
        else
            line.set_xy1(resultLn, lineStart, price)
            line.set_xy2(resultLn, lineEnd, price)
            line.set_extend(resultLn, extendRight ? extend.right : extend.none)
            line.set_color(resultLn, dimLineColor(col))
        
        if fib_showLabels and showLabels
            string labelTxt = showPriceOnLabel ? txt + " : " + str.tostring(price, format.mintick) : txt
            if na(resultLb)
                resultLb := label.new(bar_index + xShift, price, labelTxt, xloc.bar_index, yloc.price, col, getLabelStyle(), colLabelText, getLabelSize())
            else
                label.set_xy(resultLb, bar_index + xShift, price)
                label.set_text(resultLb, labelTxt)
                label.set_color(resultLb, col)
                label.set_style(resultLb, getLabelStyle())
            // Add to activeLevels for combining with other labels
            array.push(activeLevels, LevelInfo.new(txt, price, col, resultLb))
        else
            if not na(resultLb)
                label.delete(resultLb)
                resultLb := na
    else
        if not na(resultLn)
            line.delete(resultLn)
            resultLn := na
        if not na(resultLb)
            label.delete(resultLb)
            resultLb := na
    [resultLn, resultLb]
// Draw Fib Set 1
[fib1H, fib1L] = getFibAnchor(fib1_anchor)
bool fib1Active = useFIB and fib1_enable
fib1_price_236 := fib1Active ? calcFib(fib1H, fib1L, 0.236) : na
fib1_price_382 := fib1Active ? calcFib(fib1H, fib1L, 0.382) : na
fib1_price_500 := fib1Active ? calcFib(fib1H, fib1L, 0.5) : na
fib1_price_618 := fib1Active ? calcFib(fib1H, fib1L, 0.618) : na
fib1_price_786 := fib1Active ? calcFib(fib1H, fib1L, 0.786) : na
fib1_price_886 := fib1Active ? calcFib(fib1H, fib1L, 0.886) : na
fib1_price_1272 := fib1Active ? calcFib(fib1H, fib1L, 1.272) : na
fib1_price_1618 := fib1Active ? calcFib(fib1H, fib1L, 1.618) : na
[newLn236_1, newLb236_1] = drawSingleFib(fib1_ln_236, fib1_lb_236, fib1Active and fib1_236, fib1_price_236, fib1_color, "0.236", fib1_style, fib_extend)
fib1_ln_236 := newLn236_1, fib1_lb_236 := newLb236_1
[newLn382_1, newLb382_1] = drawSingleFib(fib1_ln_382, fib1_lb_382, fib1Active and fib1_382, fib1_price_382, fib1_color, "0.382", fib1_style, fib_extend)
fib1_ln_382 := newLn382_1, fib1_lb_382 := newLb382_1
[newLn500_1, newLb500_1] = drawSingleFib(fib1_ln_500, fib1_lb_500, fib1Active and fib1_500, fib1_price_500, fib1_color, "0.5", fib1_style, fib_extend)
fib1_ln_500 := newLn500_1, fib1_lb_500 := newLb500_1
[newLn618_1, newLb618_1] = drawSingleFib(fib1_ln_618, fib1_lb_618, fib1Active and fib1_618, fib1_price_618, fib1_color, "0.618", fib1_style, fib_extend)
fib1_ln_618 := newLn618_1, fib1_lb_618 := newLb618_1
[newLn786_1, newLb786_1] = drawSingleFib(fib1_ln_786, fib1_lb_786, fib1Active and fib1_786, fib1_price_786, fib1_color, "0.786", fib1_style, fib_extend)
fib1_ln_786 := newLn786_1, fib1_lb_786 := newLb786_1
[newLn886_1, newLb886_1] = drawSingleFib(fib1_ln_886, fib1_lb_886, fib1Active and fib1_886, fib1_price_886, fib1_color, "0.886", fib1_style, fib_extend)
fib1_ln_886 := newLn886_1, fib1_lb_886 := newLb886_1
[newLn1272_1, newLb1272_1] = drawSingleFib(fib1_ln_1272, fib1_lb_1272, fib1Active and fib1_1272, fib1_price_1272, fib1_color, "1.272", fib1_style, fib_extend)
fib1_ln_1272 := newLn1272_1, fib1_lb_1272 := newLb1272_1
[newLn1618_1, newLb1618_1] = drawSingleFib(fib1_ln_1618, fib1_lb_1618, fib1Active and fib1_1618, fib1_price_1618, fib1_color, "1.618", fib1_style, fib_extend)
fib1_ln_1618 := newLn1618_1, fib1_lb_1618 := newLb1618_1
// Draw Fib Set 2
[fib2H, fib2L] = getFibAnchor(fib2_anchor)
bool fib2Active = useFIB and fib2_enable
fib2_price_236 := fib2Active ? calcFib(fib2H, fib2L, 0.236) : na
fib2_price_382 := fib2Active ? calcFib(fib2H, fib2L, 0.382) : na
fib2_price_500 := fib2Active ? calcFib(fib2H, fib2L, 0.5) : na
fib2_price_618 := fib2Active ? calcFib(fib2H, fib2L, 0.618) : na
fib2_price_786 := fib2Active ? calcFib(fib2H, fib2L, 0.786) : na
fib2_price_886 := fib2Active ? calcFib(fib2H, fib2L, 0.886) : na
fib2_price_1272 := fib2Active ? calcFib(fib2H, fib2L, 1.272) : na
fib2_price_1618 := fib2Active ? calcFib(fib2H, fib2L, 1.618) : na
[newLn236_2, newLb236_2] = drawSingleFib(fib2_ln_236, fib2_lb_236, fib2Active and fib2_236, fib2_price_236, fib2_color, "0.236", fib2_style, fib_extend)
fib2_ln_236 := newLn236_2, fib2_lb_236 := newLb236_2
[newLn382_2, newLb382_2] = drawSingleFib(fib2_ln_382, fib2_lb_382, fib2Active and fib2_382, fib2_price_382, fib2_color, "0.382", fib2_style, fib_extend)
fib2_ln_382 := newLn382_2, fib2_lb_382 := newLb382_2
[newLn500_2, newLb500_2] = drawSingleFib(fib2_ln_500, fib2_lb_500, fib2Active and fib2_500, fib2_price_500, fib2_color, "0.5", fib2_style, fib_extend)
fib2_ln_500 := newLn500_2, fib2_lb_500 := newLb500_2
[newLn618_2, newLb618_2] = drawSingleFib(fib2_ln_618, fib2_lb_618, fib2Active and fib2_618, fib2_price_618, fib2_color, "0.618", fib2_style, fib_extend)
fib2_ln_618 := newLn618_2, fib2_lb_618 := newLb618_2
[newLn786_2, newLb786_2] = drawSingleFib(fib2_ln_786, fib2_lb_786, fib2Active and fib2_786, fib2_price_786, fib2_color, "0.786", fib2_style, fib_extend)
fib2_ln_786 := newLn786_2, fib2_lb_786 := newLb786_2
[newLn886_2, newLb886_2] = drawSingleFib(fib2_ln_886, fib2_lb_886, fib2Active and fib2_886, fib2_price_886, fib2_color, "0.886", fib2_style, fib_extend)
fib2_ln_886 := newLn886_2, fib2_lb_886 := newLb886_2
[newLn1272_2, newLb1272_2] = drawSingleFib(fib2_ln_1272, fib2_lb_1272, fib2Active and fib2_1272, fib2_price_1272, fib2_color, "1.272", fib2_style, fib_extend)
fib2_ln_1272 := newLn1272_2, fib2_lb_1272 := newLb1272_2
[newLn1618_2, newLb1618_2] = drawSingleFib(fib2_ln_1618, fib2_lb_1618, fib2Active and fib2_1618, fib2_price_1618, fib2_color, "1.618", fib2_style, fib_extend)
fib2_ln_1618 := newLn1618_2, fib2_lb_1618 := newLb1618_2
// Add nPOC labels to activeLevels (must be after array.clear and before COMBINE)
if show_dnPOC and array.size(dnPOC_labels) > 0
    for i = 0 to array.size(dnPOC_labels) - 1
        label lb = array.get(dnPOC_labels, i)
        float lvl = array.size(dnPOC_levels) > i ? array.get(dnPOC_levels, i) : na
        if not na(lb) and not na(lvl)
            array.push(activeLevels, LevelInfo.new("dnPOC" + str.tostring(i + 1), lvl, colnPOC, lb))
if show_wnPOC and array.size(wnPOC_labels) > 0
    for i = 0 to array.size(wnPOC_labels) - 1
        label lb = array.get(wnPOC_labels, i)
        float lvl = array.size(wnPOC_levels) > i ? array.get(wnPOC_levels, i) : na
        if not na(lb) and not na(lvl)
            array.push(activeLevels, LevelInfo.new("wnPOC" + str.tostring(i + 1), lvl, colnPOC, lb))
// ═══════════════════════════════════════════════════
// ═══════════════════════════════════════════════════
// POPULATE ALL DISCOVERABLE LEVELS (for hidden confluence feature)
// Only on last bar - this is expensive!
// ═══════════════════════════════════════════════════
if barstate.islast and tblShowHidden
    array.clear(allDiscoverableLevels)
    
    // HTF Levels - Daily
    if not na(calD_O)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("dO", calD_O, "HTF"))
    if not na(calD_H)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("dH", calD_H, "HTF"))
    if not na(calD_L)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("dL", calD_L, "HTF"))
    if not na(midD)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("dMid", midD, "HTF"))
    // HTF Levels - Weekly
    if not na(calW_O)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("wO", calW_O, "HTF"))
    if not na(calW_H)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("wH", calW_H, "HTF"))
    if not na(calW_L)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("wL", calW_L, "HTF"))
    if not na(midW)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("wMid", midW, "HTF"))
    // HTF Levels - Monthly
    if not na(calM_O)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("mO", calM_O, "HTF"))
    if not na(calM_H)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("mH", calM_H, "HTF"))
    if not na(calM_L)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("mL", calM_L, "HTF"))
    if not na(midM)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("mMid", midM, "HTF"))
    // HTF Levels - Quarterly
    if not na(calQ_H)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("qH", calQ_H, "HTF"))
    if not na(calQ_L)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("qL", calQ_L, "HTF"))
    // HTF Levels - Yearly
    if not na(calY_H)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("yH", calY_H, "HTF"))
    if not na(calY_L)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("yL", calY_L, "HTF"))
    // Monday Range
    if not na(moH)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("moH", moH, "Mon"))
    if not na(moL)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("moL", moL, "Mon"))
    if not na(pmoH)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pmoH", pmoH, "PMon"))
    if not na(pmoL)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pmoL", pmoL, "PMon"))
    // Session Levels
    if not na(asH)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("asH", asH, "Sess"))
    if not na(asL)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("asL", asL, "Sess"))
    if not na(euH)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("euH", euH, "Sess"))
    if not na(euL)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("euL", euL, "Sess"))
    if not na(naH)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("naH", naH, "Sess"))
    if not na(naL)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("naL", naL, "Sess"))
    // Opening Range
    if not na(orHigh)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("orH", orHigh, "OR"))
    if not na(orLow)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("orL", orLow, "OR"))
    // Previous Period Levels
    if not na(calD_O_p)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pdO", calD_O_p, "Prev"))
    if not na(calD_H_p)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pdH", calD_H_p, "Prev"))
    if not na(calD_L_p)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pdL", calD_L_p, "Prev"))
    if not na(calW_O_p)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pwO", calW_O_p, "Prev"))
    if not na(calW_H_p)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pwH", calW_H_p, "Prev"))
    if not na(calW_L_p)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pwL", calW_L_p, "Prev"))
    // VWAP Levels
    if not na(daily_vwap)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("dVWAP", daily_vwap, "VWAP"))
    if not na(weekly_vwap)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("wVWAP", weekly_vwap, "VWAP"))
    if not na(monthly_vwap)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("mVWAP", monthly_vwap, "VWAP"))
    if not na(pdVWAP)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pdVWAP", pdVWAP, "VWAP"))
    if not na(pwVWAP)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("pwVWAP", pwVWAP, "VWAP"))
    // Volume Profile
    if not na(daily_poc)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("dPOC", daily_poc, "VP"))
    if not na(weekly_poc)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("wPOC", weekly_poc, "VP"))
    if not na(monthly_poc)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("mPOC", monthly_poc, "VP"))
    // Fibonacci Levels (calculate even if Fib not enabled, for discovery)
    [fib_discH, fib_discL] = getFibAnchor(fib1_anchor)
    if not na(fib_discH) and not na(fib_discL)
        array.push(allDiscoverableLevels, DiscoverableLevel.new("0.236", calcFib(fib_discH, fib_discL, 0.236), "Fib"))
        array.push(allDiscoverableLevels, DiscoverableLevel.new("0.382", calcFib(fib_discH, fib_discL, 0.382), "Fib"))
        array.push(allDiscoverableLevels, DiscoverableLevel.new("0.5", calcFib(fib_discH, fib_discL, 0.5), "Fib"))
        array.push(allDiscoverableLevels, DiscoverableLevel.new("0.618", calcFib(fib_discH, fib_discL, 0.618), "Fib"))
        array.push(allDiscoverableLevels, DiscoverableLevel.new("0.786", calcFib(fib_discH, fib_discL, 0.786), "Fib"))
// ═══════════════════════════════════════════════════
// COMBINE OVERLAPPING LABELS (runs after all labels created)
// ═══════════════════════════════════════════════════
combineOverlappingLabels() =>
    int maxNamesShown = 3
    float priceThreshold = close * sp_combineThreshold / 100
    array<int> processed = array.new<int>()
    int arrSize = array.size(activeLevels)
    for i = 0 to arrSize - 1
        if array.includes(processed, i)
            continue
        LevelInfo lvl1 = array.get(activeLevels, i)
        string combinedText = lvl1.name
        int matchCount = 0
        int namesShown = 1
        if i < arrSize - 1
            for j = i + 1 to arrSize - 1
                if array.includes(processed, j)
                    continue
                LevelInfo lvl2 = array.get(activeLevels, j)
                if math.abs(lvl2.price - lvl1.price) < priceThreshold
                    matchCount += 1
                    if namesShown < maxNamesShown
                        combinedText += " · " + lvl2.name
                        namesShown += 1
                    array.push(processed, j)
                    if not na(lvl2.lb)
                        label.set_text(lvl2.lb, " ")
                        label.set_style(lvl2.lb, label.style_none)
        if matchCount > 0
            array.push(processed, i)
            int totalLevels = matchCount + 1
            string overflowStr = totalLevels > maxNamesShown ? " +" + str.tostring(totalLevels - maxNamesShown) : ""
            string strengthStr = (useCONF and confShowStrength) ? " (×" + str.tostring(totalLevels) + ")" : ""
            string finalText = showPriceOnLabel ? combinedText + overflowStr + strengthStr + " : " + str.tostring(lvl1.price, format.mintick) : combinedText + overflowStr + strengthStr
            if not na(lvl1.lb)
                label.set_text(lvl1.lb, finalText)
    true  // explicit return
if showLabels and array.size(activeLevels) > 1
    combineOverlappingLabels()
// Stack close labels vertically (for Text Only mode especially)
stackCloseLabels() =>
    array<float> sortedPrices = array.new<float>()
    array<label> sortedLabels = array.new<label>()
    for i = 0 to array.size(activeLevels) - 1
        LevelInfo lvl = array.get(activeLevels, i)
        if not na(lvl.lb) and label.get_text(lvl.lb) != " "
            array.push(sortedPrices, lvl.price)
            array.push(sortedLabels, lvl.lb)
    int n = array.size(sortedPrices)
    if n > 1
        for i = 0 to n - 2
            for j = 0 to n - i - 2
                if array.get(sortedPrices, j) < array.get(sortedPrices, j + 1)
                    float tempP = array.get(sortedPrices, j)
                    array.set(sortedPrices, j, array.get(sortedPrices, j + 1))
                    array.set(sortedPrices, j + 1, tempP)
                    label tempL = array.get(sortedLabels, j)
                    array.set(sortedLabels, j, array.get(sortedLabels, j + 1))
                    array.set(sortedLabels, j + 1, tempL)
    float stackThreshold = close * 0.5 / 100
    float offsetAmount = sp_labelSpacing * syminfo.mintick
    var float cumulativeOffset = 0.0
    cumulativeOffset := 0.0
    if n > 1
        for i = 1 to n - 1
            float prevPrice = array.get(sortedPrices, i - 1)
            float currPrice = array.get(sortedPrices, i)
            label currLabel = array.get(sortedLabels, i)
            bool isClose = math.abs(prevPrice - currPrice) < stackThreshold and not na(currLabel)
            if isClose
                cumulativeOffset := cumulativeOffset + offsetAmount
                label.set_y(currLabel, currPrice - cumulativeOffset)
            if not isClose
                cumulativeOffset := 0.0
    true
if showLabels and sp_labelStyle == "Text Only" and array.size(activeLevels) > 1 and barstate.islast
    stackCloseLabels()
// ═══════════════════════════════════════════════════
// KILLZONES (Background Boxes)
// ═══════════════════════════════════════════════════
var box kzAsianBox = na, var box kzLondonBox = na, var box kzNYOpenBox = na
var box kzLondonCloseBox = na, var box kzNYPMBox = na
drawKillzone(box existingBox, bool enabled, string timeStr, color col) =>
    box theBox = existingBox
    if useKZ and enabled
        bool inKZ = not na(time(timeframe.period, timeStr, tz))
        bool kzStart = inKZ and na(time(timeframe.period, timeStr, tz)[1])
        bool kzEnd = not inKZ and not na(time(timeframe.period, timeStr, tz)[1])
        
        if kzStart
            if not na(theBox)
                box.delete(theBox)
            theBox := box.new(bar_index, high, bar_index, low, col, 1, line.style_solid, extend.none, xloc.bar_index, col)
        
        if inKZ and not na(theBox)
            box.set_right(theBox, bar_index)
            box.set_top(theBox, math.max(box.get_top(theBox), high))
            box.set_bottom(theBox, math.min(box.get_bottom(theBox), low))
    theBox
kzAsianBox := drawKillzone(kzAsianBox, kz_asian, kz_asian_time, colKZasian)
kzLondonBox := drawKillzone(kzLondonBox, kz_london, kz_london_time, colKZlondon)
kzNYOpenBox := drawKillzone(kzNYOpenBox, kz_nyopen, kz_nyopen_time, colKZnyopen)
kzLondonCloseBox := drawKillzone(kzLondonCloseBox, kz_londonclose, kz_londonclose_time, colKZlondonclose)
kzNYPMBox := drawKillzone(kzNYPMBox, kz_nypm, kz_nypm_time, colKZnypm)
// ═══════════════════════════════════════════════════
// DISTANCE TABLE
// ═══════════════════════════════════════════════════
type LevelDist
    string name
    float dist
    int strength  // Confluence count (1 = single, 2+ = multiple levels)
    string hidden // Hidden confluence: "+0.618 (Fib)" etc.
var table distTable = na
getTblPosition() =>
    switch tblPosition
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Middle Right" => position.middle_right
        "Middle Left" => position.middle_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.bottom_center
// Helper to convert strength to stars
getStrengthStr(s) =>
    s == 1 ? "★" : s == 2 ? "★★" : s == 3 ? "★★★" : s >= 4 ? "★★★★" : "★"
// Render compact table layout
renderCompactTable(table tbl, array<LevelDist> above, array<LevelDist> below, int showA, int showB, string sz, bool showHid) =>
    color cR = color.red, color cS = color.green, color cY = color.yellow
    int r = 0
    table.cell(tbl, 0, r, "▲ RESIST", text_color=cR, text_size=sz)
    r += 1
    if showA > 0
        for i = 0 to showA - 1
            LevelDist ld = above.get(i)
            string stars = ld.strength >= 2 ? " " + getStrengthStr(ld.strength) : ""
            string hid = showHid and ld.hidden != "" ? " +" + ld.hidden : ""
            table.cell(tbl, 0, r, ld.name + " " + str.tostring(ld.dist, "#") + stars + hid, text_color=ld.strength >= 3 ? cY : cR, text_size=sz)
            r += 1
    table.cell(tbl, 0, r, "▼ SUPPORT", text_color=cS, text_size=sz)
    r += 1
    if showB > 0
        for i = 0 to showB - 1
            LevelDist ld = below.get(i)
            string stars = ld.strength >= 2 ? " " + getStrengthStr(ld.strength) : ""
            string hid = showHid and ld.hidden != "" ? " +" + ld.hidden : ""
            table.cell(tbl, 0, r, ld.name + " " + str.tostring(ld.dist, "#") + stars + hid, text_color=ld.strength >= 3 ? cY : cS, text_size=sz)
            r += 1
// Render vertical table layout
renderVerticalTable(table tbl, array<LevelDist> above, array<LevelDist> below, int showA, int showB, string sz, bool showHid, bool showStr) =>
    color cR = color.red, color cS = color.green, color cY = color.yellow, color cH = color.gray, color cO = color.orange
    int r = 0
    table.cell(tbl, 0, r, "▲ RESIST", text_color=cR, text_size=sz, text_halign=text.align_left)
    table.cell(tbl, 1, r, "Dist", text_color=cH, text_size=sz, text_halign=text.align_right)
    table.cell(tbl, 2, r, "Str", text_color=cH, text_size=sz, text_halign=text.align_center)
    if showHid
        table.cell(tbl, 3, r, "+", text_color=cO, text_size=sz, text_halign=text.align_left)
    r += 1
    if showA > 0
        for i = 0 to showA - 1
            LevelDist ld = above.get(i)
            color lc = ld.strength >= 3 ? cY : cR
            table.cell(tbl, 0, r, ld.name, text_color=lc, text_size=sz, text_halign=text.align_left)
            table.cell(tbl, 1, r, str.tostring(ld.dist, "#"), text_color=cR, text_size=sz, text_halign=text.align_right)
            table.cell(tbl, 2, r, ld.strength >= 2 ? getStrengthStr(ld.strength) : "", text_color=ld.strength >= 3 ? cY : cH, text_size=sz, text_halign=text.align_center)
            if showHid
                table.cell(tbl, 3, r, ld.hidden, text_color=cO, text_size=sz, text_halign=text.align_left)
            r += 1
    table.cell(tbl, 0, r, "▼ SUPPORT", text_color=cS, text_size=sz, text_halign=text.align_left)
    r += 1
    if showB > 0
        for i = 0 to showB - 1
            LevelDist ld = below.get(i)
            color lc = ld.strength >= 3 ? cY : cS
            table.cell(tbl, 0, r, ld.name, text_color=lc, text_size=sz, text_halign=text.align_left)
            table.cell(tbl, 1, r, str.tostring(ld.dist, "#"), text_color=cS, text_size=sz, text_halign=text.align_right)
            table.cell(tbl, 2, r, ld.strength >= 2 ? getStrengthStr(ld.strength) : "", text_color=ld.strength >= 3 ? cY : cH, text_size=sz, text_halign=text.align_center)
            if showHid
                table.cell(tbl, 3, r, ld.hidden, text_color=cO, text_size=sz, text_halign=text.align_left)
            r += 1
if useTBL and barstate.islast
    // Collect distances - split into ABOVE (resistance) and BELOW (support)
    array<LevelDist> aboveLevels = array.new<LevelDist>()  // Resistance
    array<LevelDist> belowLevels = array.new<LevelDist>()  // Support
    float confThreshold = close * sp_combineThreshold / 100
    
    // Build set of active level names for quick lookup
    array<string> activeNames = array.new<string>()
    if array.size(htfTableLevels) > 0
        for i = 0 to array.size(htfTableLevels) - 1
            array.push(activeNames, array.get(htfTableLevels, i).name)
    
    if array.size(htfTableLevels) > 0
        for i = 0 to array.size(htfTableLevels) - 1
            LevelInfo lvl = array.get(htfTableLevels, i)
            float dist = lvl.price - close
            float distDisplay = tblUnits == "Ticks" ? dist / syminfo.mintick : tblUnits == "Price" ? dist : dist / close * 100
            
            // Calculate confluence strength from ENABLED levels
            int enabledStrength = 1
            string enabledStr = ""
            int enabledOthers = 0
            for j = 0 to array.size(htfTableLevels) - 1
                if j != i
                    LevelInfo other = array.get(htfTableLevels, j)
                    if math.abs(other.price - lvl.price) < confThreshold
                        enabledStrength += 1
                        enabledOthers += 1
                        if tblShowHidden
                            enabledStr := enabledOthers == 1 ? other.name : enabledStr + " " + other.name
            
            // Find hidden confluence ONLY if user wants to see details (expensive operation!)
            string hiddenStr = ""
            int hiddenCount = 0
            if tblShowHidden and array.size(allDiscoverableLevels) > 0
                for k = 0 to array.size(allDiscoverableLevels) - 1
                    DiscoverableLevel disc = array.get(allDiscoverableLevels, k)
                    if math.abs(disc.price - lvl.price) < confThreshold
                        bool alreadyActive = false
                        for m = 0 to array.size(activeNames) - 1
                            if array.get(activeNames, m) == disc.name
                                alreadyActive := true
                                break
                        if not alreadyActive
                            hiddenCount += 1
                            hiddenStr := hiddenCount == 1 ? disc.name : hiddenStr + " " + disc.name
            
            // Combine enabled + hidden for display
            string allConfStr = ""
            if enabledStr != "" and hiddenStr != ""
                allConfStr := enabledStr + " " + hiddenStr
            else if enabledStr != ""
                allConfStr := enabledStr
            else
                allConfStr := hiddenStr
            
            // TOTAL strength = enabled + hidden
            int totalStrength = enabledStrength + hiddenCount
            
            // Split into above/below
            if dist > 0
                array.push(aboveLevels, LevelDist.new(lvl.name, math.abs(distDisplay), totalStrength, allConfStr))
            else
                array.push(belowLevels, LevelDist.new(lvl.name, math.abs(distDisplay), totalStrength, allConfStr))
    
    // Sort by distance (closest first)
    if array.size(aboveLevels) > 1
        for i = 0 to array.size(aboveLevels) - 2
            for j = 0 to array.size(aboveLevels) - i - 2
                if array.get(aboveLevels, j).dist > array.get(aboveLevels, j + 1).dist
                    LevelDist temp = array.get(aboveLevels, j)
                    array.set(aboveLevels, j, array.get(aboveLevels, j + 1))
                    array.set(aboveLevels, j + 1, temp)
    if array.size(belowLevels) > 1
        for i = 0 to array.size(belowLevels) - 2
            for j = 0 to array.size(belowLevels) - i - 2
                if array.get(belowLevels, j).dist > array.get(belowLevels, j + 1).dist
                    LevelDist temp = array.get(belowLevels, j)
                    array.set(belowLevels, j, array.get(belowLevels, j + 1))
                    array.set(belowLevels, j + 1, temp)
    
    // Smart split - if one side has fewer levels, give extra to the other
    int aboveCount = array.size(aboveLevels)
    int belowCount = array.size(belowLevels)
    int showAbove = 0
    int showBelow = 0
    
    if aboveCount + belowCount <= tblLevels
        // Show all if under limit
        showAbove := aboveCount
        showBelow := belowCount
    else
        // Split with overflow to other side
        int halfLimit = math.ceil(tblLevels / 2)
        if aboveCount < halfLimit
            // Fewer resist than half - give extra to support
            showAbove := aboveCount
            showBelow := math.min(tblLevels - aboveCount, belowCount)
        else if belowCount < halfLimit
            // Fewer support than half - give extra to resist
            showBelow := belowCount
            showAbove := math.min(tblLevels - belowCount, aboveCount)
        else
            // Both have enough - split evenly
            showAbove := halfLimit
            showBelow := halfLimit
    
    // Text size
    string txtSize = tblSize == "Tiny" ? size.tiny : tblSize == "Small" ? size.small : size.normal
    
    // Delete old table
    if not na(distTable)
        table.delete(distTable)
    
    if tblLayout == "Compact"
        int totalRows = 1 + showAbove + 1 + showBelow
        distTable := table.new(getTblPosition(), 1, totalRows, tblBgColor, tblBgColor, 1, tblBgColor, 1)
        renderCompactTable(distTable, aboveLevels, belowLevels, showAbove, showBelow, txtSize, tblShowHidden)
    
    else
        int numCols = tblShowHidden ? 4 : 3
        int totalRows = 1 + showAbove + 1 + showBelow
        distTable := table.new(getTblPosition(), numCols, totalRows, tblBgColor, tblBgColor, 1, tblBgColor, 1)
        renderVerticalTable(distTable, aboveLevels, belowLevels, showAbove, showBelow, txtSize, tblShowHidden, tblShowStrength)
// ═══════════════════════════════════════════════════
// MARKET STRUCTURE
// ═══════════════════════════════════════════════════
var int msTrend = 0
var float lastHigh = na, var int lastHighIdx = na
var float lastLow = na, var int lastLowIdx = na
var bool lastHighWasPlus = false, var bool lastLowWasPlus = false
var string lastLabeledType = na
var bool armHighBreak = false, var bool armLowBreak = false
var float prevHigh1 = na, var float prevHigh2 = na
var float prevLow1 = na, var float prevLow2 = na
structLabelSizeSel() => msLabelSize == "Tiny" ? size.tiny : msLabelSize == "Small" ? size.small : size.normal
breakLabelSizeSel() => msBreakLabelSize == "Tiny" ? size.tiny : msBreakLabelSize == "Small" ? size.small : size.normal
if useMS
    int pivotLen = finalPivotLen
    float ph = ta.pivothigh(high, pivotLen, pivotLen)
    float pl = ta.pivotlow(low, pivotLen, pivotLen)
    
    bool newHigh = not na(ph), bool newLow = not na(pl)
    bool isPlusUp = false, bool isPlusDn = false
    
    if msMode == "Manual"
        float atrThrust = ta.atr(14) * 2.5
        isPlusUp := not na(lastHigh) and not na(ph) and (ph - lastHigh) > atrThrust
        isPlusDn := not na(lastLow) and not na(pl) and (lastLow - pl) > atrThrust
    else
        isPlusUp := not na(prevHigh1) and not na(lastHigh) and not na(ph) and (ph > lastHigh) and (lastHigh > prevHigh1)
        isPlusDn := not na(prevLow1) and not na(lastLow) and not na(pl) and (pl < lastLow) and (lastLow < prevLow1)
    
    if newHigh
        prevHigh2 := prevHigh1, prevHigh1 := lastHigh
    if newLow
        prevLow2 := prevLow1, prevLow1 := lastLow
    
    float swingOffsetPrice = msSwingOffset * syminfo.mintick
    float breakLabelOffsetPrice = msBreakLabelOffset * syminfo.mintick
    float atrFilter = ta.atr(14) * finalATRMult
    bool isClosed = barstate.isconfirmed
    
    if isClosed and newHigh
        bool isSignificant = finalATRMult == 0 or na(lastHigh) or math.abs(ph - lastHigh) >= atrFilter
        bool canLabel = na(lastLabeledType) or lastLabeledType == "low"
        // Only label if we have a previous reference (don't label first swing)
        if isSignificant and canLabel and not na(lastHigh)
            string txt = ph > lastHigh ? "HH" : "LH"
            label.new(bar_index[pivotLen], high[pivotLen] + swingOffsetPrice, txt, xloc.bar_index, yloc.price, noFill, label.style_label_down, colSwingHighTxt, structLabelSizeSel())
            lastLabeledType := "high"
        lastHigh := ph, lastHighIdx := bar_index[pivotLen]
        lastHighWasPlus := isPlusUp, armHighBreak := isSignificant and canLabel and not na(lastHigh)
    
    if isClosed and newLow
        bool isSignificant = finalATRMult == 0 or na(lastLow) or math.abs(pl - lastLow) >= atrFilter
        bool canLabel = na(lastLabeledType) or lastLabeledType == "high"
        // Only label if we have a previous reference (don't label first swing)
        if isSignificant and canLabel and not na(lastLow)
            string txt = pl < lastLow ? "LL" : "HL"
            label.new(bar_index[pivotLen], low[pivotLen] - swingOffsetPrice, txt, xloc.bar_index, yloc.price, noFill, label.style_label_up, colSwingLowTxt, structLabelSizeSel())
            lastLabeledType := "low"
        lastLow := pl, lastLowIdx := bar_index[pivotLen]
        lastLowWasPlus := isPlusDn, armLowBreak := isSignificant and canLabel and not na(lastLow)
    
    if isClosed and armHighBreak and not na(lastHigh) and high > lastHigh
        armHighBreak := false
        float breakY = lastHigh
        int fromX = lastHighIdx, int toX = bar_index
        int midX = math.round((fromX + toX) / 2)
        if msTrend <= 0
            msTrend := 1
            if msShowBreakLink
                line.new(fromX, breakY, toX, breakY, xloc.bar_index, extend.none, color.new(colBullTxt, msLinkAlpha), line.style_dashed, msLinkWidth)
            label.new(midX, breakY + breakLabelOffsetPrice, "CHoCH" + (lastHighWasPlus ? "+" : ""), xloc.bar_index, yloc.price, noFill, label.style_none, colBullTxt, breakLabelSizeSel())
        else
            if msShowBreakLink
                line.new(fromX, breakY, toX, breakY, xloc.bar_index, extend.none, color.new(colBullTxt, msLinkAlpha), line.style_dashed, msLinkWidth)
            label.new(midX, breakY + breakLabelOffsetPrice, "BOS" + (lastHighWasPlus ? "+" : ""), xloc.bar_index, yloc.price, noFill, label.style_none, colBullTxt, breakLabelSizeSel())
    
    if isClosed and armLowBreak and not na(lastLow) and low < lastLow
        armLowBreak := false
        float breakY = lastLow
        int fromX = lastLowIdx, int toX = bar_index
        int midX = math.round((fromX + toX) / 2)
        if msTrend >= 0
            msTrend := -1
            if msShowBreakLink
                line.new(fromX, breakY, toX, breakY, xloc.bar_index, extend.none, color.new(colBearTxt, msLinkAlpha), line.style_dashed, msLinkWidth)
            label.new(midX, breakY - breakLabelOffsetPrice, "CHoCH" + (lastLowWasPlus ? "+" : ""), xloc.bar_index, yloc.price, noFill, label.style_none, colBearTxt, breakLabelSizeSel())
        else
            if msShowBreakLink
                line.new(fromX, breakY, toX, breakY, xloc.bar_index, extend.none, color.new(colBearTxt, msLinkAlpha), line.style_dashed, msLinkWidth)
            label.new(midX, breakY - breakLabelOffsetPrice, "BOS" + (lastLowWasPlus ? "+" : ""), xloc.bar_index, yloc.price, noFill, label.style_none, colBearTxt, breakLabelSizeSel())
// ═══════════════════════════════════════════════════
// FAIR VALUE GAPS
// ═══════════════════════════════════════════════════
type FVG
    int startBar
    int mitigatedBar
    float top
    float bottom
    bool isBull
    bool mitigated
    box bx
var array<FVG> fvgArray = array.new<FVG>()
if useFVG
    // Detect new FVGs (need at least 3 bars)
    if bar_index >= 2
        // Bullish FVG: gap up (current low > 2 bars ago high)
        bool bullFVG = low > high[2] and fvg_showBull
        // Bearish FVG: gap down (current high < 2 bars ago low)  
        bool bearFVG = high < low[2] and fvg_showBear
        
        if bullFVG
            float fvgTop = low
            float fvgBottom = high[2]
            // Color based on position: FVG below price = green (demand)
            color initCol = close > fvgTop ? colFVGbull : colFVGbear
            box newBox = box.new(bar_index - 1, fvgTop, bar_index, fvgBottom, border_color=initCol, bgcolor=initCol, border_width=1)
            array.push(fvgArray, FVG.new(bar_index, na, fvgTop, fvgBottom, true, false, newBox))
        
        if bearFVG
            float fvgTop = low[2]
            float fvgBottom = high
            // Color based on position: FVG above price = red (supply)
            color initCol = close < fvgBottom ? colFVGbear : colFVGbull
            box newBox = box.new(bar_index - 1, fvgTop, bar_index, fvgBottom, border_color=initCol, bgcolor=initCol, border_width=1)
            array.push(fvgArray, FVG.new(bar_index, na, fvgTop, fvgBottom, false, false, newBox))
    
    // Trim to max count
    while array.size(fvgArray) > fvg_maxCount
        FVG oldest = array.shift(fvgArray)
        box.delete(oldest.bx)
    
    // Process existing FVGs (remove old, update remaining)
    if array.size(fvgArray) > 0
        for i = array.size(fvgArray) - 1 to 0
            FVG fvg = array.get(fvgArray, i)
            
            // Remove FVGs outside lookback window
            if bar_index - fvg.startBar > fvg_lookback
                box.delete(fvg.bx)
                array.remove(fvgArray, i)
                continue
            
            // Skip mitigation check on the bar the FVG formed
            if bar_index > fvg.startBar and not fvg.mitigated
                bool mitigated = false
                if fvg_mitigate == "Wick"
                    // Wick touches the gap
                    if fvg.isBull
                        mitigated := low <= fvg.top  // Price came back down into gap
                    else
                        mitigated := high >= fvg.bottom  // Price came back up into gap
                else
                    // Close inside the gap
                    if fvg.isBull
                        mitigated := close <= fvg.top and close >= fvg.bottom
                    else
                        mitigated := close >= fvg.bottom and close <= fvg.top
                
                if mitigated
                    fvg.mitigated := true
                    fvg.mitigatedBar := bar_index
                    box.set_bgcolor(fvg.bx, colFVGmitigated)
                    box.set_border_color(fvg.bx, colFVGmitigated)
            
            // Update color based on position (only for unmitigated)
            if not fvg.mitigated
                float fvgMid = (fvg.top + fvg.bottom) / 2
                color posCol = close > fvgMid ? colFVGbull : colFVGbear  // Below price = green, Above price = red
                box.set_bgcolor(fvg.bx, posCol)
                box.set_border_color(fvg.bx, posCol)
            
            // Extend right or hide mitigated
            if fvg_showMode == "Unmitigated" and fvg.mitigated
                box.delete(fvg.bx)
                array.remove(fvgArray, i)
            else
                // Update box right edge
                if fvg.mitigated
                    // Mitigated: stop at mitigation bar
                    box.set_right(fvg.bx, fvg.mitigatedBar)
                else if fvg_extendRight
                    // Unmitigated + extend: keep extending
                    box.set_right(fvg.bx, bar_index + 5)
                else
                    // Unmitigated + no extend: fixed width
                    box.set_right(fvg.bx, fvg.startBar + 3)
// ═══════════════════════════════════════════════════
// CME GAPS  
// ═══════════════════════════════════════════════════
// Use fallback symbol for request.security (can't be empty)
string cme_requestSymbol = cme_symbol != "" ? cme_symbol : "CME:BTC1!"
// Use CME WEEKLY data with close[1] for previous week's close
[cme_wkOpen, cme_wkPrevClose, cme_wkTime] = request.security(cme_requestSymbol, "W",
    [open, close[1], time], barmerge.gaps_off, barmerge.lookahead_off)
// Gap data structure
type CMEGap
    float gapHigh
    float gapLow
    bool  isGapUp
    box   gapBox
    line  lineH
    line  lineL
var CMEGap[] cme_gaps = array.new<CMEGap>()
var int cme_lastGapTime = 0
// Alert flags
var bool cme_newGapAlert = false
var bool cme_fillAlert = false
cme_newGapAlert := false
cme_fillAlert := false
// Minimum gap threshold (0.2% of price = ~$190 at current BTC)
float cme_minGap = close * 0.002
// Detect new CME weekly bar
bool cme_newWeeklyBar = ta.change(cme_wkTime) != 0 and cme_wkTime != cme_lastGapTime
// Create gap when new CME week starts (only if valid symbol detected)
if useCME and cme_hasValidSymbol and cme_newWeeklyBar and not na(cme_wkPrevClose) and not na(cme_wkOpen)
    cme_lastGapTime := cme_wkTime
    
    // Gap = this week's open vs last week's close
    float gapSize = math.abs(cme_wkOpen - cme_wkPrevClose)
    
    if gapSize >= cme_minGap
        float gapH = math.max(cme_wkOpen, cme_wkPrevClose)
        float gapL = math.min(cme_wkOpen, cme_wkPrevClose)
        bool gapUp = cme_wkOpen > cme_wkPrevClose
        
        // Check duplicate
        bool exists = false
        if array.size(cme_gaps) > 0
            for i = 0 to array.size(cme_gaps) - 1
                CMEGap existing = array.get(cme_gaps, i)
                if math.abs(existing.gapHigh - gapH) < cme_minGap and math.abs(existing.gapLow - gapL) < cme_minGap
                    exists := true
                    break
        
        if not exists
            CMEGap newGap = CMEGap.new()
            newGap.gapHigh := gapH
            newGap.gapLow := gapL
            newGap.isGapUp := gapUp
            
            color boxCol = color.new(cme_gapColor, cme_transparency)
            color lineCol = color.new(cme_gapColor, 30)
            
            if cme_style == "Box"
                newGap.gapBox := box.new(bar_index, gapH, bar_index + 50, gapL,
                     bgcolor=boxCol, border_color=lineCol, border_width=1)
            else
                newGap.lineH := line.new(bar_index, gapH, bar_index + 50, gapH,
                     color=lineCol, style=line.style_dashed, width=1)
                newGap.lineL := line.new(bar_index, gapL, bar_index + 50, gapL,
                     color=lineCol, style=line.style_dashed, width=1)
            
            array.push(cme_gaps, newGap)
            
            // Enforce max gaps
            while array.size(cme_gaps) > cme_maxGaps
                CMEGap oldest = array.shift(cme_gaps)
                box.delete(oldest.gapBox)
                line.delete(oldest.lineH)
                line.delete(oldest.lineL)
            
            if barstate.islast
                cme_newGapAlert := true
// Process all gaps: extend visuals, check fills
if useCME and cme_hasValidSymbol and array.size(cme_gaps) > 0
    for i = array.size(cme_gaps) - 1 to 0
        CMEGap g = array.get(cme_gaps, i)
        
        // Fill detection - gap is filled when price passes through entirely
        bool filled = g.isGapUp ? (low <= g.gapLow) : (high >= g.gapHigh)
        
        if filled
            // Delete the gap
            box.delete(g.gapBox)
            line.delete(g.lineH)
            line.delete(g.lineL)
            array.remove(cme_gaps, i)
            
            if barstate.islast
                cme_fillAlert := true
        else
            // Extend visuals for unfilled gaps
            if cme_style == "Box" and not na(g.gapBox)
                box.set_right(g.gapBox, bar_index + 5)
            else
                if not na(g.lineH)
                    line.set_x2(g.lineH, bar_index + 5)
                if not na(g.lineL)
                    line.set_x2(g.lineL, bar_index + 5)
// ═══════════════════════════════════════════════════
// ANCHORED VWAP (Auto-anchor from swing highs/lows)
// ═══════════════════════════════════════════════════
// Brian Shannon methodology: "Price has memory."
// AVWAP from a swing low = where avg buyer is positioned since that low.
// AVWAP from a swing high = where avg seller is positioned since that high.
// Price between two AVWAPs = "The Pinch" — potential breakout setup.
// Auto-adjust pivot lookback by timeframe
// Lower TFs need more bars to filter noise; higher TFs need fewer
f_avwapAutoLen() =>
    int s = timeframe.in_seconds()
    int result = 6                    // W+:  6 bars (~6 weeks)
    if s <= 86400
        result := 10                  // D:   10 bars (~2 weeks)
    if s <= 14400
        result := 12                  // 4H:  12 bars (~2 days)
    if s <= 3600
        result := 20                  // 1H:  20 bars (~1 trading day)
    if s <= 1800
        result := 25                  // 30m: 25 bars (~12.5 hours)
    if s <= 900
        result := 30                  // 15m: 30 bars (~7.5 hours)
    if s <= 300
        result := 40                  // 5m:  40 bars (~3.3 hours)
    if s <= 60
        result := 50                  // 1m:  50 bars (~50 minutes)
    result
// Swap AVWAP line segments when new anchor replaces old
f_avwapSwapLines(array<line> recentLines, array<line> olderLines, color olderCol, int maxLines) =>
    if maxLines >= 2
        if olderLines.size() > 0
            for i = 0 to olderLines.size() - 1
                olderLines.get(i).delete()
        olderLines.clear()
        if recentLines.size() > 0
            for i = 0 to recentLines.size() - 1
                recentLines.get(i).set_color(olderCol)
                olderLines.push(recentLines.get(i))
        recentLines.clear()
    else
        if recentLines.size() > 0
            for i = 0 to recentLines.size() - 1
                recentLines.get(i).delete()
        recentLines.clear()
// Draw single AVWAP line segment from prev bar to current bar
f_avwapSegment(array<line> lines, float prev, float curr, color col, int w) =>
    if not na(curr) and not na(prev)
        lines.push(line.new(x1=bar_index - 1, y1=prev, x2=bar_index, y2=curr, xloc=xloc.bar_index, extend=extend.none, color=col, style=line.style_solid, width=w))
// Store a new AVWAP anchor and manage labels + trimming
f_avwapStoreAnchor(array<int> bars, array<float> pvArr, array<float> volArr, array<label> lbls, int anchorBar, float anchorPV, float anchorVol, float pivotPrice, bool showAnchors, color recentCol, color olderCol, string style, string tipRecent, string tipOlder, int maxLines) =>
    bars.unshift(anchorBar)
    pvArr.unshift(anchorPV)
    volArr.unshift(anchorVol)
    if showAnchors
        label lbl = label.new(x=anchorBar, y=pivotPrice, text="aV", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(recentCol, 70), style=style == "down" ? label.style_label_down : label.style_label_up, textcolor=recentCol, size=size.tiny)
        lbl.set_tooltip(tipRecent)
        lbls.unshift(lbl)
        if lbls.size() > 1
            label oldLbl = lbls.get(1)
            oldLbl.set_color(color.new(olderCol, 70))
            oldLbl.set_textcolor(olderCol)
            oldLbl.set_tooltip(tipOlder)
    if bars.size() > maxLines
        bars.pop(), pvArr.pop(), volArr.pop()
        if lbls.size() > maxLines
            lbls.pop().delete()
// Calculate single AVWAP value from anchor data
f_avwapCalc(float cumPV, float cumVol, float anchorPV, float anchorVol) =>
    float dV = cumVol - anchorVol
    dV > 0 ? (cumPV - anchorPV) / dV : na
// Draw one manual AVWAP as a polyline (single object, no GC issues)
f_manAvwapDraw(bool on, int anchorBar, float pivot, float aPV, float aVol, float cumPV, float cumVol, array<chart.point> pts, polyline pl, color col, int w) =>
    polyline _pl = pl
    if on and not na(anchorBar)
        if bar_index == anchorBar
            pts.push(chart.point.from_index(anchorBar, pivot))
        if bar_index > anchorBar
            float val = f_avwapCalc(cumPV, cumVol, aPV, aVol)
            if not na(val)
                pts.push(chart.point.from_index(bar_index, val))
                if not na(_pl)
                    _pl.delete()
                _pl := polyline.new(pts, curved=false, closed=false, line_color=col, line_width=w)
    _pl
int avwap_effectiveLen = avwap_autoTF ? f_avwapAutoLen() : avwap_pivotLen
// Track cumulative values for VWAP calculation
var float avwap_cumPV = 0.0
var float avwap_cumVol = 0.0
avwap_cumPV += hlc3 * volume
avwap_cumVol += volume
// Store anchor points: bar_index and cumulative values AT that bar
var array<int> avwap_bullBars = array.new<int>()      // swing low bar indices
var array<float> avwap_bullPV = array.new<float>()    // cumPV at anchor
var array<float> avwap_bullVol = array.new<float>()   // cumVol at anchor
var array<label> avwap_bullLbls = array.new<label>()   // anchor marker labels
var array<int> avwap_bearBars = array.new<int>()      // swing high bar indices  
var array<float> avwap_bearPV = array.new<float>()    // cumPV at anchor
var array<float> avwap_bearVol = array.new<float>()   // cumVol at anchor
var array<label> avwap_bearLbls = array.new<label>()   // anchor marker labels
// Line segment arrays (replaces plot() to avoid ghost trails on anchor change)
var array<line> avwap_b1Lines = array.new<line>()    // bull recent
var array<line> avwap_b2Lines = array.new<line>()    // bull older
var array<line> avwap_s1Lines = array.new<line>()    // bear recent
var array<line> avwap_s2Lines = array.new<line>()    // bear older
var float avwap_bull1Prev = na, var float avwap_bull2Prev = na
var float avwap_bear1Prev = na, var float avwap_bear2Prev = na
// Detect pivots using effective lookback
float avwap_ph = useAVWAP ? ta.pivothigh(high, avwap_effectiveLen, avwap_effectiveLen) : na
float avwap_pl = useAVWAP ? ta.pivotlow(low, avwap_effectiveLen, avwap_effectiveLen) : na
// Store new swing HIGH (bearish anchor: sellers appeared here)
if useAVWAP and not na(avwap_ph)
    f_avwapSwapLines(avwap_s1Lines, avwap_s2Lines, avwap_bear2Color, avwap_maxLines)
    avwap_bear1Prev := na
    float _aPV = avwap_cumPV[avwap_effectiveLen]
    float _aVl = avwap_cumVol[avwap_effectiveLen]
    f_avwapStoreAnchor(avwap_bearBars, avwap_bearPV, avwap_bearVol, avwap_bearLbls, bar_index - avwap_effectiveLen, _aPV, _aVl, avwap_ph, avwap_showAnchors, avwap_bear1Color, avwap_bear2Color, "down", "AVWAP from Swing High (recent)\nLatest sellers positioned here\nPrice below = sellers in profit", "AVWAP from Swing High (older)\nEarlier sellers positioned here\nPrice below = sellers in profit", avwap_maxLines)
    // Single line from anchor price to current AVWAP value
    float _cv = f_avwapCalc(avwap_cumPV, avwap_cumVol, _aPV, _aVl)
    if not na(_cv)
        avwap_s1Lines.push(line.new(x1=bar_index - avwap_effectiveLen, y1=avwap_ph, x2=bar_index, y2=_cv, xloc=xloc.bar_index, extend=extend.none, color=avwap_bear1Color, style=line.style_solid, width=avwap_lineWidth))
// Store new swing LOW (bullish anchor: buyers stepped in here)
if useAVWAP and not na(avwap_pl)
    f_avwapSwapLines(avwap_b1Lines, avwap_b2Lines, avwap_bull2Color, avwap_maxLines)
    avwap_bull1Prev := na
    float _aPV = avwap_cumPV[avwap_effectiveLen]
    float _aVl = avwap_cumVol[avwap_effectiveLen]
    f_avwapStoreAnchor(avwap_bullBars, avwap_bullPV, avwap_bullVol, avwap_bullLbls, bar_index - avwap_effectiveLen, _aPV, _aVl, avwap_pl, avwap_showAnchors, avwap_bull1Color, avwap_bull2Color, "up", "AVWAP from Swing Low (recent)\nLatest buyers positioned here\nPrice above = buyers in profit", "AVWAP from Swing Low (older)\nEarlier buyers positioned here\nPrice above = buyers in profit", avwap_maxLines)
    // Single line from anchor price to current AVWAP value
    float _cv = f_avwapCalc(avwap_cumPV, avwap_cumVol, _aPV, _aVl)
    if not na(_cv)
        avwap_b1Lines.push(line.new(x1=bar_index - avwap_effectiveLen, y1=avwap_pl, x2=bar_index, y2=_cv, xloc=xloc.bar_index, extend=extend.none, color=avwap_bull1Color, style=line.style_solid, width=avwap_lineWidth))
// Calculate AVWAP values (still needed for alerts)
float avwap_bull1 = na, float avwap_bull2 = na
float avwap_bear1 = na, float avwap_bear2 = na
if useAVWAP and avwap_bullBars.size() > 0
    if bar_index >= avwap_bullBars.get(0)
        avwap_bull1 := f_avwapCalc(avwap_cumPV, avwap_cumVol, avwap_bullPV.get(0), avwap_bullVol.get(0))
    if avwap_bullBars.size() > 1 and bar_index >= avwap_bullBars.get(1)
        avwap_bull2 := f_avwapCalc(avwap_cumPV, avwap_cumVol, avwap_bullPV.get(1), avwap_bullVol.get(1))
if useAVWAP and avwap_bearBars.size() > 0
    if bar_index >= avwap_bearBars.get(0)
        avwap_bear1 := f_avwapCalc(avwap_cumPV, avwap_cumVol, avwap_bearPV.get(0), avwap_bearVol.get(0))
    if avwap_bearBars.size() > 1 and bar_index >= avwap_bearBars.get(1)
        avwap_bear2 := f_avwapCalc(avwap_cumPV, avwap_cumVol, avwap_bearPV.get(1), avwap_bearVol.get(1))
// Draw AVWAP as line segments (no ghost trails on anchor change)
if useAVWAP
    f_avwapSegment(avwap_b1Lines, avwap_bull1Prev, avwap_bull1, avwap_bull1Color, avwap_lineWidth)
    f_avwapSegment(avwap_b2Lines, avwap_bull2Prev, avwap_bull2, avwap_bull2Color, avwap_lineWidth)
    f_avwapSegment(avwap_s1Lines, avwap_bear1Prev, avwap_bear1, avwap_bear1Color, avwap_lineWidth)
    f_avwapSegment(avwap_s2Lines, avwap_bear2Prev, avwap_bear2, avwap_bear2Color, avwap_lineWidth)
avwap_bull1Prev := avwap_bull1
avwap_bull2Prev := avwap_bull2
avwap_bear1Prev := avwap_bear1
avwap_bear2Prev := avwap_bear2
// ── Manual AVWAP Anchors ──
var int man1_bar = na, var float man1_pv = na, var float man1_vl = na, var float man1_pivot = na
var int man2_bar = na, var float man2_pv = na, var float man2_vl = na, var float man2_pivot = na
var int man3_bar = na, var float man3_pv = na, var float man3_vl = na, var float man3_pivot = na
var int man4_bar = na, var float man4_pv = na, var float man4_vl = na, var float man4_pivot = na
var array<chart.point> man1_pts = array.new<chart.point>(), var polyline man1_pl = na
var array<chart.point> man2_pts = array.new<chart.point>(), var polyline man2_pl = na
var array<chart.point> man3_pts = array.new<chart.point>(), var polyline man3_pl = na
var array<chart.point> man4_pts = array.new<chart.point>(), var polyline man4_pl = na
// Find anchor bars (fires once per anchor when bar time matches)
// Initialize manual anchor: find bar, set prev, create label with tooltip, draw bridge line
f_manAnchorInit(bool on, int anchorTime, string aType, color col, bool showAnch) =>
    int   _bar = na
    float _pv  = na
    float _vl  = na
    float _prev = na
    if on and time >= anchorTime
        _bar  := bar_index
        _pv   := avwap_cumPV
        _vl   := avwap_cumVol
        _prev := aType == "Swing High" ? high : low
        if showAnch
            string tip = "Manual AVWAP (user-defined)\n" + aType + "\nPrice at anchor: " + str.tostring(_prev, "#.##")
            label lbl = label.new(x=bar_index, y=_prev, text="aV", xloc=xloc.bar_index, yloc=yloc.price, color=color.new(col, 70), style=aType == "Swing High" ? label.style_label_down : label.style_label_up, textcolor=col, size=size.tiny)
            lbl.set_tooltip(tip)
    [_bar, _pv, _vl, _prev]
if man1_on and na(man1_bar) and time >= man1_time
    [b, p, v, pr] = f_manAnchorInit(man1_on, man1_time, man1_type, man1_col, avwap_showAnchors)
    man1_bar := b, man1_pv := p, man1_vl := v, man1_pivot := pr
if man2_on and na(man2_bar) and time >= man2_time
    [b, p, v, pr] = f_manAnchorInit(man2_on, man2_time, man2_type, man2_col, avwap_showAnchors)
    man2_bar := b, man2_pv := p, man2_vl := v, man2_pivot := pr
if man3_on and na(man3_bar) and time >= man3_time
    [b, p, v, pr] = f_manAnchorInit(man3_on, man3_time, man3_type, man3_col, avwap_showAnchors)
    man3_bar := b, man3_pv := p, man3_vl := v, man3_pivot := pr
if man4_on and na(man4_bar) and time >= man4_time
    [b, p, v, pr] = f_manAnchorInit(man4_on, man4_time, man4_type, man4_col, avwap_showAnchors)
    man4_bar := b, man4_pv := p, man4_vl := v, man4_pivot := pr
// Draw manual AVWAP lines (polyline: single object per anchor, full curve from anchor)
man1_pl := f_manAvwapDraw(man1_on, man1_bar, man1_pivot, man1_pv, man1_vl, avwap_cumPV, avwap_cumVol, man1_pts, man1_pl, man1_col, avwap_lineWidth)
man2_pl := f_manAvwapDraw(man2_on, man2_bar, man2_pivot, man2_pv, man2_vl, avwap_cumPV, avwap_cumVol, man2_pts, man2_pl, man2_col, avwap_lineWidth)
man3_pl := f_manAvwapDraw(man3_on, man3_bar, man3_pivot, man3_pv, man3_vl, avwap_cumPV, avwap_cumVol, man3_pts, man3_pl, man3_col, avwap_lineWidth)
man4_pl := f_manAvwapDraw(man4_on, man4_bar, man4_pivot, man4_pv, man4_vl, avwap_cumPV, avwap_cumVol, man4_pts, man4_pl, man4_col, avwap_lineWidth)
// Manual AVWAP values for alerts
float manAvwap1 = man1_on and not na(man1_bar) and bar_index > man1_bar ? f_avwapCalc(avwap_cumPV, avwap_cumVol, man1_pv, man1_vl) : na
float manAvwap2 = man2_on and not na(man2_bar) and bar_index > man2_bar ? f_avwapCalc(avwap_cumPV, avwap_cumVol, man2_pv, man2_vl) : na
float manAvwap3 = man3_on and not na(man3_bar) and bar_index > man3_bar ? f_avwapCalc(avwap_cumPV, avwap_cumVol, man3_pv, man3_vl) : na
float manAvwap4 = man4_on and not na(man4_bar) and bar_index > man4_bar ? f_avwapCalc(avwap_cumPV, avwap_cumVol, man4_pv, man4_vl) : na
// ALERTS
// ═══════════════════════════════════════════════════
bool confirmed = barstate.isconfirmed
touched(float level) => not na(level) and ((high >= level and low <= level) or ta.cross(close, level)) and confirmed
touchedHigh(float level) => not na(level) and high >= level and high[1] < level and confirmed
touchedLow(float level) => not na(level) and low <= level and low[1] > level and confirmed
// ═══════════════════════════════════════════════════
// INDIVIDUAL ALERTS - Most Actionable Levels
// ═══════════════════════════════════════════════════
// Previous Day (3)
alertcondition(touched(calD_O_p), "pdO • Prev Day Open", "Previous Day Open Touched")
alertcondition(touchedHigh(calD_H_p), "pdH • Prev Day High", "Previous Day High Touched")
alertcondition(touchedLow(calD_L_p), "pdL • Prev Day Low", "Previous Day Low Touched")
// Daily (3)
alertcondition(touched(calD_O), "dO • Daily Open", "Daily Open Touched")
alertcondition(touchedHigh(calD_H), "dH • Daily High", "Daily High Touched")
alertcondition(touchedLow(calD_L), "dL • Daily Low", "Daily Low Touched")
// Weekly (3)
alertcondition(touched(calW_O), "wO • Weekly Open", "Weekly Open Touched")
alertcondition(touchedHigh(calW_H), "wH • Weekly High", "Weekly High Touched")
alertcondition(touchedLow(calW_L), "wL • Weekly Low", "Weekly Low Touched")
// Monday (3)
alertcondition(touched(moO), "moO • Monday Open", "Monday Open Touched")
alertcondition(touchedHigh(moH), "moH • Monday High", "Monday High Touched")
alertcondition(touchedLow(moL), "moL • Monday Low", "Monday Low Touched")
// Opening Range (2)
alertcondition(touchedHigh(orHigh) and orFormed, "orH • OR High", "Opening Range High Touched")
alertcondition(touchedLow(orLow) and orFormed, "orL • OR Low", "Opening Range Low Touched")
// Daily/Weekly VWAP (3)
alertcondition(touched(daily_vwap), "dVWAP • Daily VWAP", "Daily VWAP Touched")
alertcondition(touched(weekly_vwap), "wVWAP • Weekly VWAP", "Weekly VWAP Touched")
alertcondition(touched(pdVWAP), "pdVWAP • Prev Day VWAP", "Previous Day VWAP Touched")
// Daily VP (3)
alertcondition(touched(daily_poc), "dPOC • Daily POC", "Daily POC Touched")
alertcondition(touchedHigh(daily_vah), "dVAH • Daily VAH", "Daily Value Area High Touched")
alertcondition(touchedLow(daily_val), "dVAL • Daily VAL", "Daily Value Area Low Touched")
// Weekly VP (3)
alertcondition(touched(weekly_poc), "wPOC • Weekly POC", "Weekly POC Touched")
alertcondition(touchedHigh(weekly_vah), "wVAH • Weekly VAH", "Weekly Value Area High Touched")
alertcondition(touchedLow(weekly_val), "wVAL • Weekly VAL", "Weekly Value Area Low Touched")
// Naked POC (2)
alertcondition(dnPOC_touchedThisBar and confirmed, "dnPOC • Daily nPOC", "Daily Naked POC Touched")
alertcondition(wnPOC_touchedThisBar and confirmed, "wnPOC • Weekly nPOC", "Weekly Naked POC Touched")
// Gap (3)
alertcondition(gapExists and not gapFilled and touched(gapHigh), "gapH • Gap High", "Gap High Touched")
alertcondition(gapExists and not gapFilled and touched(gapLow), "gapL • Gap Low", "Gap Low Touched")
alertcondition(gapFilled and gapFilled[1] == false, "Gap Filled", "Gap Has Been Filled")
// Market Structure (4)
alertcondition(msTrend == 1 and msTrend[1] <= 0, "CHoCH • 🟢 Bullish", "Bullish Change of Character")
alertcondition(msTrend == -1 and msTrend[1] >= 0, "CHoCH • 🔴 Bearish", "Bearish Change of Character")
alertcondition(msTrend == 1 and msTrend[1] == 1 and high > lastHigh and confirmed, "BOS • 🟢 Bullish", "Bullish Break of Structure")
alertcondition(msTrend == -1 and msTrend[1] == -1 and low < lastLow and confirmed, "BOS • 🔴 Bearish", "Bearish Break of Structure")
// FVG (2)
bool fvg_bullDetected = useFVG and fvg_showBull and low > high[2] and barstate.isconfirmed
bool fvg_bearDetected = useFVG and fvg_showBear and high < low[2] and barstate.isconfirmed
alertcondition(fvg_bullDetected, "FVG • 🟢 Bullish", "Bullish Fair Value Gap Detected")
alertcondition(fvg_bearDetected, "FVG • 🔴 Bearish", "Bearish Fair Value Gap Detected")
// Fib (1)
bool fibTouched = (touched(fib1_price_236) and fib1_236) or (touched(fib1_price_382) and fib1_382) or 
     (touched(fib1_price_500) and fib1_500) or (touched(fib1_price_618) and fib1_618) or
     (touched(fib1_price_786) and fib1_786) or (touched(fib1_price_886) and fib1_886) or
     (touched(fib2_price_236) and fib2_236) or (touched(fib2_price_382) and fib2_382) or 
     (touched(fib2_price_500) and fib2_500) or (touched(fib2_price_618) and fib2_618) or
     (touched(fib2_price_786) and fib2_786) or (touched(fib2_price_886) and fib2_886)
alertcondition(useFIB and fibTouched, "Fib Level Touched", "Fibonacci Level Touched")
// Confluence (1)
bool confZoneDetected = useCONF and array.size(activeLevels) >= 2
alertcondition(confZoneDetected and not confZoneDetected[1], "Confluence Zone", "Confluence Zone Detected")
// ═══════════════════════════════════════════════════
// GROUPED ALERTS - Context Levels (1 alert = multiple levels)
// ═══════════════════════════════════════════════════
// Monthly OHLC (1)
bool monthlyTouched = touched(calM_O) or touchedHigh(calM_H) or touchedLow(calM_L)
alertcondition(monthlyTouched, "Monthly (mO, mH, mL)", "Monthly Level Touched")
// Quarterly OHLC (1)
bool quarterlyTouched = touched(calQ_O) or touchedHigh(calQ_H) or touchedLow(calQ_L)
alertcondition(quarterlyTouched, "Quarterly (qO, qH, qL)", "Quarterly Level Touched")
// Yearly OHLC (1)
bool yearlyTouched = touched(calY_O) or touchedHigh(calY_H) or touchedLow(calY_L)
alertcondition(yearlyTouched, "Yearly (yO, yH, yL)", "Yearly Level Touched")
// Sessions (1)
bool sessionTouched = touched(asO) or touchedHigh(asH) or touchedLow(asL) or
     touched(euO) or touchedHigh(euH) or touchedLow(euL) or
     touched(naO) or touchedHigh(naH) or touchedLow(naL)
alertcondition(sessionTouched, "Sessions (Asia/Euro/NY O/H/L)", "Session Level Touched")
// Custom Sessions (1)
bool customSessionTouched = (touchedHigh(cs1H) and inCS1) or (touchedLow(cs1L) and inCS1) or
     (touchedHigh(cs2H) and inCS2) or (touchedLow(cs2L) and inCS2)
alertcondition(customSessionTouched, "Custom Sessions (CS1/CS2 H/L)", "Custom Session Level Touched")
// Prev Week (1)
bool prevWeekTouched = touched(calW_O_p) or touchedHigh(calW_H_p) or touchedLow(calW_L_p)
alertcondition(prevWeekTouched, "Prev Week (pwO, pwH, pwL)", "Previous Week Level Touched")
// Prev Month (1)
bool prevMonthTouched = touched(calM_O_p) or touchedHigh(calM_H_p) or touchedLow(calM_L_p)
alertcondition(prevMonthTouched, "Prev Month (pmO, pmH, pmL)", "Previous Month Level Touched")
// Prev Quarter (1)
bool prevQuarterTouched = touched(calQ_O_p) or touchedHigh(calQ_H_p) or touchedLow(calQ_L_p)
alertcondition(prevQuarterTouched, "Prev Quarter (pqO, pqH, pqL)", "Previous Quarter Level Touched")
// Prev Year (1)
bool prevYearTouched = touched(calY_O_p) or touchedHigh(calY_H_p) or touchedLow(calY_L_p)
alertcondition(prevYearTouched, "Prev Year (pyO, pyH, pyL)", "Previous Year Level Touched")
// HTF VWAP (1)
bool htfVWAPTouched = touched(monthly_vwap) or touched(quarterly_vwap) or touched(yearly_vwap)
alertcondition(htfVWAPTouched, "HTF VWAP (mVWAP, qVWAP, yVWAP)", "HTF VWAP Touched")
// Prev VWAPs (1)
bool prevVWAPTouched = touched(pwVWAP) or touched(pmVWAP) or touched(pqVWAP) or touched(pyVWAP)
alertcondition(prevVWAPTouched, "Prev VWAP (pw, pm, pq, pyVWAP)", "Previous Period VWAP Touched")
// Monthly VP (1)
bool monthlyVPTouched = touched(monthly_poc) or touchedHigh(monthly_vah) or touchedLow(monthly_val)
alertcondition(monthlyVPTouched, "Monthly VP (mPOC, mVAH, mVAL)", "Monthly Value Area Touched")
// Quarterly VP (1)
bool quarterlyVPTouched = touched(quarterly_poc) or touchedHigh(quarterly_vah) or touchedLow(quarterly_val)
alertcondition(quarterlyVPTouched, "Quarterly VP (qPOC, qVAH, qVAL)", "Quarterly Value Area Touched")
// Yearly VP (1)
bool yearlyVPTouched = touched(yearly_poc) or touchedHigh(yearly_vah) or touchedLow(yearly_val)
alertcondition(yearlyVPTouched, "Yearly VP (yPOC, yVAH, yVAL)", "Yearly Value Area Touched")
// CME Gaps (2)
alertcondition(cme_newGapAlert, "CME Gap • New", "New CME Gap Created")
alertcondition(cme_fillAlert, "CME Gap • Filled", "CME Gap Has Been Filled")
// Anchored VWAP (2)
bool avwapBullTouched = touched(avwap_bull1) or touched(avwap_bull2)
bool avwapBearTouched = touched(avwap_bear1) or touched(avwap_bear2)
alertcondition(useAVWAP and avwapBullTouched, "aVWAP • Swing Low", "Price Touched Anchored VWAP From Swing Low")
alertcondition(useAVWAP and avwapBearTouched, "aVWAP • Swing High", "Price Touched Anchored VWAP From Swing High")
// Manual AVWAP (4)
// Manual AVWAP (4)
alertcondition(touched(manAvwap1), "aVWAP • Manual Anchor 1", "Price Touched Manual AVWAP Anchor 1")
alertcondition(touched(manAvwap2), "aVWAP • Manual Anchor 2", "Price Touched Manual AVWAP Anchor 2")
alertcondition(touched(manAvwap3), "aVWAP • Manual Anchor 3", "Price Touched Manual AVWAP Anchor 3")
alertcondition(touched(manAvwap4), "aVWAP • Manual Anchor 4", "Price Touched Manual AVWAP Anchor 4")
// ╔════════════════════════════════════════════════════════════════╗
// ║                   END: Janus Atlas v1.1.1                      ║
// ╚════════════════════════════════════════════════════════════════╝