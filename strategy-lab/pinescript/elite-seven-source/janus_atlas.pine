// FIBONACCI LEVELS
// ═══════════════════════════════════════════════════
// Helper function to get anchor H/L based on selection
getFibAnchor(string anchor) =>
    float anchorH = na
    float anchorL = na
    switch anchor
        "Daily H/L" => 
            anchorH := calD_H
            anchorL := calD_L
        "Weekly H/L" => 
            anchorH := calW_H
            anchorL := calW_L
        "Monthly H/L" => 
            anchorH := calM_H
            anchorL := calM_L
        "Quarterly H/L" => 
            anchorH := calQ_H
            anchorL := calQ_L
        "Yearly H/L" => 
            anchorH := calY_H
            anchorL := calY_L
        "Prev Day H/L" => 
            anchorH := calD_H_p
            anchorL := calD_L_p
        "Prev Week H/L" => 
            anchorH := calW_H_p
            anchorL := calW_L_p
        "Prev Month H/L" => 
            anchorH := calM_H_p
            anchorL := calM_L_p
        "Prev Quarter H/L" => 
            anchorH := calQ_H_p
            anchorL := calQ_L_p
        "Prev Year H/L" => 
            anchorH := calY_H_p
            anchorL := calY_L_p
        "Monday H/L" => 
            anchorH := moH
            anchorL := moL
        "Wednesday H/L" => 
            anchorH := wedH
            anchorL := wedL
        "Friday H/L" => 
            anchorH := friH
            anchorL := friL
        "Opening Range H/L" => 
            anchorH := orFormed ? orHigh : na
            anchorL := orFormed ? orLow : na
        "Asian Session H/L" => 
            anchorH := asH
            anchorL := asL
        "Euro Session H/L" => 
            anchorH := euH
            anchorL := euL
        "NY Session H/L" => 
            anchorH := naH
            anchorL := naL
        "Custom Session 1 H/L" => 
            anchorH := cs1H
            anchorL := cs1L
        "Custom Session 2 H/L" => 
            anchorH := cs2H
            anchorL := cs2L
        "Gap H/L" => 
            anchorH := gapExists ? gapHigh : na
            anchorL := gapExists ? gapLow : na
    [anchorH, anchorL]
// Calculate fib level price
calcFib(float anchorH, float anchorL, float ratio) =>
    anchorL + (anchorH - anchorL) * ratio
