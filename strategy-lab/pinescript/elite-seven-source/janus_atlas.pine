// 15. FAIR VALUE GAPS
// ═══════════════════════════════════════════════════
string fvg_tooltip = "Fair Value Gaps are price inefficiencies (3-candle pattern with gap). Bullish FVG = gap UP (price jumped). Bearish FVG = gap DOWN (price dropped). Colors by POSITION: Green = below price (demand). Red = above price (supply)."
bool   fvg_showBull    = input.bool(true,  "Bullish FVG",    group=groupFVG, inline="fvgt", tooltip=fvg_tooltip)
bool   fvg_showBear    = input.bool(true,  "Bearish FVG",    group=groupFVG, inline="fvgt")
int    fvg_maxCount    = input.int(10, "Max FVGs", minval=1, maxval=50, group=groupFVG, tooltip="Max FVG boxes. 10 = default.")
string fvg_showMode    = input.string("Unmitigated", "Show", options=["All", "Unmitigated"], group=groupFVG, tooltip="All = show filled too. Unmitigated = unfilled only.")
string fvg_mitigate    = input.string("Wick", "Mitigation", options=["Wick", "Close"], group=groupFVG, tooltip="Wick = any touch fills. Close = must close inside.")
bool   fvg_extendRight = input.bool(false, "Extend Right", group=groupFVG, tooltip="Controls FVG box extension. OFF = fixed width boxes (default). ON = extends boxes to current bar.")
color  colFVGbull      = input.color(color.new(#089981, 80), "Demand Color (below)", group=groupFVG)
color  colFVGbear      = input.color(color.new(#F23645, 80), "Supply Color (above)", group=groupFVG)
color  colFVGmitigated = input.color(color.new(color.gray, 75), "Mitigated Color", group=groupFVG)
// Auto-calculate lookback based on timeframe
// 1m-15m: 2 days | 30m-1H: 1 week | 2H-4H: 2 weeks | Daily: 1 month | Weekly+: 3 months
fvg_getAutoLookback() =>
    int tfMins = timeframe.in_seconds() / 60
    int result = 0
    if tfMins <= 15
        // 1m-15m: 2 days
        result := 2 * 1440 / tfMins
    else if tfMins <= 60
        // 30m-1H: 1 week
        result := 7 * 1440 / tfMins
    else if tfMins <= 240
        // 2H-4H: 2 weeks
        result := 14 * 1440 / tfMins
    else if tfMins <= 1440
        // Daily: 1 month (30 bars)
        result := 30
    else if tfMins <= 10080
        // Weekly: 3 months (12 bars)
        result := 12
    else
        // Monthly: 6 months (6 bars)
        result := 6
    math.max(20, result)
int fvg_lookback = fvg_getAutoLookback()
