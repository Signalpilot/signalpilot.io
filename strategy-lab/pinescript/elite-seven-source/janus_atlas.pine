// ╔════════════════════════════════════════════════════════════════╗
// ║          JANUS ATLAS - Multi-Timeframe Auto-Levels             ║
// ║                    v1.1.1 • 2026                               ║
// ╚════════════════════════════════════════════════════════════════╝
//
// ┌────────────────────────────────────────────────────────────────┐
// │                      TABLE OF CONTENTS                         │
// ├────────────────────────────────────────────────────────────────┤
// │  SECTION                                        LINE (approx)  │
// │                                                                │
// │  1. INPUTS / SETTINGS ................................. ~82    │
// │     ├── 1.1  Controls (master toggles)                         │
// │     ├── 1.2  Appearance (labels, lines, colors)                │
// │     ├── 1.3  HTF Levels (D/W/M/Q/Y)                            │
// │     ├── 1.4  Session Levels (AS/EU/NA)                         │
// │     ├── 1.5  Custom Sessions                                   │
// │     ├── 1.6  Opening Range                                     │
// │     ├── 1.7  Killzones                                         │
// │     ├── 1.8  Gap Levels                                        │
// │     ├── 1.9  VWAP Levels                                       │
// │     ├── 1.10 Volume Profile                                    │
// │     ├── 1.11 Previous Periods                                  │
// │     ├── 1.12 Fibonacci Levels                                  │
// │     ├── 1.13 Confluence Zones (Strength Scoring)               │
// │     ├── 1.14 Market Structure                                  │
// │     ├── 1.15 Fair Value Gaps                                   │
// │     ├── 1.16 Distance Table (Strength + Hidden Discovery)      │
// │     ├── 1.17 CME Gaps                                          │
// │     └── 1.18 Anchored VWAP (auto-pivot, anchor markers)        │
// │  2. CONSTANTS & HELPERS ............................... ~560   │
// │  3. SECURITY CALLS (HTF data) ......................... ~600   │
// │  4. CORE CALCULATIONS ................................. ~650   │
// │     ├── 4.1 Day-of-Week Ranges (Mon/Wed/Fri)                   │
// │     ├── 4.2 Sessions (AS/EU/NA, Custom)                        │
// │     ├── 4.3 Opening Range                                      │
// │     ├── 4.4 VWAP + Bands                                       │
// │     ├── 4.5 Volume Profile                                     │
// │     ├── 4.6 Naked POC                                          │
// │     └── 4.7 Gap Levels                                         │
// │  5. VISUALS / DRAWING ................................. ~1150  │
// │     ├── 5.1 HTF/Session/OR Lines & Labels                      │
// │     ├── 5.2 VWAP Lines & Labels                                │
// │     ├── 5.3 Volume Profile Lines                               │
// │     ├── 5.4 Gap Levels                                         │
// │     └── 5.5 Fibonacci Levels                                   │
// │  6. DISCOVERABLE LEVELS (Hidden Confluence) ........... ~1810  │
// │  7. LABEL COMBINING + STRENGTH SCORING ................ ~1860  │
// │  8. KILLZONES (Background Shading) .................... ~1920  │
// │  9. CONFLUENCE ZONES .................................. ~1970  │
// │  10. DISTANCE TABLE (Strength + Hidden) ............... ~2040  │
// │  11. MARKET STRUCTURE ................................. ~2180  │
// │  12. FAIR VALUE GAPS .................................. ~2280  │
// │  13. CME GAPS ......................................... ~2380  │
// │  14. ALERTS ........................................... ~2490  │
// │      ├── Individual (36): PD, Daily, Weekly, OR, VWAP, etc.    │
// │      ├── Grouped (14): M/Q/Y, Sessions, Prev Periods           │
// │      ├── CME Gaps (2): New Gap, Gap Filled                     │
// │      └── Anchored VWAP (2): Swing Low, Swing High              │
// └────────────────────────────────────────────────────────────────┘
//
// Non-repainting • All signals confirmed on bar close • 58 alerts
//
//@version=6
indicator("Janus Atlas - Multi-Timeframe Auto-Levels", overlay=true, max_lines_count=500, max_labels_count=200, max_boxes_count=100, max_bars_back=5000, shorttitle="Janus Atlas")
// ═══════════════════════════════════════════════════
// GROUPS
// ═══════════════════════════════════════════════════
groupCtl   = "1. Controls"
groupApp   = "2. Appearance"
groupHTF   = "3. HTF Levels"
groupSES   = "4. Session Levels"
groupCS    = "5. Custom Sessions"
groupOR    = "6. Opening Range"
groupKZ    = "7. Killzones"
groupGAP   = "8. Gap Levels"
groupVWAP  = "9. VWAP Levels"
groupVP    = "10. Volume Profile"
groupPP    = "11. Previous Periods"
groupFIB   = "12. Fibonacci Levels"
groupCONF  = "13. Confluence Zones"
groupMS    = "14. Market Structure"
groupFVG   = "15. Fair Value Gaps"
groupTBL   = "16. Distance Table"
groupCME   = "17. CME Gaps"
groupAVWAP = "18. Anchored VWAP"
// ═══════════════════════════════════════════════════
// 1. CONTROLS
// ═══════════════════════════════════════════════════
string tt_htf = "HTF Open/High/Low/Mid levels."
string tt_ses = "Session High/Low levels."
string tt_cs = "Two custom session windows."
string tt_or = "Opening Range High/Low for selected session."
string tt_gap = "Gap levels (prev close to current open)."
string tt_vwap = "VWAP with optional bands."
string tt_vp = "POC, VAH, VAL from volume distribution."
string tt_pp = "Previous period O/H/L levels."
string tt_fib = "Fibonacci retracement levels."
string tt_conf = "Highlights zones where multiple levels cluster."
string tt_ms = "BOS and CHoCH labels."
string tt_fvg = "Fair Value Gap zones."
bool useHTF  = input.bool(true,  "HTF Levels",        group=groupCtl, tooltip=tt_htf)
bool useSES  = input.bool(false, "Session Levels",    group=groupCtl, tooltip=tt_ses)
bool useCS   = input.bool(false, "Custom Sessions",   group=groupCtl, tooltip=tt_cs)
bool useOR   = input.bool(false, "Opening Range",     group=groupCtl, tooltip=tt_or)
bool useKZ   = input.bool(false, "Killzones",         group=groupCtl, tooltip="Background shading during high-volume windows: Asian, London, NY Open, London Close, NY PM.")
bool useGAP  = input.bool(false, "Gap Levels",        group=groupCtl, tooltip=tt_gap)
bool useVWAP = input.bool(true,  "VWAP Levels",       group=groupCtl, tooltip=tt_vwap)
bool useVP   = input.bool(false, "Volume Profile",    group=groupCtl, tooltip=tt_vp)
bool usePP   = input.bool(true,  "Previous Periods",  group=groupCtl, tooltip=tt_pp)
bool useFIB  = input.bool(false, "Fibonacci Levels",  group=groupCtl, tooltip=tt_fib)
bool useCONF = input.bool(true,  "Confluence Zones",  group=groupCtl, tooltip=tt_conf)
bool useMS   = input.bool(true,  "Market Structure",  group=groupCtl, tooltip=tt_ms)
bool useFVG  = input.bool(true,  "Fair Value Gaps",   group=groupCtl, tooltip=tt_fvg)
bool useTBL  = input.bool(true,  "Distance Table",    group=groupCtl, tooltip="Distance table to nearest levels above/below price.")
bool useCME  = input.bool(false, "CME Gaps",          group=groupCtl, tooltip="Track CME futures weekend gaps. CME closes Fri 4pm CT, reopens Sun 5pm CT. Price often fills these gaps.")
bool useAVWAP = input.bool(false, "Anchored VWAP",     group=groupCtl, tooltip="VWAP lines from detected swing highs/lows. Shows where average buyer/seller is positioned since each swing.")
// ═══════════════════════════════════════════════════
// 2. APPEARANCE
// ═══════════════════════════════════════════════════
string sp_timezone = input.string("America/New_York", "Session Timezone", options=["America/New_York", "Europe/London", "Asia/Tokyo", "Asia/Hong_Kong", "UTC", "Exchange"], group=groupApp, tooltip="Timezone for sessions and killzones.")
string tz = sp_timezone == "Exchange" ? syminfo.timezone : sp_timezone
bool   showLabels      = input.bool(true, "Show Labels", group=groupApp, tooltip="Show/hide text labels at levels.")
bool   showPriceOnLabel = input.bool(false, "Show Price on Labels", group=groupApp, tooltip="Appends price to labels (e.g. dH: 88500).")
int    sp_labelOffset  = input.int(15, "Label Offset", minval=1, maxval=100, group=groupApp, tooltip="Bars to offset labels from price. 15 = default.")
string sp_labelSize    = input.string("Small", "Label Size", options=["Tiny", "Small", "Normal", "Large"], group=groupApp, tooltip="Text size for level labels.")
string sp_labelStyle   = input.string("Box", "Label Style", options=["Box", "Text Only"], group=groupApp, tooltip="Box = label with background. Text Only = floating text.")
color  colLabelText    = input.color(color.white, "Label Text Color", group=groupApp, tooltip="Text color inside labels. White works on dark themes, use black/gray for light themes.")
int    sp_lineWidth    = input.int(1, "Line Width", minval=1, maxval=5, group=groupApp, tooltip="Line thickness. 1 = default.")
int    sp_lineOpacity  = input.int(15, "Line Dim %", minval=0, maxval=50, step=5, group=groupApp, tooltip="Dims lines vs labels. 0 = full, 15 = default, 30+ = subtle.")
bool   sp_lineExtend   = input.bool(false, "Extend Lines Right", group=groupApp, tooltip="ON = lines extend across entire chart.")
int    sp_labelSpacing = input.int(10, "Label Spacing (ticks)", minval=5, maxval=50, group=groupApp, tooltip="Vertical gap between stacked labels. 10 = default.")
float  sp_combineThreshold = input.float(0.15, "Label Combine % ", minval=0.01, maxval=1.0, step=0.01, group=groupApp, tooltip="Merges nearby labels into one (e.g. 'dH · wH'). Lower = tighter merging.")
// ═══════════════════════════════════════════════════
// 3. HTF LEVELS
// ═══════════════════════════════════════════════════
// Monday
bool htfMo_showO = input.bool(false, "Monday • O",   group=groupHTF, inline="mo")
bool htfMo_showH = input.bool(false, "H",            group=groupHTF, inline="mo")
bool htfMo_showL = input.bool(false, "L",            group=groupHTF, inline="mo")
bool htfMo_showM = input.bool(false, "Mid",          group=groupHTF, inline="mo")
color colMonday  = input.color(color.new(color.gray, 50), "Monday Color", group=groupHTF)
// Daily
bool htfD_showO = input.bool(false, "Daily • O",    group=groupHTF, inline="d")
bool htfD_showH = input.bool(true,  "H",            group=groupHTF, inline="d")
bool htfD_showL = input.bool(true,  "L",            group=groupHTF, inline="d")
bool htfD_showM = input.bool(false, "Mid",          group=groupHTF, inline="d")
// Weekly
bool htfW_showO = input.bool(false, "Weekly • O",   group=groupHTF, inline="w")
bool htfW_showH = input.bool(true,  "H",            group=groupHTF, inline="w")
bool htfW_showL = input.bool(true,  "L",            group=groupHTF, inline="w")
bool htfW_showM = input.bool(false, "Mid",          group=groupHTF, inline="w")
// Monthly
bool htfM_showO = input.bool(false, "Monthly • O",  group=groupHTF, inline="m")
bool htfM_showH = input.bool(false, "H",            group=groupHTF, inline="m")
bool htfM_showL = input.bool(false, "L",            group=groupHTF, inline="m")
bool htfM_showM = input.bool(false, "Mid",          group=groupHTF, inline="m")
// Quarterly
string htfQY_tooltip = "⚠️ Quarterly/Yearly levels may be far from current price. On lower timeframes (1m-1H), this can compress your chart vertically. Best viewed on 4H+ charts for proper scaling."
bool htfQ_showO = input.bool(false, "Quarterly • O", group=groupHTF, inline="q", tooltip=htfQY_tooltip)
bool htfQ_showH = input.bool(false, "H",             group=groupHTF, inline="q")
bool htfQ_showL = input.bool(false, "L",             group=groupHTF, inline="q")
bool htfQ_showM = input.bool(false, "Mid",           group=groupHTF, inline="q")
// Yearly
bool htfY_showO = input.bool(false, "Yearly • O",    group=groupHTF, inline="y", tooltip=htfQY_tooltip)
bool htfY_showH = input.bool(false, "H",             group=groupHTF, inline="y")
bool htfY_showL = input.bool(false, "L",             group=groupHTF, inline="y")
bool htfY_showM = input.bool(false, "Mid",           group=groupHTF, inline="y")
color colHTF = input.color(color.new(color.gray, 50), "HTF Color (D/W/M/Q/Y)", group=groupHTF, tooltip="Color for all higher-timeframe levels. Adjust transparency in color picker.")
string htfLineStyle = input.string("Dashed", "HTF Style", options=["Solid", "Dashed", "Dotted"], group=groupHTF, tooltip="HTF line style.")
// ═══════════════════════════════════════════════════
// 4. SESSION LEVELS
// ═══════════════════════════════════════════════════
string tt_sess_tz = "Times use your selected Session Timezone."
string sessAS_str = input.session("0000-0900", "Asian Session", group=groupSES, tooltip=tt_sess_tz)
bool   as_O       = input.bool(false, "AS • O",   group=groupSES, inline="as")
bool   as_H       = input.bool(true,  "H",        group=groupSES, inline="as")
bool   as_L       = input.bool(true,  "L",        group=groupSES, inline="as")
bool   as_M       = input.bool(false, "Mid",      group=groupSES, inline="as")
color  colAS      = input.color(color.new(color.gray, 50), "AS Color", group=groupSES)
string asLineStyle = input.string("Dashed", "AS Style", options=["Solid", "Dashed", "Dotted"], group=groupSES, tooltip="Line style for Asian session levels. 'Dashed' = default.")
string sessEU_str = input.session("0700-1600", "European Session", group=groupSES, tooltip=tt_sess_tz)
bool   eu_O       = input.bool(false, "EU • O",   group=groupSES, inline="eu")
bool   eu_H       = input.bool(true,  "H",        group=groupSES, inline="eu")
bool   eu_L       = input.bool(true,  "L",        group=groupSES, inline="eu")
bool   eu_M       = input.bool(false, "Mid",      group=groupSES, inline="eu")
color  colEU      = input.color(color.new(color.gray, 50), "EU Color", group=groupSES)
string euLineStyle = input.string("Dashed", "EU Style", options=["Solid", "Dashed", "Dotted"], group=groupSES, tooltip="Line style for European session levels. 'Dashed' = default.")
string sessNA_str = input.session("0930-1600", "N.A. Session", group=groupSES, tooltip=tt_sess_tz)
bool   na_O       = input.bool(false, "NA • O",   group=groupSES, inline="na")
bool   na_H       = input.bool(true,  "H",        group=groupSES, inline="na")
bool   na_L       = input.bool(true,  "L",        group=groupSES, inline="na")
bool   na_M       = input.bool(false, "Mid",      group=groupSES, inline="na")
color  colNA      = input.color(color.new(color.gray, 50), "NA Color", group=groupSES)
string naLineStyle = input.string("Dashed", "NA Style", options=["Solid", "Dashed", "Dotted"], group=groupSES, tooltip="Line style for North American session levels. 'Dashed' = default.")
// ═══════════════════════════════════════════════════
// 5. CUSTOM SESSIONS
// ═══════════════════════════════════════════════════
string cs1_name    = input.string("Custom 1", "Session 1 Name", group=groupCS, tooltip="Label name for first custom session. Appears on chart labels.")
string cs1_time    = input.session("0800-1400", "Session 1 Time", group=groupCS, tooltip=tt_sess_tz)
bool   cs1_O       = input.bool(false, "CS1 • O", group=groupCS, inline="cs1")
bool   cs1_H       = input.bool(true,  "H",       group=groupCS, inline="cs1")
bool   cs1_L       = input.bool(true,  "L",       group=groupCS, inline="cs1")
bool   cs1_M       = input.bool(false, "Mid",     group=groupCS, inline="cs1")
color  colCS1      = input.color(color.new(color.gray, 50), "CS1 Color", group=groupCS)
string cs2_name    = input.string("Custom 2", "Session 2 Name", group=groupCS, tooltip="Label name for second custom session. Appears on chart labels.")
string cs2_time    = input.session("1400-2000", "Session 2 Time", group=groupCS, tooltip=tt_sess_tz)
bool   cs2_O       = input.bool(false, "CS2 • O", group=groupCS, inline="cs2")
bool   cs2_H       = input.bool(false, "H",       group=groupCS, inline="cs2")
bool   cs2_L       = input.bool(false, "L",       group=groupCS, inline="cs2")
bool   cs2_M       = input.bool(false, "Mid",     group=groupCS, inline="cs2")
color  colCS2      = input.color(color.new(color.gray, 50), "CS2 Color", group=groupCS)
string csLineStyle = input.string("Dashed", "Custom Session Style", options=["Solid", "Dashed", "Dotted"], group=groupCS, tooltip="Line style for custom session levels. 'Dashed' = default.")
// ═══════════════════════════════════════════════════
// 6. OPENING RANGE
// ═══════════════════════════════════════════════════
string orSession   = input.string("NY", "OR Session", options=["Asian", "Euro", "NY", "Custom"], group=groupOR, tooltip="Session for Opening Range calculation.")
string orCustom    = input.session("0930-1000", "Custom OR Time", group=groupOR, tooltip=tt_sess_tz)
int    orDuration  = input.int(30, "OR Duration (min)", options=[5, 15, 30, 60], group=groupOR, tooltip="Minutes after open to track OR. 30 = default.")
bool   or_H        = input.bool(true,  "OR High",  group=groupOR, inline="or")
bool   or_L        = input.bool(true,  "OR Low",   group=groupOR, inline="or")
bool   or_M        = input.bool(false, "OR Mid",   group=groupOR, inline="or")
color  colOR       = input.color(color.new(color.gray, 50), "OR Color", group=groupOR)
string orLineStyle = input.string("Dashed", "OR Style", options=["Solid", "Dashed", "Dotted"], group=groupOR, tooltip="Line style for Opening Range levels. 'Dashed' = default.")
// ═══════════════════════════════════════════════════
// 7. KILLZONES
// ═══════════════════════════════════════════════════
string tt_kz_tz = "Times use your selected Session Timezone."
bool   kz_asian      = input.bool(true,  "Asian      ",   group=groupKZ, inline="kza", tooltip=tt_kz_tz)
string kz_asian_time = input.session("2000-0000", "",      group=groupKZ, inline="kza")
color  colKZasian    = input.color(color.new(color.purple, 90), "", group=groupKZ, inline="kza")
bool   kz_london     = input.bool(true,  "London Open",   group=groupKZ, inline="kzl", tooltip=tt_kz_tz)
string kz_london_time = input.session("0200-0500", "",     group=groupKZ, inline="kzl")
color  colKZlondon   = input.color(color.new(color.blue, 90), "", group=groupKZ, inline="kzl")
bool   kz_nyopen     = input.bool(true,  "NY Open    ",   group=groupKZ, inline="kzn", tooltip=tt_kz_tz)
string kz_nyopen_time = input.session("0830-1100", "",     group=groupKZ, inline="kzn")
color  colKZnyopen   = input.color(color.new(color.green, 90), "", group=groupKZ, inline="kzn")
bool   kz_londonclose = input.bool(false, "London Cls ",   group=groupKZ, inline="kzlc", tooltip=tt_kz_tz)
string kz_londonclose_time = input.session("1000-1200", "", group=groupKZ, inline="kzlc")
color  colKZlondonclose = input.color(color.new(color.orange, 90), "", group=groupKZ, inline="kzlc")
bool   kz_nypm       = input.bool(false, "NY PM      ",   group=groupKZ, inline="kzpm", tooltip=tt_kz_tz)
string kz_nypm_time  = input.session("1300-1600", "",      group=groupKZ, inline="kzpm")
color  colKZnypm     = input.color(color.new(color.red, 90), "", group=groupKZ, inline="kzpm")
// ═══════════════════════════════════════════════════
// 8. GAP LEVELS
// ═══════════════════════════════════════════════════
bool   gap_daily     = input.bool(true,  "Daily Gap",   group=groupGAP, tooltip="Gap between yesterday's close and today's open. OFF = no daily gap. ON = shows gap zone (default).")
bool   gap_weekend   = input.bool(true,  "Weekend Gap", group=groupGAP, tooltip="Gap between Friday's close and Sunday/Monday's open. OFF = no weekend gap. ON = shows gap zone (default). Often larger than daily gaps.")
float  gap_minSize   = input.float(0.1, "Min Gap Size (%)", minval=0, step=0.05, group=groupGAP, tooltip="Min gap size as % of price. 0.1 = default.")
bool   gap_showHigh  = input.bool(true,  "Gap High",    group=groupGAP, inline="gap")
bool   gap_showLow   = input.bool(true,  "Gap Low",     group=groupGAP, inline="gap")
bool   gap_markFill  = input.bool(true,  "Mark Gap Fill", group=groupGAP, tooltip="Visual indicator when price fills the gap. OFF = gap stays visible after fill. ON = changes appearance when filled (default).")
color  colGAP        = input.color(color.new(color.gray, 40), "Gap Color", group=groupGAP)
string gapLineStyle  = input.string("Dotted", "Gap Style", options=["Solid", "Dashed", "Dotted"], group=groupGAP, tooltip="Line style for gap levels. 'Dotted' = subtle (default).")
// ═══════════════════════════════════════════════════
// 9. VWAP LEVELS
// ═══════════════════════════════════════════════════
bool show_daily_vwap     = input.bool(true,  "Daily VWAP",     group=groupVWAP, inline="vd")
bool show_dVWAP_bands    = input.bool(false, "Bands",          group=groupVWAP, inline="vd")
bool show_pdVWAP         = input.bool(false, "Prev",           group=groupVWAP, inline="vd")
bool show_weekly_vwap    = input.bool(false, "Weekly VWAP",    group=groupVWAP, inline="vw")
bool show_wVWAP_bands    = input.bool(false, "Bands",          group=groupVWAP, inline="vw")
bool show_pwVWAP         = input.bool(false, "Prev",           group=groupVWAP, inline="vw")
bool show_monthly_vwap   = input.bool(false, "Monthly VWAP",   group=groupVWAP, inline="vm")
bool show_mVWAP_bands    = input.bool(false, "Bands",          group=groupVWAP, inline="vm")
bool show_pmVWAP         = input.bool(false, "Prev",           group=groupVWAP, inline="vm")
bool show_quarterly_vwap = input.bool(false, "Quarterly VWAP", group=groupVWAP, inline="vq")
bool show_qVWAP_bands    = input.bool(false, "Bands",          group=groupVWAP, inline="vq")
bool show_pqVWAP         = input.bool(false, "Prev",           group=groupVWAP, inline="vq")
bool show_yearly_vwap    = input.bool(false, "Yearly VWAP",    group=groupVWAP, inline="vy")
bool show_yVWAP_bands    = input.bool(false, "Bands",          group=groupVWAP, inline="vy")
bool show_pyVWAP         = input.bool(false, "Prev",           group=groupVWAP, inline="vy")
string vwap_band_tooltip = "Standard deviation bands show how far price has moved from VWAP.\n\n±1σ = ~68% of price action stays within this range (normal moves)\n±2σ = ~95% of price action stays within this range (extreme moves)\n\nPrice at ±2σ often signals overbought/oversold conditions."
bool vwap_show1Dev       = input.bool(true,  "Show ±1σ",       group=groupVWAP, inline="vb", tooltip=vwap_band_tooltip)
bool vwap_show2Dev       = input.bool(true,  "Show ±2σ",       group=groupVWAP, inline="vb")
color colVWAP     = input.color(color.new(color.gray, 50), "VWAP Color", group=groupVWAP)
color colVWAPprev = input.color(color.new(color.gray, 40), "Prev VWAP Color", group=groupVWAP)
color colVWAPband = input.color(color.new(color.gray, 75), "Band Color", group=groupVWAP)
string vwapLineStyle = input.string("Dashed", "VWAP Style", options=["Solid", "Dashed", "Dotted"], group=groupVWAP, tooltip="Line style for VWAP levels. 'Dashed' = default.")
// ═══════════════════════════════════════════════════
// 10. VOLUME PROFILE
// ═══════════════════════════════════════════════════
string tt_vp_daily = "Daily VP. Use timeframe lower than Daily."
string tt_vp_weekly = "Weekly VP. Use timeframe lower than Weekly."
string tt_vp_monthly = "Monthly VP. Use timeframe lower than Monthly."
bool show_daily_poc   = input.bool(false, "Daily POC", group=groupVP, inline="vpd", tooltip=tt_vp_daily)
