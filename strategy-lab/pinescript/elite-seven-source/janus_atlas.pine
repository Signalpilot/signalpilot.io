    orHigh := math.max(nz(orHigh, high), high)
    orLow := math.min(nz(orLow, low), low)
// Mark OR as formed after duration
if not na(orStartTime) and time > orStartTime + orDurationMs
    orFormed := true
float orMid = (orHigh + orLow) / 2.0
// ═══════════════════════════════════════════════════
// VWAP WITH STANDARD DEVIATION BANDS
// ═══════════════════════════════════════════════════
// Manual VWAP calculation to get standard deviation
var float d_sumPV = 0.0, var float d_sumV = 0.0, var float d_sumV2 = 0.0
var float w_sumPV = 0.0, var float w_sumV = 0.0, var float w_sumV2 = 0.0
var float m_sumPV = 0.0, var float m_sumV = 0.0, var float m_sumV2 = 0.0
var float q_sumPV = 0.0, var float q_sumV = 0.0, var float q_sumV2 = 0.0
var float y_sumPV = 0.0, var float y_sumV = 0.0, var float y_sumV2 = 0.0
// Reset on period change
if timeframe.change("D")
    d_sumPV := 0.0, d_sumV := 0.0, d_sumV2 := 0.0
if timeframe.change("W")
    w_sumPV := 0.0, w_sumV := 0.0, w_sumV2 := 0.0
if timeframe.change("M")
    m_sumPV := 0.0, m_sumV := 0.0, m_sumV2 := 0.0
if timeframe.change("3M")
    q_sumPV := 0.0, q_sumV := 0.0, q_sumV2 := 0.0
if timeframe.change("12M")
    y_sumPV := 0.0, y_sumV := 0.0, y_sumV2 := 0.0
// Accumulate
float typPrice = hlc3
float vol = volume
d_sumPV += typPrice * vol, d_sumV += vol
w_sumPV += typPrice * vol, w_sumV += vol
m_sumPV += typPrice * vol, m_sumV += vol
q_sumPV += typPrice * vol, q_sumV += vol
y_sumPV += typPrice * vol, y_sumV += vol
// Calculate VWAP
float daily_vwap = d_sumV > 0 ? d_sumPV / d_sumV : na
float weekly_vwap = w_sumV > 0 ? w_sumPV / w_sumV : na
float monthly_vwap = m_sumV > 0 ? m_sumPV / m_sumV : na
float quarterly_vwap = q_sumV > 0 ? q_sumPV / q_sumV : na
float yearly_vwap = y_sumV > 0 ? y_sumPV / y_sumV : na
// Accumulate variance (after VWAP calculated)
d_sumV2 += vol * math.pow(typPrice - nz(daily_vwap), 2)
w_sumV2 += vol * math.pow(typPrice - nz(weekly_vwap), 2)
m_sumV2 += vol * math.pow(typPrice - nz(monthly_vwap), 2)
q_sumV2 += vol * math.pow(typPrice - nz(quarterly_vwap), 2)
y_sumV2 += vol * math.pow(typPrice - nz(yearly_vwap), 2)
// Calculate Standard Deviation
float d_stdev = d_sumV > 0 ? math.sqrt(d_sumV2 / d_sumV) : na
float w_stdev = w_sumV > 0 ? math.sqrt(w_sumV2 / w_sumV) : na
float m_stdev = m_sumV > 0 ? math.sqrt(m_sumV2 / m_sumV) : na
float q_stdev = q_sumV > 0 ? math.sqrt(q_sumV2 / q_sumV) : na
float y_stdev = y_sumV > 0 ? math.sqrt(y_sumV2 / y_sumV) : na
// Band levels
float d_upper1 = daily_vwap + d_stdev, float d_upper2 = daily_vwap + 2 * d_stdev
float d_lower1 = daily_vwap - d_stdev, float d_lower2 = daily_vwap - 2 * d_stdev
float w_upper1 = weekly_vwap + w_stdev, float w_upper2 = weekly_vwap + 2 * w_stdev
float w_lower1 = weekly_vwap - w_stdev, float w_lower2 = weekly_vwap - 2 * w_stdev
float m_upper1 = monthly_vwap + m_stdev, float m_upper2 = monthly_vwap + 2 * m_stdev
float m_lower1 = monthly_vwap - m_stdev, float m_lower2 = monthly_vwap - 2 * m_stdev
float q_upper1 = quarterly_vwap + q_stdev, float q_upper2 = quarterly_vwap + 2 * q_stdev
float q_lower1 = quarterly_vwap - q_stdev, float q_lower2 = quarterly_vwap - 2 * q_stdev
float y_upper1 = yearly_vwap + y_stdev, float y_upper2 = yearly_vwap + 2 * y_stdev
float y_lower1 = yearly_vwap - y_stdev, float y_lower2 = yearly_vwap - 2 * y_stdev
var float pdVWAP = na, var float pwVWAP = na, var float pmVWAP = na, var float pqVWAP = na, var float pyVWAP = na
var float lastDailyVWAP = na, var float lastWeeklyVWAP = na, var float lastMonthlyVWAP = na, var float lastQuarterlyVWAP = na, var float lastYearlyVWAP = na
if barstate.isconfirmed
    lastDailyVWAP := daily_vwap
    lastWeeklyVWAP := weekly_vwap
    lastMonthlyVWAP := monthly_vwap
    lastQuarterlyVWAP := quarterly_vwap
    lastYearlyVWAP := yearly_vwap
    
if timeframe.change("D")
    pdVWAP := lastDailyVWAP
if timeframe.change("W")
    pwVWAP := lastWeeklyVWAP
if timeframe.change("M")
    pmVWAP := lastMonthlyVWAP
if timeframe.change("3M")
    pqVWAP := lastQuarterlyVWAP
if timeframe.change("12M")
    pyVWAP := lastYearlyVWAP
// ═══════════════════════════════════════════════════
// VOLUME PROFILE
// ═══════════════════════════════════════════════════
type VolumeProfile
    array<float> prices
    array<float> volumes
    float poc
    float vah
    float val
    float periodHigh
    float periodLow
var VolumeProfile vpDaily = VolumeProfile.new(array.new<float>(), array.new<float>(), na, na, na, na, na)
var VolumeProfile vpWeekly = VolumeProfile.new(array.new<float>(), array.new<float>(), na, na, na, na, na)
var VolumeProfile vpMonthly = VolumeProfile.new(array.new<float>(), array.new<float>(), na, na, na, na, na)
var VolumeProfile vpQuarterly = VolumeProfile.new(array.new<float>(), array.new<float>(), na, na, na, na, na)
var VolumeProfile vpYearly = VolumeProfile.new(array.new<float>(), array.new<float>(), na, na, na, na, na)
calcVolumeProfile(VolumeProfile vp, int numBins) =>
    float poc = na, float vah = na, float val = na
    if array.size(vp.volumes) > 0 and not na(vp.periodHigh) and not na(vp.periodLow) and vp.periodHigh > vp.periodLow
        float binSize = (vp.periodHigh - vp.periodLow) / numBins
        if binSize > 0
            array<float> binVolumes = array.new<float>(numBins, 0.0)
            for i = 0 to array.size(vp.prices) - 1
                float price = array.get(vp.prices, i)
                float binVol = array.get(vp.volumes, i)
                int binIdx = math.min(math.floor((price - vp.periodLow) / binSize), numBins - 1)
                if binIdx >= 0 and binIdx < numBins
                    array.set(binVolumes, binIdx, array.get(binVolumes, binIdx) + binVol)
            float maxVol = 0.0
            int pocBin = 0
            for i = 0 to numBins - 1
                if array.get(binVolumes, i) > maxVol
                    maxVol := array.get(binVolumes, i)
                    pocBin := i
            poc := vp.periodLow + (pocBin + 0.5) * binSize
            float totalVol = array.sum(binVolumes)
            float targetVol = totalVol * 0.70
            float accumulatedVol = array.get(binVolumes, pocBin)
            int upperBin = pocBin, int lowerBin = pocBin
            while accumulatedVol < targetVol and (lowerBin > 0 or upperBin < numBins - 1)
                float upperVol = upperBin < numBins - 1 ? array.get(binVolumes, upperBin + 1) : 0.0
                float lowerVol = lowerBin > 0 ? array.get(binVolumes, lowerBin - 1) : 0.0
                if upperVol >= lowerVol and upperBin < numBins - 1
                    upperBin += 1
                    accumulatedVol += upperVol
                else if lowerBin > 0
                    lowerBin -= 1
                    accumulatedVol += lowerVol
                else if upperBin < numBins - 1
                    upperBin += 1
                    accumulatedVol += upperVol
                else
                    break
            val := vp.periodLow + lowerBin * binSize
            vah := vp.periodLow + (upperBin + 1) * binSize
    [poc, vah, val]
if timeframe.change("D")
    array.clear(vpDaily.prices), array.clear(vpDaily.volumes)
    vpDaily.periodHigh := high, vpDaily.periodLow := low
if timeframe.change("W")
    array.clear(vpWeekly.prices), array.clear(vpWeekly.volumes)
    vpWeekly.periodHigh := high, vpWeekly.periodLow := low
if timeframe.change("M")
    array.clear(vpMonthly.prices), array.clear(vpMonthly.volumes)
    vpMonthly.periodHigh := high, vpMonthly.periodLow := low
if timeframe.change("3M")
    array.clear(vpQuarterly.prices), array.clear(vpQuarterly.volumes)
    vpQuarterly.periodHigh := high, vpQuarterly.periodLow := low
if timeframe.change("12M")
    array.clear(vpYearly.prices), array.clear(vpYearly.volumes)
    vpYearly.periodHigh := high, vpYearly.periodLow := low
// Collect VP data (useVP OR nPOC features need data)
bool needVPdata = useVP or show_dnPOC or show_wnPOC
if needVPdata
    float barVol = volume
    if show_daily_poc or show_daily_vah or show_daily_val or show_dnPOC
        array.push(vpDaily.prices, typPrice), array.push(vpDaily.volumes, barVol)
        vpDaily.periodHigh := math.max(nz(vpDaily.periodHigh, high), high)
        vpDaily.periodLow := math.min(nz(vpDaily.periodLow, low), low)
    if show_weekly_poc or show_weekly_vah or show_weekly_val or show_wnPOC
        array.push(vpWeekly.prices, typPrice), array.push(vpWeekly.volumes, barVol)
        vpWeekly.periodHigh := math.max(nz(vpWeekly.periodHigh, high), high)
        vpWeekly.periodLow := math.min(nz(vpWeekly.periodLow, low), low)
    if show_monthly_poc or show_monthly_vah or show_monthly_val
        array.push(vpMonthly.prices, typPrice), array.push(vpMonthly.volumes, barVol)
        vpMonthly.periodHigh := math.max(nz(vpMonthly.periodHigh, high), high)
        vpMonthly.periodLow := math.min(nz(vpMonthly.periodLow, low), low)
    if show_quarterly_poc or show_quarterly_vah or show_quarterly_val
        array.push(vpQuarterly.prices, typPrice), array.push(vpQuarterly.volumes, barVol)
        vpQuarterly.periodHigh := math.max(nz(vpQuarterly.periodHigh, high), high)
        vpQuarterly.periodLow := math.min(nz(vpQuarterly.periodLow, low), low)
    if show_yearly_poc or show_yearly_vah or show_yearly_val
        array.push(vpYearly.prices, typPrice), array.push(vpYearly.volumes, barVol)
        vpYearly.periodHigh := math.max(nz(vpYearly.periodHigh, high), high)
        vpYearly.periodLow := math.min(nz(vpYearly.periodLow, low), low)
// Calculate VP (only on recent bars for performance)
var float daily_poc = na, var float daily_vah = na, var float daily_val = na
var float weekly_poc = na, var float weekly_vah = na, var float weekly_val = na
var float monthly_poc = na, var float monthly_vah = na, var float monthly_val = na
var float quarterly_poc = na, var float quarterly_vah = na, var float quarterly_val = na
var float yearly_poc = na, var float yearly_vah = na, var float yearly_val = na
// Calculate VP (limit to last 50 bars for performance, unless nPOC needs full history)
bool needFullHistory = show_dnPOC or show_wnPOC
if bar_index > last_bar_index - 50 or needFullHistory
    [d_poc, d_vah, d_val] = calcVolumeProfile(vpDaily, vpBins)
    daily_poc := d_poc, daily_vah := d_vah, daily_val := d_val
    [w_poc, w_vah, w_val] = calcVolumeProfile(vpWeekly, vpBins)
    weekly_poc := w_poc, weekly_vah := w_vah, weekly_val := w_val
    [m_poc, m_vah, m_val] = calcVolumeProfile(vpMonthly, vpBins)
    monthly_poc := m_poc, monthly_vah := m_vah, monthly_val := m_val
    [q_poc, q_vah, q_val] = calcVolumeProfile(vpQuarterly, vpBins)
    quarterly_poc := q_poc, quarterly_vah := q_vah, quarterly_val := q_val
    [y_poc, y_vah, y_val] = calcVolumeProfile(vpYearly, vpBins)
    yearly_poc := y_poc, yearly_vah := y_vah, yearly_val := y_val
// ═══════════════════════════════════════════════════
// NAKED POC (nPOC) - Previous POCs not yet touched
// ═══════════════════════════════════════════════════
var float[] dnPOC_levels = array.new_float()
var line[] dnPOC_lines = array.new_line()
var label[] dnPOC_labels = array.new_label()
var float[] wnPOC_levels = array.new_float()
var line[] wnPOC_lines = array.new_line()
var label[] wnPOC_labels = array.new_label()
// On new day, add YESTERDAY's POC to nPOC array (use [1] to get previous bar's value)
if timeframe.change("D") and show_dnPOC and not na(daily_poc[1])
    float yesterdayPOC = daily_poc[1]
    // Check if this POC is already in array (avoid duplicates)
    bool isDuplicate = false
    if array.size(dnPOC_levels) > 0
        for i = 0 to array.size(dnPOC_levels) - 1
            if math.abs(array.get(dnPOC_levels, i) - yesterdayPOC) < syminfo.mintick * 5
                isDuplicate := true
                break
    if not isDuplicate
        array.unshift(dnPOC_levels, yesterdayPOC)
        // Trim to max count
        while array.size(dnPOC_levels) > dnPOC_count
            array.pop(dnPOC_levels)
// On new week, add LAST WEEK's POC to nPOC array
if timeframe.change("W") and show_wnPOC and not na(weekly_poc[1])
    float lastWeekPOC = weekly_poc[1]
    bool isDuplicate = false
    if array.size(wnPOC_levels) > 0
        for i = 0 to array.size(wnPOC_levels) - 1
            if math.abs(array.get(wnPOC_levels, i) - lastWeekPOC) < syminfo.mintick * 5
                isDuplicate := true
                break
    if not isDuplicate
        array.unshift(wnPOC_levels, lastWeekPOC)
        while array.size(wnPOC_levels) > wnPOC_count
            array.pop(wnPOC_levels)
// Check for touches and remove touched nPOCs
// Daily nPOC touch check
var bool dnPOC_touchedThisBar = false
dnPOC_touchedThisBar := false
if array.size(dnPOC_levels) > 0
    for i = array.size(dnPOC_levels) - 1 to 0
        float lvl = array.get(dnPOC_levels, i)
        // Check if price touched this level (wick through)
        if high >= lvl and low <= lvl
            dnPOC_touchedThisBar := true
            array.remove(dnPOC_levels, i)
// Weekly nPOC touch check  
var bool wnPOC_touchedThisBar = false
wnPOC_touchedThisBar := false
if array.size(wnPOC_levels) > 0
    for i = array.size(wnPOC_levels) - 1 to 0
        float lvl = array.get(wnPOC_levels, i)
        if high >= lvl and low <= lvl
            wnPOC_touchedThisBar := true
            array.remove(wnPOC_levels, i)
// Draw nPOC lines and labels
// Clear previous drawings
for ln in dnPOC_lines
    line.delete(ln)
array.clear(dnPOC_lines)
for lb in dnPOC_labels
    label.delete(lb)
array.clear(dnPOC_labels)
for ln in wnPOC_lines
    line.delete(ln)
array.clear(wnPOC_lines)
for lb in wnPOC_labels
    label.delete(lb)
array.clear(wnPOC_labels)
// nPOC styling (calculated once, used for both daily and weekly)
string nPOCLineStyle = vpLineStyle == "Dashed" ? line.style_dashed : vpLineStyle == "Dotted" ? line.style_dotted : line.style_solid
var nPOCLabelStyle = sp_labelStyle == "Text Only" ? label.style_none : label.style_label_left
// Draw daily nPOCs
if show_dnPOC and array.size(dnPOC_levels) > 0
    for i = 0 to array.size(dnPOC_levels) - 1
        float lvl = array.get(dnPOC_levels, i)
        line ln = line.new(bar_index - 50, lvl, bar_index + xShift, lvl, color=dimLineColor(colnPOC), width=sp_lineWidth, style=nPOCLineStyle)
        array.push(dnPOC_lines, ln)
        if showLabels
            string lblText = "dnPOC" + str.tostring(i + 1)
            label lb = label.new(bar_index + xShift, lvl, lblText, style=nPOCLabelStyle, color=color.new(colnPOC, 80), textcolor=colLabelText, size=getLabelSize())
            array.push(dnPOC_labels, lb)
// Draw weekly nPOCs
if show_wnPOC and array.size(wnPOC_levels) > 0
    for i = 0 to array.size(wnPOC_levels) - 1
        float lvl = array.get(wnPOC_levels, i)
        line ln = line.new(bar_index - 100, lvl, bar_index + xShift, lvl, color=dimLineColor(colnPOC), width=sp_lineWidth, style=nPOCLineStyle)
        array.push(wnPOC_lines, ln)
        if showLabels
            string lblText = "wnPOC" + str.tostring(i + 1)
            label lb = label.new(bar_index + xShift, lvl, lblText, style=nPOCLabelStyle, color=color.new(colnPOC, 80), textcolor=colLabelText, size=getLabelSize())
            array.push(wnPOC_labels, lb)
// ═══════════════════════════════════════════════════
// GAP LEVELS
// ═══════════════════════════════════════════════════
var float gapHigh = na
var float gapLow = na
var bool gapExists = false
var bool gapFilled = false
var bool gapUp = false
// Daily gap detection
if timeframe.change("D") and useGAP and gap_daily
    float prevClose = calD_C_p
    float todayOpen = open
    float gapSize = math.abs(todayOpen - prevClose) / prevClose * 100
    
    if gapSize >= gap_minSize
        gapExists := true
        gapFilled := false
        gapUp := todayOpen > prevClose
        if gapUp  // Gap up
            gapHigh := todayOpen
            gapLow := prevClose
        else  // Gap down
            gapHigh := prevClose
            gapLow := todayOpen
    else
        gapExists := false
// Check gap fill
if gapExists and not gapFilled
    if low <= gapLow and high >= gapHigh
        gapFilled := true
    else if gapUp  // Gap up - filled when price comes down to prev close
        if low <= gapLow
            gapFilled := true
    else  // Gap down - filled when price goes up to prev close
        if high >= gapHigh
            gapFilled := true
// ═══════════════════════════════════════════════════
// LEVEL INFO TYPE FOR SMART LABELS & CONFLUENCE
// ═══════════════════════════════════════════════════
type LevelInfo
    string name
    float price
    color col
    label lb
// Type for hidden confluence discovery
type DiscoverableLevel
    string name      // e.g. "0.618", "dH", "wVWAP"
    float price
    string system    // e.g. "Fib", "HTF", "VWAP", "Prev"
var array<LevelInfo> activeLevels = array.new<LevelInfo>()
var array<LevelInfo> htfTableLevels = array.new<LevelInfo>()
var array<DiscoverableLevel> allDiscoverableLevels = array.new<DiscoverableLevel>()
// ═══════════════════════════════════════════════════
// SMART LABEL FUNCTION
// ═══════════════════════════════════════════════════
formatLabel(string txt, float price) =>
    showPriceOnLabel ? txt + " : " + str.tostring(price, format.mintick) : txt
getLabelStyle() =>
    sp_labelStyle == "Text Only" ? label.style_none : label.style_label_left
ensureLabelSmart(label existingLabel, bool enabled, float price, color col, string txt) =>
    label theLabel = existingLabel
    if showLabels and enabled and not na(price)
        // Draw label (will be combined later if overlapping)
        string labelText = formatLabel(txt, price)
        if na(theLabel)
            theLabel := label.new(bar_index + xShift, price, labelText, xloc.bar_index, yloc.price, col, getLabelStyle(), colLabelText, getLabelSize())
        else
            label.set_xy(theLabel, bar_index + xShift, price)
            label.set_text(theLabel, labelText)
            label.set_color(theLabel, col)
            label.set_textcolor(theLabel, colLabelText)
            label.set_size(theLabel, getLabelSize())
            label.set_style(theLabel, getLabelStyle())  // Reset style in case it was hidden
        // Track for combining
        array.push(activeLevels, LevelInfo.new(txt, price, col, theLabel))
    else
        if not na(theLabel)
            label.delete(theLabel)
            theLabel := na
    theLabel
// ═══════════════════════════════════════════════════
// LEVEL DRAWING TYPE AND FUNCTION
// ═══════════════════════════════════════════════════
type LevelState
    line ln
    label lb
    float prevPrice
    int anchor
// Track prices where lines have been drawn (for deduplication)
var array<float> drawnLinePrices = array.new<float>()
// Check if a line already exists at this price
lineExistsAtPrice(float price) =>
    bool exists = false
    int sz = array.size(drawnLinePrices)
    float threshold = close * sp_combineThreshold / 100
    if sz > 0
        for i = 0 to sz - 1
            if math.abs(array.get(drawnLinePrices, i) - price) <= threshold
                exists := true
                break
    exists
drawLevel(LevelState state, bool enabled, float price, color col, string txt, string lineStyle, int startBar) =>
    bool shouldDraw = enabled and not na(price)
    if shouldDraw
        // Check if line already exists at this price level
        bool lineAlreadyDrawn = lineExistsAtPrice(price)
        if not lineAlreadyDrawn
            // Draw line - either extend right or stop at label
            int safeStartBar = bar_index
            int lineEndBar = sp_lineExtend ? bar_index + 1 : bar_index + xShift
            if not na(state.ln)
                line.delete(state.ln)
            state.ln := line.new(safeStartBar, price, lineEndBar, price, xloc.bar_index, sp_lineExtend ? extend.right : extend.none, dimLineColor(col), getLineStyle(lineStyle), sp_lineWidth)
            state.prevPrice := price
            // Track this price as having a line
            array.push(drawnLinePrices, price)
        else
            // Line exists - delete our line if we had one
            if not na(state.ln)
                line.delete(state.ln)
                state.ln := na
            state.prevPrice := na
    else
        if not na(state.ln)
            line.delete(state.ln)
            state.ln := na
        state.prevPrice := na
    state.lb := ensureLabelSmart(state.lb, shouldDraw, price, col, txt)
// Clear tracking arrays at start of each bar
array.clear(activeLevels)
array.clear(drawnLinePrices)
