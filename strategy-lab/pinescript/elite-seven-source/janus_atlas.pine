// Auto-detect CME symbol based on chart ticker
detectCMESymbol() =>
    string ticker = str.upper(syminfo.ticker)
    string base = str.upper(syminfo.basecurrency)
    
    // Bitcoin (CME)
    if str.contains(ticker, "BTC") or str.contains(ticker, "XBT") or base == "BTC"
        "CME:BTC1!"
    // Ethereum (CME)
    else if str.contains(ticker, "ETH") or base == "ETH"
        "CME:ETH1!"
    // S&P 500 (CME_MINI for E-mini)
    else if str.contains(ticker, "SPY") or str.contains(ticker, "SPX") or str.contains(ticker, "ES1") or ticker == "ES" or str.contains(ticker, "SPDR")
        "CME_MINI:ES1!"
    // Nasdaq (CME_MINI for E-mini)
    else if str.contains(ticker, "QQQ") or str.contains(ticker, "NDX") or str.contains(ticker, "NQ1") or ticker == "NQ" or str.contains(ticker, "NASDAQ")
        "CME_MINI:NQ1!"
    // Dow Jones (CBOT_MINI for E-mini)
    else if str.contains(ticker, "DIA") or str.contains(ticker, "DJI") or str.contains(ticker, "YM1") or ticker == "YM"
        "CBOT_MINI:YM1!"
    // Russell 2000 (CME_MINI for E-mini)
    else if str.contains(ticker, "IWM") or str.contains(ticker, "RUT") or str.contains(ticker, "RTY1") or ticker == "RTY"
        "CME_MINI:RTY1!"
    // Gold (COMEX)
    else if str.contains(ticker, "GOLD") or str.contains(ticker, "XAU") or str.contains(ticker, "GC1") or ticker == "GC" or str.contains(ticker, "GLD")
        "COMEX:GC1!"
    // Silver (COMEX)
    else if str.contains(ticker, "SILVER") or str.contains(ticker, "XAG") or str.contains(ticker, "SI1") or ticker == "SI" or str.contains(ticker, "SLV")
        "COMEX:SI1!"
    // Crude Oil (NYMEX)
    else if str.contains(ticker, "OIL") or str.contains(ticker, "WTI") or str.contains(ticker, "CL1") or ticker == "CL" or str.contains(ticker, "USO") or str.contains(ticker, "USOIL")
        "NYMEX:CL1!"
    // Natural Gas (NYMEX)
    else if str.contains(ticker, "NATGAS") or str.contains(ticker, "NG1") or ticker == "NG" or str.contains(ticker, "UNG")
        "NYMEX:NG1!"
    // Euro FX (CME)
    else if str.contains(ticker, "EURUSD") or str.contains(ticker, "6E1") or ticker == "6E"
        "CME:6E1!"
    // Japanese Yen (CME)
    else if str.contains(ticker, "USDJPY") or str.contains(ticker, "6J1") or ticker == "6J"
        "CME:6J1!"
    // Dollar Index (ICEUS)
    else if str.contains(ticker, "DXY") or str.contains(ticker, "DX1") or ticker == "DX"
        "ICEUS:DX1!"
    // Copper (COMEX)
    else if str.contains(ticker, "COPPER") or str.contains(ticker, "HG1") or ticker == "HG"
        "COMEX:HG1!"
    // Corn (CBOT)
    else if str.contains(ticker, "CORN") or str.contains(ticker, "ZC1") or ticker == "ZC"
        "CBOT:ZC1!"
    // Soybeans (CBOT)
    else if str.contains(ticker, "SOYBEAN") or str.contains(ticker, "ZS1") or ticker == "ZS"
        "CBOT:ZS1!"
    // Wheat (CBOT)
    else if str.contains(ticker, "WHEAT") or str.contains(ticker, "ZW1") or ticker == "ZW"
        "CBOT:ZW1!"
    // No match
    else
        ""
// Determine final CME symbol to use
string cme_detected = detectCMESymbol()
string cme_symbol = cme_autoDetect ? cme_detected : cme_manualSym
bool cme_hasValidSymbol = cme_symbol != ""
