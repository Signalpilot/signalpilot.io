// +==================================================================+ // | VOLUME ORACLE - REGIME DETECTION | // | v1.0 - 2026 | // +==================================================================+ // // +------------------------------------------------------------------+ // | TABLE OF CONTENTS | // +------------------------------------------------------------------+ // | SECTION LINE (approx) | // | | // | 1. INPUTS / SETTINGS ................................. ~60 | // | |-- 1.1 Detection | // | |-- 1.2 Risk | // | |-- 1.3 Multi-Timeframe | // | |-- 1.4 Strategy | // | |-- 1.5 Display | // | +-- 1.6 Table Style | // | 2. HELPER FUNCTIONS .................................. ~118 | // | 3. MODULAR ANALYSIS FUNCTIONS ........................ ~149 | // | |-- 3.1 Footprint Analysis | // | |-- 3.2 Regime Scoring | // | +-- 3.3 Warning Status | // | 4. TIMEFRAME ADAPTATION .............................. ~244 | // | 5. CORE CALCULATIONS ................................. ~326 | // | |-- 5.1 Squeeze Detection | // | |-- 5.2 Volume Climax Detection | // | |-- 5.3 Regime Detection Engine | // | |-- 5.4 Market Structure | // | |-- 5.5 Volume Footprint | // | |-- 5.6 Volume-Weighted Flow | // | +-- 5.7 Regime Scoring & Thresholds | // | 6. ENHANCED WARNING SYSTEM ........................... ~631 | // | 7. LEADING EXIT INDICATORS ........................... ~700 | // | 8. HTF SYSTEM ........................................ ~743 | // | 9. SIGNAL GENERATION ................................. ~797 | // | |-- 9.1 Signal Density Tracking | // | |-- 9.2 Quality Scoring | // | +-- 9.3 Signal Conditions | // | 10. POSITION MANAGEMENT .............................. ~969 | // | 11. EXIT CONDITIONS .................................. ~1058 | // | 12. VISUALS .......................................... ~1139 | // | |-- 12.1 Volume Plot & Labels | // | |-- 12.2 Regime Table | // | +-- 12.3 HTF Table | // | 13. ALERTS & SCREENER ................................ ~1388 | // +------------------------------------------------------------------+ // // Non-repainting - All signals confirmed on bar close - 25 alerts // // DISCLAIMER: Educational analysis tool only. Not financial advice. // // =================================================================== //@version=6 indicator("Volume Oracle - Regime Detection", shorttitle="Volume Oracle", overlay=false, max_labels_count=200, max_lines_count=50) // ═══════════════════════════════════════════════════════════════════ // 1. INPUTS / SETTINGS // ═══════════════════════════════════════════════════════════════════ // ─── 1️⃣ DETECTION ─── sp_grp_detect = "1️⃣ Detection" sp_z_threshold = input.float(2.0, "Volume spike threshold", minval=1.5, step=0.1, group=sp_grp_detect, tooltip="Z-score threshold for detecting significant volume spikes. Higher values require larger volume anomalies to trigger signals. 1.5 = permissive, more signals. 2.0 = balanced (default). 2.5+ = strict, only major volume events.") sp_signal_cooldown = input.int(45, "Signal cooldown (bars)", minval=15, group=sp_grp_detect, tooltip="Minimum bars required between consecutive signals. Prevents overtrading during choppy conditions. 15 = frequent signals. 45 = balanced (default). 80+ = conservative, only well-spaced setups.") sp_regime_sensitivity = input.string("Balanced", "Regime sensitivity", options=["Conservative","Balanced","Aggressive"], group=sp_grp_detect, tooltip="Controls how quickly regime detection responds to changing conditions. 'Conservative' = stable regimes, fewer flips, more confirmation required. 'Balanced' = moderate response speed (default). 'Aggressive' = fast regime changes, quicker to flip but more noise.") sp_auto_adapt = input.bool(true, "Auto-adapt to volatility", group=sp_grp_detect, tooltip="Automatically adjusts detection thresholds based on current ATR volatility. OFF = fixed thresholds regardless of market conditions. ON = thresholds scale with volatility (default), raises bar during high volatility, lowers during calm periods.") sp_early_warning = input.bool(true, "Regime warnings", group=sp_grp_detect, tooltip="Shows graduated warning levels (FADING → WEAKENING → CRITICAL) as regime loses strength. OFF = no early warnings, only regime flips shown. ON = early warning system active (default), volume bars turn yellow when regime weakening.") // ─── 2️⃣ RISK ─── sp_grp_risk = "2️⃣ Risk" sp_account_size = input.float(10000, "Account size ($)", minval=100, group=sp_grp_risk, tooltip="Your trading account balance in dollars. Used to calculate position sizes based on risk percentage. Update this to match your actual account for accurate sizing suggestions.") sp_risk_percent = input.float(1.0, "Risk per trade (%)", minval=0.1, maxval=5.0, step=0.1, group=sp_grp_risk, tooltip="Percentage of account to risk per trade. Controls position sizing in tooltips. 0.5% = conservative. 1.0% = standard (default). 2.0%+ = aggressive, not recommended for most traders.") sp_atr_len = input.int(14, "ATR length", minval=5, group=sp_grp_risk, tooltip="Period for Average True Range calculation used in stop/target distances. 7 = responsive to recent volatility. 14 = industry standard (default). 21+ = smoother, less reactive to spikes.") sp_stop_mult = input.float(1.5, "Stop (ATR×)", minval=0.5, step=0.1, group=sp_grp_risk, tooltip="Stop loss distance as multiple of ATR. Determines how much room the trade has to breathe. 1.0× = tight stop, less risk but more stops hit. 1.5× = balanced (default). 2.0×+ = wide stop, more room but larger risk per share.") sp_target1_mult = input.float(2.0, "Target 1 (ATR×)", minval=0.5, step=0.1, group=sp_grp_risk, tooltip="First profit target as multiple of ATR. Where partial exit occurs. 1.5× = quick scalp target. 2.0× = balanced R:R of 1.3:1 (default). 3.0×+ = extended target, fewer hits but larger wins.") sp_target2_mult = input.float(3.5, "Target 2 (ATR×)", minval=0.5, step=0.1, group=sp_grp_risk, tooltip="Final profit target as multiple of ATR. Where remaining position exits. 2.5× = conservative runner. 3.5× = balanced R:R of 2.3:1 (default). 5.0×+ = aggressive runner, requires strong trends.") sp_partial_t1 = input.float(50.0, "Partial exit at T1 (%)", minval=0, maxval=100, step=10, group=sp_grp_risk, tooltip="Percentage of position to close when Target 1 is reached. Locks in profit while letting remainder run. 0% = no partial, all-or-nothing. 50% = half position (default). 75%+ = take most profit early, small runner.") sp_use_trailing = input.bool(true, "Trailing stop", group=sp_grp_risk, tooltip="Enables trailing stop after Target 1 is hit. Protects profits on the remaining position. OFF = fixed stop only, no trailing. ON = trailing activates after T1 (default), locks in gains as price extends.") sp_trailing_mult = input.float(1.0, "Trailing (ATR×)", minval=0.5, step=0.1, group=sp_grp_risk, tooltip="Trailing stop distance as multiple of ATR. How close the stop follows price after T1. 0.5× = tight trail, quick exit on pullbacks. 1.0× = balanced (default). 1.5×+ = loose trail, more room for volatility.") sp_breakeven_mult = input.float(1.0, "Breakeven (ATR×)", minval=0.5, step=0.1, group=sp_grp_risk, tooltip="Distance price must move before stop moves to breakeven. Protects entry once momentum confirmed. 0.5× = quick breakeven. 1.0× = balanced (default). 1.5×+ = gives trade more room before protecting.") // ─── 3️⃣ MULTI-TIMEFRAME ─── sp_grp_htf = "3️⃣ Multi-Timeframe" sp_use_htf = input.bool(false, "Enable HTF filter", group=sp_grp_htf, tooltip="Adds higher timeframe regime confirmation before generating signals. Reduces noise by requiring HTF agreement. OFF = signals based on current TF only (default). ON = signals require HTF regime alignment, fewer but higher conviction setups.") sp_htf_tf1 = input.timeframe("60", "HTF 1", group=sp_grp_htf, tooltip="First higher timeframe for regime confirmation. Should be 3-6× your chart timeframe. Use '60' on 15m charts. Use '240' on 1H charts. Use 'D' on 4H charts. Use 'W' on daily charts.") sp_use_htf2 = input.bool(false, "Enable HTF 2", group=sp_grp_htf, tooltip="Adds a second higher timeframe layer for triple-TF confirmation. OFF = single HTF filter only (default). ON = requires both HTF1 and HTF2 alignment, maximum filtering but fewest signals.") sp_htf_tf2 = input.timeframe("240", "HTF 2", group=sp_grp_htf, tooltip="Second higher timeframe, should be higher than HTF1. Use '240' when HTF1 is '60'. Use 'D' when HTF1 is '240'. Use 'W' when HTF1 is 'D'.") sp_htf_strict = input.bool(true, "Strict mode", group=sp_grp_htf, tooltip="Controls whether HTF disagreement blocks signals entirely or just reduces quality score. OFF = HTF is advisory, signals still fire but with lower quality. ON = HTF must agree for signal to fire (default), cleanest signals.") sp_htf_strength_min = input.float(40.0, "Min HTF strength (%)", minval=0, maxval=100, group=sp_grp_htf, tooltip="Minimum HTF regime strength required for alignment. Filters weak HTF regimes that provide little directional conviction. 20% = permissive, weak HTF regimes count. 40% = balanced (default). 60%+ = strict, only strong HTF trends qualify.") // ─── 4️⃣ STRATEGY ─── sp_grp_strategy = "4️⃣ Strategy" sp_strategy_mode = input.string("Trend Following", "Mode", options=["Trend Following","Mean Reversion","Hybrid"], group=sp_grp_strategy, tooltip="Core strategy approach that affects signal generation logic. 'Trend Following' = signals align with regime direction, buy accumulation sell distribution (default). 'Mean Reversion' = signals at regime extremes expecting snapback. 'Hybrid' = both signal types enabled.") sp_mr_enabled = input.bool(false, "Mean reversion signals", group=sp_grp_strategy, tooltip="Enables counter-trend signals when regime reaches statistical extremes. OFF = trend-following signals only (default). ON = adds mean reversion signals at overbought/oversold levels, more signals but requires different trade management.") sp_mr_extremes = input.float(2.5, "MR threshold", minval=1.5, step=0.1, group=sp_grp_strategy, tooltip="Z-score threshold for mean reversion signal triggers. Measures how extended the regime is from normal. 1.5 = permissive, more MR signals at moderate extremes. 2.0 = balanced. 2.5 = conservative (default), only fires at statistical extremes. 3.0+ = rare, only major overextensions.") // ─── 5️⃣ DISPLAY ─── sp_grp_display = "5️⃣ Display" sp_show_regime_meter = input.bool(true, "Regime table", group=sp_grp_display, tooltip="Shows the regime status table with strength, status, structure, and health metrics. OFF = cleaner chart, no table. ON = full regime dashboard visible (default), essential for reading market state.") sp_show_regime_bg = input.bool(true, "Regime background", group=sp_grp_display, tooltip="Colors the indicator background based on current regime. OFF = neutral background. ON = green tint for accumulation, red for distribution (default), instant visual regime identification.") sp_show_exit_warnings = input.bool(true, "Exit warnings", group=sp_grp_display, tooltip="Displays yellow warning labels when exit conditions trigger. OFF = no exit notifications shown. ON = shows warnings for regime flips, weakness, time exits (default), helps with position management.") sp_show_quality_stars = input.bool(true, "Quality stars", group=sp_grp_display, tooltip="Displays star ratings on signal labels indicating confluence level. OFF = plain signal labels. ON = ⭐⭐⭐ rating system visible (default), quickly identify high-conviction vs marginal setups.") sp_show_mgmt_labels = input.bool(false, "T1/BE labels", group=sp_grp_display, tooltip="Shows chart labels when Target 1 hit or stop moved to breakeven. OFF = no management labels (default), cleaner chart. ON = T1 and BE events marked on chart, useful for journaling and review.") sp_show_risk_labels = input.bool(true, "Risk in tooltips", group=sp_grp_display, tooltip="Includes dollar risk amount in signal label tooltips. OFF = no risk info. ON = shows risk based on account size setting (default), helps with position sizing decisions.") sp_show_position_size = input.bool(true, "Size in tooltips", group=sp_grp_display, tooltip="Includes suggested position size in signal label tooltips. OFF = no size suggestions. ON = shows calculated position size based on risk settings (default), ready-to-use sizing.") sp_show_htf_table = input.bool(true, "HTF table", group=sp_grp_display, tooltip="Shows the higher timeframe status table when HTF filter is enabled. OFF = no HTF table even if HTF enabled. ON = displays HTF regime, strength, trend, and alignment status (default).") // ─── 6️⃣ TABLE STYLE ─── sp_grp_table = "6️⃣ Table Style" sp_table_layout = input.string("Vertical", "Layout", options=["Horizontal", "Vertical"], group=sp_grp_table, tooltip="Orientation of the regime status table. 'Horizontal' = compact 2-row layout, wider but shorter. 'Vertical' = 7-row stacked layout (default), narrower but taller, easier to read each metric.") sp_regime_table_pos = input.string("Bottom Right", "Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=sp_grp_table, tooltip="Screen position for the regime table. Choose based on your chart layout and where price action typically occurs. 'Bottom Right' = default, away from most price action.") sp_regime_table_size = input.string("Tiny", "Text size", options=["Tiny", "Small", "Normal", "Large"], group=sp_grp_table, tooltip="Font size for regime table text. 'Tiny' = smallest, minimal screen space (default). 'Small' = slightly larger. 'Normal' = standard size. 'Large' = maximum readability, takes more space.") sp_table_border = input.int(1, "Border", minval=0, maxval=3, group=sp_grp_table, tooltip="Border thickness around table cells. 0 = no borders, seamless look. 1 = thin borders (default). 2-3 = thicker borders, more defined cells.") sp_table_frame = input.int(0, "Frame", minval=0, maxval=3, group=sp_grp_table, tooltip="Frame thickness around entire table. 0 = no frame (default), table blends with chart. 1-3 = visible frame, makes table stand out more.") sp_htf_table_pos = input.string("Bottom Center", "HTF position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=sp_grp_table, tooltip="Screen position for the HTF status table. Place separately from regime table to avoid overlap. 'Bottom Center' = default.") sp_htf_table_size = input.string("Tiny", "HTF text size", options=["Tiny", "Small", "Normal", "Large"], group=sp_grp_table, tooltip="Font size for HTF table text. 'Tiny' = smallest (default). 'Small' = slightly larger. 'Normal' = standard. 'Large' = maximum readability.") // ═══════════════════════════════════════════════════════════════════ // 2. HELPER FUNCTIONS // ═══════════════════════════════════════════════════════════════════ spZscore(src, len) => float m = ta.sma(src, len) float sd = ta.stdev(src, len) sd == 0.0 ? 0.0 : (src - m) / sd spCalcPositionSize(accountSize, riskPercent, stopDistance) => float riskAmount = accountSize * (riskPercent / 100.0) float shares = riskAmount / stopDistance shares spGetTablePosition(pos) => pos == "Top Left" ? position.top_left : pos == "Top Center" ? position.top_center : pos == "Top Right" ? position.top_right : pos == "Middle Left" ? position.middle_left : pos == "Middle Center" ? position.middle_center : pos == "Middle Right" ? position.middle_right : pos == "Bottom Left" ? position.bottom_left : pos == "Bottom Center" ? position.bottom_center : position.bottom_right spGetTextSize(sz) => sz == "Tiny" ? size.tiny : sz == "Small" ? size.small : sz == "Normal" ? size.normal : size.large // ═══════════════════════════════════════════════════════════════════ // 3. MODULAR ANALYSIS FUNCTIONS (Pure - No ta.* Inside) // ═══════════════════════════════════════════════════════════════════ // ─── FOOTPRINT ANALYSIS ─── // Classifies volume spikes as Momentum or Absorption spCalcFootprint(volSpike, bodyRatio, totalWick, body, isBullBar) => // Absorption: small body + large wicks bool isAbsorption = volSpike and bodyRatio < 0.35 and totalWick > body * 1.5 // Momentum: large body + small wicks bool isMomentum = volSpike and bodyRatio > 0.65
bool bullishAbsorption = isAbsorption and isBullBar bool bearishAbsorption = isAbsorption and not isBullBar bool bullishMomentum = isMomentum and isBullBar bool bearishMomentum = isMomentum and not isBullBar  string footprint = isAbsorption ? "ABSORPTION" : isMomentum ? "MOMENTUM" : volSpike ? "SPIKE" : "NORMAL"  [footprint, isAbsorption, isMomentum, bullishMomentum, bearishMomentum, bullishAbsorption, bearishAbsorption] 
// ─── REGIME SCORING ─── // Calculates composite regime score from multiple components spCalcRegimeScore(priceVelocity, priceAccel, trendBull, trendBullSoft, trendBear, trendBearSoft, emaSpread, bullFrac, flowShift, elevatedVol) => float score = 0.0
// Price velocity is KING (1% = 30 points) score += priceVelocity * 30.0  // Acceleration bonus score += priceAccel * 15.0  // Trend alignment if trendBull     score += 25.0 else if trendBullSoft     score += 12.0 else if trendBear     score -= 25.0 else if trendBearSoft     score -= 12.0  // EMA spread (1% = 8 points) score += emaSpread * 8.0  // Flow imbalance (70% bull = +40 points) score += (bullFrac - 0.5) * 200.0  // Flow shift momentum score += flowShift * 100.0  // Volume confirmation if elevatedVol     score += score > 0 ? 10.0 : -10.0  score 
// ─── WARNING STATUS ─── // Determines regime health status based on thresholds spCalcWarningStatus(regimeEma, flipThreshold, isAccum, isDist, regimeRoc, rapidThreshold) => float warnFading = flipThreshold * 2.5 float warnWeakening = flipThreshold * 1.8 float warnCritical = flipThreshold * 1.3
string status = "✓ STRONG" bool weakening = false bool rapidDecline = false  if isAccum     rapidDecline := regimeRoc < -rapidThreshold     if regimeEma < warnCritical and regimeEma > 0         status := "⚠️ CRITICAL"         weakening := true     else if regimeEma < warnWeakening and regimeEma > 0         status := "⚡ WEAKENING"         weakening := true     else if regimeEma < warnFading and regimeEma > 0         status := "📉 FADING"         weakening := true else if isDist     rapidDecline := regimeRoc > rapidThreshold     if regimeEma > -warnCritical and regimeEma < 0         status := "⚠️ CRITICAL"         weakening := true     else if regimeEma > -warnWeakening and regimeEma < 0         status := "⚡ WEAKENING"         weakening := true     else if regimeEma > -warnFading and regimeEma < 0         status := "📉 FADING"         weakening := true else     status := "— NEUTRAL"  [status, weakening, rapidDecline] 
// ═══════════════════════════════════════════════════════════════════ // 4. TIMEFRAME ADAPTATION - COMPREHENSIVE SYSTEM // ═══════════════════════════════════════════════════════════════════ // Get current timeframe in minutes float sp_tf_minutes = timeframe.in_seconds() / 60.0 // ─── TIMEFRAME CATEGORIES ─── // Each category has different trading characteristics bool sp_is_scalp = sp_tf_minutes <= 5 // 1m, 3m, 5m - High noise, fast moves bool sp_is_intraday = sp_tf_minutes <= 60 // 15m, 30m, 1H - Medium noise bool sp_is_swing = sp_tf_minutes <= 240 // 2H, 4H - Lower noise, clearer trends bool sp_is_position = sp_tf_minutes > 240 // 1D, 1W, 1M - Lowest noise, major trends string sp_tf_category = sp_is_scalp ? "SCALP" : sp_is_intraday ? "INTRADAY" : sp_is_swing ? "SWING" : "POSITION" // ─── TARGET REGIME DURATION (in hours) ─── // How long should a "real" regime last for this trading style? // Scalper: 1-2 hours | Day trader: 4-8 hours | Swing: 1-3 days | Position: 1-2 weeks float sp_target_regime_hours = sp_is_scalp ? 1.5 : sp_is_intraday ? 6.0 : sp_is_swing ? 36.0 : 168.0 // Convert target duration to bars (minimum regime stability) int sp_target_regime_bars = math.max(5, math.round(sp_target_regime_hours * 60.0 / sp_tf_minutes)) // ─── ADAPTIVE PARAMETERS ─── // REGIME LOOKBACK: Analyze 2-3x target regime duration for context // But cap it to avoid looking too far back on low TFs int sp_adaptive_regime_len = math.max(15, math.min(100, math.round(sp_target_regime_bars * 2.5))) // VELOCITY LOOKBACK: Recent momentum, ~15% of regime duration // This is what makes it responsive to reversals int sp_adaptive_velocity_len = math.max(2, math.min(20, math.round(sp_target_regime_bars * 0.15))) // COOLDOWN: Minimum stability, ~30% of target regime // Prevents flip-flop within a regime int sp_adaptive_cooldown = math.max(2, math.min(15, math.round(sp_target_regime_bars * 0.3))) // FLOW ANALYSIS: Consensus window, ~50% of regime lookback int sp_flow_len = math.max(8, math.min(30, math.round(sp_adaptive_regime_len * 0.5))) // VOLUME CHECK: For drying detection, ~30% of velocity int sp_vol_check_len = math.max(3, math.round(sp_adaptive_velocity_len * 0.5)) // ─── THRESHOLD SCALING ─── // Lower TFs have more noise, need LOWER thresholds (easier to trigger) // Higher TFs have cleaner signals, need HIGHER thresholds (more conviction required) float sp_tf_threshold_mult = sp_is_scalp ? 0.65 : sp_is_intraday ? 0.80 : sp_is_swing ? 1.0 : 1.3 // ─── CONFIRMATION BARS REQUIRED ─── // How many bars above threshold before we flip? // More bars on lower TFs (filter noise), fewer on higher TFs (each bar matters) int sp_confirm_bars = sp_is_scalp ? 3 : sp_is_intraday ? 2 : 2 // ─── FLOW RATIO ─── // Consensus required for flow agreement // Slightly higher on low TFs to filter noise float sp_flow_ratio = sp_is_scalp ? 0.68 : sp_is_intraday ? 0.65 : sp_is_swing ? 0.62 : 0.60 // ─── EMA SMOOTHING ─── // Regime score smoothing - more on low TFs int sp_regime_ema_len = sp_is_scalp ? 5 : sp_is_intraday ? 3 : sp_is_swing ? 3 : 2 // ─── ACCELERATION LOOKBACK ─── int sp_accel_lookback = math.max(2, math.round(sp_adaptive_velocity_len * 0.5)) // ═══════════════════════════════════════════════════════════════════ // 5. CORE CALCULATIONS // ═══════════════════════════════════════════════════════════════════ // ─── 5.1 VOLUME SPIKE DETECTION ─── float sp_vol_z = spZscore(math.log(math.max(volume, 1.0)), 100) bool sp_vol_spike = sp_vol_z >= sp_z_threshold // ─── 5.2 ADAPTIVE VOLATILITY SYSTEM ─── float sp_atr = ta.atr(sp_atr_len) float sp_atr_z = spZscore(sp_atr, 100) string sp_vol_regime = sp_atr_z > 1.0 ? "HIGH" : sp_atr_z < -1.0 ? "LOW" : "NORMAL" float sp_vol_multiplier = sp_vol_regime == "HIGH" ? 1.3 : sp_vol_regime == "LOW" ? 0.8 : 1.0 // ─── 5.3 SQUEEZE DETECTION (Adaptive) ─── // Adaptive BB lengths based on regime lookback int sp_bb_len = math.max(10, math.round(sp_adaptive_regime_len * 0.3)) int sp_bb_sma_len = math.max(20, sp_adaptive_regime_len) float sp_bb_basis = ta.sma(close, sp_bb_len) float sp_bb_dev = ta.stdev(close, sp_bb_len) float sp_bb_width = sp_bb_basis != 0 ? (sp_bb_dev * 2) / sp_bb_basis * 100 : 0 float sp_bb_width_sma = ta.sma(sp_bb_width, sp_bb_sma_len) bool sp_in_squeeze = sp_bb_width < sp_bb_width_sma * 0.8 float sp_squeeze_proximity = sp_bb_width_sma > 0 ? sp_bb_width_sma / math.max(sp_bb_width, 0.001) : 1.0 float sp_squeeze_score = math.min(math.max(sp_squeeze_proximity - 1.0, 0.0), 1.0) * 10.0 bool sp_squeeze_breakout = sp_in_squeeze or sp_in_squeeze[1] or sp_in_squeeze[2] or sp_in_squeeze[3] or sp_in_squeeze[4] // ─── 5.4 VOLUME CLIMAX DETECTION ─── float sp_climax_threshold = 3.5 bool sp_extreme_volume = sp_vol_z > sp_climax_threshold bool sp_bull_exhaustion = sp_extreme_volume and close < open and close < (high + low) / 2 bool sp_bear_exhaustion = sp_extreme_volume and close > open and close > (high + low) / 2 // ─── 5.5 DELTA CONFIRMATION ─── bool sp_bar_delta_bullish = close >= open bool sp_bar_delta_bearish = close < open // ─── 5.6 REGIME DETECTION ENGINE ─── // ─── COMPONENT 1: RECENT PRICE DIRECTION (Most Important!) ─── // Where is price going RIGHT NOW vs recent past? float sp_price_velocity = (close - close[sp_adaptive_velocity_len]) / close[sp_adaptive_velocity_len] * 100 // As percentage float sp_price_accel = sp_price_velocity - nz(sp_price_velocity[sp_accel_lookback]) // ─── COMPONENT 2: TREND STATE (EMA Alignment) ─── // Clear trend = EMAs aligned and price respecting them float sp_ema_fast = ta.ema(close, 8) // Faster EMAs for quicker response float sp_ema_mid = ta.ema(close, 21) float sp_ema_slow = ta.ema(close, 55) bool sp_trend_bull = sp_ema_fast > sp_ema_mid and sp_ema_mid > sp_ema_slow and close > sp_ema_fast bool sp_trend_bear = sp_ema_fast < sp_ema_mid and sp_ema_mid < sp_ema_slow and close < sp_ema_fast bool sp_trend_bull_soft = sp_ema_fast > sp_ema_slow and close > sp_ema_mid // Softer check bool sp_trend_bear_soft = sp_ema_fast < sp_ema_slow and close < sp_ema_mid // EMA spread as trend strength (percentage) float sp_ema_spread = (sp_ema_fast - sp_ema_slow) / sp_ema_slow * 100 float sp_trend_strength = math.abs(sp_ema_spread) // ─── COMPONENT 2B: MARKET STRUCTURE DETECTION (Backend Only) ─── // Detects HH/HL (bullish) vs LH/LL (bearish) to validate regime int sp_pivot_len = math.max(2, math.min(5, math.round(sp_adaptive_velocity_len * 0.5))) // Detect swing points float sp_swing_high = ta.pivothigh(high, sp_pivot_len, sp_pivot_len) float sp_swing_low = ta.pivotlow(low, sp_pivot_len, sp_pivot_len) // Track last two swing highs and lows var float sp_prev_swing_high = na var float sp_last_swing_high = na var float sp_prev_swing_low = na var float sp_last_swing_low = na if not na(sp_swing_high) sp_prev_swing_high := sp_last_swing_high sp_last_swing_high := sp_swing_high if not na(sp_swing_low) sp_prev_swing_low := sp_last_swing_low sp_last_swing_low := sp_swing_low // Determine structure bool sp_higher_high = not na(sp_last_swing_high) and not na(sp_prev_swing_high) and sp_last_swing_high > sp_prev_swing_high bool sp_lower_high = not na(sp_last_swing_high) and not na(sp_prev_swing_high) and sp_last_swing_high < sp_prev_swing_high bool sp_higher_low = not na(sp_last_swing_low) and not na(sp_prev_swing_low) and sp_last_swing_low > sp_prev_swing_low bool sp_lower_low = not na(sp_last_swing_low) and not na(sp_prev_swing_low) and sp_last_swing_low < sp_prev_swing_low // Structure state (no visual output - backend only) var string sp_prev_structure = "UNCLEAR" string sp_structure = "UNCLEAR" if sp_higher_high and sp_higher_low sp_structure := "BULLISH" // HH + HL = Uptrend structure else if sp_lower_high and sp_lower_low sp_structure := "BEARISH" // LH + LL = Downtrend structure else if sp_higher_high or sp_higher_low sp_structure := "MIXED_BULL" // Partial bullish else if sp_lower_high or sp_lower_low sp_structure := "MIXED_BEAR" // Partial bearish // ─── COMPONENT 2C: VOLUME FOOTPRINT DETECTION ─── // Classifies volume spikes as Absorption or Momentum float sp_body = math.abs(close - open) float sp_range = high - low float sp_body_ratio = sp_range > 0 ? sp_body / sp_range : 0 float sp_upper_wick = high - math.max(open, close) float sp_lower_wick = math.min(open, close) - low float sp_total_wick = sp_upper_wick + sp_lower_wick // Absorption: High volume + small body + large wicks (supply/demand being absorbed) bool sp_is_absorption = sp_vol_spike and sp_body_ratio < 0.35 and sp_total_wick > sp_body * 1.5 // Momentum: High volume + large body + small wicks (strong directional conviction) bool sp_is_momentum = sp_vol_spike and sp_body_ratio > 0.65 // Context-aware footprint bool sp_bullish_absorption = sp_is_absorption and close > open // Absorption with bullish close bool sp_bearish_absorption = sp_is_absorption and close < open // Absorption with bearish close bool sp_bullish_momentum = sp_is_momentum and close > open // Momentum pushing up bool sp_bearish_momentum = sp_is_momentum and close < open // Momentum pushing down string sp_footprint = sp_is_absorption ? "ABSORPTION" : sp_is_momentum ? "MOMENTUM" : sp_vol_spike ? "SPIKE" : "NORMAL" // ─── COMPONENT 3: VOLUME-WEIGHTED FLOW (Recent Bars Only) ─── float sp_recent_bull_flow = 0.0 float sp_recent_bear_flow = 0.0 int sp_flow_window = math.min(sp_flow_len, 20) // Cap at 20 bars for responsiveness for i = 0 to sp_flow_window - 1 float bar_range = math.max(high[i] - low[i], 0.0001) float bar_position = (close[i] - low[i]) / bar_range // 0 = closed at low, 1 = closed at high float bar_volume = volume[i]
// Bull bars: high close position = strong bull, low close position = weak bull // Bear bars: low close position = strong bear, high close position = weak bear if close[i] >= open[i]     // Green bar - contributes to bull flow, weighted by close position     sp_recent_bull_flow += bar_volume * bar_position else     // Red bar - contributes to bear flow, weighted by how low it closed     sp_recent_bear_flow += bar_volume * (1.0 - bar_position) 
float sp_flow_total = sp_recent_bull_flow + sp_recent_bear_flow float sp_bull_frac = sp_flow_total > 0 ? sp_recent_bull_flow / sp_flow_total : 0.5 float sp_bear_frac = 1.0 - sp_bull_frac // Flow momentum (is flow shifting?) var float sp_bull_frac_prev = 0.5 if barstate.isconfirmed sp_bull_frac_prev := sp_bull_frac[1] float sp_flow_shift = sp_bull_frac - sp_bull_frac_prev // Positive = shifting bullish // ─── COMPONENT 4: VOLUME CONFIRMATION ─── float sp_avg_vol = ta.sma(volume, sp_adaptive_regime_len) float sp_vol_ratio = volume / math.max(sp_avg_vol, 1.0) bool sp_elevated_vol = sp_vol_ratio > 1.2 // ─── REGIME SCORING - WEIGHTED FOR RESPONSIVENESS ─── float sp_regime_score = 0.0 // Price velocity is KING (recent direction) // 1% move = 30 points, 3% move = 90 points sp_regime_score += sp_price_velocity * 30.0 // Acceleration bonus (momentum increasing) sp_regime_score += sp_price_accel * 15.0 // Trend alignment (strong when EMAs stacked) if sp_trend_bull sp_regime_score += 25.0 else if sp_trend_bull_soft sp_regime_score += 12.0 else if sp_trend_bear sp_regime_score -= 25.0 else if sp_trend_bear_soft sp_regime_score -= 12.0 // EMA spread (wider = stronger trend) sp_regime_score += sp_ema_spread * 8.0 // 1% spread = 8 points // Flow imbalance (bull% - 50%) * multiplier // 70% bull = +40 points, 30% bull = -40 points sp_regime_score += (sp_bull_frac - 0.5) * 200.0 // Flow shift momentum sp_regime_score += sp_flow_shift * 100.0 // Volume spike bonus (confirms moves) if sp_elevated_vol if sp_regime_score > 0 sp_regime_score += 10.0 else sp_regime_score -= 10.0 // ─── ADAPTIVE THRESHOLDS ─── float sp_base_flip = sp_regime_sensitivity == "Conservative" ? 35 : sp_regime_sensitivity == "Balanced" ? 25 : 18 float sp_base_neutral = sp_regime_sensitivity == "Conservative" ? 20 : sp_regime_sensitivity == "Balanced" ? 15 : 10 float sp_flip_threshold = sp_base_flip * sp_tf_threshold_mult * (sp_auto_adapt ? sp_vol_multiplier : 1.0) float sp_neutral_band = sp_base_neutral * sp_tf_threshold_mult * (sp_auto_adapt ? sp_vol_multiplier : 1.0) // ═══════════════════════════════════════════════════ // v1.0: MULTI-BAR REGIME CONFIRMATION (Improvements #1, #2) // ═══════════════════════════════════════════════════ var string sp_regime = "NEUTRAL" var int sp_last_regime_flip = 0 var float sp_regime_ema = 0.0 sp_regime_ema := ta.ema(sp_regime_score, sp_regime_ema_len) var int sp_bars_above_threshold = 0 var int sp_bars_below_threshold = 0 var int sp_bars_in_neutral = 0 if sp_regime_ema > sp_flip_threshold sp_bars_above_threshold := sp_bars_above_threshold + 1 sp_bars_below_threshold := 0 sp_bars_in_neutral := 0 else if sp_regime_ema < -sp_flip_threshold sp_bars_below_threshold := sp_bars_below_threshold + 1 sp_bars_above_threshold := 0 sp_bars_in_neutral := 0 else if math.abs(sp_regime_ema) < sp_neutral_band sp_bars_in_neutral := sp_bars_in_neutral + 1 sp_bars_above_threshold := 0 sp_bars_below_threshold := 0 else sp_bars_in_neutral := 0 // Require confirmation bars (adaptive - more on low TFs to filter noise) bool sp_confirmed_accum = sp_bars_above_threshold >= sp_confirm_bars bool sp_confirmed_dist = sp_bars_below_threshold >= sp_confirm_bars bool sp_confirmed_neutral = sp_bars_in_neutral >= sp_confirm_bars bool sp_regime_cooldown_ok = bar_index - sp_last_regime_flip >= sp_adaptive_cooldown // Track if regime changed this bar (for resetting weakening counter) string sp_prev_regime = sp_regime if sp_regime_cooldown_ok if sp_confirmed_accum if sp_regime != "ACCUMULATION" sp_last_regime_flip := bar_index sp_regime := "ACCUMULATION" else if sp_confirmed_dist if sp_regime != "DISTRIBUTION" sp_last_regime_flip := bar_index sp_regime := "DISTRIBUTION" else if sp_confirmed_neutral if sp_regime != "NEUTRAL" sp_last_regime_flip := bar_index sp_regime := "NEUTRAL" // Reset weakening counter when regime changes bool sp_regime_just_changed = sp_regime != sp_prev_regime bool sp_accumulation = sp_regime == "ACCUMULATION" bool sp_distribution = sp_regime == "DISTRIBUTION" bool sp_neutral = sp_regime == "NEUTRAL" float sp_regime_strength = math.min(math.abs(sp_regime_ema) * 1.5, 100) int sp_regime_duration = bar_index - sp_last_regime_flip // Regime freshness (adaptive) - newer regimes get bonus float sp_freshness_period = sp_adaptive_regime_len * 2.0 // 2x regime length float sp_regime_freshness = math.max(0.0, 1.0 - (float(sp_regime_duration) / sp_freshness_period)) // ─── REGIME STABILITY INDEX ─── // Tracks flip frequency to identify trending vs choppy markets var array<int> sp_flip_history = array.new_int(0) int sp_stability_window = math.max(30, sp_target_regime_bars * 4) // Record flip if sp_regime_just_changed array.push(sp_flip_history, bar_index) // Clean old flips outside window while array.size(sp_flip_history) > 0 and bar_index - array.get(sp_flip_history, 0) > sp_stability_window array.shift(sp_flip_history) // Count recent flips int sp_flip_count = array.size(sp_flip_history) // Market character based on flip frequency var string sp_prev_market_character = "NORMAL" string sp_market_character = sp_flip_count <= 1 ? "TRENDING" : sp_flip_count <= 3 ? "NORMAL" : "CHOPPY" float sp_stability_mult = sp_market_character == "TRENDING" ? 1.15 : sp_market_character == "CHOPPY" ? 0.85 : 1.0 // ─── STRUCTURE VALIDATION ─── // Does price structure agree with detected regime? bool sp_structure_confirms_bull = sp_structure == "BULLISH" or sp_structure == "MIXED_BULL" bool sp_structure_confirms_bear = sp_structure == "BEARISH" or sp_structure == "MIXED_BEAR" bool sp_structure_agrees = (sp_accumulation and sp_structure_confirms_bull) or (sp_distribution and sp_structure_confirms_bear) or sp_neutral bool sp_structure_conflicts = (sp_accumulation and sp_structure_confirms_bear) or (sp_distribution and sp_structure_confirms_bull) // Structure status for display string sp_structure_status = sp_structure_agrees ? "✓ ALIGNED" : sp_structure_conflicts ? "✗ CONFLICT" : "— UNCLEAR" // ═══════════════════════════════════════════════════════════════════ // 6. ENHANCED WARNING SYSTEM // ═══════════════════════════════════════════════════════════════════ float sp_warning_fading = sp_flip_threshold * 2.5 float sp_warning_weakening = sp_flip_threshold * 1.8 float sp_warning_critical = sp_flip_threshold * 1.3 // Rate of change - how fast is regime score changing? (adaptive lookback) int sp_roc_lookback = math.max(3, sp_accel_lookback * 2) float sp_regime_roc = sp_regime_ema - nz(sp_regime_ema[sp_roc_lookback]) string sp_regime_status = "STRONG" bool sp_regime_weakening = false bool sp_rapid_decline = false // Adaptive rapid decline threshold based on flip threshold float sp_rapid_threshold = sp_flip_threshold * 0.15 // 15% of flip threshold per ROC period // Track consecutive bars in weakening state for color stability var int sp_bars_weakening = 0 // Reset on regime change if sp_regime_just_changed sp_bars_weakening := 0 if sp_accumulation sp_rapid_decline := sp_regime_roc < -sp_rapid_threshold if sp_regime_ema < sp_warning_critical and sp_regime_ema > 0 sp_regime_status := "⚠️ CRITICAL" sp_regime_weakening := true sp_bars_weakening := sp_bars_weakening + 1 else if sp_regime_ema < sp_warning_weakening and sp_regime_ema > 0 sp_regime_status := "⚡ WEAKENING" sp_regime_weakening := true sp_bars_weakening := sp_bars_weakening + 1 else if sp_regime_ema < sp_warning_fading and sp_regime_ema > 0 sp_regime_status := "📉 FADING" sp_regime_weakening := true sp_bars_weakening := sp_bars_weakening + 1 else sp_regime_status := "✓ STRONG" sp_bars_weakening := 0 else if sp_distribution sp_rapid_decline := sp_regime_roc > sp_rapid_threshold if sp_regime_ema > -sp_warning_critical and sp_regime_ema < 0 sp_regime_status := "⚠️ CRITICAL" sp_regime_weakening := true sp_bars_weakening := sp_bars_weakening + 1 else if sp_regime_ema > -sp_warning_weakening and sp_regime_ema < 0 sp_regime_status := "⚡ WEAKENING" sp_regime_weakening := true sp_bars_weakening := sp_bars_weakening + 1 else if sp_regime_ema > -sp_warning_fading and sp_regime_ema < 0 sp_regime_status := "📉 FADING" sp_regime_weakening := true sp_bars_weakening := sp_bars_weakening + 1 else sp_regime_status := "✓ STRONG" sp_bars_weakening := 0 else sp_regime_status := "— NEUTRAL" sp_bars_weakening := 0 // Only show weakening colors after 3+ consecutive bars (prevents flip-flop) bool sp_show_weakening_color = sp_regime_weakening and sp_bars_weakening >= 3 string sp_decline_status = sp_rapid_decline ? "⚡ RAPID" : "— STEADY" // ═══════════════════════════════════════════════════════════════════ // 7. LEADING EXIT INDICATORS // ═══════════════════════════════════════════════════════════════════ bool sp_momentum_fading = false if sp_trend_bull sp_momentum_fading := sp_price_velocity < nz(sp_price_velocity[sp_accel_lookback]) and nz(sp_price_velocity[sp_accel_lookback]) > 0 else if sp_trend_bear sp_momentum_fading := sp_price_velocity > nz(sp_price_velocity[sp_accel_lookback]) and nz(sp_price_velocity[sp_accel_lookback]) < 0 bool sp_flow_deteriorating = false if sp_trend_bull sp_flow_deteriorating := sp_bull_frac < 0.60 and sp_bull_frac_prev >= 0.65 else if sp_trend_bear sp_flow_deteriorating := sp_bear_frac < 0.60 and (1 - sp_bull_frac_prev) >= 0.65 // Volume drying detection (adaptive) float sp_recent_vol_avg = ta.sma(volume, sp_vol_check_len) float sp_prior_vol_avg = ta.sma(volume[sp_vol_check_len], sp_vol_check_len) bool sp_volume_drying = sp_prior_vol_avg > 0 and sp_recent_vol_avg < sp_prior_vol_avg * 0.7 // Health status string sp_health_status = "✓ HEALTHY" int sp_warning_count = 0 if sp_momentum_fading sp_warning_count := sp_warning_count + 1 if sp_flow_deteriorating sp_warning_count := sp_warning_count + 1 if sp_volume_drying sp_warning_count := sp_warning_count + 1 if sp_regime_weakening sp_warning_count := sp_warning_count + 1 if sp_warning_count >= 3 sp_health_status := "🔴 DANGER" else if sp_warning_count >= 2 sp_health_status := "🟠 CAUTION" else if sp_warning_count >= 1 sp_health_status := "🟡 WATCH" else sp_health_status := "🟢 HEALTHY" // ═══════════════════════════════════════════════════════════════════ // 8. HTF SYSTEM // ═══════════════════════════════════════════════════════════════════ // Validate HTF is actually higher than current TF float sp_htf1_minutes = timeframe.in_seconds(sp_htf_tf1) / 60.0 float sp_htf2_minutes = timeframe.in_seconds(sp_htf_tf2) / 60.0 bool sp_htf1_is_valid = sp_htf1_minutes > sp_tf_minutes bool sp_htf2_is_valid = sp_htf2_minutes > sp_tf_minutes // HTF1: Fetch trend and price data [sp_htf1_ema_fast, sp_htf1_ema_slow, sp_htf1_close, sp_htf1_close_prev] = request.security(syminfo.tickerid, sp_htf_tf1, [ta.ema(close, 21), ta.ema(close, 55), close, close[5]], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off) bool sp_htf1_trend_bull = sp_htf1_ema_fast > sp_htf1_ema_slow and sp_htf1_close > sp_htf1_ema_fast bool sp_htf1_trend_bear = sp_htf1_ema_fast < sp_htf1_ema_slow and sp_htf1_close < sp_htf1_ema_fast float sp_htf1_velocity = sp_htf1_close_prev != 0 ? (sp_htf1_close - sp_htf1_close_prev) / sp_htf1_close_prev * 100 : 0 // Simple HTF scoring float sp_htf1_score = sp_htf1_velocity * 20 + (sp_htf1_trend_bull ? 30 : sp_htf1_trend_bear ? -30 : 0) string sp_htf1_regime = sp_htf1_score > 15 ? "ACCUMULATION" : sp_htf1_score < -15 ? "DISTRIBUTION" : "NEUTRAL" float sp_htf1_strength = math.min(math.abs(sp_htf1_score) * 2, 100) bool sp_htf1_strengthening = (sp_htf1_regime == "ACCUMULATION" and sp_htf1_velocity > 0) or (sp_htf1_regime == "DISTRIBUTION" and sp_htf1_velocity < 0) or sp_htf1_regime == "NEUTRAL" bool sp_htf1_trend_agrees = (sp_trend_bull and sp_htf1_trend_bull) or (sp_trend_bear and sp_htf1_trend_bear) or sp_neutral // Only align if HTF is valid (actually higher TF) bool sp_htf1_aligned = not sp_use_htf or not sp_htf1_is_valid or (sp_regime == sp_htf1_regime and sp_htf1_strength >= sp_htf_strength_min and sp_htf1_trend_agrees) // HTF2: Same approach [sp_htf2_ema_fast, sp_htf2_ema_slow, sp_htf2_close, sp_htf2_close_prev] = request.security(syminfo.tickerid, sp_htf_tf2, [ta.ema(close, 21), ta.ema(close, 55), close, close[5]], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off) bool sp_htf2_trend_bull = sp_htf2_ema_fast > sp_htf2_ema_slow and sp_htf2_close > sp_htf2_ema_fast bool sp_htf2_trend_bear = sp_htf2_ema_fast < sp_htf2_ema_slow and sp_htf2_close < sp_htf2_ema_fast float sp_htf2_velocity = sp_htf2_close_prev != 0 ? (sp_htf2_close - sp_htf2_close_prev) / sp_htf2_close_prev * 100 : 0 float sp_htf2_score = sp_htf2_velocity * 20 + (sp_htf2_trend_bull ? 30 : sp_htf2_trend_bear ? -30 : 0) string sp_htf2_regime = sp_htf2_score > 15 ? "ACCUMULATION" : sp_htf2_score < -15 ? "DISTRIBUTION" : "NEUTRAL" float sp_htf2_strength = math.min(math.abs(sp_htf2_score) * 2, 100) bool sp_htf2_strengthening = (sp_htf2_regime == "ACCUMULATION" and sp_htf2_velocity > 0) or (sp_htf2_regime == "DISTRIBUTION" and sp_htf2_velocity < 0) or sp_htf2_regime == "NEUTRAL" bool sp_htf2_trend_agrees = (sp_trend_bull and sp_htf2_trend_bull) or (sp_trend_bear and sp_htf2_trend_bear) or sp_neutral bool sp_htf2_aligned = not sp_use_htf2 or not sp_htf2_is_valid or (sp_regime == sp_htf2_regime and sp_htf2_strength >= sp_htf_strength_min and sp_htf2_trend_agrees) bool sp_htf_all_aligned = sp_htf1_aligned and sp_htf2_aligned // ═══════════════════════════════════════════════════════════════════ // 9. SIGNAL GENERATION // ═══════════════════════════════════════════════════════════════════ bool sp_bull_flow = sp_bull_frac >= sp_flow_ratio bool sp_bear_flow = sp_bear_frac >= sp_flow_ratio // Simplified signal conditions (divergence removed - too slow) bool sp_tf_bull_raw = sp_vol_spike and sp_trend_bull and sp_bull_flow and sp_accumulation and sp_bar_delta_bullish and not sp_bull_exhaustion bool sp_tf_bear_raw = sp_vol_spike and sp_trend_bear and sp_bear_flow and sp_distribution and sp_bar_delta_bearish and not sp_bear_exhaustion float sp_price_z = spZscore(close, sp_adaptive_regime_len) bool sp_mr_bull_setup = sp_accumulation and sp_price_z < -sp_mr_extremes and sp_vol_spike and sp_bar_delta_bullish and not sp_bull_exhaustion bool sp_mr_bear_setup = sp_distribution and sp_price_z > sp_mr_extremes and sp_vol_spike and sp_bar_delta_bearish and not sp_bear_exhaustion bool sp_bull_raw = false bool sp_bear_raw = false bool sp_is_mean_reversion = false if sp_strategy_mode == "Trend Following" sp_bull_raw := sp_tf_bull_raw sp_bear_raw := sp_tf_bear_raw else if sp_strategy_mode == "Mean Reversion" sp_bull_raw := sp_mr_bull_setup sp_bear_raw := sp_mr_bear_setup sp_is_mean_reversion := true else sp_bull_raw := sp_tf_bull_raw or (sp_mr_enabled and sp_mr_bull_setup) sp_bear_raw := sp_tf_bear_raw or (sp_mr_enabled and sp_mr_bear_setup) sp_is_mean_reversion := (sp_mr_bull_setup or sp_mr_bear_setup) and not (sp_tf_bull_raw or sp_tf_bear_raw) if sp_htf_strict and sp_use_htf sp_bull_raw := sp_bull_raw and sp_htf_all_aligned sp_bear_raw := sp_bear_raw and sp_htf_all_aligned // ═══════════════════════════════════════════════════ // v1.0: ENHANCED QUALITY SCORING (Improvement #13) // ═══════════════════════════════════════════════════ // ─── SIGNAL DENSITY TRACKING (Simplified) ─── // Use rolling counter instead of array - track last 4 signal bars var int sp_sig_bar_1 = na var int sp_sig_bar_2 = na var int sp_sig_bar_3 = na var int sp_sig_bar_4 = na int sp_density_window = math.max(30, sp_adaptive_regime_len * 2) // Count how many of the last 4 signals are within the density window int sp_recent_signal_count = 0 if not na(sp_sig_bar_1) and bar_index - sp_sig_bar_1 <= sp_density_window sp_recent_signal_count += 1 if not na(sp_sig_bar_2) and bar_index - sp_sig_bar_2 <= sp_density_window sp_recent_signal_count += 1 if not na(sp_sig_bar_3) and bar_index - sp_sig_bar_3 <= sp_density_window sp_recent_signal_count += 1 if not na(sp_sig_bar_4) and bar_index - sp_sig_bar_4 <= sp_density_window sp_recent_signal_count += 1 // Density multiplier float sp_density_mult = sp_recent_signal_count >= 4 ? 0.80 : sp_recent_signal_count >= 3 ? 0.90 : 1.0 // ─── ENHANCED QUALITY SCORING ─── float sp_signal_quality = 0.0 int sp_confluence_count = 0 if sp_bull_raw or sp_bear_raw // Base scores (existing) float vol_score = math.min((sp_vol_z / sp_z_threshold) * 15, 15) // Reduced from 20 to make room float flow_excess = (sp_bull_raw ? sp_bull_frac : sp_bear_frac) - sp_flow_ratio float flow_score = math.min((flow_excess / (1.0 - sp_flow_ratio)) * 20, 20) float trend_score = math.min(sp_trend_strength * 2.0, 20) float regime_score_pts = math.min(sp_regime_strength * 0.25, 25) float regime_age_score = sp_regime_freshness * 10.0 float squeeze_pts = sp_squeeze_score
// HTF score float htf_score = 0.0 if sp_use_htf and sp_htf_all_aligned     float htf_strength_avg = (sp_htf1_strength + (sp_use_htf2 ? sp_htf2_strength : sp_htf1_strength)) / (sp_use_htf2 ? 2.0 : 1.0)     htf_score := (htf_strength_avg / 100.0) * 10.0  // Acceleration bonus float accel_bonus = 0.0 if sp_bull_raw and sp_price_accel > 0     accel_bonus := math.min(sp_price_accel * 150, 8) else if sp_bear_raw and sp_price_accel < 0     accel_bonus := math.min(math.abs(sp_price_accel) * 150, 8)  // NEW: Structure score (±10) float structure_score = sp_structure_agrees ? 10.0 : sp_structure_conflicts ? -10.0 : 0.0  // NEW: Footprint score (replaces generic volume bonus) float footprint_score = 0.0 if sp_bull_raw     if sp_bullish_momentum         footprint_score := 12.0  // Strong: momentum confirms direction     else if sp_bullish_absorption         footprint_score := 10.0  // Good: absorption at support     else if sp_bearish_absorption         footprint_score := -5.0  // Bad: absorption against position else if sp_bear_raw     if sp_bearish_momentum         footprint_score := 12.0     else if sp_bearish_absorption         footprint_score := 10.0     else if sp_bullish_absorption         footprint_score := -5.0  // Calculate base quality sp_signal_quality := vol_score + flow_score + trend_score + regime_score_pts + regime_age_score + squeeze_pts + htf_score + accel_bonus + structure_score + footprint_score  // Mean reversion penalty if sp_is_mean_reversion     sp_signal_quality := sp_signal_quality * 0.85  // NEW: Confluence counting if sp_vol_spike     sp_confluence_count += 1 if (sp_bull_raw and sp_bull_flow) or (sp_bear_raw and sp_bear_flow)     sp_confluence_count += 1 if sp_structure_agrees     sp_confluence_count += 1 if sp_use_htf and sp_htf_all_aligned     sp_confluence_count += 1 if (sp_bull_raw and sp_bullish_momentum) or (sp_bear_raw and sp_bearish_momentum) or (sp_bull_raw and sp_bullish_absorption) or (sp_bear_raw and sp_bearish_absorption)     sp_confluence_count += 1 if sp_market_character == "TRENDING"     sp_confluence_count += 1 if sp_regime_strength > 60     sp_confluence_count += 1  // Confluence bonus float confluence_bonus = sp_confluence_count >= 6 ? 15.0 : sp_confluence_count >= 5 ? 10.0 : sp_confluence_count >= 4 ? 5.0 : 0.0 sp_signal_quality += confluence_bonus  // Apply multipliers (stability and density) sp_signal_quality := sp_signal_quality * sp_stability_mult * sp_density_mult  // Cap at 100 sp_signal_quality := math.min(math.max(sp_signal_quality, 0), 100) 
// High confluence flag bool sp_high_confluence = sp_confluence_count >= 5 // Stars with confluence emoji string sp_stars = "" string sp_confluence_emoji = sp_high_confluence ? " 🎯" : "" bool sp_has_signal = sp_bull_raw or sp_bear_raw if sp_show_quality_stars and sp_has_signal sp_stars := sp_signal_quality >= 85 ? " ⭐⭐⭐" : sp_signal_quality >= 75 ? " ⭐⭐" : sp_signal_quality >= 65 ? " ⭐" : "" sp_stars := sp_stars + sp_confluence_emoji var int sp_last_signal_bar = na bool sp_cooldown_ok = na(sp_last_signal_bar) or (bar_index - sp_last_signal_bar >= sp_signal_cooldown) bool sp_bull_signal = sp_bull_raw and sp_cooldown_ok and barstate.isconfirmed bool sp_bear_signal = sp_bear_raw and sp_cooldown_ok and barstate.isconfirmed // Record signal for cooldown and density tracking if sp_bull_signal or sp_bear_signal sp_last_signal_bar := bar_index // Shift signal history (newest at 1, oldest at 4) sp_sig_bar_4 := sp_sig_bar_3 sp_sig_bar_3 := sp_sig_bar_2 sp_sig_bar_2 := sp_sig_bar_1 sp_sig_bar_1 := bar_index // Update previous state trackers (for change detection alerts) if barstate.isconfirmed sp_prev_structure := sp_structure sp_prev_market_character := sp_market_character // ═══════════════════════════════════════════════════════════════════ // 10. POSITION MANAGEMENT // ═══════════════════════════════════════════════════════════════════ var bool sp_in_bull_position = false var bool sp_in_bear_position = false var int sp_entry_bar = na var float sp_entry_price = na var float sp_position_size = na var float sp_initial_stop = na var float sp_current_stop = na var bool sp_t1_hit = false var bool sp_at_breakeven = false var float sp_remaining_size = 100.0 float sp_stop_distance = sp_atr * sp_stop_mult float sp_target1_distance = sp_atr * sp_target1_mult float sp_target2_distance = sp_atr * sp_target2_mult float sp_breakeven_distance = sp_atr * sp_breakeven_mult float sp_trailing_distance = sp_atr * sp_trailing_mult float sp_size_multiplier = 1.0 if sp_signal_quality >= 85 sp_size_multiplier := 1.5 else if sp_signal_quality >= 75 sp_size_multiplier := 1.2 else if sp_signal_quality >= 65 sp_size_multiplier := 1.0 else sp_size_multiplier := 0.7 if sp_bull_signal or sp_bear_signal float base_size = spCalcPositionSize(sp_account_size, sp_risk_percent, sp_stop_distance) sp_position_size := base_size * sp_size_multiplier if sp_bull_signal sp_in_bull_position := true sp_in_bear_position := false sp_entry_bar := bar_index sp_entry_price := close sp_initial_stop := close - sp_stop_distance sp_current_stop := sp_initial_stop sp_t1_hit := false sp_at_breakeven := false sp_remaining_size := 100.0 else if sp_bear_signal sp_in_bull_position := false sp_in_bear_position := true sp_entry_bar := bar_index sp_entry_price := close sp_initial_stop := close + sp_stop_distance sp_current_stop := sp_initial_stop sp_t1_hit := false sp_at_breakeven := false sp_remaining_size := 100.0 bool sp_should_move_be = false if sp_in_bull_position and not sp_at_breakeven if close >= (sp_entry_price + sp_breakeven_distance) sp_should_move_be := true sp_current_stop := sp_entry_price sp_at_breakeven := true else if sp_in_bear_position and not sp_at_breakeven if close <= (sp_entry_price - sp_breakeven_distance) sp_should_move_be := true sp_current_stop := sp_entry_price sp_at_breakeven := true if sp_use_trailing and sp_t1_hit if sp_in_bull_position float trail_level = close - sp_trailing_distance if trail_level > sp_current_stop sp_current_stop := trail_level else if sp_in_bear_position float trail_level = close + sp_trailing_distance if trail_level < sp_current_stop sp_current_stop := trail_level bool sp_t1_partial_exit = false if not sp_t1_hit if sp_in_bull_position and close >= (sp_entry_price + sp_target1_distance) and barstate.isconfirmed sp_t1_hit := true sp_t1_partial_exit := true sp_remaining_size := 100.0 - sp_partial_t1 else if sp_in_bear_position and close <= (sp_entry_price - sp_target1_distance) and barstate.isconfirmed sp_t1_hit := true sp_t1_partial_exit := true sp_remaining_size := 100.0 - sp_partial_t1 // ═══════════════════════════════════════════════════════════════════ // 11. EXIT CONDITIONS // ═══════════════════════════════════════════════════════════════════ // Time exit (adaptive - 3x target regime duration as max hold) int sp_max_hold_bars = math.max(20, sp_target_regime_bars * 3) bool sp_bull_regime_flip = sp_in_bull_position and sp_distribution bool sp_bull_flow_rev = sp_in_bull_position and sp_bear_frac > 0.65 bool sp_bull_time = sp_in_bull_position and not na(sp_entry_bar) and (bar_index - sp_entry_bar) > sp_max_hold_bars bool sp_bull_stop = sp_in_bull_position and not na(sp_current_stop) and close < sp_current_stop bool sp_bull_target2 = sp_in_bull_position and close > (sp_entry_price + sp_target2_distance) bool sp_bull_regime_weak = sp_in_bull_position and sp_regime_weakening and sp_regime_status == "⚠️ CRITICAL" bool sp_bear_regime_flip = sp_in_bear_position and sp_accumulation bool sp_bear_flow_rev = sp_in_bear_position and sp_bull_frac > 0.65 bool sp_bear_time = sp_in_bear_position and not na(sp_entry_bar) and (bar_index - sp_entry_bar) > sp_max_hold_bars bool sp_bear_stop = sp_in_bear_position and not na(sp_current_stop) and close > sp_current_stop bool sp_bear_target2 = sp_in_bear_position and close < (sp_entry_price - sp_target2_distance) bool sp_bear_regime_weak = sp_in_bear_position and sp_regime_weakening and sp_regime_status == "⚠️ CRITICAL" bool sp_any_exit = sp_bull_regime_flip or sp_bull_flow_rev or sp_bull_time or sp_bull_stop or sp_bull_target2 or sp_bull_regime_weak or sp_bear_regime_flip or sp_bear_flow_rev or sp_bear_time or sp_bear_stop or sp_bear_target2 or sp_bear_regime_weak bool sp_exit_warning = sp_show_exit_warnings and sp_any_exit and barstate.isconfirmed string sp_exit_reason = "" if sp_bull_regime_flip or sp_bear_regime_flip sp_exit_reason := "REGIME FLIP" else if sp_bull_regime_weak or sp_bear_regime_weak sp_exit_reason := "REGIME CRITICAL" else if sp_bull_flow_rev or sp_bear_flow_rev sp_exit_reason := "FLOW REVERSAL" else if sp_bull_time or sp_bear_time sp_exit_reason := "TIME EXIT" else if sp_bull_stop or sp_bear_stop sp_exit_reason := "STOP HIT" else if sp_bull_target2 or sp_bear_target2 sp_exit_reason := "T2 HIT" if sp_exit_warning sp_in_bull_position := false sp_in_bear_position := false sp_entry_bar := na sp_entry_price := na sp_position_size := na sp_initial_stop := na sp_current_stop := na sp_t1_hit := false sp_at_breakeven := false sp_remaining_size := 100.0 // ═══════════════════════════════════════════════════ // v1.0: SIMPLIFIED COLOR SCHEME (4 colors only) // Green = Accumulation | Red = Distribution | Yellow = Warning | Gray = Neutral // ═══════════════════════════════════════════════════ color sp_green = #00E676 color sp_red = #FF1744 color sp_yellow = #FFD700 color sp_gray = color.gray // Determine volume bar color color sp_vol_color = color.new(sp_gray, 60) if sp_bull_signal sp_vol_color := color.new(sp_green, 0) // Full opacity for signals else if sp_bear_signal sp_vol_color := color.new(sp_red, 0) // Full opacity for signals else if sp_accumulation if sp_show_weakening_color sp_vol_color := color.new(sp_yellow, 30) else sp_vol_color := color.new(sp_green, 40) else if sp_distribution if sp_show_weakening_color sp_vol_color := color.new(sp_yellow, 30) else sp_vol_color := color.new(sp_red, 40) else sp_vol_color := color.new(sp_gray, 60) // ═══════════════════════════════════════════════════════════════════ // 12. VISUALS // ═══════════════════════════════════════════════════════════════════ // ─── 12.1 Volume Plot & Background ─── plot(volume, "Volume", style=plot.style_columns, color=sp_vol_color) // Background - very subtle bgcolor(sp_show_regime_bg and sp_accumulation and not sp_show_weakening_color ? color.new(sp_green, 95) : na) bgcolor(sp_show_regime_bg and sp_distribution and not sp_show_weakening_color ? color.new(sp_red, 95) : na) bgcolor(sp_show_regime_bg and sp_show_weakening_color and sp_early_warning ? color.new(sp_yellow, 95) : na) // Signal labels if sp_bull_signal string label_text = (sp_is_mean_reversion ? "MR " : "") + "↑" + sp_stars string tooltip_text = (sp_is_mean_reversion ? "Mean Reversion " : "") + "Bullish Flow Signal\nQuality: " + str.tostring(sp_signal_quality, "#") + "%"
if sp_squeeze_breakout     tooltip_text := tooltip_text + "\n🔥 Squeeze Breakout" if sp_price_accel > 0     tooltip_text := tooltip_text + "\n🚀 Momentum Accelerating"  if sp_show_risk_labels     float stop_pct = (sp_stop_distance / close) * 100     float t1_pct = (sp_target1_distance / close) * 100     float t2_pct = (sp_target2_distance / close) * 100     float rr1 = sp_target1_distance / sp_stop_distance     float rr2 = sp_target2_distance / sp_stop_distance     tooltip_text := tooltip_text + "\n\nRisk:\nStop: -" + str.tostring(stop_pct, "#.##") + "%\nT1: +" + str.tostring(t1_pct, "#.##") + "% (R:" + str.tostring(rr1, "#.#") + ")\nT2: +" + str.tostring(t2_pct, "#.##") + "% (R:" + str.tostring(rr2, "#.#") + ")"  if sp_show_position_size and not na(sp_position_size)     tooltip_text := tooltip_text + "\n\nPosition: " + str.tostring(sp_position_size, "#.##") + " units\nRisk: $" + str.tostring(sp_account_size * sp_risk_percent / 100 * sp_size_multiplier, "#.##")  if sp_use_htf and sp_htf_all_aligned     label_text := label_text + " 📈"     tooltip_text := tooltip_text + "\nHTF Aligned ✓"  label.new(bar_index, volume * 1.08, label_text, style=label.style_label_up, color=color.new(sp_green, 20), textcolor=color.white, size=size.normal, tooltip=tooltip_text) 
if sp_bear_signal string label_text = (sp_is_mean_reversion ? "MR " : "") + "↓" + sp_stars string tooltip_text = (sp_is_mean_reversion ? "Mean Reversion " : "") + "Bearish Flow Signal\nQuality: " + str.tostring(sp_signal_quality, "#") + "%"
if sp_squeeze_breakout     tooltip_text := tooltip_text + "\n🔥 Squeeze Breakout" if sp_price_accel < 0     tooltip_text := tooltip_text + "\n🚀 Momentum Accelerating"  if sp_show_risk_labels     float stop_pct = (sp_stop_distance / close) * 100     float t1_pct = (sp_target1_distance / close) * 100     float t2_pct = (sp_target2_distance / close) * 100     float rr1 = sp_target1_distance / sp_stop_distance     float rr2 = sp_target2_distance / sp_stop_distance     tooltip_text := tooltip_text + "\n\nRisk:\nStop: +" + str.tostring(stop_pct, "#.##") + "%\nT1: -" + str.tostring(t1_pct, "#.##") + "% (R:" + str.tostring(rr1, "#.#") + ")\nT2: -" + str.tostring(t2_pct, "#.##") + "% (R:" + str.tostring(rr2, "#.#") + ")"  if sp_show_position_size and not na(sp_position_size)     tooltip_text := tooltip_text + "\n\nPosition: " + str.tostring(sp_position_size, "#.##") + " units\nRisk: $" + str.tostring(sp_account_size * sp_risk_percent / 100 * sp_size_multiplier, "#.##")  if sp_use_htf and sp_htf_all_aligned     label_text := label_text + " 📉"     tooltip_text := tooltip_text + "\nHTF Aligned ✓"  label.new(bar_index, volume * 1.08, label_text, style=label.style_label_down, color=color.new(sp_red, 20), textcolor=color.white, size=size.normal, tooltip=tooltip_text) 
if sp_exit_warning // Build comprehensive exit tooltip with T1/BE status string exit_tip = sp_exit_reason if sp_t1_hit exit_tip := exit_tip + "\n✓ T1 hit - " + str.tostring(sp_partial_t1, "#") + "% closed" if sp_at_breakeven exit_tip := exit_tip + "\n✓ Stop at breakeven" label.new(bar_index, volume * 1.15, "⚠️", style=label.style_label_down, color=color.new(sp_yellow, 20), textcolor=color.white, size=size.small, tooltip=exit_tip) // Position management labels (OFF by default - reduces clutter) if sp_show_mgmt_labels and sp_t1_partial_exit label.new(bar_index, volume * 0.85, "T1", style=label.style_label_center, color=color.new(sp_gray, 30), textcolor=color.white, size=size.tiny, tooltip="Partial exit at Target 1\n" + str.tostring(sp_partial_t1, "#") + "% closed") if sp_show_mgmt_labels and sp_should_move_be label.new(bar_index, volume * 0.65, "BE", style=label.style_label_center, color=color.new(sp_gray, 40), textcolor=color.white, size=size.tiny, tooltip="Stop moved to breakeven") // ═══════════════════════════════════════════════════ // ─── 12.2 Regime Table ─── // ═══════════════════════════════════════════════════ sp_regime_pos = spGetTablePosition(sp_regime_table_pos) sp_regime_size = spGetTextSize(sp_regime_table_size) sp_regime_size_header = sp_regime_table_size == "Tiny" ? size.small : sp_regime_table_size == "Small" ? size.normal : sp_regime_table_size == "Normal" ? size.large : size.huge if sp_show_regime_meter and barstate.islast color regime_color = sp_accumulation ? sp_green : sp_distribution ? sp_red : sp_gray
// Build adaptive info tooltip (shown on 📊 icon) string adapt_info = "═══ ADAPTIVE SETTINGS ═══\n" +      "TF Mode: " + sp_tf_category + "\n" +      "Target Regime: " + str.tostring(sp_target_regime_bars) + " bars\n" +      "─────────────────\n" +      "Lookback: " + str.tostring(sp_adaptive_regime_len) + " bars\n" +      "Velocity: " + str.tostring(sp_adaptive_velocity_len) + " bars\n" +      "Cooldown: " + str.tostring(sp_adaptive_cooldown) + " bars\n" +      "Confirm: " + str.tostring(sp_confirm_bars) + " bars\n" +      "Threshold: ×" + str.tostring(sp_tf_threshold_mult, "#.##") + "\n" +      "─────────────────\n" +      "Score: " + str.tostring(sp_regime_ema, "#.#") + " (flip: ±" + str.tostring(sp_flip_threshold, "#.#") + ")\n" +      "Velocity: " + str.tostring(sp_price_velocity, "#.##") + "%\n" +      "Flow: " + str.tostring(sp_bull_frac * 100, "#") + "% bull"  // Prepare common values string strength_display = str.tostring(sp_regime_strength, "#") + "%" color strength_color = sp_regime_strength > 50 ? sp_green : sp_yellow string duration_hrs = str.tostring(sp_regime_duration * timeframe.in_seconds() / 3600, "#.#") + "h" color status_color = sp_regime_status == "✓ STRONG" ? sp_green : sp_regime_status == "— NEUTRAL" ? sp_gray : sp_yellow color health_color = sp_health_status == "🟢 HEALTHY" ? sp_green : sp_yellow color structure_color = sp_structure_agrees ? sp_green : sp_structure_conflicts ? sp_red : sp_gray string structure_detail = sp_structure == "BULLISH" ? "HH/HL" : sp_structure == "BEARISH" ? "LH/LL" : sp_structure == "MIXED_BULL" ? "Mixed↑" : sp_structure == "MIXED_BEAR" ? "Mixed↓" : "—" color market_color = sp_market_character == "TRENDING" ? sp_green : sp_market_character == "CHOPPY" ? sp_yellow : sp_gray  // Flip status string confirm_status = "" string confirm_tooltip = "" color confirm_color = sp_green  bool building_accum = sp_bars_above_threshold > 0 bool building_dist = sp_bars_below_threshold > 0 bool building_neutral = sp_bars_in_neutral > 0 bool flip_to_accum = building_accum and sp_regime != "ACCUMULATION" bool flip_to_dist = building_dist and sp_regime != "DISTRIBUTION" bool flip_to_neutral = building_neutral and sp_regime != "NEUTRAL" string bars_needed = str.tostring(sp_confirm_bars)  if flip_to_accum     confirm_status := "→ ACC " + str.tostring(math.min(sp_bars_above_threshold, sp_confirm_bars)) + "/" + bars_needed     confirm_color := sp_green     confirm_tooltip := "Building toward ACCUMULATION\n" + str.tostring(sp_bars_above_threshold) + "/" + bars_needed + " bars" else if flip_to_dist     confirm_status := "→ DIST " + str.tostring(math.min(sp_bars_below_threshold, sp_confirm_bars)) + "/" + bars_needed     confirm_color := sp_red     confirm_tooltip := "Building toward DISTRIBUTION\n" + str.tostring(sp_bars_below_threshold) + "/" + bars_needed + " bars" else if flip_to_neutral     confirm_status := "→ NEU " + str.tostring(math.min(sp_bars_in_neutral, sp_confirm_bars)) + "/" + bars_needed     confirm_color := sp_gray     confirm_tooltip := "Building toward NEUTRAL\n" + str.tostring(sp_bars_in_neutral) + "/" + bars_needed + " bars" else     confirm_status := "✓ STABLE"     confirm_color := sp_green     confirm_tooltip := "Regime is stable\nNo flip building"  // ═══════════════════════════════════════════════════ // VERTICAL LAYOUT (2 columns × 7 rows) - Clear & Readable // ═══════════════════════════════════════════════════ if sp_table_layout == "Vertical"     var table sp_meter_v = table.new(sp_regime_pos, 2, 7, bgcolor=na, border_width=sp_table_border, border_color=color.new(sp_gray, 60), frame_width=sp_table_frame, frame_color=color.new(sp_gray, 40))          // Row 0: Header     table.cell(sp_meter_v, 0, 0, "📊", text_color=regime_color, text_size=sp_regime_size_header, tooltip=adapt_info)     table.cell(sp_meter_v, 1, 0, sp_regime, text_color=regime_color, text_size=sp_regime_size, tooltip="ACCUMULATION = Buying pressure\nDISTRIBUTION = Selling pressure\nNEUTRAL = No clear direction")          // Row 1: Strength + Duration     table.cell(sp_meter_v, 0, 1, strength_display, text_color=strength_color, text_size=sp_regime_size, tooltip="Regime strength\nFlow: " + str.tostring(sp_bull_frac * 100, "#") + "% bull / " + str.tostring(sp_bear_frac * 100, "#") + "% bear")     table.cell(sp_meter_v, 1, 1, duration_hrs, text_color=color.new(sp_gray, 30), text_size=sp_regime_size, tooltip="Duration\nMax hold: " + str.tostring(sp_max_hold_bars) + " bars")          // Row 2: Status     table.cell(sp_meter_v, 0, 2, "Status", text_color=color.new(sp_gray, 40), text_size=sp_regime_size)     table.cell(sp_meter_v, 1, 2, sp_regime_status, text_color=status_color, text_size=sp_regime_size, tooltip="✓ STRONG = Regime healthy\n📉 FADING = Early warning\n⚡ WEAKENING = Prepare for flip\n⚠️ CRITICAL = About to flip")          // Row 3: Health     table.cell(sp_meter_v, 0, 3, "Health", text_color=color.new(sp_gray, 40), text_size=sp_regime_size)     table.cell(sp_meter_v, 1, 3, sp_health_status, text_color=health_color, text_size=sp_regime_size, tooltip="🟢 HEALTHY = No warnings\n🟡 WATCH = 1 warning\n🟠 CAUTION = 2 warnings\n🔴 DANGER = 3+ warnings")          // Row 4: Structure     string struct_display = sp_structure_agrees ? "✓ ALIGNED" : sp_structure_conflicts ? "✗ CONFLICT" : "— UNCLEAR"     table.cell(sp_meter_v, 0, 4, "Struct", text_color=color.new(sp_gray, 40), text_size=sp_regime_size)     table.cell(sp_meter_v, 1, 4, struct_display, text_color=structure_color, text_size=sp_regime_size, tooltip="Price Structure: " + structure_detail + "\n\n✓ ALIGNED = Structure confirms regime\n✗ CONFLICT = Structure disagrees\n— UNCLEAR = No clear structure")          // Row 5: Market Character     table.cell(sp_meter_v, 0, 5, "Market", text_color=color.new(sp_gray, 40), text_size=sp_regime_size)     table.cell(sp_meter_v, 1, 5, sp_market_character, text_color=market_color, text_size=sp_regime_size, tooltip="Market character based on flip frequency\n\nTRENDING = 0-1 flips (+15% quality)\nNORMAL = 2-3 flips\nCHOPPY = 4+ flips (-15% quality)\n\nRecent flips: " + str.tostring(sp_flip_count))          // Row 6: Flip     table.cell(sp_meter_v, 0, 6, "Flip", text_color=color.new(sp_gray, 40), text_size=sp_regime_size)     table.cell(sp_meter_v, 1, 6, confirm_status, text_color=confirm_color, text_size=sp_regime_size, tooltip=confirm_tooltip)  // ═══════════════════════════════════════════════════ // HORIZONTAL LAYOUT (2 rows like Harmonic Oscillator) // ═══════════════════════════════════════════════════ else     var table sp_meter_h = table.new(sp_regime_pos, 5, 2, bgcolor=na, border_width=sp_table_border, border_color=color.new(sp_gray, 60), frame_width=sp_table_frame, frame_color=color.new(sp_gray, 40))          // Short but clear values     string status_val = sp_regime_status == "✓ STRONG" ? "STRONG ✓" : sp_regime_status == "📉 FADING" ? "FADING ▼" : sp_regime_status == "⚡ WEAKENING" ? "WEAK ▼" : sp_regime_status == "⚠️ CRITICAL" ? "CRIT ▼" : "OK —"     string health_val = sp_health_status == "🟢 HEALTHY" ? "🟢" : sp_health_status == "🟡 WATCH" ? "🟡" : sp_health_status == "🟠 CAUTION" ? "🟠" : "🔴"     string struct_val = sp_structure_agrees ? "✓" : sp_structure_conflicts ? "✗" : "—"     string market_val = sp_market_character == "TRENDING" ? "TREND ▲" : sp_market_character == "CHOPPY" ? "CHOP ▼" : "NORM —"     string flip_val = confirm_status == "✓ STABLE" ? "STABLE ✓" : "→" + str.tostring(math.min(sp_bars_above_threshold + sp_bars_below_threshold + sp_bars_in_neutral, sp_confirm_bars)) + "/" + str.tostring(sp_confirm_bars)          // Row 0: Core info     table.cell(sp_meter_h, 0, 0, "📊 " + sp_regime, text_color=regime_color, text_size=sp_regime_size, tooltip="Regime\n\n" + adapt_info)     table.cell(sp_meter_h, 1, 0, strength_display, text_color=strength_color, text_size=sp_regime_size, tooltip="Strength")     table.cell(sp_meter_h, 2, 0, duration_hrs, text_color=color.new(sp_gray, 40), text_size=sp_regime_size, tooltip="Duration")     table.cell(sp_meter_h, 3, 0, status_val, text_color=status_color, text_size=sp_regime_size, tooltip="Status: " + sp_regime_status)     table.cell(sp_meter_h, 4, 0, health_val, text_color=health_color, text_size=sp_regime_size, tooltip="Health: " + sp_health_status)          // Row 1: Secondary info     table.cell(sp_meter_h, 0, 1, "STRUCTURE " + struct_val, text_color=structure_color, text_size=sp_regime_size, tooltip="Structure: " + structure_detail)     table.cell(sp_meter_h, 1, 1, "MARKET " + market_val, text_color=market_color, text_size=sp_regime_size, tooltip="Market: " + sp_market_character)     table.cell(sp_meter_h, 2, 1, "FLIP " + flip_val, text_color=confirm_color, text_size=sp_regime_size, tooltip=confirm_tooltip)     table.cell(sp_meter_h, 3, 1, str.tostring(sp_flip_count) + " flips", text_color=color.new(sp_gray, 40), text_size=sp_regime_size, tooltip="Recent regime flips")     table.cell(sp_meter_h, 4, 1, "", text_size=sp_regime_size) 
// HTF Table (positioned beside regime meter) sp_htf_pos = spGetTablePosition(sp_htf_table_pos) sp_htf_size = spGetTextSize(sp_htf_table_size) sp_htf_size_header = sp_htf_table_size == "Tiny" ? size.small : sp_htf_table_size == "Small" ? size.normal : sp_htf_table_size == "Normal" ? size.large : size.huge if sp_show_htf_table and sp_use_htf and barstate.islast var table sp_htf_table = table.new(sp_htf_pos, 3, 5, bgcolor=na, border_width=sp_table_border, border_color=color.new(sp_gray, 60), frame_width=sp_table_frame, frame_color=color.new(sp_gray, 40))
// Show warning if HTF is not actually higher string htf1_display = sp_htf1_is_valid ? sp_htf_tf1 : "⚠️ " + sp_htf_tf1 string htf2_display = sp_use_htf2 ? (sp_htf2_is_valid ? sp_htf_tf2 : "⚠️ " + sp_htf_tf2) : "---" string htf1_tip = sp_htf1_is_valid ? "Primary higher timeframe" : "⚠️ WARNING: Not higher than current TF!\nSelect a timeframe > " + str.tostring(sp_tf_minutes, "#") + "m" string htf2_tip = sp_use_htf2 ? (sp_htf2_is_valid ? "Secondary higher timeframe" : "⚠️ WARNING: Not higher than current TF!") : "HTF 2 disabled"  table.cell(sp_htf_table, 0, 0, "🔍 HTF", text_color=color.white, text_size=sp_htf_size_header, tooltip="Higher Timeframe Analysis\nShows regime alignment across timeframes") table.cell(sp_htf_table, 1, 0, htf1_display, text_color=sp_htf1_is_valid ? color.white : sp_yellow, text_size=sp_htf_size, tooltip=htf1_tip) table.cell(sp_htf_table, 2, 0, htf2_display, text_color=sp_use_htf2 ? (sp_htf2_is_valid ? color.white : sp_yellow) : color.white, text_size=sp_htf_size, tooltip=htf2_tip)  color htf1_color = sp_htf1_regime == "ACCUMULATION" ? sp_green : sp_htf1_regime == "DISTRIBUTION" ? sp_red : sp_gray table.cell(sp_htf_table, 0, 1, "Regime", text_color=color.new(sp_gray, 30), text_size=sp_htf_size) table.cell(sp_htf_table, 1, 1, sp_htf1_regime, text_color=color.new(htf1_color, 0), text_size=sp_htf_size, tooltip="HTF1 regime state\nMust match LTF regime for alignment")  if sp_use_htf2     color htf2_color = sp_htf2_regime == "ACCUMULATION" ? sp_green : sp_htf2_regime == "DISTRIBUTION" ? sp_red : sp_gray     table.cell(sp_htf_table, 2, 1, sp_htf2_regime, text_color=color.new(htf2_color, 0), text_size=sp_htf_size, tooltip="HTF2 regime state") else     table.cell(sp_htf_table, 2, 1, "---", text_color=color.new(sp_gray, 60), text_size=sp_htf_size)  table.cell(sp_htf_table, 0, 2, "Strength", text_color=color.new(sp_gray, 30), text_size=sp_htf_size) table.cell(sp_htf_table, 1, 2, str.tostring(sp_htf1_strength, "#") + "%", text_color=color.new(color.white, 0), text_size=sp_htf_size, tooltip="HTF1 regime strength\nMust be ≥ " + str.tostring(sp_htf_strength_min, "#") + "% for alignment") table.cell(sp_htf_table, 2, 2, sp_use_htf2 ? str.tostring(sp_htf2_strength, "#") + "%" : "---", text_color=color.new(color.white, 0), text_size=sp_htf_size, tooltip=sp_use_htf2 ? "HTF2 regime strength" : "")  table.cell(sp_htf_table, 0, 3, "Trend", text_color=color.new(sp_gray, 30), text_size=sp_htf_size) string htf1_trend = sp_htf1_strengthening ? "↑ Strong" : "↓ Weak" table.cell(sp_htf_table, 1, 3, htf1_trend, text_color=color.new(sp_htf1_strengthening ? sp_green : sp_yellow, 0), text_size=sp_htf_size, tooltip="↑ Strong = HTF regime strengthening\n↓ Weak = HTF regime weakening\nMust be strengthening for alignment") string htf2_trend = sp_use_htf2 ? (sp_htf2_strengthening ? "↑ Strong" : "↓ Weak") : "---" table.cell(sp_htf_table, 2, 3, htf2_trend, text_color=color.new(sp_use_htf2 ? (sp_htf2_strengthening ? sp_green : sp_yellow) : sp_gray, sp_use_htf2 ? 0 : 60), text_size=sp_htf_size, tooltip=sp_use_htf2 ? "HTF2 trend direction" : "")  table.cell(sp_htf_table, 0, 4, "Aligned", text_color=color.new(sp_gray, 30), text_size=sp_htf_size) string htf1_align = sp_htf1_aligned ? "✓" : "✗" table.cell(sp_htf_table, 1, 4, htf1_align, text_color=color.new(sp_htf1_aligned ? sp_green : sp_red, 0), text_size=sp_htf_size, tooltip="✓ = All HTF1 conditions met:\n• Regime matches LTF\n• Strength ≥ minimum\n• HTF strengthening\n• Trend agrees") string htf2_align = sp_use_htf2 ? (sp_htf2_aligned ? "✓" : "✗") : "---" table.cell(sp_htf_table, 2, 4, htf2_align, text_color=color.new(sp_use_htf2 ? (sp_htf2_aligned ? sp_green : sp_red) : sp_gray, sp_use_htf2 ? 0 : 60), text_size=sp_htf_size, tooltip=sp_use_htf2 ? "✓ = All HTF2 conditions met" : "") 
// ═══════════════════════════════════════════════════ // ═══════════════════════════════════════════════════════════════════ // 13. ALERTS & SCREENER // ═══════════════════════════════════════════════════════════════════ // ═══════════════════════════════════════════════════ plot(sp_signal_quality, "Alert: Quality", display=display.none) plot(sp_regime_strength, "Alert: Regime Strength", display=display.none) plot(close, "Alert: Entry Price", display=display.none) plot(sp_bull_signal ? close - sp_stop_distance : sp_bear_signal ? close + sp_stop_distance : na, "Alert: Stop Price", display=display.none) plot(sp_bull_signal ? close + sp_target1_distance : sp_bear_signal ? close - sp_target1_distance : na, "Alert: T1 Price", display=display.none) plot(sp_bull_signal ? close + sp_target2_distance : sp_bear_signal ? close - sp_target2_distance : na, "Alert: T2 Price", display=display.none) plot(sp_position_size, "Alert: Position Size", display=display.none) plot(sp_account_size * sp_risk_percent / 100 * sp_size_multiplier, "Alert: Risk Amount", display=display.none) plot(sp_bull_signal ? 1 : na, "VolOracle | BULL", display=display.none) plot(sp_bear_signal ? 1 : na, "VolOracle | BEAR", display=display.none) plot(sp_exit_warning ? 1 : na, "VolOracle | EXIT", display=display.none) plot(sp_regime_weakening ? 1 : na, "VolOracle | WEAKENING", display=display.none) plot(sp_t1_partial_exit ? 1 : na, "VolOracle | T1_PARTIAL", display=display.none) plot(sp_should_move_be ? 1 : na, "VolOracle | BREAKEVEN", display=display.none) plot(sp_momentum_fading ? 1 : na, "VolOracle | MOM_FADING", display=display.none) plot(sp_flow_deteriorating ? 1 : na, "VolOracle | FLOW_WEAK", display=display.none) plot(sp_volume_drying ? 1 : na, "VolOracle | VOL_DRYING", display=display.none) bool sp_regime_to_accum = sp_accumulation and sp_prev_regime != "ACCUMULATION" bool sp_regime_to_dist = sp_distribution and sp_prev_regime != "DISTRIBUTION" bool sp_regime_to_neutral = sp_neutral and sp_prev_regime != "NEUTRAL" bool sp_any_regime_change = sp_regime_to_accum or sp_regime_to_dist or sp_regime_to_neutral alertcondition(sp_bull_signal, "🟢 BULL Signal", "🟢 BULLISH FLOW | {{ticker}} {{interval}}\nQuality: {{plot_0}}% | Regime: {{plot_1}}%\nEntry: {{plot_2}} | Stop: {{plot_3}}\nT1: {{plot_4}} | T2: {{plot_5}}\nSize: {{plot_6}} units | Risk: ${{plot_7}}") alertcondition(sp_bear_signal, "🔴 BEAR Signal", "🔴 BEARISH FLOW | {{ticker}} {{interval}}\nQuality: {{plot_0}}% | Regime: {{plot_1}}%\nEntry: {{plot_2}} | Stop: {{plot_3}}\nT1: {{plot_4}} | T2: {{plot_5}}\nSize: {{plot_6}} units | Risk: ${{plot_7}}") alertcondition(sp_bull_signal or sp_bear_signal, "⚡ ANY Signal", "⚡ FLOW SIGNAL | {{ticker}} {{interval}}\nQuality: {{plot_0}}%") alertcondition(sp_t1_partial_exit, "🎯 Target 1 Hit", "🎯 T1 HIT | {{ticker}} {{interval}}") alertcondition(sp_should_move_be, "🔒 Breakeven", "🔒 BREAKEVEN | {{ticker}} {{interval}}") alertcondition(sp_exit_warning, "⚠️ Exit Warning", "⚠️ EXIT | {{ticker}} {{interval}}") alertcondition(sp_regime_to_accum, "📈 Regime → Accumulation", "📈 ACCUMULATION | {{ticker}} {{interval}}") alertcondition(sp_regime_to_dist, "📉 Regime → Distribution", "📉 DISTRIBUTION | {{ticker}} {{interval}}") alertcondition(sp_regime_to_neutral, "⚖️ Regime → Neutral", "⚖️ NEUTRAL | {{ticker}} {{interval}}") alertcondition(sp_any_regime_change, "🔄 Any Regime Change", "🔄 REGIME CHANGE | {{ticker}} {{interval}}") alertcondition(sp_regime_weakening and sp_early_warning, "⚡ Regime Weakening", "⚡ WEAKENING | {{ticker}} {{interval}}") alertcondition(sp_momentum_fading, "📉 Momentum Fading", "📉 MOMENTUM FADING | {{ticker}} {{interval}}") alertcondition(sp_flow_deteriorating, "📉 Flow Deteriorating", "📉 FLOW WEAK | {{ticker}} {{interval}}") alertcondition(sp_volume_drying, "📉 Volume Drying Up", "📉 VOLUME DRYING | {{ticker}} {{interval}}") alertcondition(sp_warning_count >= 2, "🟠 Multiple Warnings", "🟠 CAUTION | {{ticker}} {{interval}}") bool sp_htf_just_aligned = sp_use_htf and sp_htf_all_aligned and not sp_htf_all_aligned[1] bool sp_htf_just_broke = sp_use_htf and not sp_htf_all_aligned and sp_htf_all_aligned[1] alertcondition(sp_htf_just_aligned, "✅ HTF Aligned", "✅ HTF ALIGNED | {{ticker}} {{interval}}") alertcondition(sp_htf_just_broke, "❌ HTF Broke", "❌ HTF BROKE | {{ticker}} {{interval}}") // NEW: Structure alerts bool sp_structure_just_bullish = sp_structure == "BULLISH" and sp_prev_structure != "BULLISH" bool sp_structure_just_bearish = sp_structure == "BEARISH" and sp_prev_structure != "BEARISH" bool sp_structure_conflict_alert = sp_structure_conflicts and not sp_structure_conflicts[1] alertcondition(sp_structure_just_bullish, "📊 Structure Bullish", "📊 STRUCTURE HH/HL | {{ticker}} {{interval}}") alertcondition(sp_structure_just_bearish, "📊 Structure Bearish", "📊 STRUCTURE LH/LL | {{ticker}} {{interval}}") alertcondition(sp_structure_conflict_alert, "⚠️ Structure Conflict", "⚠️ STRUCTURE CONFLICTS WITH REGIME | {{ticker}} {{interval}}") // NEW: Footprint alerts alertcondition(sp_bullish_momentum or sp_bearish_momentum, "🔥 Momentum Footprint", "🔥 MOMENTUM FOOTPRINT | {{ticker}} {{interval}}") alertcondition(sp_bullish_absorption or sp_bearish_absorption, "🛡️ Absorption Footprint", "🛡️ ABSORPTION FOOTPRINT | {{ticker}} {{interval}}") // NEW: Market character alerts bool sp_market_trending = sp_market_character == "TRENDING" and sp_prev_market_character != "TRENDING" bool sp_market_choppy = sp_market_character == "CHOPPY" and sp_prev_market_character != "CHOPPY" alertcondition(sp_market_trending, "📈 Market Trending", "📈 MARKET NOW TRENDING | {{ticker}} {{interval}}") alertcondition(sp_market_choppy, "📉 Market Choppy", "📉 MARKET NOW CHOPPY | {{ticker}} {{interval}}") // NEW: High confluence alert bool sp_confluence_signal = (sp_bull_signal or sp_bear_signal) and sp_high_confluence alertcondition(sp_confluence_signal, "🎯 High Confluence Signal", "🎯 HIGH CONFLUENCE | {{ticker}} {{interval}}") // ═══════════════════════════════════════════════════ // META: v1.0 | plots: 18 | alerts: 25 | security: 2 | repaint: ZERO // // v1.0 ADAPTIVE SYSTEM: // ───────────────────── // TF Category | Target Regime | Lookback | Velocity | Cooldown | Confirm | Threshold // SCALP (≤5m) | 1.5 hours | 15-100 | 2-20 | 2-15 | 3 bars | ×0.65 // INTRADAY | 6 hours | 15-100 | 2-20 | 2-15 | 2 bars | ×0.80 // SWING | 36 hours | 15-100 | 2-20 | 2-15 | 2 bars | ×1.00 // POSITION | 168 hours | 15-100 | 2-20 | 2-15 | 2 bars | ×1.30 // // All parameters scale based on target regime duration: // - Regime Lookback = Target × 2.5 (capped 15-100) // - Velocity = Target × 0.15 (capped 2-20) // - Cooldown = Target × 0.30 (capped 2-15) // - Flow Window = Lookback × 0.50 // - Max Hold = Target × 3 // // v1.0 BUG FIXES (Jan 2026): // - Fixed regime change alerts (was using sp_regime[1] on var) // - Fixed structure change alerts (added sp_prev_structure tracking) // - Fixed market character alerts (added sp_prev_market_character tracking) // - Removed unused transparency input // // v1.0 IMPROVEMENTS: // 1. Multi-bar regime confirmation (adaptive by TF) // 2. Removed volume confirmation (selloffs can be low volume) // 3. Multiple warning levels (FADING→WEAKENING→CRITICAL) // 4. Rate-of-change detection (adaptive) // 5. Momentum fading detection // 6. Flow deteriorating detection // 7. Volume drying up detection // 8. Regime weakening as exit trigger // 9. Color intensity by regime strength // 10. Highlight volume spikes // 11. Volume-weighted flow by bar position // 12. HTF strengthening + trend agreement + validation // 13. Momentum acceleration bonus // 14. Weakening colors require 3-bar confirmation // 15. FULLY TIMEFRAME ADAPTIVE SYSTEM // 16. Regime score visible in tooltip // 17. HTF validation (warns if not actually higher) // 18. Adaptive rapid decline detection // // +==================================================================+ // | END: Volume Oracle v1.0 | // +==================================================================+