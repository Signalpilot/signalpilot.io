// ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ OMNIDECK - UNIFIED CHART OVERLAY ║ // ║ MTF Confluence Panel • v1.0 • 2026 ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ // // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ TABLE OF CONTENTS │ // ├─────────────────────────────────────────────────────────────────────────────┤ // │ SECTION LINE (approx) │ // │ ───────────────────────────────────────────────────────────────────────── │ // │ 1. HELPER FUNCTIONS ......................................... ~55 │ // │ 2. CACHED CALCULATIONS ...................................... ~115 │ // │ 3. INPUTS / SETTINGS ........................................ ~166 │ // │ ├─ 3.1 Main Toggles (+ Master Toggle) │ // │ ├─ 3.2 Colors │ // │ ├─ 3.3 Confluence Panel │ // │ ├─ 3.4 Multi-Timeframe │ // │ ├─ 3.5 Visual Settings │ // │ ├─ 3.6 S/D Zones │ // │ └─ 3.7 Candlestick Patterns │ // │ 4. CONSTANTS ............................................... ~406 │ // │ ├─ 4.1 Squeeze / BB / KC │ // │ ├─ 4.2 Warning Markers │ // │ ├─ 4.3 Regime Detection │ // │ ├─ 4.4 Confluence Weights │ // │ ├─ 4.5 Candlestick Patterns (RCS) │ // │ ├─ 4.6 Exhaustion Detection │ // │ └─ 4.7 Derived Values │ // │ 5. CORE CALCULATIONS ....................................... ~531 │ // │ ├─ 5.1-5.3 BB/KC, Exhaustion Counter, Squeeze │ // │ ├─ 5.4-5.5 Context, Leg Engine │ // │ ├─ 5.6-5.8 SuperTrend, BMSB, Anchors │ // │ ├─ 5.9-5.11 Sweeps, EMA Stack, Regime │ // │ ├─ 5.12 Supply/Demand Zones │ // │ └─ 5.13 RCS Candlestick Patterns │ // │ 6. MTF DATA RETRIEVAL ...................................... ~2160 │ // │ 7. CONFLUENCE SCORING ...................................... ~2336 │ // │ 8. CONFLUENCE PANEL DISPLAY ................................ ~2415 │ // │ 9. ALERTS .................................................. ~2720 │ // └─────────────────────────────────────────────────────────────────────────────┘ // // Non-repainting • All signals confirmed on bar close • 38 alert conditions // //@version=6 indicator("OmniDeck - Unified Chart Overlay", shorttitle="OmniDeck", overlay=true, max_labels_count=500, max_boxes_count=300, max_lines_count=80) // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 1. HELPER FUNCTIONS ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ //@function Convert size string to size constant //@param sel Size selection string ("tiny", "small", "normal", "large") //@returns size constant szFromSel(simple string sel) => string result = sel == "tiny" ? size.tiny : sel == "small" ? size.small : sel == "large" ? size.large : size.normal result //@function Convert direction to label style //@param ud Direction: 1=up, -1=down, 0=center //@returns label style constant styleFromUD(int ud) => string result = ud == 1 ? label.style_label_up : ud == -1 ? label.style_label_down : label.style_label_center result //@function Calculate median of three values //@param a First value //@param b Second value //@param c Third value //@returns Median value median3(float a, float b, float c) => float result = a + b + c - math.max(a, math.max(b, c)) - math.min(a, math.min(b, c)) result //@function Create a label with standard styling //@param _x Bar index //@param _y Price level //@param _txt Label text //@param _tc Text color //@param _sz Size constant //@param _ud Direction for style //@returns Label object mkLbl(int _x, float _y, string _txt, color _tc, string _sz, int _ud) => label.new(x=_x, y=_y, text=_txt, xloc=xloc.bar_index, yloc=yloc.price, style=styleFromUD(_ud), color=color.new(color.black, 100), textcolor=_tc, size=_sz) //@function Convert RCS size string to size constant //@param s Size string ("Tiny", "Small", "Normal", "Large") //@returns size constant rcsToSize(simple string s) => string result = s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal result //@function Check if cooldown period has elapsed //@param lastIdx Last event bar index //@param cd Cooldown bars //@returns true if cooldown elapsed cooldownOk(int lastIdx, int cd) => bool result = (lastIdx < 0) or (bar_index - lastIdx > cd) result //@function Format timeframe string for display //@param tf Timeframe string (e.g., "15", "60", "1D") //@returns Formatted string (e.g., "15m", "1H", "1D") //@function Format timeframe string for display //@param tf Timeframe string (e.g., "15", "60", "1D") //@returns Formatted string (e.g., "15m", "1H", "1D") fmtTf(string tf) => string result = "" if tf == "" result := "" else if str.endswith(tf, "S") result := str.replace(tf, "S", "s") else if str.endswith(tf, "D") result := tf else if str.endswith(tf, "W") result := tf else if str.endswith(tf, "M") result := tf else int mins = int(str.tonumber(tf)) if mins >= 60 and mins % 60 == 0 result := str.tostring(mins / 60) + "H" else result := tf + "m" result //@function Calculate cross price between two lines //@param aPrev Line A previous value //@param aCurr Line A current value //@param bPrev Line B previous value //@param bCurr Line B current value //@returns Interpolated cross price crossPrice(float aPrev, float aCurr, float bPrev, float bCurr) => float prevDiff = aPrev - bPrev float currDiff = aCurr - bCurr float denom = prevDiff - currDiff float tRaw = denom != 0.0 ? prevDiff / denom : 0.0 float t = math.max(0.0, math.min(1.0, tRaw)) float result = aPrev + t * (aCurr - aPrev) result //@function Get dynamic lookback based on timeframe //@returns Number of bars for pattern lookback getDynamicLookback() => float tfMins = timeframe.in_seconds() / 60 int result = tfMins <= 5 ? 50 : tfMins <= 15 ? 40 : tfMins <= 60 ? 30 : tfMins <= 240 ? 40 : tfMins <= 1440 ? 30 : 20 result // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 2. CACHED CALCULATIONS ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ // Computed once, reused everywhere to avoid redundant calculations tfMins = timeframe.in_seconds() / 60 // Cache timeframe in minutes // Common ATR values (avoid recalculating) atr14 = ta.atr(14) atr20 = ta.atr(20) // Common moving averages (avoid recalculating) sma20 = ta.sma(close, 20) ema21 = ta.ema(close, 21) // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 3. INPUTS / SETTINGS ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.1 MAIN - What to show on chart │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_main = "① Main" sp_master = input.string("Manual", "═══ MASTER ═══", options=["All On", "All Off", "Manual"], group=sp_grp_main, tooltip="Quick toggle for all visual elements. 'All On' = enable everything. 'All Off' = hide everything. 'Manual' = respect individual toggles below (default).") sp_show_td_input = input.bool(true, "Exhaustion Counter (8/9)", group=sp_grp_main, tooltip="Displays sequential exhaustion counts. Count of 8 warns trend may be tiring. Count of 9 signals potential reversal zone. ON = show counts on chart (default). OFF = hide markers.") sp_show_st_input = input.bool(true, "SuperTrend", group=sp_grp_main, tooltip="Multi-ATR trend line using 2/3/4 ATR bands with consensus voting. Shows trend direction and dynamic support/resistance. ON = display SuperTrend line (default). OFF = hide.") sp_show_ema50_input = input.bool(true, "EMA 50", group=sp_grp_main, tooltip="50-period Exponential Moving Average. Short-term trend reference often used as pullback support in uptrends. ON = show line (default). OFF = hide.") sp_show_ema100_input = input.bool(true, "EMA 100", group=sp_grp_main, tooltip="100-period Exponential Moving Average. Medium-term trend reference. Price crossing this often signals trend shift. ON = show line (default). OFF = hide.") sp_show_ema200_input = input.bool(true, "EMA 200", group=sp_grp_main, tooltip="200-period Exponential Moving Average. Long-term trend and major support/resistance. Institutional reference level. ON = show line (default). OFF = hide.") sp_show_regime_input = input.bool(true, "Regime Background", group=sp_grp_main, tooltip="Subtle background tint showing bull/bear market regime. Uses EMA alignment + ADX trend strength for classification. ON = show tint (default). OFF = clean background.") sp_show_squeeze_input = input.bool(false, "Squeeze Cloud", group=sp_grp_main, tooltip="Highlights when Bollinger Bands compress inside Keltner Channels. Signals low volatility, often precedes breakout. OFF = hidden (default). ON = show purple cloud during squeeze.") sp_show_rel_arrows_input = input.bool(false, "Squeeze Break Arrows", group=sp_grp_main, tooltip="Shows ▲/▼ arrows when squeeze releases with momentum direction. Marks potential breakout entry points. OFF = hidden (default). ON = show arrows on release.") sp_show_bmsb_input = input.bool(false, "Bull Market Support Band", group=sp_grp_main, tooltip="20 SMA + 21 EMA band. Classic bull market support zone — pullbacks to this band often hold in uptrends. OFF = hidden (default). ON = show band.") sp_show_sdz_input = input.bool(false, "Supply/Demand Zones", group=sp_grp_main, tooltip="Pivot-based supply and demand zones with confluence scoring. Shows potential reversal areas with quality grades. OFF = hidden (default). ON = show zones.") sp_show_sweeps_input = input.bool(false, "Liquidity Sweeps", group=sp_grp_main, tooltip="Detects wicks grabbing liquidity beyond recent highs/lows then closing back inside. Potential reversal signal. OFF = hidden (default). ON = show sweep markers.") sp_show_rcs_input = input.bool(false, "Candlestick Patterns", group=sp_grp_main, tooltip="16 Japanese candlestick patterns: Hammer, Engulfing, Morning/Evening Star, Three Soldiers, etc. Filtered for swing location context. OFF = hidden (default). ON = show pattern labels.") sp_show_ema_events_input = input.bool(false, "EMA Cross Events (GC/DC)", group=sp_grp_main, tooltip="Labels Golden Cross (50 crosses above 200) and Death Cross (50 crosses below 200). Major long-term trend signals. OFF = hidden (default). ON = show cross labels.") sp_show_warn_input = input.bool(false, "Caution/Danger Markers", group=sp_grp_main, tooltip="Shows X markers when multiple exhaustion signals cluster during a trend leg. Warns of potential momentum failure. OFF = hidden (default). ON = show warning markers.") // Derived show variables (respecting master toggle) // "All On" = force true | "All Off" = force false | "Manual" = use individual input sp_show_td = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_td_input sp_show_st = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_st_input sp_show_ema50 = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_ema50_input sp_show_ema100 = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_ema100_input sp_show_ema200 = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_ema200_input sp_show_regime = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_regime_input sp_show_squeeze = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_squeeze_input sp_show_rel_arrows = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_rel_arrows_input sp_show_bmsb = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_bmsb_input sp_show_sdz = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_sdz_input sp_show_sweeps = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_sweeps_input sp_show_rcs = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_rcs_input sp_show_ema_events = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_ema_events_input sp_show_warn = sp_master == "All On" ? true : sp_master == "All Off" ? false : sp_show_warn_input // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.2 COLORS - Grouped by analytical function │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_colors = "② Colors" // TREND COLORS — SuperTrend, EMA Stack, BMSB, Regime Background string tt_trend = "Trend-following systems that identify directional bias: SuperTrend consensus, EMA Stack alignment, Bull Market Support Band, and Regime Detection background. These systems work together to confirm trend direction." color sp_col_trend_bull = input.color(color.rgb(0, 170, 170), "📈 Trend Bullish", group=sp_grp_colors, tooltip=tt_trend) color sp_col_trend_bear = input.color(color.rgb(255, 107, 107), "📉 Trend Bearish", group=sp_grp_colors, tooltip=tt_trend) // EXHAUSTION COLORS — Exhaustion Counter, Candlestick Patterns, Liquidity Sweeps string tt_exhaust = "Exhaustion/reversal systems that identify potential turning points: Exhaustion Counter counts (8/9), Candlestick Patterns, and Liquidity Sweeps. These detect when moves may be overextended." color sp_col_exhaust_bull = input.color(color.rgb(0, 200, 150), "🔄 Exhaust Bullish", group=sp_grp_colors, tooltip=tt_exhaust) color sp_col_exhaust_bear = input.color(color.rgb(255, 130, 100), "🔄 Exhaust Bearish", group=sp_grp_colors, tooltip=tt_exhaust) // STRUCTURE COLORS — Supply/Demand Zones string tt_struct = "Structure systems that map key price levels: Supply zones (potential resistance) and Demand zones (potential support). Grouped because they define the structural framework of price action." color sp_col_supply = input.color(color.rgb(255, 82, 82), "🟥 Supply Zone", group=sp_grp_colors, tooltip=tt_struct) color sp_col_demand = input.color(color.rgb(76, 175, 80), "🟩 Demand Zone", group=sp_grp_colors, tooltip=tt_struct) // VOLATILITY COLOR — Squeeze Detection string tt_vol = "Volatility system: Squeeze Detection identifies BB compression inside KC — periods of low volatility that often precede expansion. Separate color helps spot compression zones quickly." color sp_col_squeeze = input.color(color.rgb(156, 39, 176), "🔮 Squeeze", group=sp_grp_colors, tooltip=tt_vol) // WARNING COLOR — Caution/Danger Markers string tt_warn = "Warning markers for momentum exhaustion: Caution (✖) and Danger (‼) signals when multiple exhaustion conditions cluster. High-visibility color recommended." color sp_col_warning = input.color(color.rgb(255, 165, 0), "⚠️ Warning", group=sp_grp_colors, tooltip=tt_warn) // NEUTRAL COLOR — Backgrounds, inactive states string tt_neutral = "Non-directional structural elements: EMA lines (50/100/200), BMSB band, confluence panel backgrounds. These show price structure and reference levels, not bull/bear direction. Subtle color recommended." color sp_col_neutral = input.color(color.rgb(128, 128, 128), "⚪ Neutral", group=sp_grp_colors, tooltip=tt_neutral) // Derived colors with transparency levels // Trend derived sp_col_trend_bull_solid = color.new(sp_col_trend_bull, 0) sp_col_trend_bear_solid = color.new(sp_col_trend_bear, 0) sp_col_trend_bull_soft = color.new(sp_col_trend_bull, 50) sp_col_trend_bear_soft = color.new(sp_col_trend_bear, 50) sp_col_trend_bull_zone = color.new(sp_col_trend_bull, 80) sp_col_trend_bear_zone = color.new(sp_col_trend_bear, 80) // Exhaustion derived sp_col_exhaust_bull_solid = color.new(sp_col_exhaust_bull, 0) sp_col_exhaust_bear_solid = color.new(sp_col_exhaust_bear, 0) // Structure derived sp_col_supply_solid = color.new(sp_col_supply, 0) sp_col_supply_zone = color.new(sp_col_supply, 70) sp_col_demand_solid = color.new(sp_col_demand, 0) sp_col_demand_zone = color.new(sp_col_demand, 70) // Squeeze derived sp_col_squeeze_zone = color.new(sp_col_squeeze, 80) // Neutral derived sp_col_neutral_line = color.new(sp_col_neutral, 55) sp_col_neutral_zone = color.new(sp_col_neutral, 80) // Legacy aliases for compatibility (map old names to new grouped colors) sp_col_bull = sp_col_trend_bull sp_col_bear = sp_col_trend_bear sp_col_caution = sp_col_warning sp_col_bull_signal = sp_col_exhaust_bull_solid sp_col_bear_signal = sp_col_exhaust_bear_solid sp_col_bull_signal_soft = color.new(sp_col_exhaust_bull, 20) sp_col_bear_signal_soft = color.new(sp_col_exhaust_bear, 20) sp_col_bull_trend = sp_col_trend_bull_soft sp_col_bear_trend = sp_col_trend_bear_soft sp_col_neutral_trend = sp_col_neutral_line // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.3 CONFLUENCE PANEL │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_conf = "③ Confluence Panel" sp_show_confluence = input.bool(true, "Show Panel", group=sp_grp_conf, tooltip="Displays confluence score combining all active systems into a directional bias. Shows which systems agree and overall strength. ON = show panel (default). OFF = hide panel.") sp_confluence_mode = input.string("Table", "Mode", options=["Badge", "Table", "Horizontal"], group=sp_grp_conf, tooltip="Panel display format. 'Badge' = compact score only, minimal space. 'Table' = vertical list with each system status (default). 'Horizontal' = wide layout, good for ultrawide monitors or mobile.") sp_horizontal_rows = input.int(2, "Horizontal Rows", minval=2, maxval=3, group=sp_grp_conf, tooltip="Row count for Horizontal mode only. Affects layout width vs height. 2 = wider, fits more on one row (default). 3 = taller, narrower width.") sp_confluence_pos = input.string("Top Right", "Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=sp_grp_conf, tooltip="Screen corner for panel placement. 'Top Right' = default position. Choose based on your chart layout and other indicators.") sp_confluence_size = input.string("Tiny", "Size", options=["Tiny", "Small", "Normal", "Large"], group=sp_grp_conf, tooltip="Panel text size. 'Tiny' = minimal footprint (default). 'Small' = slightly larger. 'Normal' = standard TradingView size. 'Large' = high visibility.") sp_confluence_offset = input.int(1, "Top Offset", minval=0, maxval=5, group=sp_grp_conf, tooltip="Empty rows above panel to avoid TradingView UI elements (symbol info, etc). 0 = no offset. 1 = slight gap (default). 3-5 = push further down.") sp_confluence_transp = input.bool(true, "Transparent Background", group=sp_grp_conf, tooltip="Controls panel background visibility. ON = transparent, text only (default). OFF = semi-opaque dark background, better readability on busy charts.") // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.4 MULTI-TIMEFRAME - Settings for confluence calculations │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_mtf = "④ Multi-Timeframe (Confluence)" sp_mtf_td = input.timeframe("", "Exhaustion Counter", group=sp_grp_mtf, tooltip="Timeframe for Exhaustion Counter in confluence panel. Blank = use chart timeframe (default). Use 'D' on intraday for daily exhaustion. Use '240' for 4H on lower TFs.") sp_mtf_squeeze = input.timeframe("", "Squeeze", group=sp_grp_mtf, tooltip="Timeframe for Squeeze detection in confluence. Blank = chart TF (default). Use 'D' to see daily squeeze state on intraday. Higher TF = bigger picture volatility.") sp_mtf_st = input.timeframe("", "SuperTrend", group=sp_grp_mtf, tooltip="Timeframe for SuperTrend in confluence. Blank = chart TF (default). Use 'D' on 1H charts for daily trend. Use 'W' on daily for weekly trend direction.") sp_mtf_bmsb = input.timeframe("", "BMSB", group=sp_grp_mtf, tooltip="Timeframe for Bull Market Support Band in confluence. Blank = chart TF (default). Use 'D' to see if price is above/below daily BMSB on intraday charts.") sp_mtf_ema = input.timeframe("", "EMA Stack", group=sp_grp_mtf, tooltip="Timeframe for EMA Stack alignment in confluence. Blank = chart TF (default). Use 'D' for daily EMA alignment. Use 'W' for weekly structure.") sp_mtf_sdz = input.timeframe("", "S/D Zones", group=sp_grp_mtf, tooltip="Timeframe for Supply/Demand zone status in confluence. Blank = chart TF (default). Use 'D' to see if at daily S/D zones on lower TFs.") sp_mtf_sweep = input.timeframe("", "Sweeps", group=sp_grp_mtf, tooltip="Timeframe for Liquidity Sweep detection in confluence. Blank = chart TF (default). Use 'D' for daily sweep events. Higher TF sweeps are more significant.") sp_mtf_regime = input.timeframe("", "Regime", group=sp_grp_mtf, tooltip="Timeframe for Regime classification in confluence. Blank = chart TF (default). Use 'D' or 'W' for higher timeframe regime context.") sp_mtf_rcs = input.timeframe("", "Candlesticks", group=sp_grp_mtf, tooltip="Timeframe for Candlestick Patterns in confluence. Blank = chart TF (default). Use 'D' for daily candle patterns. Higher TF patterns carry more weight.") sp_alert_tf = input.timeframe("", "Alerts TF", group=sp_grp_mtf, tooltip="Timeframe for alert calculations. Blank = use chart TF for alerts (default). Set to specific TF to fire alerts based on that timeframe regardless of chart.") sp_bmsb_tf = input.timeframe("", "BMSB Band TF", group=sp_grp_mtf, tooltip="Timeframe for BMSB band visualization on chart (separate from confluence). Blank = chart TF (default). Use 'D' to overlay daily BMSB on intraday chart.") // MTF usage flags sp_use_mtf_td = sp_mtf_td != "" sp_use_mtf_squeeze = sp_mtf_squeeze != "" sp_use_mtf_st = sp_mtf_st != "" sp_use_mtf_bmsb = sp_mtf_bmsb != "" sp_use_mtf_ema = sp_mtf_ema != "" sp_use_mtf_sdz = sp_mtf_sdz != "" sp_use_mtf_sweep = sp_mtf_sweep != "" sp_use_mtf_regime = sp_mtf_regime != "" sp_use_mtf_rcs = sp_mtf_rcs != "" sp_use_atf = sp_alert_tf != "" sp_use_bmsb_tf = sp_bmsb_tf != "" // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.5 VISUAL - Sizes, transparency, styles │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_visual = "⑤ Visual Settings" sp_td_marker_style = input.string("Text - Teal/Red", "Counter Style", options=["Text - White","Text - Teal/Red","Boxes (Teal/Red)"], group=sp_grp_visual, tooltip="Visual style for exhaustion 8/9 counts. 'Text - White' = simple white numbers. 'Text - Teal/Red' = colored by direction (default). 'Boxes (Teal/Red)' = numbers in colored boxes, most visible.") sp_td_text_size = input.string("normal", "Counter Size", options=["tiny","small","normal","large"], group=sp_grp_visual, tooltip="Size of exhaustion count labels. 'tiny' = minimal. 'small' = subtle. 'normal' = standard (default). 'large' = high visibility.") sp_only_show9 = input.bool(false, "Counter: Hide 8s (9 only)", group=sp_grp_visual, tooltip="Controls whether to show 8 counts or only 9s. OFF = show both 8 and 9 (default). ON = only show 9 counts, cleaner chart but miss the early warning.") sp_st_plot_mode = input.string("Consensus (2/3)", "SuperTrend Mode", options=["Consensus (2/3)","All (2/3/4)"], group=sp_grp_visual, tooltip="How SuperTrend displays on chart. 'Consensus (2/3)' = single line when 2 of 3 ATR bands agree (default). 'All (2/3/4)' = show all 3 bands for detailed view.") sp_regime_trans = input.int(93, "Regime Transparency", minval=85, maxval=99, group=sp_grp_visual, tooltip="Background tint visibility. Higher = more subtle. 85 = visible tint. 93 = subtle hint (default). 99 = barely visible.") sp_bmsb_fill_tr = input.int(88, "BMSB Transparency", minval=0, maxval=100, group=sp_grp_visual, tooltip="BMSB band fill opacity. 0 = solid fill. 50 = semi-transparent. 88 = very light (default). 100 = invisible fill, outline only.") sp_x_text_size = input.string("small", "Warning Size", options=["tiny","small","normal"], group=sp_grp_visual, tooltip="Size of Caution/Danger warning markers. 'tiny' = minimal. 'small' = subtle (default). 'normal' = standard visibility.") // Derived values sp_st_mode_consensus = sp_st_plot_mode == "Consensus (2/3)" sp_st_mode_all = sp_st_plot_mode == "All (2/3/4)" // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.6 S/D ZONES - Supply/Demand zone settings │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_zones = "⑥ S/D Zones" sp_sdz_theme = input.string("Night Ops", "Zone Theme", options=["Night Ops","Neon Pulse","Monochrome Pro","Ocean Glass"], group=sp_grp_zones, tooltip="Color scheme for zone boxes. 'Night Ops' = subtle dark colors (default). 'Neon Pulse' = bright, high visibility. 'Monochrome Pro' = gray tones, minimal. 'Ocean Glass' = blue-green tints.") sp_sdz_outline_only = input.bool(true, "Outline Only", group=sp_grp_zones, tooltip="Controls zone box fill style. ON = borders only, cleaner chart (default). OFF = filled boxes, more visible but can obscure price action.") sp_sdz_invalidate = input.string("Close", "Invalidate With", options=["Close","Wick"], group=sp_grp_zones, tooltip="When a zone is considered broken. 'Close' = candle must close through zone (default, more reliable). 'Wick' = any touch invalidates (more sensitive).") sp_sdz_hide_broken = input.bool(true, "Hide Broken", group=sp_grp_zones, tooltip="Whether to remove zones after price breaks through. ON = hide broken zones, keeps chart clean (default). OFF = keep showing broken zones for reference.") sp_sdz_show_tags = input.bool(true, "Show Labels", group=sp_grp_zones, tooltip="Display 'supply'/'demand' text labels on zones. ON = show labels (default). OFF = boxes only, minimal.") sp_sdz_show_badge = input.bool(true, "Show Quality Badge", group=sp_grp_zones, tooltip="Display confluence quality score on each zone. ON = show grade/score (default). OFF = hide quality badges.") sp_sdz_badge_style = input.string("A/B/C", "Badge Style", options=["A/B/C","0..10"], group=sp_grp_zones, tooltip="Format for quality badge. 'A/B/C' = letter grades, quick glance (default). '0..10' = numeric score, more granular.") // HIDDEN TECHNICAL DEFAULTS (Perfect settings - no user exposure) sp_sdz_left = 8 sp_sdz_right = 8 sp_sdz_use_atr = true sp_sdz_atr_len = 14 sp_sdz_atr_mult = 0.20 sp_sdz_min_h_mult = 0.10 sp_sdz_mark_touch = false sp_sdz_nearest_per_side = 2 sp_sdz_max_age = 600 sp_sdz_store_limit = 10 sp_sdz_merge_on = true sp_sdz_merge_overlap = 0.30 sp_sdz_merge_gap = 0.12 sp_sdz_excl_on = true sp_sdz_excl_overlap = 0.25 sp_sdz_excl_gap = 0.06 sp_sdz_excl_mode = "Most Recent" sp_sdz_show_hl = true sp_sdz_hl_len = 50 sp_sdz_fade_others = true // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 3.7 CANDLESTICK PATTERNS - Pattern selection and display │ // └─────────────────────────────────────────────────────────────────────────────┘ sp_grp_patterns = "⑦ Candlestick Patterns" sp_rcs_txt_size = input.string("Tiny", "Label Size", options=["Tiny","Small","Normal","Large"], group=sp_grp_patterns, tooltip="Size of pattern labels on chart. 'Tiny' = minimal footprint (default). 'Small' = slightly larger. 'Normal' = standard. 'Large' = high visibility.") sp_rcs_cooldown = input.int(8, "Cooldown Bars", minval=0, maxval=50, group=sp_grp_patterns, tooltip="Minimum bars between same-direction patterns. Prevents clustering of similar signals. 0 = no cooldown, all patterns shown. 8 = balanced (default). 15+ = only isolated patterns.") // Bullish patterns sp_rcs_hammer = input.bool(true, "Hammer", group=sp_grp_patterns, inline="b1") sp_rcs_inv_hammer = input.bool(false, "Inv Hammer", group=sp_grp_patterns, inline="b1") sp_rcs_bull_engulf = input.bool(false, "Bull Engulf", group=sp_grp_patterns, inline="b2") sp_rcs_bull_harami = input.bool(false, "Bull Harami", group=sp_grp_patterns, inline="b2") sp_rcs_rising3 = input.bool(false, "Rising 3", group=sp_grp_patterns, inline="b3") sp_rcs_3white = input.bool(true, "3 White", group=sp_grp_patterns, inline="b3") sp_rcs_morning_star = input.bool(true, "Morning Star", group=sp_grp_patterns, inline="b4") sp_rcs_tweezer_bottom = input.bool(false, "Tweezer Bot", group=sp_grp_patterns, inline="b4") // Bearish patterns sp_rcs_hanging_man = input.bool(true, "Hanging Man", group=sp_grp_patterns, inline="s1") sp_rcs_shooting_star = input.bool(true, "Shooting Star", group=sp_grp_patterns, inline="s1") sp_rcs_bear_engulf = input.bool(false, "Bear Engulf", group=sp_grp_patterns, inline="s2") sp_rcs_bear_harami = input.bool(false, "Bear Harami", group=sp_grp_patterns, inline="s2") sp_rcs_falling3 = input.bool(false, "Falling 3", group=sp_grp_patterns, inline="s3") sp_rcs_3black = input.bool(true, "3 Black", group=sp_grp_patterns, inline="s3") sp_rcs_evening_star = input.bool(true, "Evening Star", group=sp_grp_patterns, inline="s4") sp_rcs_tweezer_top = input.bool(false, "Tweezer Top", group=sp_grp_patterns, inline="s4") // RCS styling (hidden technical - use theme colors) sp_rcs_bull_color = sp_col_exhaust_bull sp_rcs_bear_color = sp_col_exhaust_bear sp_rcs_bg_tr = 100 sp_rcs_off_atr_pct = 0.5 // 50% of ATR offset (was 0.008 - way too small!) sp_rcs_off_ticks = 10 // Minimum tick offset // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 4. CONSTANTS ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.1 SQUEEZE / BB / KC Constants │ // └─────────────────────────────────────────────────────────────────────────────┘ bbLen = 20 bbMult = 2.0 kLen = 20 kMult = 1.5 kcPadATR = 0.03 autoWin = 300 sqzMinBars = 3 sqzExitBoost = 0.10 sqzMinHold = 2 // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.2 WARNING MARKERS Constants │ // └─────────────────────────────────────────────────────────────────────────────┘ minBarsBeforeX = 3 xCooldown = 12 minBodyATR_X = 0.16 minDistATR_X = 0.25 rsiOB = 70 rsiOS = 30 dangerConfirm = 2 // Liquidity Sweep parameters (pivot-based) - BALANCED: Significant but not rare const int SWEEP_PIVOT_LEFT = 10 // 10 bars of structure (catches more swings) const int SWEEP_PIVOT_RIGHT = 5 // 5 bars confirmation const int SWEEP_MAX_PIVOTS = 4 // Track 4 levels per side const int SWEEP_MIN_AGE = 12 // Level must be 12+ bars old const float SWEEP_DEPTH_ATR = 0.10 // Wick must pierce level by 10% ATR const float SWEEP_WICK_FRAC = 0.45 // Wick must be 45%+ of candle range const float SWEEP_SIGNIF_ATR = 0.75 // Pivot must be 0.75 ATR from surrounding const float SWEEP_SPACING_ATR = 1.0 // Min 1.0 ATR between stored pivots const float SWEEP_CLOSE_ATR = 0.05 // Close must be 5% ATR beyond level const float SWEEP_CLOSE_FRAC = 0.40 // Close must be in upper/lower 40% of candle ATR_LEN = 14 COOLDOWN = 10 STRICT_PB = true PB1_WINDOW = 60 // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.3 REGIME DETECTION Constants │ // └─────────────────────────────────────────────────────────────────────────────┘ const int EMA_FAST_RB = 34 const int EMA_SLOW_RB = 55 const int PL_LEN_RB = 100 const int ADX_LEN_RB = 14 const float HYST_ATR_MULT = 0.05 const float SLOPE_ATR_DEAD = 0.02 const float CLEAR_ATR_MULT_RB = 0.25 const int TREND_BARS_RB = 8 const int MIN_HOLD_BARS = 12 const int CONFIRM_BARS = 3 const float MIN_ADX = 15.0 // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.4 CONFLUENCE WEIGHTS │ // └─────────────────────────────────────────────────────────────────────────────┘ const float WT_TD9_PERF = 2.0 const float WT_TD9 = 1.5 const float WT_TD8 = 1.0 const float WT_SQUEEZE = 1.5 const float WT_ST = 1.0 const float WT_BMSB = 0.5 const float WT_EMA_REG = 1.0 const float WT_SDZ = 1.5 const float WT_SWEEP = 2.0 const float WT_REGIME = 0.5 const float WT_RCS = 1.0 // High confluence threshold for alerts const float HIGH_CONF_THRESHOLD = 6.0 // Dynamic lookback for RCS rcsLookback = getDynamicLookback() // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.5 CANDLESTICK PATTERN Constants │ // └─────────────────────────────────────────────────────────────────────────────┘ // Position context const float RCS_RANGE_PCT = 0.30 // Close in top/bottom 30% of range = "near extreme" const float RCS_REJECT_PCT = 0.15 // Rejection wick threshold (15% of range) // Shape detection (hammer/shooting star family) const float RCS_WICK_RATIO = 2.0 // Long wick must be >= 2x body const float RCS_OPP_WICK_MAX = 0.5 // Opposite wick must be <= 0.5x body const float RCS_TWEEZER_TOL = 0.1 // ATR multiplier for tweezer matching // Star patterns (morning/evening star) const float RCS_SMALL_BODY = 0.5 // Middle candle body < 50% of first candle // Continuation patterns (rising/falling three) const float RCS_STRONG_BODY = 0.5 // First/last candle body > 0.5 ATR // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.6 EXHAUSTION DETECTION Constants │ // └─────────────────────────────────────────────────────────────────────────────┘ const float IMPULSE_BODY_ATR = 0.70 // Body >= 70% ATR = impulse candle const float WICK_EXHAUST_RATIO = 0.55 // Wick >= 55% of range = exhaustion wick const float VOL_EXHAUST_MULT = 1.8 // Volume >= 1.8x average = high volume const float DIST_MID_EXTREME = 0.80 // Distance from KC mid >= 0.8 ATR = extended const int RSI_CAUTION_OB = 65 // RSI > 65 during upleg = caution const int RSI_CAUTION_OS = 35 // RSI < 35 during downleg = caution // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 4.7 DERIVED VALUES (from settings) │ // └─────────────────────────────────────────────────────────────────────────────┘ color teal = sp_col_bull // Legacy reference color upST = sp_col_bull_trend color dnST = sp_col_bear_trend labelSizeTD = szFromSel(sp_td_text_size) labelSizeX = szFromSel(sp_x_text_size) tdIsBoxes = sp_td_marker_style == "Boxes (Teal/Red)" tdIsTealRed = sp_td_marker_style == "Text - Teal/Red" tdBuyColor = tdIsBoxes ? color.white : (tdIsTealRed ? sp_col_exhaust_bull : color.white) tdSellColor = tdIsBoxes ? color.white : (tdIsTealRed ? sp_col_exhaust_bear : color.white) tdBuyUD = tdIsBoxes ? 1 : 0 tdSellUD = tdIsBoxes ? -1 : 0 // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 5. CORE CALCULATIONS ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.1 BOLLINGER BANDS + KELTNER CHANNELS (base for Squeeze) │ // └─────────────────────────────────────────────────────────────────────────────┘ basisBB = ta.sma(hlc3, bbLen) devBB = ta.stdev(hlc3, bbLen) bbU = basisBB + bbMult * devBB bbL = basisBB - bbMult * devBB midK = ta.ema(hlc3, kLen) atrK = ta.atr(kLen) kU = midK + kMult * atrK kL = midK - kMult * atrK // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.2 EXHAUSTION COUNTER (8/9 exhaustion counts) │ // └─────────────────────────────────────────────────────────────────────────────┘ var int buySetup = 0 var int sellSetup = 0 var int buySetup_conf = 0 var int sellSetup_conf = 0 if barstate.isconfirmed c_now = close c_4back = close[4] buyNow = c_now < c_4back sellNow = c_now > c_4back // Standard exhaustion count: increment on ANY qualifying bar, reset on opposite if buyNow buySetup := buySetup + 1 sellSetup := 0 else if sellNow sellSetup := sellSetup + 1 buySetup := 0 else buySetup := 0 sellSetup := 0 buySetup_conf := buySetup sellSetup_conf := sellSetup else buySetup_conf := buySetup_conf[1] sellSetup_conf := sellSetup_conf[1] td8B_evt = barstate.isconfirmed and buySetup_conf == 8 td9B_evt = barstate.isconfirmed and buySetup_conf == 9 td8S_evt = barstate.isconfirmed and sellSetup_conf == 8 td9S_evt = barstate.isconfirmed and sellSetup_conf == 9 l0 = barstate.isconfirmed ? low : low[1] l1 = barstate.isconfirmed ? low[1] : low[2] l2 = barstate.isconfirmed ? low[2] : low[3] l3 = barstate.isconfirmed ? low[3] : low[4] h0 = barstate.isconfirmed ? high : high[1] h1 = barstate.isconfirmed ? high[1] : high[2] h2 = barstate.isconfirmed ? high[2] : high[3] h3 = barstate.isconfirmed ? high[3] : high[4] td9B_perf_evt = td9B_evt and (math.min(l0, l1) <= math.min(l2, l3)) td9S_perf_evt = td9S_evt and (math.max(h0, h1) >= math.max(h2, h3)) var bool SP_TD8B = false, SP_TD9B = false, SP_TD8S = false, SP_TD9S = false var bool SP_TD9B_PERF = false, SP_TD9S_PERF = false if barstate.isconfirmed SP_TD8B := td8B_evt SP_TD9B := td9B_evt SP_TD8S := td8S_evt SP_TD9S := td9S_evt SP_TD9B_PERF := td9B_perf_evt SP_TD9S_PERF := td9S_perf_evt // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.3 SQUEEZE DETECTION + Break Arrows │ // └─────────────────────────────────────────────────────────────────────────────┘ kcWidth = math.max(kU - kL, 1e-10) normW = (bbU - bbL) / kcWidth qW25 = ta.percentile_linear_interpolation(normW, autoWin, 25) enterThr = nz(qW25, normW) exitThr = enterThr + sqzExitBoost kcPad = kcPadATR * atrK insideKC = (bbU <= kU - kcPad) and (bbL >= kL + kcPad) inSqz_enter = insideKC and (normW <= enterThr) inSqz_exit = (not insideKC) or (normW > exitThr) var int sqzEnterRun = 0 var int sqzAge = 0 var bool SP_SQZ = false var bool SP_SQZ_conf = false if barstate.isconfirmed if not SP_SQZ sqzEnterRun := inSqz_enter ? sqzEnterRun + 1 : 0 if sqzEnterRun >= sqzMinBars SP_SQZ := true sqzAge := 1 else SP_SQZ := false sqzAge := 0 else sqzAge := sqzAge + 1 if sqzAge >= sqzMinHold and inSqz_exit SP_SQZ := false sqzEnterRun := 0 sqzAge := 0 SP_SQZ_conf := SP_SQZ else SP_SQZ_conf := SP_SQZ_conf[1] // Squeeze BREAK detection - fires when squeeze RELEASES (ends) with directional momentum var bool SP_BRK_UP = false var bool SP_BRK_DN = false var bool SP_BRK_UP_conf = false var bool SP_BRK_DN_conf = false // Momentum indicator for break direction momOsc = ta.linreg(close - sma20, 20, 0) // Squeeze just ENDED: was in squeeze LAST bar, not in squeeze THIS bar sqzJustReleased = SP_SQZ_conf[1] and not SP_SQZ_conf if barstate.isconfirmed // Break fires on release with momentum direction SP_BRK_UP := sqzJustReleased and momOsc > 0 SP_BRK_DN := sqzJustReleased and momOsc <= 0
SP_BRK_UP_conf := SP_BRK_UP SP_BRK_DN_conf := SP_BRK_DN 
else SP_BRK_UP_conf := SP_BRK_UP_conf[1] SP_BRK_DN_conf := SP_BRK_DN_conf[1] // Squeeze cloud visualization (proper fill) pSqzU = plot(sp_show_squeeze and SP_SQZ_conf ? bbU : na, title="Squeeze Upper", color=color.new(sp_col_neutral, 100), display=display.none) pSqzL = plot(sp_show_squeeze and SP_SQZ_conf ? bbL : na, title="Squeeze Lower", color=color.new(sp_col_neutral, 100), display=display.none) fill(pSqzU, pSqzL, color=sp_col_squeeze_zone, title="Squeeze Cloud") // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.4 CONTEXT CALCULATIONS (for warnings & sweeps) │ // └─────────────────────────────────────────────────────────────────────────────┘ emaFast = ta.ema(close, 9) emaSlow = ta.ema(close, 26) momSlope = emaFast - emaSlow rsiSig = ta.rsi(close, 14) volMA = ta.sma(volume, 20) distFromMidATR = math.abs(close - midK) / math.max(atrK, 1e-9) bodyATR = math.abs(close - open) / math.max(atrK, 1e-9) upperW = high - math.max(open, close) lowerW = math.min(open, close) - low rng = math.max(high - low, 1e-9) upMove = high - nz(high[1]) downMove = nz(low[1]) - low plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0 minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0 trRaw = math.max(math.max(high - low, math.abs(high - nz(close[1]))), math.abs(low - nz(close[1]))) trSm = ta.rma(trRaw, 14) plusDI = 100.0 * (ta.rma(plusDM, 14) / math.max(trSm, 1e-9)) minusDI = 100.0 * (ta.rma(minusDM,14) / math.max(trSm, 1e-9)) dxVal = 100.0 * (math.abs(plusDI - minusDI) / math.max(plusDI + minusDI, 1e-9)) adxSig = ta.rma(dxVal, 14) // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.5 LEG ENGINE + Caution/Danger Markers │ // └─────────────────────────────────────────────────────────────────────────────┘ impulseUp_evt = barstate.isconfirmed and (bodyATR >= IMPULSE_BODY_ATR) and (close > high[1]) and (emaFast > emaSlow) impulseDown_evt = barstate.isconfirmed and (bodyATR >= IMPULSE_BODY_ATR) and (close < low[1]) and (emaFast < emaSlow) var int legDir = 0 var bool legActive = false var int legAge = 0 var int decelCnt = 0 var int failStreak = 0 var int legId = 0 startUp_evt = SP_BRK_UP_conf or impulseUp_evt startDown_evt = SP_BRK_DN_conf or impulseDown_evt if barstate.isconfirmed if not legActive and (startUp_evt or startDown_evt) legDir := startUp_evt ? 1 : -1 legActive := true legAge := 0 decelCnt := 0 failStreak := 0 legId := legId + 1 if SP_SQZ_conf legActive := false legDir := 0 legAge := 0 decelCnt := 0 failStreak := 0 if legActive legAge := legAge + 1 decelNow = legDir == 1 ? (momSlope < nz(momSlope[1])) : (momSlope > nz(momSlope[1])) decelCnt := decelNow ? decelCnt + 1 : 0 hhPrice = ta.highest(high, 9) hhRSI = ta.highest(rsiSig, 9) llPrice = ta.lowest(low, 9) llRSI = ta.lowest(rsiSig, 9) bearDiv = legActive and legDir == 1 and (high >= hhPrice[1]) and (rsiSig < hhRSI[1]) bullDiv = legActive and legDir == -1 and (low <= llPrice[1]) and (rsiSig > llRSI[1]) wickExhaustUp = (upperW/rng >= WICK_EXHAUST_RATIO) and (volume >= volMA * VOL_EXHAUST_MULT) wickExhaustDown = (lowerW/rng >= WICK_EXHAUST_RATIO) and (volume >= volMA * VOL_EXHAUST_MULT) wickExhaust = wickExhaustUp or wickExhaustDown emaCrossDown = ta.crossunder(emaFast, emaSlow) emaCrossUp = ta.crossover(emaFast, emaSlow) loseMidUp = legActive and legDir == 1 and close < midK loseMidDn = legActive and legDir == -1 and close > midK momFlipUp = legActive and legDir == 1 and momSlope <= 0 momFlipDn = legActive and legDir == -1 and momSlope >= 0 weakADX = (adxSig < 15) or (adxSig < nz(adxSig[1]) and nz(adxSig[1]) < nz(adxSig[2])) failNow = legActive and ((legDir == 1 and ((loseMidUp?1:0)+(momFlipUp?1:0)+(weakADX?1:0) >= 2)) or (legDir == -1 and ((loseMidDn?1:0)+(momFlipDn?1:0)+(weakADX?1:0) >= 2))) if barstate.isconfirmed and legActive failStreak := failNow ? failStreak + 1 : 0 int cautionScore = 0 cautionScore += (legActive and (legAge >= 2) and (decelCnt >= 2)) ? 1 : 0 cautionScore += (math.abs(distFromMidATR) >= DIST_MID_EXTREME) ? 1 : 0 cautionScore += ((close >= kU) or (close <= kL)) ? 1 : 0 cautionScore += ((bearDiv or bullDiv) ? 2 : 0) cautionScore += ((legDir == 1 and rsiSig > RSI_CAUTION_OB) or (legDir == -1 and rsiSig < RSI_CAUTION_OS)) ? 1 : 0 int dangerScore = 0 dangerScore += ((failStreak >= 2) ? 2 : 0) dangerScore += (wickExhaust ? 2 : 0) dangerScore += ((legActive and ((legDir == 1 and emaCrossDown) or (legDir == -1 and emaCrossUp))) ? 3 : 0) highWin = ta.highest(high, 5) lowWin = ta.lowest(low, 5) dangerScore += ((close < lowWin[1]) or (close > highWin[1])) ? 1 : 0 dangerScore += ((legDir == 1 and rsiSig > 75) or (legDir == -1 and rsiSig < 25)) ? 1 : 0 simpleGate = sp_show_warn and (legActive and legAge >= 1) var int lastCautionIdx = -1 var int lastDangerIdx = -1 var int lastCautionLeg = -1 var int lastDangerLeg = -1 mayCaution = ((lastCautionIdx < 0) or (bar_index - lastCautionIdx >= xCooldown)) and (lastCautionLeg != legId) mayDanger = ((lastDangerIdx < 0) or (bar_index - lastDangerIdx >= xCooldown)) and (lastDangerLeg != legId) caution_evt = barstate.isconfirmed and simpleGate and (cautionScore >= 3) and mayCaution danger_evt = barstate.isconfirmed and simpleGate and (dangerScore >= 4) and mayDanger var bool doDanger_conf = false var bool doCaution_conf = false if barstate.isconfirmed doDanger_conf := danger_evt doCaution_conf := caution_evt and not danger_evt // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.6 SUPERTREND CONSENSUS (2/3/4 ATR voting) │ // └─────────────────────────────────────────────────────────────────────────────┘ stLen = 10 atrST = ta.atr(stLen) hl2v = (high + low) / 2.0 basicU2 = hl2v + 2.0 * atrST basicL2 = hl2v - 2.0 * atrST var float fu2 = na var float fl2 = na var int dir2 = 1 if barstate.isconfirmed fu2_prev = nz(fu2, basicU2) fl2_prev = nz(fl2, basicL2) d2_prev = nz(dir2[1], 1) d2_cur = d2_prev if d2_prev == 1 and close < fl2_prev d2_cur := -1 else if d2_prev == -1 and close > fu2_prev d2_cur := 1 fu2 := (basicU2 < fu2_prev or close[1] > fu2_prev) ? basicU2 : fu2_prev fl2 := (basicL2 > fl2_prev or close[1] < fl2_prev) ? basicL2 : fl2_prev dir2 := d2_cur basicU3 = hl2v + 3.0 * atrST basicL3 = hl2v - 3.0 * atrST var float fu3 = na var float fl3 = na var int dir3 = 1 if barstate.isconfirmed fu3_prev = nz(fu3, basicU3) fl3_prev = nz(fl3, basicL3) d3_prev = nz(dir3[1], 1) d3_cur = d3_prev if d3_prev == 1 and close < fl3_prev d3_cur := -1 else if d3_prev == -1 and close > fu3_prev d3_cur := 1 fu3 := (basicU3 < fu3_prev or close[1] > fu3_prev) ? basicU3 : fu3_prev fl3 := (basicL3 > fl3_prev or close[1] < fl3_prev) ? basicL3 : fl3_prev dir3 := d3_cur basicU4 = hl2v + 4.0 * atrST basicL4 = hl2v - 4.0 * atrST var float fu4 = na var float fl4 = na var int dir4 = 1 if barstate.isconfirmed fu4_prev = nz(fu4, basicU4) fl4_prev = nz(fl4, basicL4) d4_prev = nz(dir4[1], 1) d4_cur = d4_prev if d4_prev == 1 and close < fl4_prev d4_cur := -1 else if d4_prev == -1 and close > fu4_prev d4_cur := 1 fu4 := (basicU4 < fu4_prev or close[1] > fu4_prev) ? basicU4 : fu4_prev fl4 := (basicL4 > fl4_prev or close[1] < fl4_prev) ? basicL4 : fl4_prev dir4 := d4_cur upCount = (dir2 == 1 ? 1 : 0) + (dir3 == 1 ? 1 : 0) + (dir4 == 1 ? 1 : 0) ST_DIR_NOW = upCount >= 2 ? 1 : -1 haveAllL = not na(fl2) and not na(fl3) and not na(fl4) haveAllU = not na(fu2) and not na(fu3) and not na(fu4) lowerMed = haveAllL ? median3(fl2, fl3, fl4) : basicL3 upperMed = haveAllU ? median3(fu2, fu3, fu4) : basicU3 var int ST_DIR = 1 var float ST_BAND = na if barstate.isconfirmed ST_DIR := ST_DIR_NOW ST_BAND := ST_DIR_NOW == 1 ? lowerMed : upperMed st2Band = dir2 == 1 ? fl2 : fu2 st3Band = dir3 == 1 ? fl3 : fu3 st4Band = dir4 == 1 ? fl4 : fu4 stColor = ST_DIR == 1 ? upST : dnST // Detect SuperTrend flip for visual marker (local chart TF only) stFlipUp_visual = barstate.isconfirmed and ST_DIR == 1 and ST_DIR[1] == -1 stFlipDn_visual = barstate.isconfirmed and ST_DIR == -1 and ST_DIR[1] == 1 // SuperTrend flip markers (● dot on flip bar) if sp_show_st and stFlipUp_visual label.new(bar_index, ST_BAND, "●", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=color.new(color.black, 100), textcolor=sp_col_trend_bull, size=size.tiny, textalign=text.align_center) if sp_show_st and stFlipDn_visual label.new(bar_index, ST_BAND, "●", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=color.new(color.black, 100), textcolor=sp_col_trend_bear, size=size.tiny, textalign=text.align_center) // SuperTrend - Smart plot management (consensus OR all, not both) plot(sp_show_st and sp_st_mode_consensus ? ST_BAND : na, title="SuperTrend Consensus", color=stColor, linewidth=2) plot(sp_show_st and sp_st_mode_all ? st2Band : na, title="SuperTrend x2", color=dir2==1?upST:dnST, linewidth=2) plot(sp_show_st and sp_st_mode_all ? st3Band : na, title="SuperTrend x3", color=dir3==1?upST:dnST, linewidth=2) plot(sp_show_st and sp_st_mode_all ? st4Band : na, title="SuperTrend x4", color=dir4==1?upST:dnST, linewidth=2) // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.7 BMSB - Bull Market Support Band │ // └─────────────────────────────────────────────────────────────────────────────┘ bSMA = sp_use_bmsb_tf ? request.security(syminfo.tickerid, sp_bmsb_tf, ta.sma(close, 20), barmerge.gaps_off, barmerge.lookahead_off) : sma20 bEMA = sp_use_bmsb_tf ? request.security(syminfo.tickerid, sp_bmsb_tf, ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off) : ema21 bmsbUpper = math.max(bSMA, bEMA) bmsbLower = math.min(bSMA, bEMA) bmsbMid = (bSMA + bEMA) / 2.0 // BMSB Cross Detection (crossover/crossunder must be global, not in conditional) priceAboveBMSB = close > bmsbUpper priceBelowBMSB = close < bmsbLower bmsb_cross_up_raw = ta.crossover(close, bmsbUpper) bmsb_cross_dn_raw = ta.crossunder(close, bmsbLower) bmsb_cross_up = barstate.isconfirmed and bmsb_cross_up_raw bmsb_cross_dn = barstate.isconfirmed and bmsb_cross_dn_raw pBsma = plot(sp_show_bmsb ? bSMA : na, title="BMSB 20-SMA", color=sp_col_neutral_trend, linewidth=2) pBema = plot(sp_show_bmsb ? bEMA : na, title="BMSB 21-EMA", color=sp_col_neutral_trend, linewidth=2) fill(pBsma, pBema, color=color.new(sp_col_neutral, sp_bmsb_fill_tr), title="BMSB Zone") // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.8 LABEL ANCHORS (positioning calculations) │ // └─────────────────────────────────────────────────────────────────────────────┘ var float atrSnap = na var float lowSnap = na var float highSnap = na var float padTD = na var float padX = na var float padArrow = na var float yBuySnap = na var float ySellSnap = na var float yXSnap = na var float yUpSnap = na var float yDnSnap = na if barstate.isconfirmed atrSnap := atrK lowSnap := low highSnap := high padTD := atrSnap * 0.70 padX := atrSnap * 0.50 padArrow := atrSnap * 0.40 yBuySnap := lowSnap - padTD ySellSnap := highSnap + padTD yXSnap := highSnap + padX yUpSnap := lowSnap - padArrow yDnSnap := highSnap + padArrow // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.9 LIQUIDITY SWEEPS (Pivot-Based) │ // │ │ // │ Real liquidity pools at swing highs/lows where stops cluster. │ // │ Uses ta.pivothigh/pivotlow to find actual structure levels. │ // │ Only fires when price sweeps a REAL swing point and rejects. │ // └─────────────────────────────────────────────────────────────────────────────┘ // Arrays to track pivot levels (price and bar index) var float[] swpPivotHighs = array.new_float(0) var int[] swpPivotHighBars = array.new_int(0) var float[] swpPivotLows = array.new_float(0) var int[] swpPivotLowBars = array.new_int(0) // Detect new pivots (returns value at bar_index - SWEEP_PIVOT_RIGHT) float newPivotHigh = ta.pivothigh(high, SWEEP_PIVOT_LEFT, SWEEP_PIVOT_RIGHT) float newPivotLow = ta.pivotlow(low, SWEEP_PIVOT_LEFT, SWEEP_PIVOT_RIGHT) // Significance check: pivot must stand out from surrounding price action // A real swing high should be clearly above nearby lows, not just a minor bump int pivotBar = bar_index - SWEEP_PIVOT_RIGHT float surroundLowAvg = ta.lowest(low, SWEEP_PIVOT_LEFT + SWEEP_PIVOT_RIGHT + 1)[SWEEP_PIVOT_RIGHT] float surroundHighAvg = ta.highest(high, SWEEP_PIVOT_LEFT + SWEEP_PIVOT_RIGHT + 1)[SWEEP_PIVOT_RIGHT] bool pivotHighSignificant = not na(newPivotHigh) and (newPivotHigh - surroundLowAvg) >= (atr14 * SWEEP_SIGNIF_ATR) bool pivotLowSignificant = not na(newPivotLow) and (surroundHighAvg - newPivotLow) >= (atr14 * SWEEP_SIGNIF_ATR) // Spacing check: don't store if too close to existing pivot (prevents clustering) f_tooCloseToExisting(float[] _arr, float _newVal, float _minDist) => bool tooClose = false if array.size(_arr) > 0 for i = 0 to array.size(_arr) - 1 if math.abs(array.get(_arr, i) - _newVal) < _minDist tooClose := true break tooClose float spacingDist = atr14 * SWEEP_SPACING_ATR // Store new pivot highs (only if significant AND not too close to existing) if pivotHighSignificant and barstate.isconfirmed if not f_tooCloseToExisting(swpPivotHighs, newPivotHigh, spacingDist) array.unshift(swpPivotHighs, newPivotHigh) array.unshift(swpPivotHighBars, bar_index - SWEEP_PIVOT_RIGHT) // Trim to max size if array.size(swpPivotHighs) > SWEEP_MAX_PIVOTS array.pop(swpPivotHighs) array.pop(swpPivotHighBars) // Store new pivot lows (only if significant AND not too close to existing) if pivotLowSignificant and barstate.isconfirmed if not f_tooCloseToExisting(swpPivotLows, newPivotLow, spacingDist) array.unshift(swpPivotLows, newPivotLow) array.unshift(swpPivotLowBars, bar_index - SWEEP_PIVOT_RIGHT) if array.size(swpPivotLows) > SWEEP_MAX_PIVOTS array.pop(swpPivotLows) array.pop(swpPivotLowBars) // Sweep detection variables var bool sweepUp_evt = false var bool sweepDn_evt = false var float sweepUpLevel = na var float sweepDnLevel = na // Reset each bar if barstate.isconfirmed sweepUp_evt := false sweepDn_evt := false sweepUpLevel := na sweepDnLevel := na // Check for bullish sweep (price dips below pivot low, closes back above) if barstate.isconfirmed and sp_show_sweeps and array.size(swpPivotLows) > 0 float _lowerWick = math.min(open[1], close[1]) - low[1] float _range = math.max(high[1] - low[1], 1e-9) bool _hasRejectionWick = _lowerWick / _range >= SWEEP_WICK_FRAC
// NEW: Close must be in upper portion of candle (shows buying strength) float _closePosition = (close[1] - low[1]) / _range bool _strongClose = _closePosition >= (1.0 - SWEEP_CLOSE_FRAC)  // Upper 35%  if _hasRejectionWick and _strongClose     int _idx = -1     for i = 0 to array.size(swpPivotLows) - 1         float _lvl = array.get(swpPivotLows, i)         int _lvlBar = array.get(swpPivotLowBars, i)         int _age = bar_index - _lvlBar                  // Sweep conditions:         // 1. Level is old enough (stops have accumulated)         // 2. Bar[1] low went below level (by at least sweep depth)         // 3. Bar[1] closed convincingly above level (not just barely)         // 4. Close in upper portion of candle (buying strength)         if _age >= SWEEP_MIN_AGE             bool _brokeLevel = low[1] < _lvl - (atr14 * SWEEP_DEPTH_ATR)             bool _closedAbove = close[1] > _lvl + (atr14 * SWEEP_CLOSE_ATR)                          if _brokeLevel and _closedAbove                 sweepUp_evt := true                 sweepUpLevel := _lvl                 _idx := i                 break          // Remove swept level so it doesn't fire again     if _idx >= 0         array.remove(swpPivotLows, _idx)         array.remove(swpPivotLowBars, _idx) 
// Check for bearish sweep (price spikes above pivot high, closes back below) if barstate.isconfirmed and sp_show_sweeps and array.size(swpPivotHighs) > 0 float _upperWick = high[1] - math.max(open[1], close[1]) float _range = math.max(high[1] - low[1], 1e-9) bool _hasRejectionWick = _upperWick / _range >= SWEEP_WICK_FRAC
// NEW: Close must be in lower portion of candle (shows selling strength) float _closePosition = (close[1] - low[1]) / _range bool _strongClose = _closePosition <= SWEEP_CLOSE_FRAC  // Lower 35%  if _hasRejectionWick and _strongClose     int _idx = -1     for i = 0 to array.size(swpPivotHighs) - 1         float _lvl = array.get(swpPivotHighs, i)         int _lvlBar = array.get(swpPivotHighBars, i)         int _age = bar_index - _lvlBar                  // Sweep conditions:         // 1. Level is old enough (stops have accumulated)         // 2. Bar[1] high went above level (by at least sweep depth)         // 3. Bar[1] closed convincingly below level (not just barely)         // 4. Close in lower portion of candle (selling strength)         if _age >= SWEEP_MIN_AGE             bool _brokeLevel = high[1] > _lvl + (atr14 * SWEEP_DEPTH_ATR)             bool _closedBelow = close[1] < _lvl - (atr14 * SWEEP_CLOSE_ATR)                          if _brokeLevel and _closedBelow                 sweepDn_evt := true                 sweepDnLevel := _lvl                 _idx := i                 break          if _idx >= 0         array.remove(swpPivotHighs, _idx)         array.remove(swpPivotHighBars, _idx) 
// Confirmed state for confluence var bool sweepUp_conf = false var bool sweepDn_conf = false if barstate.isconfirmed sweepUp_conf := sweepUp_evt sweepDn_conf := sweepDn_evt // Labels - positioned at the swept level float sweepOffset = atr14 * 0.15 if sweepUp_evt label.new(bar_index[1], low[1] - sweepOffset * 2.5, "💧", style=label.style_none, textcolor=sp_col_exhaust_bull_solid, size=size.small) if sweepDn_evt label.new(bar_index[1], high[1] + sweepOffset, "🩸", style=label.style_none, textcolor=sp_col_exhaust_bear_solid, size=size.small) // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.10 EMA STACK (50/100/200) + Golden/Death Cross │ // └─────────────────────────────────────────────────────────────────────────────┘ LEN50 = 50 LEN100 = 100 LEN200 = 200 ema50_raw = ta.ema(close, LEN50) ema100_raw = ta.ema(close, LEN100) ema200_raw = ta.ema(close, LEN200) ema50 = nz(ema50_raw, nz(ema50_raw[1], close)) ema100 = nz(ema100_raw, nz(ema100_raw[1], close)) ema200 = nz(ema200_raw, nz(ema200_raw[1], close)) atrE = ta.atr(ATR_LEN) // EMA100 plot (no events) plot(sp_show_ema100 ? ema100 : na, title="EMA 100", color=color.new(sp_col_neutral, 60), linewidth=1) bullReg = ema50 > ema100 and ema100 > ema200 bearReg = ema50 < ema100 and ema100 < ema200 x_close_50_up = ta.crossover(close, ema50) x_close_50_dn = ta.crossunder(close, ema50) x_close_200_up = ta.crossover(close, ema200) x_close_200_dn = ta.crossunder(close, ema200) x_50_200_up = ta.crossover(ema50, ema200) x_50_200_dn = ta.crossunder(ema50, ema200) pbLong_raw = bullReg and x_close_50_up and (STRICT_PB ? close > ema100 : true) pbShort_raw = bearReg and x_close_50_dn and (STRICT_PB ? close < ema100 : true) reclaim_raw = x_close_200_up reject_raw = x_close_200_dn golden_raw = x_50_200_up death_raw = x_50_200_dn var int last_pbL = -1 var int last_pbS = -1 var int last_rc = -1 var int last_rj = -1 var int lastGC = -1 var int lastDC = -1 var bool pb1GC_done = true var bool pb1DC_done = true var bool pbLong = false var bool pbShort = false var bool reclaim = false var bool reject = false var bool pb1_after_GC = false var bool pb1_after_DC = false if barstate.isconfirmed pbLong := false pbShort := false reclaim := false reject := false pb1_after_GC := false pb1_after_DC := false if pbLong_raw and cooldownOk(last_pbL, COOLDOWN) pbLong := true last_pbL := bar_index if pbShort_raw and cooldownOk(last_pbS, COOLDOWN) pbShort := true last_pbS := bar_index if reclaim_raw and cooldownOk(last_rc, COOLDOWN) reclaim := true last_rc := bar_index if reject_raw and cooldownOk(last_rj, COOLDOWN) reject := true last_rj := bar_index if golden_raw lastGC := bar_index pb1GC_done := false if death_raw lastDC := bar_index pb1DC_done := false if pbLong and (lastGC >= 0) and not pb1GC_done and (bar_index - lastGC <= PB1_WINDOW) pb1_after_GC := true pb1GC_done := true if pbShort and (lastDC >= 0) and not pb1DC_done and (bar_index - lastDC <= PB1_WINDOW) pb1_after_DC := true pb1DC_done := true golden_evt = barstate.isconfirmed and golden_raw death_evt = barstate.isconfirmed and death_raw pbLong_vis = pbLong and not reclaim and not pb1_after_GC and not (golden_evt or death_evt) pbShort_vis = pbShort and not reject and not pb1_after_DC and not (golden_evt or death_evt) reclaim_vis = reclaim and not (golden_evt or death_evt) reject_vis = reject and not (golden_evt or death_evt) // EMA50 - Simple neutral color (events shown via labels, not line color changes) plot(sp_show_ema50 ? ema50 : na, title="EMA 50", color=color.new(sp_col_neutral, 55), linewidth=1) // EMA200 - Simple neutral color (events shown via labels, not line color changes) plot(sp_show_ema200 ? ema200 : na, title="EMA 200", color=color.new(sp_col_neutral, 45), linewidth=2) // EMA events now integrated into base EMA plots above (color/width changes on events) gcY = crossPrice(ema50[1], ema50, ema200[1], ema200) rcY = crossPrice(close[1], close, ema200[1], ema200) if barstate.isconfirmed and sp_show_ema_events if golden_evt label.new(bar_index, gcY, "GC", xloc=xloc.bar_index, yloc=yloc.price, color=sp_col_bull, textcolor=color.white, style=label.style_label_up, size=size.small) if death_evt label.new(bar_index, gcY, "DC", xloc=xloc.bar_index, yloc=yloc.price, color=sp_col_bear, textcolor=color.white, style=label.style_label_down, size=size.small) // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.11 REGIME DETECTION (background shading) │ // └─────────────────────────────────────────────────────────────────────────────┘ emaF_RB = ta.ema(close, EMA_FAST_RB) emaS_RB = ta.ema(close, EMA_SLOW_RB) pl_RB = ta.ema(close, PL_LEN_RB) atrKC_RB = atr20 // Reuse cached value kcBase_RB = ta.ema(hlc3, 20) kcU_RB = kcBase_RB + 1.5 * atrKC_RB kcL_RB = kcBase_RB - 1.5 * atrKC_RB tr1_RB = high - low tr2_RB = math.abs(high - close[1]) tr3_RB = math.abs(low - close[1]) tr_RB = math.max(math.max(tr1_RB, tr2_RB), tr3_RB) trR_RB = ta.rma(tr_RB, ADX_LEN_RB) upMove_RB = high - high[1] downMove_RB = low[1] - low plusDM_RB = (upMove_RB > downMove_RB and upMove_RB > 0) ? upMove_RB : 0.0 minusDM_RB = (downMove_RB > upMove_RB and downMove_RB > 0) ? downMove_RB : 0.0 plusDM_R_RB = ta.rma(plusDM_RB, ADX_LEN_RB) minusDM_R_RB = ta.rma(minusDM_RB, ADX_LEN_RB) diPlusL_RB = trR_RB != 0 ? 100.0 * (plusDM_R_RB / trR_RB) : 0.0 diMinusL_RB = trR_RB != 0 ? 100.0 * (minusDM_R_RB / trR_RB) : 0.0 adxL_RB = ta.rma((diPlusL_RB + diMinusL_RB != 0 ? 100.0 * math.abs(diPlusL_RB - diMinusL_RB) / (diPlusL_RB + diMinusL_RB) : 0.0), ADX_LEN_RB) hyst_RB = atrKC_RB * HYST_ATR_MULT slopeRaw_RB = pl_RB - pl_RB[1] slopeMA_RB = ta.ema(slopeRaw_RB, 5) slopeUp_RB = (slopeMA_RB > atrKC_RB * SLOPE_ATR_DEAD) and (slopeMA_RB > slopeMA_RB[1]) slopeDn_RB = (slopeMA_RB < -atrKC_RB * SLOPE_ATR_DEAD) and (slopeMA_RB < slopeMA_RB[1]) adxNorm_RB = math.min(1.0, math.max(0.0, (adxL_RB - 10.0) / 30.0)) diMarginGate_RB = 5.0 + (1.0 - adxNorm_RB) * 10.0 diDiff_RB = diPlusL_RB - diMinusL_RB vote1_bull_RB = emaF_RB > emaS_RB vote1_bear_RB = emaF_RB < emaS_RB vote2_bull_RB = close > pl_RB + hyst_RB vote2_bear_RB = close < pl_RB - hyst_RB vote3_bull_RB = slopeUp_RB vote3_bear_RB = slopeDn_RB vote4_bull_RB = diDiff_RB > diMarginGate_RB vote4_bear_RB = -diDiff_RB > diMarginGate_RB bullVotes_RB = (vote1_bull_RB?1:0) + (vote2_bull_RB?1:0) + (vote3_bull_RB?1:0) + (vote4_bull_RB?1:0) bearVotes_RB = (vote1_bear_RB?1:0) + (vote2_bear_RB?1:0) + (vote3_bear_RB?1:0) + (vote4_bear_RB?1:0) rawWant_RB = bullVotes_RB >= 3 ? 1 : bearVotes_RB >= 3 ? -1 : 0 clearUp_RB = (close - pl_RB) > (atrKC_RB * CLEAR_ATR_MULT_RB) clearDn_RB = (pl_RB - close) > (atrKC_RB * CLEAR_ATR_MULT_RB) hhCheck_RB = high > ta.highest(high[1], TREND_BARS_RB) llCheck_RB = low < ta.lowest(low[1], TREND_BARS_RB) rawWantCleared_RB = rawWant_RB == 1 and clearUp_RB and hhCheck_RB ? 1 : rawWant_RB == -1 and clearDn_RB and llCheck_RB ? -1 : 0 var int regime_RB = 0 var int regimeAge_RB = 0 var int wantDir_RB = 0 var int wantStreak_RB = 0 var int prevRegime_RB = 0 if barstate.isconfirmed prevRegime_RB := regime_RB regimeAge_RB += 1
if rawWantCleared_RB == 0     wantDir_RB := 0     wantStreak_RB := 0 else     if wantDir_RB == rawWantCleared_RB         wantStreak_RB += 1     else         wantDir_RB := rawWantCleared_RB         wantStreak_RB := 1  readyToFlip_RB = (wantDir_RB != 0) and                   (wantDir_RB != regime_RB) and                   (regimeAge_RB >= MIN_HOLD_BARS) and                   (wantStreak_RB >= CONFIRM_BARS) and                   (adxL_RB >= MIN_ADX)  if readyToFlip_RB     regime_RB := wantDir_RB     regimeAge_RB := 0 
if regime_RB == 0 regime_RB := emaF_RB > emaS_RB ? 1 : -1 // Regime flip detection regime_flip_bull = barstate.isconfirmed and (prevRegime_RB == -1 and regime_RB == 1) regime_flip_bear = barstate.isconfirmed and (prevRegime_RB == 1 and regime_RB == -1) trendUpA_RB = regime_RB == 1 trendDownA_RB = regime_RB == -1 regimeColor = regime_RB == 1 ? color.new(sp_col_trend_bull, sp_regime_trans) : color.new(sp_col_trend_bear, sp_regime_trans) bgcolor(sp_show_regime ? regimeColor : na, title="Regime Background") // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.12 SUPPLY/DEMAND ZONES │ // └─────────────────────────────────────────────────────────────────────────────┘ color supBase = sp_col_supply color demBase = sp_col_demand if sp_sdz_theme == "Neon Pulse" supBase := color.rgb(255, 51, 153) demBase := color.rgb(0, 255, 204) else if sp_sdz_theme == "Monochrome Pro" supBase := color.rgb(220, 70, 70) demBase := color.rgb(80, 200, 120) else if sp_sdz_theme == "Ocean Glass" supBase := color.rgb(0, 180, 255) demBase := color.rgb(0, 200, 170) supFillBase = sp_sdz_outline_only ? color.new(supBase, 100) : color.new(supBase, 88) demFillBase = sp_sdz_outline_only ? color.new(demBase, 100) : color.new(demBase, 88) supBrdrBase = color.new(supBase, 60) demBrdrBase = color.new(demBase, 60) atr_sdz = ta.atr(sp_sdz_atr_len) pad_sdz = sp_sdz_use_atr ? atr_sdz * sp_sdz_atr_mult : 0.0 minH_sdz = sp_sdz_use_atr ? atr_sdz * sp_sdz_min_h_mult : 0.0 mergeGap_sdz = sp_sdz_use_atr ? atr_sdz * sp_sdz_merge_gap : syminfo.mintick * 5.0 exclGap_sdz = sp_sdz_use_atr ? atr_sdz * sp_sdz_excl_gap : syminfo.mintick * 3.0 var box[] supBox = array.new_box() var float[] supTop = array.new_float() var float[] supBot = array.new_float() var int[] supLBar = array.new_int() var bool[] supBroken = array.new_bool() var bool[] supWasIn = array.new_bool() var bool[] supTouched = array.new_bool() var int[] supTouchCt = array.new_int() var box[] demBox = array.new_box() var float[] demTop = array.new_float() var float[] demBot = array.new_float() var int[] demLBar = array.new_int() var bool[] demBroken = array.new_bool() var bool[] demWasIn = array.new_bool() var bool[] demTouched = array.new_bool() var int[] demTouchCt = array.new_int() var line[] supHLines = array.new_line() var line[] demHLines = array.new_line() var label[] supTags = array.new_label() var label[] demTags = array.new_label() var label supQL = na var label demQL = na var array<label> supBadges = array.new_label() var array<label> demBadges = array.new_label() //@function Calculate height with minimum threshold //@param t Top value //@param b Bottom value //@returns Height (minimum 1e-10) f_h(float t, float b) => float result = math.max(t - b, 1e-10) result //@function Calculate overlap fraction between two zones //@param t1 Zone 1 top //@param b1 Zone 1 bottom //@param t2 Zone 2 top //@param b2 Zone 2 bottom //@returns Overlap as fraction of smaller zone f_overlap_frac(float t1, float b1, float t2, float b2) => float inter = math.max(0.0, math.min(t1, t2) - math.max(b1, b2)) float result = inter / math.min(f_h(t1, b1), f_h(t2, b2)) result //@function Calculate gap between two zones //@param t1 Zone 1 top //@param b1 Zone 1 bottom //@param t2 Zone 2 top //@param b2 Zone 2 bottom //@returns Gap distance (0 if overlapping) f_gap(float t1, float b1, float t2, float b2) => float result = math.max(0.0, math.max(b1, b2) - math.min(t1, t2)) result //@function Clear all lines in array //@param _arr Array of line objects f_clear_lines(line[] _arr) => int n = array.size(_arr) if n > 0 for k = 0 to n - 1 line ln = array.get(_arr, k) if not na(ln) line.delete(ln) array.clear(_arr) //@function Clear all labels in array //@param _arr Array of label objects f_clear_labels(label[] _arr) => int n = array.size(_arr) if n > 0 for k = 0 to n - 1 label lb = array.get(_arr, k) if not na(lb) label.delete(lb) array.clear(_arr) //@function Trim zone arrays to limit f_trim_side(box[] _box, float[] _top, float[] _bot, int[] _lbar, bool[] _broken, bool[] _wasin, bool[] _touched, int[] _tcount, int _limit) => while array.size(_box) > _limit b = array.shift(_box) if not na(b) box.delete(b) array.shift(_top) array.shift(_bot) array.shift(_lbar) array.shift(_broken) array.shift(_wasin) array.shift(_touched) array.shift(_tcount) //@function Add new zone or merge with existing f_add_or_merge(box[] _box, float[] _top, float[] _bot, int[] _lbar, bool[] _broken, bool[] _wasin, bool[] _touched, int[] _tcount, float tNew, float bNew, int lbNew, color fillCol, color brdrCol) => if (tNew - bNew) >= minH_sdz bool didMerge = false if sp_sdz_merge_on n = array.size(_box) if n > 0 best = -1 bestScore = -1.0 for i = 0 to n - 1 isBr = i < array.size(_broken) ? array.get(_broken, i) : false if not (sp_sdz_hide_broken and isBr) tOld = array.get(_top, i) bOld = array.get(_bot, i) ov = f_overlap_frac(tOld, bOld, tNew, bNew) gp = f_gap(tOld, bOld, tNew, bNew) ok = (ov >= sp_sdz_merge_overlap) or (gp <= mergeGap_sdz) if ok scr = ov > 0 ? ov : (1.0 - math.min(gp / math.max(mergeGap_sdz, 1e-10), 1.0)) if scr > bestScore bestScore := scr best := i if best != -1 tOld = array.get(_top, best) bOld = array.get(_bot, best) tM = math.max(tOld, tNew) bM = math.min(bOld, bNew) lbOld = array.get(_lbar, best) lbM = math.min(lbOld, lbNew) array.set(_top, best, tM) array.set(_bot, best, bM) array.set(_lbar, best, lbM) bx = array.get(_box, best) box.set_lefttop(bx, lbM, tM) box.set_rightbottom(bx, bar_index - 1, bM) box.set_bgcolor(bx, fillCol) box.set_border_color(bx, brdrCol) didMerge := true if not didMerge bx = box.new(left=lbNew, right=bar_index - 1, top=tNew, bottom=bNew, xloc=xloc.bar_index, bgcolor=fillCol, border_color=brdrCol) array.push(_box, bx) array.push(_top, tNew) array.push(_bot, bNew) array.push(_lbar, lbNew) array.push(_broken, false) array.push(_wasin, false) array.push(_touched, false) array.push(_tcount, 0) //@function Pick N nearest zones to current price //@returns Boolean array marking selected zones f_pick_nearest(float[] _top, float[] _bot, int[] _lbar, bool[] _broken, int _keepN) => int n = array.size(_top) if n <= 0 array.new_bool(0) else bool[] take = array.new_bool(n, false) float[] dist = array.new_float(n, 1e10) for i = 0 to n - 1 if i < array.size(_bot) and i < array.size(_lbar) and i < array.size(_broken) float t = array.get(_top, i) float bt = array.get(_bot, i) int lb = array.get(_lbar, i) bool br = array.get(_broken, i) bool tooOld = bar_index - lb > sp_sdz_max_age if not (sp_sdz_hide_broken and br) and not tooOld bool inside = close <= t and close >= bt float d = inside ? 0.0 : math.min(math.abs(close - t), math.abs(close - bt)) array.set(dist, i, d) int k = math.min(_keepN, n) if k > 0 int picks = 0 while picks < k int best = -1 float bestD = 1e10 for i = 0 to n - 1 if not array.get(take, i) float di = array.get(dist, i) if di < bestD bestD := di best := i if best == -1 or bestD == 1e10 break array.set(take, best, true) picks += 1 take //@function Apply exclusivity rules between supply and demand zones //@returns Tuple of filtered boolean arrays [outSup, outDem] f_apply_exclusive(float[] _supTop, float[] _supBot, int[] _supLBar, bool[] _takeSup, float[] _demTop, float[] _demBot, int[] _demLBar, bool[] _takeDem) => int ns = array.size(_takeSup) int nd = array.size(_takeDem) bool[] outSup = array.new_bool(ns, false) bool[] outDem = array.new_bool(nd, false) if ns > 0 for i = 0 to ns - 1 array.set(outSup, i, array.get(_takeSup, i)) if nd > 0 for j = 0 to nd - 1 array.set(outDem, j, array.get(_takeDem, j)) if sp_sdz_excl_on and ns > 0 and nd > 0 for i = 0 to ns - 1 bool okSi = i < array.size(outSup) and i < array.size(_supTop) and i < array.size(_supBot) if okSi and array.get(outSup, i) float st = array.get(_supTop, i) float sb = array.get(_supBot, i) for j = 0 to nd - 1 bool okDj = j < array.size(outDem) and j < array.size(_demTop) and j < array.size(_demBot) if okDj and array.get(outDem, j) float dt = array.get(_demTop, j) float db = array.get(_demBot, j) float ov = f_overlap_frac(st, sb, dt, db) float gp = f_gap(st, sb, dt, db) bool clash = (ov >= sp_sdz_excl_overlap) or (gp <= exclGap_sdz) if clash bool keepSup = false bool keepDem = false if sp_sdz_excl_mode == "Most Recent" int sAge = i < array.size(_supLBar) ? array.get(_supLBar, i) : 0 int dAge = j < array.size(_demLBar) ? array.get(_demLBar, j) : 0 if sAge >= dAge keepSup := true else keepDem := true else if sp_sdz_excl_mode == "Nearest" float sDist = math.min(math.abs(close - st), math.abs(close - sb)) float dDist = math.min(math.abs(close - dt), math.abs(close - db)) if sDist <= dDist keepSup := true else keepDem := true else if sp_sdz_excl_mode == "Keep Supply" keepSup := true else keepDem := true if keepSup and not keepDem array.set(outDem, j, false) else if keepDem and not keepSup array.set(outSup, i, false) else float sDist2 = math.min(math.abs(close - st), math.abs(close - sb)) float dDist2 = math.min(math.abs(close - dt), math.abs(close - db)) if sDist2 <= dDist2 array.set(outDem, j, false) else array.set(outSup, i, false) [outSup, outDem] //@function Clamp value between 0 and 1 f_clamp01(float x) => float result = math.max(0.0, math.min(1.0, x)) result //@function Calculate nearness score (0-1, 1=exact match) f_near(float val, float ref, float scale) => float result = f_clamp01(1.0 - math.abs(val - ref) / math.max(scale, 1e-10)) result //@function Calculate zone quality score and grade //@param midY Zone midpoint //@param leftBar Zone start bar //@param touchCt Touch count //@returns Tuple [adjusted_score, grade_index] f_score_and_grade(float midY, int leftBar, int touchCt) => // Quality = confluence with institutional levels = likelihood to hold as S/R // Zone near VWAP + PDH/PDL + EMAs + round numbers = higher grade
vwapS = ta.vwap(close) emaFast_sdz = ta.ema(close, 20) emaSlow_sdz = ta.ema(close, 50) dHighS = request.security(syminfo.tickerid, "D", high, lookahead=barmerge.lookahead_off) dLowS  = request.security(syminfo.tickerid, "D", low,  lookahead=barmerge.lookahead_off) dHigh = dHighS[1] dLow  = dLowS[1] rnStep = math.max(syminfo.mintick, atr_sdz * 0.25) rn  = math.round(midY / rnStep) * rnStep  // Confluence scoring with WIDENED tolerances (1.5-2.0 ATR instead of 0.35-0.60) sVW = na(vwapS) ? 0.0 : f_near(midY, vwapS, atr_sdz * 2.0) sPD = math.max(f_near(midY, dHigh, atr_sdz * 2.0), f_near(midY, dLow, atr_sdz * 2.0)) sEM = math.max(f_near(midY, emaFast_sdz, atr_sdz * 1.5), f_near(midY, emaSlow_sdz, atr_sdz * 1.5)) sRN = f_near(midY, rn, atr_sdz * 1.5)  // Weighted score (same weights as original) wVW = 0.30, wPD = 0.30, wEM = 0.25, wRN = 0.15 score01 = (wVW*sVW + wPD*sPD + wEM*sEM + wRN*sRN) score10 = score01 * 10.0  // Penalties for degradation ageBars = bar_index - leftBar agePenalty   = math.min(ageBars / 400.0, 1.0) * 2.0 touchPenalty = math.min(touchCt * 0.7, 3.5)  float adj = math.max(score10 - agePenalty - touchPenalty, 0.0)  // LOWERED thresholds (was 7.5/5.0 - too strict) int gradeI = adj >= 5.0 ? 2 : adj >= 2.5 ? 1 : 0 [adj, gradeI] 
//@function Convert grade index to letter //@param gi Grade index (0-2) //@returns "A", "B", or "C" f_txt_grade(int gi) => string result = gi == 2 ? "A" : gi == 1 ? "B" : "C" result //@function Convert score to 0-10 string //@param si Score integer //@returns Score as string f_txt_0_10(int si) => string result = si >= 10 ? "10" : si >= 9 ? "9" : si >= 8 ? "8" : si >= 7 ? "7" : si >= 6 ? "6" : si >= 5 ? "5" : si >= 4 ? "4" : si >= 3 ? "3" : si >= 2 ? "2" : si >= 1 ? "1" : "0" result ph = ta.pivothigh(high, sp_sdz_left, sp_sdz_right) pl = ta.pivotlow(low, sp_sdz_left, sp_sdz_right) hiR = high[sp_sdz_right] bodyLoR = math.min(open[sp_sdz_right], close[sp_sdz_right]) topSupC = math.max(hiR, bodyLoR) + pad_sdz botSupC = math.min(hiR, bodyLoR) - pad_sdz loR = low[sp_sdz_right] bodyHiR = math.max(open[sp_sdz_right], close[sp_sdz_right]) topDemC = math.max(bodyHiR, loR) + pad_sdz botDemC = math.min(bodyHiR, loR) - pad_sdz if not na(ph) and sp_show_sdz lb = bar_index - sp_sdz_right f_add_or_merge(supBox, supTop, supBot, supLBar, supBroken, supWasIn, supTouched, supTouchCt, topSupC, botSupC, lb, supFillBase, supBrdrBase) f_trim_side(supBox, supTop, supBot, supLBar, supBroken, supWasIn, supTouched, supTouchCt, sp_sdz_store_limit) if not na(pl) and sp_show_sdz lb = bar_index - sp_sdz_right f_add_or_merge(demBox, demTop, demBot, demLBar, demBroken, demWasIn, demTouched, demTouchCt, topDemC, botDemC, lb, demFillBase, demBrdrBase) f_trim_side(demBox, demTop, demBot, demLBar, demBroken, demWasIn, demTouched, demTouchCt, sp_sdz_store_limit) supBreakThisBar = false demBreakThisBar = false supTouchThisBar = false demTouchThisBar = false ns = array.size(supBox) if ns > 0 for i = 0 to ns - 1 st = i < array.size(supTop) ? array.get(supTop, i) : na sb = i < array.size(supBot) ? array.get(supBot, i) : na if not na(st) and not na(sb) condBreak = sp_sdz_invalidate == "Close" ? close > st : high > st if condBreak and (i < array.size(supBroken) ? not array.get(supBroken, i) : true) array.set(supBroken, i, true) supBreakThisBar := true inside = high >= sb and low <= st wasIn = i < array.size(supWasIn) ? array.get(supWasIn, i) : false newT = inside and not wasIn if newT prevCt = i < array.size(supTouchCt) ? array.get(supTouchCt, i) : 0 array.set(supTouchCt, i, prevCt + 1) supTouchThisBar := true if sp_sdz_mark_touch and (i < array.size(supTouched) ? not array.get(supTouched, i) : true) label.new(bar_index, st, "SR", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, textcolor=color.white, color=color.new(supBase, 0), size=size.tiny) array.set(supTouched, i, true) if i < array.size(supWasIn) array.set(supWasIn, i, inside) nd = array.size(demBox) if nd > 0 for i = 0 to nd - 1 dt = i < array.size(demTop) ? array.get(demTop, i) : na db = i < array.size(demBot) ? array.get(demBot, i) : na if not na(dt) and not na(db) condBreak = sp_sdz_invalidate == "Close" ? close < db : low < db if condBreak and (i < array.size(demBroken) ? not array.get(demBroken, i) : true) array.set(demBroken, i, true) demBreakThisBar := true inside = high >= db and low <= dt wasIn = i < array.size(demWasIn) ? array.get(demWasIn, i) : false newT = inside and not wasIn if newT prevCt = i < array.size(demTouchCt) ? array.get(demTouchCt, i) : 0 array.set(demTouchCt, i, prevCt + 1) demTouchThisBar := true if sp_sdz_mark_touch and (i < array.size(demTouched) ? not array.get(demTouched, i) : true) label.new(bar_index, db, "DR", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, textcolor=color.white, color=color.new(demBase, 0), size=size.tiny) array.set(demTouched, i, true) if i < array.size(demWasIn) array.set(demWasIn, i, inside) takeSup0 = f_pick_nearest(supTop, supBot, supLBar, supBroken, sp_sdz_nearest_per_side) takeDem0 = f_pick_nearest(demTop, demBot, demLBar, demBroken, sp_sdz_nearest_per_side) [takeSup, takeDem] = f_apply_exclusive(supTop, supBot, supLBar, takeSup0, demTop, demBot, demLBar, takeDem0) activeSup = -1 activeDem = -1 bestSD = 1e10 if ns > 0 for i = 0 to ns - 1 ks = i < array.size(takeSup) ? array.get(takeSup, i) : false if ks and i < array.size(supTop) and i < array.size(supBot) st = array.get(supTop, i) sb = array.get(supBot, i) inside = close <= st and close >= sb d = inside ? 0.0 : math.min(math.abs(close - st), math.abs(close - sb)) if d < bestSD bestSD := d activeSup := i bestDD = 1e10 if nd > 0 for i = 0 to nd - 1 kd = i < array.size(takeDem) ? array.get(takeDem, i) : false if kd and i < array.size(demTop) and i < array.size(demBot) dt = array.get(demTop, i) db = array.get(demBot, i) inside = close <= dt and close >= db d = inside ? 0.0 : math.min(math.abs(close - dt), math.abs(close - db)) if d < bestDD bestDD := d activeDem := i // Check if price is AT supply/demand zone atSupplyZone = false atDemandZone = false if activeSup >= 0 and activeSup < array.size(supTop) and activeSup < array.size(supBot) st = array.get(supTop, activeSup) sb = array.get(supBot, activeSup) atSupplyZone := high >= sb and low <= st if activeDem >= 0 and activeDem < array.size(demTop) and activeDem < array.size(demBot) dt = array.get(demTop, activeDem) db = array.get(demBot, activeDem) atDemandZone := high >= db and low <= dt collapseBoxToPrice(_b, _base) => box.set_lefttop(_b, bar_index, close) box.set_rightbottom(_b, bar_index, close) box.set_bgcolor(_b, color.new(_base, 100)) box.set_border_color(_b, color.new(_base, 100)) if ns > 0 for i = 0 to ns - 1 b = array.get(supBox, i) st = i < array.size(supTop) ? array.get(supTop, i) : na sb = i < array.size(supBot) ? array.get(supBot, i) : na lb = i < array.size(supLBar) ? array.get(supLBar, i) : 0 keep = i < array.size(takeSup) ? array.get(takeSup, i) : false isBr = i < array.size(supBroken) ? array.get(supBroken, i) : false if not na(st) and not na(sb) if isBr and sp_sdz_hide_broken keep := false if keep baseAlpha = sp_sdz_outline_only ? 100.0 : 88.0 fillCol = color.new(supBase, int(baseAlpha)) brdrCol = supBrdrBase if sp_sdz_fade_others and sp_sdz_show_hl and (i != activeSup) fillCol := color.new(supBase, 96) brdrCol := color.new(supBase, 86) if isBr and not sp_sdz_hide_broken fillCol := color.new(color.gray, 100) brdrCol := color.new(color.gray, 85) box.set_lefttop(b, lb, st) box.set_rightbottom(b, bar_index - 1, sb) box.set_bgcolor(b, fillCol) box.set_border_color(b, brdrCol) else collapseBoxToPrice(b, supBase) if nd > 0 for j = 0 to nd - 1 b = array.get(demBox, j) dt = j < array.size(demTop) ? array.get(demTop, j) : na db = j < array.size(demBot) ? array.get(demBot, j) : na lb = j < array.size(demLBar) ? array.get(demLBar, j) : 0 keep = j < array.size(takeDem) ? array.get(takeDem, j) : false isBr = j < array.size(demBroken) ? array.get(demBroken, j) : false if not na(dt) and not na(db) if isBr and sp_sdz_hide_broken keep := false if keep baseAlpha = sp_sdz_outline_only ? 100.0 : 88.0 fillCol = color.new(demBase, int(baseAlpha)) brdrCol = demBrdrBase if sp_sdz_fade_others and sp_sdz_show_hl and (j != activeDem) fillCol := color.new(demBase, 96) brdrCol := color.new(demBase, 86) if isBr and not sp_sdz_hide_broken fillCol := color.new(color.gray, 100) brdrCol := color.new(color.gray, 85) box.set_lefttop(b, lb, dt) box.set_rightbottom(b, bar_index - 1, db) box.set_bgcolor(b, fillCol) box.set_border_color(b, brdrCol) else collapseBoxToPrice(b, demBase) f_clear_lines(supHLines) f_clear_lines(demHLines) f_clear_labels(supTags) f_clear_labels(demTags) f_clear_labels(supBadges) f_clear_labels(demBadges) if not na(supQL) label.delete(supQL) supQL := na if not na(demQL) label.delete(demQL) demQL := na // Draw quality badges on ALL zones if sp_sdz_show_badge // Supply zone badges if ns > 0 for i = 0 to ns - 1 st = i < array.size(supTop) ? array.get(supTop, i) : na sb = i < array.size(supBot) ? array.get(supBot, i) : na lb = i < array.size(supLBar) ? array.get(supLBar, i) : 0 tc = i < array.size(supTouchCt) ? array.get(supTouchCt, i) : 0 keep = i < array.size(takeSup) ? array.get(takeSup, i) : false isBr = i < array.size(supBroken) ? array.get(supBroken, i) : false if keep and not (isBr and sp_sdz_hide_broken) and not na(st) and not na(sb) midY = (st + sb) / 2.0 [adjSup, gSup] = f_score_and_grade(midY, lb, tc) sInt = int(math.max(0, math.min(10, math.round(adjSup)))) txt = sp_sdz_badge_style == "A/B/C" ? f_txt_grade(gSup) : f_txt_0_10(sInt) badgeLbl = label.new(bar_index - 2, st, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(supBase, 30), color=color.new(color.black, 100), size=size.small) array.push(supBadges, badgeLbl)
// Demand zone badges if nd > 0     for j = 0 to nd - 1         dt = j < array.size(demTop) ? array.get(demTop, j) : na         db = j < array.size(demBot) ? array.get(demBot, j) : na         lb = j < array.size(demLBar) ? array.get(demLBar, j) : 0         tc = j < array.size(demTouchCt) ? array.get(demTouchCt, j) : 0         keep = j < array.size(takeDem) ? array.get(takeDem, j) : false         isBr = j < array.size(demBroken) ? array.get(demBroken, j) : false         if keep and not (isBr and sp_sdz_hide_broken) and not na(dt) and not na(db)             midY = (dt + db) / 2.0             [adjDem, gDem] = f_score_and_grade(midY, lb, tc)             sInt = int(math.max(0, math.min(10, math.round(adjDem))))             txt = sp_sdz_badge_style == "A/B/C" ? f_txt_grade(gDem) : f_txt_0_10(sInt)             badgeLbl = label.new(bar_index - 2, db, txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(demBase, 30), color=color.new(color.black, 100), size=size.small)             array.push(demBadges, badgeLbl) 
// ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.12.1 SDZ LABELS - Inside Box Corners │ // └─────────────────────────────────────────────────────────────────────────────┘ if sp_sdz_show_hl and activeSup >= 0 and activeSup < array.size(supTop) and activeSup < array.size(supBot) st = array.get(supTop, activeSup) sb = array.get(supBot, activeSup) x1 = bar_index - sp_sdz_hl_len + 1 sdz_l1 = line.new(x1, st, bar_index, st, xloc=xloc.bar_index, extend=extend.none, width=1, color=color.new(supBase, 0)) sdz_l2 = line.new(x1, sb, bar_index, sb, xloc=xloc.bar_index, extend=extend.none, width=1, color=color.new(supBase, 0)) array.push(supHLines, sdz_l1) array.push(supHLines, sdz_l2) // Label INSIDE box: offset X left by 5 bars, Y down from top edge if sp_sdz_show_tags zoneHeight = st - sb yOffset = st - (zoneHeight * 0.15) // 15% down from top tg = label.new(bar_index - 5, yOffset, "supply", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(supBase, 20), color=color.new(color.black, 100), size=size.tiny) array.push(supTags, tg) if sp_sdz_show_hl and activeDem >= 0 and activeDem < array.size(demTop) and activeDem < array.size(demBot) dt = array.get(demTop, activeDem) db = array.get(demBot, activeDem) x1 = bar_index - sp_sdz_hl_len + 1 sdz_l3 = line.new(x1, dt, bar_index, dt, xloc=xloc.bar_index, extend=extend.none, width=1, color=color.new(demBase, 0)) sdz_l4 = line.new(x1, db, bar_index, db, xloc=xloc.bar_index, extend=extend.none, width=1, color=color.new(demBase, 0)) array.push(demHLines, sdz_l3) array.push(demHLines, sdz_l4) // Label INSIDE box: offset X left by 5 bars, Y up from bottom edge if sp_sdz_show_tags zoneHeight = dt - db yOffset = db + (zoneHeight * 0.15) // 15% up from bottom tg2 = label.new(bar_index - 5, yOffset, "demand", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textcolor=color.new(demBase, 20), color=color.new(color.black, 100), size=size.tiny) array.push(demTags, tg2) // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 5.13 RCS - REVERSAL CANDLESTICK PATTERNS (16 patterns) │ // └─────────────────────────────────────────────────────────────────────────────┘ rngR = high - low bodyR = math.abs(close - open) upperR = high - math.max(open, close) lowerR = math.min(open, close) - low bullishR = close >= open bearishR = close < open // Position context for reversal patterns // Swing detection - dynamic: stricter on LTF (more noise), looser on HTF (fewer candles) // LTF needs more bars to filter noise, HTF needs fewer to catch patterns swingLen = timeframe.in_seconds() / 60 <= 5 ? 20 : timeframe.in_seconds() / 60 <= 15 ? 15 : timeframe.in_seconds() / 60 <= 60 ? 12 : timeframe.in_seconds() / 60 <= 240 ? 10 : 8 recentLow = ta.lowest(low, swingLen)[1] // Lowest low of prior N bars recentHigh = ta.highest(high, swingLen)[1] // Highest high of prior N bars recentRange = recentHigh - recentLow // Prior trend context - was there actually a move to reverse? priorDownMove = close[5] > close[2] // Price was falling into this area (bullish reversal context) priorUpMove = close[5] < close[2] // Price was rising into this area (bearish reversal context) // Range position - ensure we're actually near the extreme, not just making new highs/lows in trend nearRangeBottom = close < (recentLow + recentRange * RCS_RANGE_PCT) // Close in bottom 30% of range nearRangeTop = close > (recentHigh - recentRange * RCS_RANGE_PCT) // Close in top 30% of range // Rejection evidence - wick touched extreme but close rejected it rejectedLow = low <= recentLow and close > (recentLow + recentRange * RCS_REJECT_PCT) // Wicked low but closed higher rejectedHigh = high >= recentHigh and close < (recentHigh - recentRange * RCS_REJECT_PCT) // Wicked high but closed lower // FINAL SWING CHECKS - must pass multiple filters // Bullish: at swing low + prior down move + showing rejection (not waterfall) atSwingLow = low <= recentLow and priorDownMove and (rejectedLow or nearRangeBottom) // Bearish: at swing high + prior up move + showing rejection (not melt-up) atSwingHigh = high >= recentHigh and priorUpMove and (rejectedHigh or nearRangeTop) // Shape detection (standard: shadow ≥ 2× body, opposite shadow small) isHammerShape = bodyR > 0 and lowerR >= bodyR * RCS_WICK_RATIO and upperR <= bodyR * RCS_OPP_WICK_MAX isInvertedShape = bodyR > 0 and upperR >= bodyR * RCS_WICK_RATIO and lowerR <= bodyR * RCS_OPP_WICK_MAX // --- Single Candle Patterns (4) - Require swing location --- hammerPattern = isHammerShape and atSwingLow // Hammer at BOTTOM invHammerPattern = isInvertedShape and atSwingLow // Inv Hammer at BOTTOM hangingManPattern = isHammerShape and atSwingHigh // Hanging Man at TOP shootingStarPattern = isInvertedShape and atSwingHigh // Shooting Star at TOP // --- Two Candle Patterns (6) - Require swing location --- // Bull Engulfing: green engulfs prior red, at BOTTOM bullEngulfPattern = bar_index > 0 and bearishR[1] and bullishR and close > open[1] and open < close[1] and atSwingLow // Bear Engulfing: red engulfs prior green, at TOP bearEngulfPattern = bar_index > 0 and bullishR[1] and bearishR and close < open[1] and open > close[1] and atSwingHigh // Bull Harami: small green inside prior red, at BOTTOM bullHaramiPattern = bar_index > 0 and bearishR[1] and bullishR and high < high[1] and low > low[1] and atSwingLow // Bear Harami: small red inside prior green, at TOP bearHaramiPattern = bar_index > 0 and bullishR[1] and bearishR and high < high[1] and low > low[1] and atSwingHigh // Tweezer Bottom: matching lows, red→green, at BOTTOM tweezerTol = atrK * RCS_TWEEZER_TOL tweezerBottomPattern = bar_index > 0 and math.abs(low - low[1]) <= tweezerTol and bullishR and bearishR[1] and atSwingLow // Tweezer Top: matching highs, green→red, at TOP tweezerTopPattern = bar_index > 0 and math.abs(high - high[1]) <= tweezerTol and bearishR and bullishR[1] and atSwingHigh // --- Three Candle Patterns (4) --- // Three White Soldiers: 3 green, higher closes, starting from BOTTOM threeWhiteLow = ta.lowest(low, 10)[3] // 10-bar low before pattern started threeWhitePattern = bar_index >= 2 and bullishR and bullishR[1] and bullishR[2] and close > close[1] and close[1] > close[2] and low[2] <= threeWhiteLow // First candle at swing low // Three Black Crows: 3 red, lower closes, starting from TOP threeBlackHigh = ta.highest(high, 10)[3] // 10-bar high before pattern started threeBlackPattern = bar_index >= 2 and bearishR and bearishR[1] and bearishR[2] and close < close[1] and close[1] < close[2] and high[2] >= threeBlackHigh // First candle at swing high // Morning Star: red, small, green - REQUIRE swing low location morningStarBody1 = math.abs(close[2] - open[2]) morningStarBody2 = math.abs(close[1] - open[1]) morningStarMid = (open[2] + close[2]) / 2.0 morningStarLow = ta.lowest(low, swingLen)[1] // Must be at swing low morningStarPattern = bar_index >= 2 and bearishR[2] and // First candle bearish morningStarBody2 < morningStarBody1 * RCS_SMALL_BODY and // Middle candle small bullishR and // Third candle bullish close > morningStarMid and // Closes above midpoint low[1] <= morningStarLow // Middle candle at swing low // Evening Star: green, small, red - REQUIRE swing high location eveningStarBody1 = math.abs(close[2] - open[2]) eveningStarBody2 = math.abs(close[1] - open[1]) eveningStarMid = (open[2] + close[2]) / 2.0 eveningStarHigh = ta.highest(high, swingLen)[1] // Must be at swing high eveningStarPattern = bar_index >= 2 and bullishR[2] and // First candle bullish eveningStarBody2 < eveningStarBody1 * RCS_SMALL_BODY and // Middle candle small bearishR and // Third candle bearish close < eveningStarMid and // Closes below midpoint high[1] >= eveningStarHigh // Middle candle at swing high // --- Five Candle Continuation Patterns (2) - No location (continuation) --- risingThreeFirst = close[4] > open[4] and (close[4] - open[4]) > atrK * RCS_STRONG_BODY risingThreeSmall1 = close[3] < open[3] and low[3] >= low[4] and high[3] <= high[4] risingThreeSmall2 = close[2] < open[2] and low[2] >= low[4] and high[2] <= high[4] risingThreeSmall3 = close[1] < open[1] and low[1] >= low[4] and high[1] <= high[4] risingThreeLast = bullishR and close > close[4] and (close - open) > atrK * RCS_STRONG_BODY risingThreePattern = bar_index >= 4 and risingThreeFirst and risingThreeSmall1 and risingThreeSmall2 and risingThreeSmall3 and risingThreeLast fallingThreeFirst = close[4] < open[4] and (open[4] - close[4]) > atrK * RCS_STRONG_BODY fallingThreeSmall1 = close[3] > open[3] and low[3] >= low[4] and high[3] <= high[4] fallingThreeSmall2 = close[2] > open[2] and low[2] >= low[4] and high[2] <= high[4] fallingThreeSmall3 = close[1] > open[1] and low[1] >= low[4] and high[1] <= high[4] fallingThreeLast = bearishR and close < close[4] and (open - close) > atrK * RCS_STRONG_BODY fallingThreePattern = bar_index >= 4 and fallingThreeFirst and fallingThreeSmall1 and fallingThreeSmall2 and fallingThreeSmall3 and fallingThreeLast // RCS event flags for alerts var bool rcs_hammer_evt = false var bool rcs_inv_hammer_evt = false var bool rcs_bull_engulf_evt = false var bool rcs_rising3_evt = false var bool rcs_3white_evt = false var bool rcs_morning_star_evt = false var bool rcs_bull_harami_evt = false var bool rcs_tweezer_bottom_evt = false var bool rcs_hanging_man_evt = false var bool rcs_shooting_star_evt = false var bool rcs_bear_engulf_evt = false var bool rcs_falling3_evt = false var bool rcs_3black_evt = false var bool rcs_evening_star_evt = false var bool rcs_bear_harami_evt = false var bool rcs_tweezer_top_evt = false // Reset all events if barstate.isconfirmed rcs_hammer_evt := false rcs_inv_hammer_evt := false rcs_bull_engulf_evt := false rcs_rising3_evt := false rcs_3white_evt := false rcs_morning_star_evt := false rcs_bull_harami_evt := false rcs_tweezer_bottom_evt := false rcs_hanging_man_evt := false rcs_shooting_star_evt := false rcs_bear_engulf_evt := false rcs_falling3_evt := false rcs_3black_evt := false rcs_evening_star_evt := false rcs_bear_harami_evt := false rcs_tweezer_top_evt := false var int lastRcsBull = -1 var int lastRcsBear = -1 rcsTickOff = syminfo.mintick * sp_rcs_off_ticks rcsDynOff = atr14 * sp_rcs_off_atr_pct rcsOff = math.max(rcsDynOff, rcsTickOff) rcsBgc = color.new(color.black, sp_rcs_bg_tr) rcsSize = rcsToSize(sp_rcs_txt_size) // Only show RCS patterns within lookback window rcsInRange = bar_index > (last_bar_index - rcsLookback) if barstate.isconfirmed and sp_show_rcs and rcsInRange // BULLISH PATTERNS (compact labels with tooltips) if sp_rcs_hammer and hammerPattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "HMR", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="HAMMER\nLong lower wick, small body at top.\nBullish reversal pattern at swing lows.\nShows buyers rejected lower prices.") lastRcsBull := bar_index rcs_hammer_evt := true else if sp_rcs_inv_hammer and invHammerPattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "IH", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="INVERTED HAMMER\nLong upper wick, small body at bottom.\nBullish reversal after downtrend.\nShows buying pressure emerging.") lastRcsBull := bar_index rcs_inv_hammer_evt := true else if sp_rcs_bull_engulf and bullEngulfPattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "ENG", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="BULLISH ENGULFING\nGreen candle fully engulfs prior red candle.\nStrong bullish reversal signal.\nBuyers overwhelmed sellers.") lastRcsBull := bar_index rcs_bull_engulf_evt := true else if sp_rcs_bull_harami and bullHaramiPattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "HAR", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="BULLISH HARAMI\nSmall green candle inside prior large red.\nPotential reversal, momentum slowing.\nWait for confirmation.") lastRcsBull := bar_index rcs_bull_harami_evt := true else if sp_rcs_rising3 and risingThreePattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "R3", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="RISING THREE METHODS\nThree small red candles inside large green range.\nBullish continuation pattern.\nPullback within uptrend.") lastRcsBull := bar_index rcs_rising3_evt := true else if sp_rcs_3white and threeWhitePattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "3W", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="THREE WHITE SOLDIERS\nThree consecutive rising green candles.\nStrong bullish momentum.\nOften marks trend reversal.") lastRcsBull := bar_index rcs_3white_evt := true else if sp_rcs_morning_star and morningStarPattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "MS", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="MORNING STAR\nRed → small body → green closes above midpoint.\nThree-candle bullish reversal.\nDawn after the darkness.") lastRcsBull := bar_index rcs_morning_star_evt := true else if sp_rcs_tweezer_bottom and tweezerBottomPattern and cooldownOk(lastRcsBull, sp_rcs_cooldown) label.new(bar_index, low - rcsOff, "TW", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bull_color, size=rcsSize, textalign=text.align_center, tooltip="TWEEZER BOTTOM\nTwo candles with matching lows.\nDouble test of support held.\nBullish reversal signal.") lastRcsBull := bar_index rcs_tweezer_bottom_evt := true // BEARISH PATTERNS (compact labels with tooltips) if sp_rcs_hanging_man and hangingManPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "HNG", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="HANGING MAN\nLong lower wick, small body at top.\nBearish reversal at swing highs.\nSellers tested, buyers weakening.") lastRcsBear := bar_index rcs_hanging_man_evt := true else if sp_rcs_shooting_star and shootingStarPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "SS", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="SHOOTING STAR\nLong upper wick, small body at bottom.\nBearish reversal at resistance.\nBuyers failed to hold highs.") lastRcsBear := bar_index rcs_shooting_star_evt := true else if sp_rcs_bear_engulf and bearEngulfPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "ENG", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="BEARISH ENGULFING\nRed candle fully engulfs prior green candle.\nStrong bearish reversal signal.\nSellers overwhelmed buyers.") lastRcsBear := bar_index rcs_bear_engulf_evt := true else if sp_rcs_bear_harami and bearHaramiPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "HAR", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="BEARISH HARAMI\nSmall red candle inside prior large green.\nPotential reversal, momentum slowing.\nWait for confirmation.") lastRcsBear := bar_index rcs_bear_harami_evt := true else if sp_rcs_falling3 and fallingThreePattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "F3", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="FALLING THREE METHODS\nThree small green candles inside large red range.\nBearish continuation pattern.\nBounce within downtrend.") lastRcsBear := bar_index rcs_falling3_evt := true else if sp_rcs_3black and threeBlackPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "3B", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="THREE BLACK CROWS\nThree consecutive falling red candles.\nStrong bearish momentum.\nOften marks trend reversal.") lastRcsBear := bar_index rcs_3black_evt := true else if sp_rcs_evening_star and eveningStarPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "ES", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="EVENING STAR\nGreen → small body → red closes below midpoint.\nThree-candle bearish reversal.\nDusk after the daylight.") lastRcsBear := bar_index rcs_evening_star_evt := true else if sp_rcs_tweezer_top and tweezerTopPattern and cooldownOk(lastRcsBear, sp_rcs_cooldown) label.new(bar_index, high + rcsOff, "TW", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, color=rcsBgc, textcolor=sp_rcs_bear_color, size=rcsSize, textalign=text.align_center, tooltip="TWEEZER TOP\nTwo candles with matching highs.\nDouble test of resistance failed.\nBearish reversal signal.") lastRcsBear := bar_index rcs_tweezer_top_evt := true // Aggregate RCS signals for confluence rcsBullSignal = rcs_hammer_evt or rcs_inv_hammer_evt or rcs_bull_engulf_evt or rcs_rising3_evt or rcs_3white_evt or rcs_morning_star_evt or rcs_bull_harami_evt or rcs_tweezer_bottom_evt rcsBearSignal = rcs_hanging_man_evt or rcs_shooting_star_evt or rcs_bear_engulf_evt or rcs_falling3_evt or rcs_3black_evt or rcs_evening_star_evt or rcs_bear_harami_evt or rcs_tweezer_top_evt // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 6. MTF DATA RETRIEVAL ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ //@function SuperTrend MTF wrapper //@returns 1 for bullish consensus, -1 for bearish f_stDir() => float atr = ta.atr(10) float hl2v = (high + low) / 2.0
float basicU2 = hl2v + 2.0 * atr float basicL2 = hl2v - 2.0 * atr float basicU3 = hl2v + 3.0 * atr float basicL3 = hl2v - 3.0 * atr float basicU4 = hl2v + 4.0 * atr float basicL4 = hl2v - 4.0 * atr  var float fu2_ = na, var float fl2_ = na, var int dir2_ = 1 var float fu3_ = na, var float fl3_ = na, var int dir3_ = 1 var float fu4_ = na, var float fl4_ = na, var int dir4_ = 1  fu2_ := basicU2 < nz(fu2_[1], basicU2) or close[1] > nz(fu2_[1], basicU2) ? basicU2 : nz(fu2_[1], basicU2) fl2_ := basicL2 > nz(fl2_[1], basicL2) or close[1] < nz(fl2_[1], basicL2) ? basicL2 : nz(fl2_[1], basicL2) dir2_ := nz(dir2_[1], 1) == 1 and close < fl2_ ? -1 : nz(dir2_[1], 1) == -1 and close > fu2_ ? 1 : nz(dir2_[1], 1)  fu3_ := basicU3 < nz(fu3_[1], basicU3) or close[1] > nz(fu3_[1], basicU3) ? basicU3 : nz(fu3_[1], basicU3) fl3_ := basicL3 > nz(fl3_[1], basicL3) or close[1] < nz(fl3_[1], basicL3) ? basicL3 : nz(fl3_[1], basicL3) dir3_ := nz(dir3_[1], 1) == 1 and close < fl3_ ? -1 : nz(dir3_[1], 1) == -1 and close > fu3_ ? 1 : nz(dir3_[1], 1)  fu4_ := basicU4 < nz(fu4_[1], basicU4) or close[1] > nz(fu4_[1], basicU4) ? basicU4 : nz(fu4_[1], basicU4) fl4_ := basicL4 > nz(fl4_[1], basicL4) or close[1] < nz(fl4_[1], basicL4) ? basicL4 : nz(fl4_[1], basicL4) dir4_ := nz(dir4_[1], 1) == 1 and close < fl4_ ? -1 : nz(dir4_[1], 1) == -1 and close > fu4_ ? 1 : nz(dir4_[1], 1)  int upCount = (dir2_ == 1 ? 1 : 0) + (dir3_ == 1 ? 1 : 0) + (dir4_ == 1 ? 1 : 0) int result = upCount >= 2 ? 1 : -1 result 
//@function BMSB MTF wrapper //@returns 1 if above band, -1 if below, 0 if inside f_bmsbPos() => float sma20 = ta.sma(close, 20) float ema21 = ta.ema(close, 21) float upper = math.max(sma20, ema21) float lower = math.min(sma20, ema21) int result = close > upper ? 1 : close < lower ? -1 : 0 result //@function EMA Stack MTF wrapper //@returns 1 if bull stack, -1 if bear stack, 0 if mixed f_emaStack() => float e50 = ta.ema(close, 50) float e100 = ta.ema(close, 100) float e200 = ta.ema(close, 200) int result = e50 > e100 and e100 > e200 ? 1 : e50 < e100 and e100 < e200 ? -1 : 0 result //@function Regime MTF wrapper (aligned with main regime logic) //@returns 1 for bull, -1 for bear f_regime() => float emaF = ta.ema(close, 34) float emaS = ta.ema(close, 55) float pl = ta.ema(close, 100) float atrK = ta.atr(20) float kcBase = ta.ema(hlc3, 20)
float tr1 = high - low float tr2 = math.abs(high - close[1]) float tr3 = math.abs(low - close[1]) float tr = math.max(math.max(tr1, tr2), tr3) float trR = ta.rma(tr, 14) float upMove = high - high[1] float downMove = low[1] - low float plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0 float minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0 float plusDM_R = ta.rma(plusDM, 14) float minusDM_R = ta.rma(minusDM, 14) float diPlus = trR != 0 ? 100.0 * (plusDM_R / trR) : 0.0 float diMinus = trR != 0 ? 100.0 * (minusDM_R / trR) : 0.0  float hyst = atrK * HYST_ATR_MULT float slopeRaw = pl - pl[1] float slopeMA = ta.ema(slopeRaw, 5) bool slopeUp = slopeMA > atrK * SLOPE_ATR_DEAD and slopeMA > slopeMA[1] bool slopeDn = slopeMA < -atrK * SLOPE_ATR_DEAD and slopeMA < slopeMA[1]  float diDiff = diPlus - diMinus  bool vote1_bull = emaF > emaS bool vote2_bull = close > pl + hyst bool vote3_bull = slopeUp bool vote4_bull = diDiff > 5.0  bool vote1_bear = emaF < emaS bool vote2_bear = close < pl - hyst bool vote3_bear = slopeDn bool vote4_bear = -diDiff > 5.0  int bullVotes = (vote1_bull?1:0) + (vote2_bull?1:0) + (vote3_bull?1:0) + (vote4_bull?1:0) int bearVotes = (vote1_bear?1:0) + (vote2_bear?1:0) + (vote3_bear?1:0) + (vote4_bear?1:0)  int result = bullVotes >= 3 ? 1 : bearVotes >= 3 ? -1 : emaF > emaS ? 1 : -1 result 
//@function Squeeze MTF wrapper //@returns 1 if squeeze active, 0 otherwise f_sqzActive() => int bbLen = 20 int kcLen = 20 float bbMult = 2.0 float kcMult = 1.5
float basis = ta.sma(close, bbLen) float dev = bbMult * ta.stdev(close, bbLen) float bbU = basis + dev float bbL = basis - dev  float kcBasis = ta.ema(close, kcLen) float kcRange = ta.atr(kcLen) float kcU = kcBasis + kcMult * kcRange float kcL = kcBasis - kcMult * kcRange  int result = bbU < kcU and bbL > kcL ? 1 : 0 result 
//@function RCS MTF wrapper //@returns 1 for bull pattern, -1 for bear pattern, 0 for none f_rcsPattern() => float bodyPct = math.abs(close - open) / (high - low + 0.0001) bool isGreen = close > open bool isRed = close < open
// Simplified pattern detection (using same ratios as main logic) bool hammerBody = bodyPct < 0.35 and (high - low) > 0 float lowerWick = isGreen ? open - low : close - low float upperWick = isGreen ? high - close : high - open bool hammerWick = lowerWick > RCS_WICK_RATIO * math.abs(close - open) and upperWick < math.abs(close - open) * RCS_OPP_WICK_MAX bool hammer = hammerBody and hammerWick and isGreen  bool shootingBody = bodyPct < 0.35 bool shootingWick = upperWick > RCS_WICK_RATIO * math.abs(close - open) and lowerWick < math.abs(close - open) * RCS_OPP_WICK_MAX bool shootingStar = shootingBody and shootingWick and isRed  bool bullEngulf = isRed[1] and isGreen and close > open[1] and open < close[1] bool bearEngulf = isGreen[1] and isRed and close < open[1] and open > close[1]  int result = hammer or bullEngulf ? 1 : shootingStar or bearEngulf ? -1 : 0 result 
// ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 6.1 MTF REQUEST.SECURITY CALLS │ // │ │ // │ Each system can have an independent MTF timeframe for maximum flexibility. │ // │ If a system's MTF is disabled (empty string), it uses chart TF values. │ // │ request.security calls are only made when the corresponding MTF is enabled. │ // └─────────────────────────────────────────────────────────────────────────────┘ // Trend-following systems int mtf_stDir = sp_use_mtf_st ? request.security(syminfo.tickerid, sp_mtf_st, f_stDir(), barmerge.gaps_off, barmerge.lookahead_off) : ST_DIR int mtf_bmsbPos = sp_use_mtf_bmsb ? request.security(syminfo.tickerid, sp_mtf_bmsb, f_bmsbPos(), barmerge.gaps_off, barmerge.lookahead_off) : (priceAboveBMSB ? 1 : priceBelowBMSB ? -1 : 0) int mtf_emaStack = sp_use_mtf_ema ? request.security(syminfo.tickerid, sp_mtf_ema, f_emaStack(), barmerge.gaps_off, barmerge.lookahead_off) : (bullReg ? 1 : bearReg ? -1 : 0) int mtf_regime = sp_use_mtf_regime ? request.security(syminfo.tickerid, sp_mtf_regime, f_regime(), barmerge.gaps_off, barmerge.lookahead_off) : regime_RB // Volatility/pattern systems int mtf_sqzActive = sp_use_mtf_squeeze ? request.security(syminfo.tickerid, sp_mtf_squeeze, f_sqzActive(), barmerge.gaps_off, barmerge.lookahead_off) : (SP_SQZ_conf ? 1 : 0) int mtf_rcsPattern = sp_use_mtf_rcs ? request.security(syminfo.tickerid, sp_mtf_rcs, f_rcsPattern(), barmerge.gaps_off, barmerge.lookahead_off) : (rcsBullSignal ? 1 : rcsBearSignal ? -1 : 0) // Event-based systems (chart TF only - too complex for MTF without losing accuracy) bool mtf_tdBull = SP_TD9B or SP_TD8B or SP_TD9B_PERF bool mtf_tdBear = SP_TD9S or SP_TD8S or SP_TD9S_PERF bool mtf_sweepBull = sweepUp_conf bool mtf_sweepBear = sweepDn_conf bool mtf_atDemand = atDemandZone bool mtf_atSupply = atSupplyZone bool mtf_sqzBrkUp = SP_BRK_UP_conf bool mtf_sqzBrkDn = SP_BRK_DN_conf // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 7. CONFLUENCE SCORING ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ var float confBull = 0.0 var float confBear = 0.0 if barstate.isconfirmed confBull := 0.0 confBear := 0.0
// Exhaustion Counter (uses chart TF for now - event timing critical) if SP_TD9B_PERF     confBull += WT_TD9_PERF else if SP_TD9B     confBull += WT_TD9 else if SP_TD8B     confBull += WT_TD8  if SP_TD9S_PERF     confBear += WT_TD9_PERF else if SP_TD9S     confBear += WT_TD9 else if SP_TD8S     confBear += WT_TD8  // Squeeze Break (uses chart TF - event timing critical) if mtf_sqzBrkUp     confBull += WT_SQUEEZE if mtf_sqzBrkDn     confBear += WT_SQUEEZE  // SuperTrend (MTF) if mtf_stDir == 1     confBull += WT_ST else     confBear += WT_ST  // BMSB (MTF) if mtf_bmsbPos == 1     confBull += WT_BMSB if mtf_bmsbPos == -1     confBear += WT_BMSB  // EMA Regime (MTF) if mtf_emaStack == 1     confBull += WT_EMA_REG if mtf_emaStack == -1     confBear += WT_EMA_REG  // At S/D Zone (uses chart TF - price-based) if mtf_atDemand     confBull += WT_SDZ if mtf_atSupply     confBear += WT_SDZ  // Liquidity Sweep (uses chart TF - event timing) if mtf_sweepBull     confBull += WT_SWEEP if mtf_sweepBear     confBear += WT_SWEEP  // Regime (MTF) if mtf_regime == 1     confBull += WT_REGIME else     confBear += WT_REGIME  // RCS Patterns (MTF) if mtf_rcsPattern == 1     confBull += WT_RCS if mtf_rcsPattern == -1     confBear += WT_RCS 
// Calculate net score and direction confNet = confBull - confBear confTotal = confBull + confBear confDir = confNet > 0.5 ? 1 : confNet < -0.5 ? -1 : 0 confStrength = math.max(confBull, confBear) // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 8. CONFLUENCE PANEL DISPLAY ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ var table confTable = na // Helper to show TF suffix tfLabel(simple string tf) => tf == "" ? "" : " [" + tf + "]" //@function Render a single table cell //@param tbl Table reference //@param col Column index //@param row Row index //@param txt Cell text //@param txtCol Text color //@param sz Size constant //@param bgCol Background color //@param align Text alignment (default left) f_cell(table tbl, int col, int row, string txt, color txtCol, string sz, color bgCol, string align = text.align_left) => table.cell(tbl, col, row, txt, text_color=txtCol, text_size=sz, bgcolor=bgCol, text_halign=align) //@function Add spacer rows for offset //@param tbl Table reference //@param cols Number of columns //@param offset Number of spacer rows //@param sz Size constant f_spacers(table tbl, int cols, int offset, string sz) => if offset > 0 for i = 0 to offset - 1 for c = 0 to cols - 1 table.cell(tbl, c, i, " ", text_color=color.new(color.black, 100), text_size=sz, bgcolor=color.new(color.black, 100)) if barstate.islast and sp_show_confluence // Position string tblPos = sp_confluence_pos == "Top Right" ? position.top_right : sp_confluence_pos == "Top Left" ? position.top_left : sp_confluence_pos == "Bottom Right" ? position.bottom_right : position.bottom_left
// Colors (using unified palette) color confColor = confDir == 1 ? sp_col_bull : confDir == -1 ? sp_col_bear : sp_col_neutral color cellBgColor = sp_confluence_transp ? color.new(color.black, 100) : color.new(color.black, 85) color dimColor = color.new(color.gray, 60) color sepColor = color.new(color.gray, 60)  // User-controlled panel size string confSize = sp_confluence_size == "Tiny" ? size.tiny : sp_confluence_size == "Small" ? size.small : sp_confluence_size == "Large" ? size.large : size.normal  // Pre-calculate all status values string tdStatus = SP_TD9B_PERF ? "9P▲" : SP_TD9B ? "9▲" : SP_TD8B ? "8▲" : SP_TD9S_PERF ? "9P▼" : SP_TD9S ? "9▼" : SP_TD8S ? "8▼" : "—" color tdColor = (SP_TD9B or SP_TD8B or SP_TD9B_PERF) ? sp_col_bull : (SP_TD9S or SP_TD8S or SP_TD9S_PERF) ? sp_col_bear : sp_col_neutral string sqzStatus = mtf_sqzBrkUp ? "▲ Brk" : mtf_sqzBrkDn ? "▼ Brk" : mtf_sqzActive == 1 ? "Active" : "—" color sqzColor = mtf_sqzBrkUp ? sp_col_bull : mtf_sqzBrkDn ? sp_col_bear : mtf_sqzActive == 1 ? sp_col_caution : sp_col_neutral string stStatus = mtf_stDir == 1 ? "Bullish" : "Bearish" color stTblColor = mtf_stDir == 1 ? sp_col_bull : sp_col_bear string bmsbStatus = mtf_bmsbPos == 1 ? "Above" : mtf_bmsbPos == -1 ? "Below" : "In Band" color bmsbColor = mtf_bmsbPos == 1 ? sp_col_bull : mtf_bmsbPos == -1 ? sp_col_bear : sp_col_caution string emaStatus = mtf_emaStack == 1 ? "Bull Stack" : mtf_emaStack == -1 ? "Bear Stack" : "Mixed" color emaColor = mtf_emaStack == 1 ? sp_col_bull : mtf_emaStack == -1 ? sp_col_bear : sp_col_caution string sdzStatus = mtf_atDemand ? "@ Demand" : mtf_atSupply ? "@ Supply" : "—" color sdzColor = mtf_atDemand ? sp_col_bull : mtf_atSupply ? sp_col_bear : sp_col_neutral string sweepStatus = mtf_sweepBull ? "▲ Bull" : mtf_sweepBear ? "▼ Bear" : "—" color sweepColor = mtf_sweepBull ? sp_col_bull : mtf_sweepBear ? sp_col_bear : sp_col_neutral string regStatus = mtf_regime == 1 ? "Bull" : "Bear" color regColor = mtf_regime == 1 ? sp_col_bull : sp_col_bear string rcsStatus = mtf_rcsPattern == 1 ? "▲ Bull" : mtf_rcsPattern == -1 ? "▼ Bear" : "—" color rcsColor = mtf_rcsPattern == 1 ? sp_col_bull : mtf_rcsPattern == -1 ? sp_col_bear : sp_col_neutral string dirArrow = confDir == 1 ? "▲" : confDir == -1 ? "▼" : "◆" string scoreDisp = dirArrow + " " + str.tostring(math.round(confStrength, 1))  // Display strings with optional TF suffix string tdDisp   = "EC" + (sp_mtf_td != "" ? ":" + fmtTf(sp_mtf_td) : "") + " " + tdStatus string stDisp   = "ST" + (sp_mtf_st != "" ? ":" + fmtTf(sp_mtf_st) : "") + " " + stStatus string bmsbDisp = "BMSB" + (sp_mtf_bmsb != "" ? ":" + fmtTf(sp_mtf_bmsb) : "") + " " + bmsbStatus string emaDisp  = "EMA" + (sp_mtf_ema != "" ? ":" + fmtTf(sp_mtf_ema) : "") + " " + emaStatus string sdzDisp  = "S/D" + (sp_mtf_sdz != "" ? ":" + fmtTf(sp_mtf_sdz) : "") + " " + sdzStatus string sqzDisp  = "SQZ" + (sp_mtf_squeeze != "" ? ":" + fmtTf(sp_mtf_squeeze) : "") + " " + sqzStatus string swpDisp  = "SWP" + (sp_mtf_sweep != "" ? ":" + fmtTf(sp_mtf_sweep) : "") + " " + sweepStatus string regDisp  = "REG" + (sp_mtf_regime != "" ? ":" + fmtTf(sp_mtf_regime) : "") + " " + regStatus string rcsDisp  = "RCS" + (sp_mtf_rcs != "" ? ":" + fmtTf(sp_mtf_rcs) : "") + " " + rcsStatus  // Offset calculation bool isTop = sp_confluence_pos == "Top Right" or sp_confluence_pos == "Top Left" int rowOffset = isTop ? sp_confluence_offset : 0  // Clean up previous table if not na(confTable)     table.delete(confTable)  if sp_confluence_mode == "Badge"     // Compact badge mode - just score     confTable := table.new(tblPos, 1, 1 + rowOffset, bgcolor=cellBgColor, border_width=0, border_color=color.new(color.black, 100))     f_spacers(confTable, 1, rowOffset, confSize)     f_cell(confTable, 0, rowOffset, scoreDisp, confColor, confSize, cellBgColor)  else if sp_confluence_mode == "Horizontal"     if sp_horizontal_rows == 2         // 2-row layout: 9 cols × 2 rows         confTable := table.new(tblPos, 9, 2 + rowOffset, bgcolor=cellBgColor, border_width=0, border_color=color.new(color.black, 100))         f_spacers(confTable, 9, rowOffset, confSize)         // Row 1: Score | EC | ST | BMSB | EMA         f_cell(confTable, 0, rowOffset, scoreDisp, confColor, confSize, cellBgColor)         f_cell(confTable, 1, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 2, rowOffset, tdDisp, tdColor, confSize, cellBgColor)         f_cell(confTable, 3, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 4, rowOffset, stDisp, stTblColor, confSize, cellBgColor)         f_cell(confTable, 5, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 6, rowOffset, bmsbDisp, bmsbColor, confSize, cellBgColor)         f_cell(confTable, 7, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 8, rowOffset, emaDisp, emaColor, confSize, cellBgColor)         // Row 2: S/D | SQZ | SWP | REG | RCS         f_cell(confTable, 0, 1 + rowOffset, sdzDisp, sdzColor, confSize, cellBgColor)         f_cell(confTable, 1, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 2, 1 + rowOffset, sqzDisp, sqzColor, confSize, cellBgColor)         f_cell(confTable, 3, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 4, 1 + rowOffset, swpDisp, sweepColor, confSize, cellBgColor)         f_cell(confTable, 5, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 6, 1 + rowOffset, regDisp, regColor, confSize, cellBgColor)         f_cell(confTable, 7, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 8, 1 + rowOffset, rcsDisp, rcsColor, confSize, cellBgColor)     else         // 3-row layout: 7 cols × 3 rows         confTable := table.new(tblPos, 7, 3 + rowOffset, bgcolor=cellBgColor, border_width=0, border_color=color.new(color.black, 100))         f_spacers(confTable, 7, rowOffset, confSize)         // Row 1         f_cell(confTable, 0, rowOffset, scoreDisp, confColor, confSize, cellBgColor)         f_cell(confTable, 1, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 2, rowOffset, tdDisp, tdColor, confSize, cellBgColor)         f_cell(confTable, 3, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 4, rowOffset, stDisp, stTblColor, confSize, cellBgColor)         f_cell(confTable, 5, rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 6, rowOffset, bmsbDisp, bmsbColor, confSize, cellBgColor)         // Row 2         f_cell(confTable, 0, 1 + rowOffset, emaDisp, emaColor, confSize, cellBgColor)         f_cell(confTable, 1, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 2, 1 + rowOffset, sdzDisp, sdzColor, confSize, cellBgColor)         f_cell(confTable, 3, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 4, 1 + rowOffset, sqzDisp, sqzColor, confSize, cellBgColor)         f_cell(confTable, 5, 1 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 6, 1 + rowOffset, swpDisp, sweepColor, confSize, cellBgColor)         // Row 3         f_cell(confTable, 0, 2 + rowOffset, regDisp, regColor, confSize, cellBgColor)         f_cell(confTable, 1, 2 + rowOffset, "│", sepColor, confSize, cellBgColor)         f_cell(confTable, 2, 2 + rowOffset, rcsDisp, rcsColor, confSize, cellBgColor)         f_cell(confTable, 3, 2 + rowOffset, "", dimColor, confSize, cellBgColor)         f_cell(confTable, 4, 2 + rowOffset, "", dimColor, confSize, cellBgColor)         f_cell(confTable, 5, 2 + rowOffset, "", dimColor, confSize, cellBgColor)         f_cell(confTable, 6, 2 + rowOffset, "", dimColor, confSize, cellBgColor)  else     // Vertical table mode     bool hasMtf = sp_mtf_td != "" or sp_mtf_squeeze != "" or sp_mtf_st != "" or sp_mtf_bmsb != "" or sp_mtf_ema != "" or sp_mtf_sdz != "" or sp_mtf_sweep != "" or sp_mtf_regime != "" or sp_mtf_rcs != ""          // System data arrays for loop-based rendering     var string[] sysNames = array.from("EC", "ST", "BMSB", "EMA", "S/D", "SQZ", "SWP", "REG", "RCS")     string[] sysStatus = array.from(tdStatus, stStatus, bmsbStatus, emaStatus, sdzStatus, sqzStatus, sweepStatus, regStatus, rcsStatus)     color[] sysColors = array.from(         tdStatus == "—" ? dimColor : tdColor,         stTblColor,         bmsbColor,         emaColor,         sdzStatus == "—" ? dimColor : sdzColor,         sqzStatus == "—" ? dimColor : sqzColor,         sweepStatus == "—" ? dimColor : sweepColor,         regColor,         rcsStatus == "—" ? dimColor : rcsColor     )     string[] sysTfs = array.from(sp_mtf_td, sp_mtf_st, sp_mtf_bmsb, sp_mtf_ema, sp_mtf_sdz, sp_mtf_squeeze, sp_mtf_sweep, sp_mtf_regime, sp_mtf_rcs)          if hasMtf         // 3-column mode: SYSTEM | TF | STATUS         confTable := table.new(tblPos, 3, 11 + rowOffset, bgcolor=cellBgColor, border_width=0, border_color=color.new(color.black, 100))         f_spacers(confTable, 3, rowOffset, confSize)                  for i = 0 to 8             string nm = array.get(sysNames, i)             string st = array.get(sysStatus, i)             color cl = array.get(sysColors, i)             string tf = array.get(sysTfs, i)             string tfDisp = tf == "" ? "—" : fmtTf(tf)             color tfCol = tf == "" ? dimColor : color.gray                          f_cell(confTable, 0, i + rowOffset, nm, color.gray, confSize, cellBgColor)             f_cell(confTable, 1, i + rowOffset, tfDisp, tfCol, confSize, cellBgColor)             table.cell(confTable, 2, i + rowOffset, st, text_color=cl, text_size=confSize, bgcolor=cellBgColor, text_halign=text.align_right)                  // Separator         f_cell(confTable, 0, 9 + rowOffset, "───", dimColor, confSize, cellBgColor)         f_cell(confTable, 1, 9 + rowOffset, "──", dimColor, confSize, cellBgColor)         f_cell(confTable, 2, 9 + rowOffset, "─────", dimColor, confSize, cellBgColor)         // Score         f_cell(confTable, 0, 10 + rowOffset, "SCORE", color.white, confSize, cellBgColor)         f_cell(confTable, 1, 10 + rowOffset, "", color.gray, confSize, cellBgColor)         table.cell(confTable, 2, 10 + rowOffset, scoreDisp, text_color=confColor, text_size=confSize, bgcolor=cellBgColor, text_halign=text.align_right)     else         // 2-column mode: SYSTEM | STATUS         confTable := table.new(tblPos, 2, 11 + rowOffset, bgcolor=cellBgColor, border_width=0, border_color=color.new(color.black, 100))         f_spacers(confTable, 2, rowOffset, confSize)                  for i = 0 to 8             string nm = array.get(sysNames, i)             string st = array.get(sysStatus, i)             color cl = array.get(sysColors, i)                          f_cell(confTable, 0, i + rowOffset, nm, color.gray, confSize, cellBgColor)             table.cell(confTable, 1, i + rowOffset, st, text_color=cl, text_size=confSize, bgcolor=cellBgColor, text_halign=text.align_right)                  // Separator         f_cell(confTable, 0, 9 + rowOffset, "────", dimColor, confSize, cellBgColor)         f_cell(confTable, 1, 9 + rowOffset, "──────", dimColor, confSize, cellBgColor)         // Score         f_cell(confTable, 0, 10 + rowOffset, "SCORE", color.white, confSize, cellBgColor)         table.cell(confTable, 1, 10 + rowOffset, scoreDisp, text_color=confColor, text_size=confSize, bgcolor=cellBgColor, text_halign=text.align_right) 
// ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 8.1 LABEL RENDERING (EC, X markers, arrows) │ // └─────────────────────────────────────────────────────────────────────────────┘ // EC size hierarchy: 9 = full size (signal), 8 = one size smaller (warning) labelSize8 = labelSizeTD == size.large ? size.normal : labelSizeTD == size.normal ? size.small : labelSizeTD == size.small ? size.tiny : size.tiny color td8BuyColor = color.new(tdBuyColor, 40) // 8s are dimmer color td8SellColor = color.new(tdSellColor, 40) if barstate.isconfirmed if sp_show_td if SP_TD9B mkLbl(bar_index, yBuySnap, "9", tdBuyColor, labelSizeTD, tdBuyUD) if SP_TD8B and not sp_only_show9 mkLbl(bar_index, yBuySnap, "8", td8BuyColor, labelSize8, tdBuyUD) if SP_TD9S mkLbl(bar_index, ySellSnap, "9", tdSellColor, labelSizeTD, tdSellUD) if SP_TD8S and not sp_only_show9 mkLbl(bar_index, ySellSnap, "8", td8SellColor, labelSize8, tdSellUD) if sp_show_warn if doDanger_conf mkLbl(bar_index, yXSnap, "x", sp_col_bear, labelSizeX, 0) lastDangerIdx := bar_index lastDangerLeg := legId if doCaution_conf mkLbl(bar_index, yXSnap, "x", sp_col_caution, labelSizeX, 0) lastCautionIdx := bar_index lastCautionLeg := legId if sp_show_rel_arrows if SP_BRK_UP_conf // Draw on previous bar (the actual breakout candle) mkLbl(bar_index - 1, low[1] - padArrow, "▲", sp_col_bull, size.small, 0) if SP_BRK_DN_conf // Draw on previous bar (the actual breakout candle) mkLbl(bar_index - 1, high[1] + padArrow, "▼", sp_col_bear, size.small, 0) // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 8.2 ANY-TF HELPERS (for alerts) │ // └─────────────────────────────────────────────────────────────────────────────┘ //@function Check if SuperTrend consensus is bullish //@returns true if 2 of 3 SuperTrends are bullish stDirBool() => int _len = 10 [st2, d2] = ta.supertrend(2.0, _len) [st3, d3] = ta.supertrend(3.0, _len) [st4, d4] = ta.supertrend(4.0, _len) bool result = ((d2 > 0 ? 1 : 0) + (d3 > 0 ? 1 : 0) + (d4 > 0 ? 1 : 0)) >= 2 result //@function Check for bullish liquidity sweep (simplified for alerts) //@returns true if sweep detected sweepUpExpr() => // For alerts: use rolling low with strict wick requirement int _lookback = 15 // Fixed lookback for alerts float _prevLL = ta.lowest(low, _lookback)[1] float _lowerW = math.min(open, close) - low float _rng = math.max(high - low, 1e-9) bool result = (low < _prevLL) and (close > _prevLL) and (_lowerW/_rng >= SWEEP_WICK_FRAC) result //@function Check for bearish liquidity sweep (simplified for alerts) //@returns true if sweep detected sweepDnExpr() => int _lookback = 15 // Fixed lookback for alerts float _prevHH = ta.highest(high, _lookback)[1] float _upperW = high - math.max(open, close) float _rng = math.max(high - low, 1e-9) bool result = (high > _prevHH) and (close < _prevHH) and (_upperW/_rng >= SWEEP_WICK_FRAC) result // ┌─────────────────────────────────────────────────────────────────────────────┐ // │ 8.3 PRECOMPUTED ALERT SERIES │ // └─────────────────────────────────────────────────────────────────────────────┘ stUp_chart = ST_DIR == 1 stUp_tf = sp_use_atf ? request.security(syminfo.tickerid, sp_alert_tf, stDirBool(), barmerge.gaps_off, barmerge.lookahead_off) : bool(na) stUp_series = sp_use_atf ? stUp_tf : stUp_chart var int stUpNum_conf = 0 if barstate.isconfirmed stUpNum_conf := stUp_series ? 1 : 0 stFlipUpCross = ta.crossover(stUpNum_conf, 0.5) stFlipDnCross = ta.crossunder(stUpNum_conf, 0.5) stFlipUp_evt = barstate.isconfirmed and stFlipUpCross stFlipDn_evt = barstate.isconfirmed and stFlipDnCross sweepUp_tf = sp_use_atf ? request.security(syminfo.tickerid, sp_alert_tf, sweepUpExpr(), barmerge.gaps_off, barmerge.lookahead_off) : bool(na) sweepDn_tf = sp_use_atf ? request.security(syminfo.tickerid, sp_alert_tf, sweepDnExpr(), barmerge.gaps_off, barmerge.lookahead_off) : bool(na) sweepUp_final = barstate.isconfirmed and (sp_use_atf ? sweepUp_tf : sweepUp_conf) sweepDn_final = barstate.isconfirmed and (sp_use_atf ? sweepDn_tf : sweepDn_conf) // High confluence alerts highConfBull = barstate.isconfirmed and confBull >= HIGH_CONF_THRESHOLD highConfBear = barstate.isconfirmed and confBear >= HIGH_CONF_THRESHOLD // ╔═══════════════════════════════════════════════════════════════════════════╗ // ║ 9. ALERTS ║ // ╚═══════════════════════════════════════════════════════════════════════════╝ // Exhaustion Counter alertcondition(SP_TD8B, "EC8B", "Count 8 Buy Setup") alertcondition(SP_TD9B, "EC9B", "Count 9 Buy Setup") alertcondition(SP_TD8S, "EC8S", "Count 8 Sell Setup") alertcondition(SP_TD9S, "EC9S", "Count 9 Sell Setup") // Squeeze alertcondition(SP_SQZ_conf, "SQZ_ACTIVE", "Squeeze Active") alertcondition(SP_BRK_UP_conf, "SQZ_BREAK_UP", "Squeeze Break UP") alertcondition(SP_BRK_DN_conf, "SQZ_BREAK_DN", "Squeeze Break DOWN") // SuperTrend alertcondition(stFlipUp_evt, "ST_BULL", "SuperTrend Bullish Flip") alertcondition(stFlipDn_evt, "ST_BEAR", "SuperTrend Bearish Flip") // Warnings alertcondition(doCaution_conf, "CAUTION", "Caution Marker") alertcondition(doDanger_conf, "DANGER", "Danger Marker") // Sweeps alertcondition(sweepUp_final, "SWEEP_BULL", "Liquidity Sweep — Bullish") alertcondition(sweepDn_final, "SWEEP_BEAR", "Liquidity Sweep — Bearish") // EMA Events alertcondition(golden_evt, "GOLDEN_CROSS", "EMA50 crossed ABOVE EMA200 (Golden Cross)") alertcondition(death_evt, "DEATH_CROSS", "EMA50 crossed BELOW EMA200 (Death Cross)") // EMA Pullback alerts removed (v1.4) - GC/DC alerts cover the important events // S/D Zones alertcondition(supBreakThisBar and barstate.isconfirmed, "SDZ_SUPPLY_BROKEN", "Supply zone broken") alertcondition(demBreakThisBar and barstate.isconfirmed, "SDZ_DEMAND_BROKEN", "Demand zone broken") // BMSB Cross (NEW) alertcondition(bmsb_cross_up, "BMSB_CROSS_UP", "Price crossed ABOVE BMSB") alertcondition(bmsb_cross_dn, "BMSB_CROSS_DN", "Price crossed BELOW BMSB") // Regime Flip (NEW) // Regime alerts removed (v1.4) - background color visually shows regime changes // RCS Pattern Alerts (All 16 individual patterns) alertcondition(rcs_hammer_evt, "RCS_HAMMER", "Hammer pattern detected") alertcondition(rcs_inv_hammer_evt, "RCS_INV_HAMMER", "Inverted Hammer pattern detected") alertcondition(rcs_bull_engulf_evt, "RCS_BULL_ENGULF", "Bullish Engulfing pattern detected") alertcondition(rcs_rising3_evt, "RCS_RISING3", "Rising Three Methods pattern detected") alertcondition(rcs_3white_evt, "RCS_3WHITE", "Three White Soldiers pattern detected") alertcondition(rcs_morning_star_evt, "RCS_MORNING_STAR", "Morning Star pattern detected") alertcondition(rcs_bull_harami_evt, "RCS_BULL_HARAMI", "Bullish Harami pattern detected") alertcondition(rcs_tweezer_bottom_evt, "RCS_TWEEZER_BTM", "Tweezer Bottom pattern detected") alertcondition(rcs_hanging_man_evt, "RCS_HANGING_MAN", "Hanging Man pattern detected") alertcondition(rcs_shooting_star_evt, "RCS_SHOOTING_STAR", "Shooting Star pattern detected") alertcondition(rcs_bear_engulf_evt, "RCS_BEAR_ENGULF", "Bearish Engulfing pattern detected") alertcondition(rcs_falling3_evt, "RCS_FALLING3", "Falling Three Methods pattern detected") alertcondition(rcs_3black_evt, "RCS_3BLACK", "Three Black Crows pattern detected") alertcondition(rcs_evening_star_evt, "RCS_EVENING_STAR", "Evening Star pattern detected") alertcondition(rcs_bear_harami_evt, "RCS_BEAR_HARAMI", "Bearish Harami pattern detected") alertcondition(rcs_tweezer_top_evt, "RCS_TWEEZER_TOP", "Tweezer Top pattern detected") // RCS Aggregate Alerts (any pattern) alertcondition(rcsBullSignal, "RCS_ANY_BULL", "Any bullish candlestick pattern") alertcondition(rcsBearSignal, "RCS_ANY_BEAR", "Any bearish candlestick pattern") // Confluence Alerts highConfAny = highConfBull or highConfBear alertcondition(highConfAny, "HIGH_CONFLUENCE", "High Confluence Signal (6+)") // META: // version: 1.0 // changelog: // - v1.0: PUBLICATION RELEASE // - Exhaustion Counter exhaustion counts (8/9) // - Multi-ATR SuperTrend with consensus mode // - EMA Stack (50/100/200) with Golden/Death Cross events // - Bull Market Support Band (20 SMA + 21 EMA) // - Squeeze detection (BB inside KC) // - Supply/Demand zones with quality scoring // - Liquidity Sweeps with emoji markers (💧/🩸) // - 16 Candlestick patterns // - Regime detection background // - MTF Confluence Panel (Badge/Table modes) // - 38 alert conditions // defaults_on: Exhaustion Counter, SuperTrend, EMA 50/100/200, Regime Background, Confluence Panel // defaults_off: Squeeze, Sweeps, Warnings, BMSB, EMA Events, S/D Zones, RCS // plot_count: 11 plots + 2 fills + 1 bgcolor + 38 alerts = 52 (limit: 64) // security_count: 14 (verified: ALL with lookahead_off + gaps_off) // repaint_risk: NONE // ═══════════════════════════════════════════════════ // END: OmniDeck - Unified Chart Overlay // ═══════════════════════════════════════════════════