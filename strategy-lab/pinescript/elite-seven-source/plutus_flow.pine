// ╔════════════════════════════════════════════════════════════════╗ // ║ PLUTUS FLOW - STATISTICAL OBV ANALYSIS ║ // ║ v1.0 • 2026 ║ // ╚════════════════════════════════════════════════════════════════╝ // // ┌────────────────────────────────────────────────────────────────┐ // │ TABLE OF CONTENTS │ // ├────────────────────────────────────────────────────────────────┤ // │ SECTION LINE (approx) │ // │ │ // │ 1. STABILITY HELPERS ................................. ~32 │ // │ 2. USER-DEFINED TYPES ................................ ~38 │ // │ 3. INPUTS / SETTINGS ................................. ~45 │ // │ ├── 3.1 Calculation │ // │ ├── 3.2 Quality (FlipGuard, Z-gate, etc.) │ // │ ├── 3.3 Assists (HTF alignment) │ // │ ├── 3.4 Divergence │ // │ └── 3.5 Visuals │ // │ 4. CONSTANTS ......................................... ~72 │ // │ 5. OBV CALCULATION (spike-clipped) ................... ~82 │ // │ 6. HTF SECURITY CALLS ................................ ~92 │ // │ 7. CORE CALCULATIONS ................................. ~110 │ // │ ├── 7.1 Basis, Bands, Z-score │ // │ └── 7.2 NFI (Normalized Flow Index) │ // │ 8. CROSS SIGNALS (with gates) ........................ ~138 │ // │ ├── 8.1 FlipGuard gate │ // │ ├── 8.2 Strict cross gate │ // │ ├── 8.3 Z-gate (FlipGuard 2.0) │ // │ ├── 8.4 HTF alignment gate │ // │ └── 8.5 Sequence gate │ // │ 9. DIVERGENCE DETECTION .............................. ~190 │ // │ ├── 9.1 Pivot tracking │ // │ ├── 9.2 Sync check │ // │ └── 9.3 ATR filter │ // │ 10. VISUALS .......................................... ~268 │ // │ ├── 10.1 OBV line & ribbon │ // │ ├── 10.2 Bands │ // │ ├── 10.3 Signal dots │ // │ └── 10.4 Divergence labels │ // │ 11. SCREENER PLOTS (hidden) .......................... ~308 │ // │ 12. ALERTS ........................................... ~322 │ // └────────────────────────────────────────────────────────────────┘ // // Non-repainting • All signals confirmed on bar close • 10 alerts // //@version=6 indicator("Plutus Flow - Statistical OBV Analysis", shorttitle="Plutus Flow", overlay=false, max_labels_count=500) // -------------------------------------------------------- // STABILITY HELPERS // -------------------------------------------------------- isClosed = barstate.isconfirmed freezeFloat(float v) => isClosed ? v : (na(v[1]) ? v : v[1]) // -------------------------------------------------------- // USER-DEFINED TYPES // -------------------------------------------------------- type PivotPair float val1 = na int idx1 = na float val2 = na int idx2 = na // -------------------------------------------------------- // INPUTS // -------------------------------------------------------- grp_calc = "Calculation" i_calc_tf = input.timeframe("", "HTF timeframe (blank = chart)", group=grp_calc, tooltip="Calculates OBV on a higher timeframe for smoother signals. Leave blank for chart TF. Use 'D' for daily OBV on intraday charts, 'W' for weekly on daily charts. Higher TF = smoother but slower signals.") grp_qual = "Quality" i_flip_bars = input.int(3, "FlipGuard bars", minval=0, group=grp_qual, tooltip="Minimum bars required between opposite cross signals. Prevents whipsaw during choppy price action. 0 = all signals (noisy). 3 = balanced (default). 5-7 = conservative, fewer whipsaws. 10+ = very few signals, only major trend shifts.") i_strict_x = input.bool(false, "Strict cross gate (basis slope)", group=grp_qual, tooltip="Filters crosses that go against the basis line direction. A bullish cross only fires if basis is rising, bearish only if falling. OFF = all crosses allowed (default). ON = aligned crosses only, reduces signals by ~30-40%.") i_use_robust = input.bool(false, "Robust extremes (MAD-like)", group=grp_qual, tooltip="Switches band calculation from standard deviation to median absolute deviation. More resistant to volume spikes distorting the bands. OFF = standard deviation (default). ON = MAD-based, try for volatile assets like crypto or meme stocks.") i_z_gate_on = input.bool(false, "FlipGuard 2.0: Z-gate (ON/OFF)", group=grp_qual, tooltip="Adds momentum filtering on top of FlipGuard. Cross signals must meet a Z-score threshold to fire. OFF = FlipGuard uses bar count only (default). ON = requires momentum threshold, filters weak crosses on choppy charts.") i_z_min = input.float(0.6, "FG2: min |z| gate", step=0.1, minval=0.0, group=grp_qual, tooltip="Minimum Z-score magnitude required for a cross signal when Z-gate is ON. Measures how far OBV is from basis in standard deviations. 0.3 = permissive, most crosses pass. 0.6 = balanced (default). 1.0+ = strict, only fires on strong momentum moves.") i_z_boost = input.float(0.8, "FG2: boost x last |z|", step=0.05, minval=0.0, maxval=2.0, group=grp_qual, tooltip="After a signal fires, the next threshold becomes: min + (boost × last signal's Z). Creates adaptive filtering that raises the bar after strong signals. 0 = fixed threshold, no adaptation. 0.8 = moderate adaptation (default). 1.5+ = aggressive, hard to fire consecutive signals.") i_z_decay = input.float(0.90, "FG2: per-bar decay", step=0.01, minval=0.5, maxval=1.0, group=grp_qual, tooltip="How fast the boosted threshold decays back to minimum each bar. Controls how long the elevated threshold persists. 0.95 = slow decay, stays elevated longer. 0.90 = balanced (default). 0.80 = fast decay, resets to minimum quickly.") i_seq_win = input.int(0, "Sequence: require recent extreme within N bars (0=off)", minval=0, group=grp_qual, tooltip="Only fires cross signals if OBV touched ±2σ extreme zone within N bars. Filters mid-range crosses, focuses on 'exhaustion then reversal' setups. 0 = OFF, all crosses allowed (default). 10-20 = moderate filter. 15-25 = recommended for exhaustion setups.") grp_assist = "Assists" i_align_tf = input.timeframe("", "Flip gate: HTF alignment timeframe (blank = off)", group=grp_assist, tooltip="Filters crosses that go against higher timeframe OBV direction. Bullish cross only fires if HTF OBV is rising, bearish only if falling. Blank = OFF (default). Use 'D' on 1H charts for daily alignment, 'W' on daily charts for weekly alignment.") grp_div = "Divergence" i_min_px_atr = input.float(0.0, "Min price swing (xATR14) for divergences", step=0.1, minval=0.0, group=grp_div, tooltip="Minimum price swing size (as multiple of 14-period ATR) required to trigger divergence labels. Filters small, noisy divergences on minor pivots. 0 = show all divergences (default). 0.5 = filter tiny swings. 1.0 = only swings larger than 1 ATR. 2.0+ = only major swings.") grp_vis = "Visuals" i_show_div_labels = input.bool(true, "Show divergence labels", group=grp_vis, tooltip="Controls text label display for divergence events (Bull Div, Bear Div, Bull Hid, Bear Hid). ON = show labels (default). OFF = hide labels, but colored divergence dots still plot on the OBV line.") i_show_exits = input.bool(true, "Show extreme zone EXITS", group=grp_vis, tooltip="Controls yellow dot display when OBV exits the ±2σ extreme zones. Exit signals often mark potential reversal points. ON = show yellow exit dots (default). OFF = only show white breach dots when entering extremes.") // -------------------------------------------------------- // CONSTANTS // -------------------------------------------------------- int LEN = 20 // Lookback for basis/bands (balance responsiveness vs noise) float BAND_K = 2.0 // Band width: ±2σ captures ~95% of normal distribution int PIV_L = 3 // Left bars for pivot confirmation int PIV_R = 3 // Right bars for pivot confirmation (also label offset) int SYNC_TOL = 5 // Max bar gap for price/OBV pivot alignment int CLIP_LEN = 50 // Volume averaging period for spike detection float CLIP_MULT = 3.0 // Volume cap: 3x average filters outlier spikes // -------------------------------------------------------- // OBV CALCULATION (spike-clipped) // -------------------------------------------------------- obvClip(_src, _vol) => vAvg = ta.rma(_vol, CLIP_LEN) vEff = math.min(_vol, CLIP_MULT * vAvg) dir = _src > _src[1] ? 1.0 : _src < _src[1] ? -1.0 : 0.0 ta.cum(dir * nz(vEff, 0.0)) // -------------------------------------------------------- // HTF SECURITY CALLS // -------------------------------------------------------- string tf_calc = i_calc_tf == "" ? timeframe.period : i_calc_tf float obv_raw = request.security(syminfo.tickerid, tf_calc, obvClip(close, volume), barmerge.gaps_off, barmerge.lookahead_off) // HTF alignment htfAlignCalcs() => _obv = obvClip(close, volume) _basis = ta.sma(_obv, LEN) [_basis, _basis[1]] string tf_align = i_align_tf == "" ? timeframe.period : i_align_tf [basis_htf, basis_htf_prev] = request.security(syminfo.tickerid, tf_align, htfAlignCalcs(), barmerge.gaps_off, barmerge.lookahead_off) int htf_slope = 0 if i_align_tf != "" htf_slope := basis_htf > basis_htf_prev ? 1 : basis_htf < basis_htf_prev ? -1 : 0 // -------------------------------------------------------- // CORE CALCULATIONS // -------------------------------------------------------- basis_raw = ta.sma(obv_raw, LEN) resid_raw = obv_raw - basis_raw sigma_raw = ta.stdev(resid_raw, LEN) upper_raw = basis_raw + BAND_K * sigma_raw lower_raw = basis_raw - BAND_K * sigma_raw obv = freezeFloat(obv_raw) basis = freezeFloat(basis_raw) sigma = freezeFloat(sigma_raw) upper = freezeFloat(upper_raw) lower = freezeFloat(lower_raw) // Z-score calculations float z_std = not na(sigma) and sigma != 0.0 ? freezeFloat((obv_raw - basis_raw) / sigma_raw) : na float ead = freezeFloat(ta.rma(math.abs(resid_raw), LEN)) float z_rob = ead != 0.0 ? freezeFloat((obv_raw - basis_raw) / (1.253 * ead)) : na float z_eff = i_use_robust ? z_rob : z_std // NFI (Normalized Flow Index): 0-100 scale for screener compatibility // Uses tanh to compress z-score into bounded range spTanhf(x) => ex2 = math.exp(2.0 * x) (ex2 - 1.0) / (ex2 + 1.0) float nfi = not na(z_eff) ? freezeFloat(50.0 + 50.0 * spTanhf(z_eff / 2.0)) : na // -------------------------------------------------------- // CROSS SIGNALS (with gates) // -------------------------------------------------------- cross_up_raw = ta.crossover(obv, basis) cross_down_raw = ta.crossunder(obv, basis) var int last_cross_up_bar = na var int last_cross_down_bar = na if cross_up_raw last_cross_up_bar := bar_index if cross_down_raw last_cross_down_bar := bar_index int bars_since_up = na(last_cross_up_bar) ? 999999 : bar_index - last_cross_up_bar int bars_since_down = na(last_cross_down_bar) ? 999999 : bar_index - last_cross_down_bar // FlipGuard gate bool flip_gated_up = cross_up_raw and (i_flip_bars == 0 or bars_since_down >= i_flip_bars) bool flip_gated_down = cross_down_raw and (i_flip_bars == 0 or bars_since_up >= i_flip_bars) // Strict cross gate float basis_slope = basis - basis[1] bool strict_gated_up = not i_strict_x or basis_slope > 0.0 bool strict_gated_down = not i_strict_x or basis_slope < 0.0 // Z-gate (FlipGuard 2.0) var float last_abs_z = 0.0 float z_thr = i_z_min + (i_z_boost * last_abs_z) if isClosed and (flip_gated_up or flip_gated_down) last_abs_z := math.abs(z_eff) else last_abs_z *= i_z_decay bool z_gated = not i_z_gate_on or math.abs(z_eff) >= z_thr // HTF alignment gate bool htf_gated_up = i_align_tf == "" or htf_slope >= 0 bool htf_gated_down = i_align_tf == "" or htf_slope <= 0 // Sequence gate int bars_since_extreme = ta.barssince(math.abs(z_eff) >= BAND_K) bool seq_gated = i_seq_win == 0 or bars_since_extreme < i_seq_win // Final cross signals bool sig_cross_up = flip_gated_up and strict_gated_up and z_gated and htf_gated_up and seq_gated bool sig_cross_down = flip_gated_down and strict_gated_down and z_gated and htf_gated_down and seq_gated // Extreme zone signals bool breach_up = z_eff >= BAND_K and z_eff[1] < BAND_K bool breach_down = z_eff <= -BAND_K and z_eff[1] > -BAND_K bool exit_up = z_eff < BAND_K and z_eff[1] >= BAND_K bool exit_down = z_eff > -BAND_K and z_eff[1] <= -BAND_K // -------------------------------------------------------- // DIVERGENCE DETECTION // -------------------------------------------------------- ph = ta.pivothigh(close, PIV_L, PIV_R) pl = ta.pivotlow(close, PIV_L, PIV_R) oh = ta.pivothigh(obv, PIV_L, PIV_R) ol = ta.pivotlow(obv, PIV_L, PIV_R) var PivotPair priceHighs = PivotPair.new() var PivotPair priceLows = PivotPair.new() var PivotPair obvHighs = PivotPair.new() var PivotPair obvLows = PivotPair.new() if not na(ph) priceHighs.val2 := priceHighs.val1 priceHighs.idx2 := priceHighs.idx1 priceHighs.val1 := ph priceHighs.idx1 := bar_index - PIV_R if not na(pl) priceLows.val2 := priceLows.val1 priceLows.idx2 := priceLows.idx1 priceLows.val1 := pl priceLows.idx1 := bar_index - PIV_R if not na(oh) obvHighs.val2 := obvHighs.val1 obvHighs.idx2 := obvHighs.idx1 obvHighs.val1 := oh obvHighs.idx1 := bar_index - PIV_R if not na(ol) obvLows.val2 := obvLows.val1 obvLows.idx2 := obvLows.idx1 obvLows.val1 := ol obvLows.idx1 := bar_index - PIV_R // Sync check: price and OBV pivots must occur within SYNC_TOL bars of each other bool sync_high = not na(priceHighs.val1) and not na(priceHighs.val2) and not na(obvHighs.val1) and not na(obvHighs.val2) and math.abs(priceHighs.idx2 - obvHighs.idx2) <= SYNC_TOL and math.abs(priceHighs.idx1 - obvHighs.idx1) <= SYNC_TOL bool sync_low = not na(priceLows.val1) and not na(priceLows.val2) and not na(obvLows.val1) and not na(obvLows.val2) and math.abs(priceLows.idx2 - obvLows.idx2) <= SYNC_TOL and math.abs(priceLows.idx1 - obvLows.idx1) <= SYNC_TOL // Base divergence conditions // Regular: price and OBV disagree (potential reversal) // Hidden: price and OBV disagree opposite way (potential continuation) bool bear_reg_base = not na(ph) and sync_high and (priceHighs.val1 > priceHighs.val2) and (obvHighs.val1 < obvHighs.val2) bool bear_hid_base = not na(ph) and sync_high and (priceHighs.val1 < priceHighs.val2) and (obvHighs.val1 > obvHighs.val2) bool bull_reg_base = not na(pl) and sync_low and (priceLows.val1 < priceLows.val2) and (obvLows.val1 > obvLows.val2) bool bull_hid_base = not na(pl) and sync_low and (priceLows.val1 > priceLows.val2) and (obvLows.val1 < obvLows.val2) // ATR filter float swing_thr = i_min_px_atr * ta.atr(14) bool big_high = not na(priceHighs.val1) and not na(priceHighs.val2) ? math.abs(priceHighs.val2 - priceHighs.val1) >= swing_thr : false bool big_low = not na(priceLows.val1) and not na(priceLows.val2) ? math.abs(priceLows.val2 - priceLows.val1) >= swing_thr : false // Final divergence signals bool bear_reg = bear_reg_base and (i_min_px_atr <= 0.0 or big_high) bool bear_hid = bear_hid_base and (i_min_px_atr <= 0.0 or big_high) bool bull_reg = bull_reg_base and (i_min_px_atr <= 0.0 or big_low) bool bull_hid = bull_hid_base and (i_min_px_atr <= 0.0 or big_low) // -------------------------------------------------------- // VISUALS // -------------------------------------------------------- color col_obv = (obv > basis and obv > obv[1]) ? color.new(#00FF7F, 0) : (obv < basis and obv < obv[1]) ? color.new(#FF4560, 0) : color.new(#8B95A1, 0) color col_ribbon = obv >= basis ? color.new(#00FF7F, 80) : color.new(#FF4560, 80) p_obv = plot(obv, title="OBV", color=col_obv, linewidth=2) p_basis = plot(basis, title="Basis", color=color.new(#FFAB00, 0), linewidth=1) fill(p_obv, p_basis, color=col_ribbon, title="Ribbon") p_upper = plot(upper, title="Upper Band", color=color.new(#00FF7F, 30), linewidth=1) p_lower = plot(lower, title="Lower Band", color=color.new(#00FF7F, 30), linewidth=1) fill(p_upper, p_lower, color=color.new(#00FF7F, 96), title="Band Fill") float dot_offset = sigma * 0.10 // Signal dots plot(breach_up ? obv + dot_offset : na, title="Breach Up", style=plot.style_circles, color=color.new(#FFFFFF, 15), linewidth=3) plot(breach_down ? obv - dot_offset : na, title="Breach Down", style=plot.style_circles, color=color.new(#FFFFFF, 15), linewidth=3) plot(i_show_exits and exit_up ? obv + dot_offset : na, title="Exit Up", style=plot.style_circles, color=color.new(#FFD700, 25), linewidth=2) plot(i_show_exits and exit_down ? obv - dot_offset : na, title="Exit Down", style=plot.style_circles, color=color.new(#FFD700, 25), linewidth=2) plot(sig_cross_up ? obv + dot_offset : na, title="CrossUp", style=plot.style_circles, color=color.new(#00FF7F, 30), linewidth=3) plot(sig_cross_down ? obv - dot_offset : na, title="CrossDn", style=plot.style_circles, color=color.new(#FF4560, 30), linewidth=3) // Divergence dots plot(bear_reg ? obv[PIV_R] + dot_offset : na, title="Bear Div Dot", style=plot.style_circles, color=color.new(#FF4560, 40), linewidth=1, offset=-PIV_R) plot(bear_hid ? obv[PIV_R] + dot_offset : na, title="Bear Hid Dot", style=plot.style_circles, color=color.new(#FF758F, 40), linewidth=1, offset=-PIV_R) plot(bull_reg ? obv[PIV_R] - dot_offset : na, title="Bull Div Dot", style=plot.style_circles, color=color.new(#00FF7F, 40), linewidth=1, offset=-PIV_R) plot(bull_hid ? obv[PIV_R] - dot_offset : na, title="Bull Hid Dot", style=plot.style_circles, color=color.new(#3DFFE5, 40), linewidth=1, offset=-PIV_R) // Divergence labels if i_show_div_labels and isClosed and bear_reg label.new(bar_index - PIV_R, obv[PIV_R] + dot_offset * 3, "Bear Div", color=color.new(#FF4560, 70), textcolor=#FF4560, style=label.style_label_down, size=size.small) if i_show_div_labels and isClosed and bear_hid label.new(bar_index - PIV_R, obv[PIV_R] + dot_offset * 3, "Bear Hid", color=color.new(#FF758F, 70), textcolor=#FF758F, style=label.style_label_down, size=size.small) if i_show_div_labels and isClosed and bull_reg label.new(bar_index - PIV_R, obv[PIV_R] - dot_offset * 3, "Bull Div", color=color.new(#00FF7F, 70), textcolor=#00FF7F, style=label.style_label_up, size=size.small) if i_show_div_labels and isClosed and bull_hid label.new(bar_index - PIV_R, obv[PIV_R] - dot_offset * 3, "Bull Hid", color=color.new(#3DFFE5, 70), textcolor=#3DFFE5, style=label.style_label_up, size=size.small) // -------------------------------------------------------- // SCREENER PLOTS (Hidden) // -------------------------------------------------------- plot(isClosed and sig_cross_up ? 1 : na, title="Scr_CrossUp", display=display.none) plot(isClosed and sig_cross_down ? 1 : na, title="Scr_CrossDown", display=display.none) plot(isClosed and breach_up ? 1 : na, title="Scr_BreachUp", display=display.none) plot(isClosed and breach_down ? 1 : na, title="Scr_BreachDown", display=display.none) plot(isClosed and exit_up ? 1 : na, title="Scr_ExitUp", display=display.none) plot(isClosed and exit_down ? 1 : na, title="Scr_ExitDown", display=display.none) plot(isClosed and bull_reg ? 1 : na, title="Scr_BullDiv", display=display.none) plot(isClosed and bear_reg ? 1 : na, title="Scr_BearDiv", display=display.none) plot(isClosed and bull_hid ? 1 : na, title="Scr_BullHid", display=display.none) plot(isClosed and bear_hid ? 1 : na, title="Scr_BearHid", display=display.none) plot(isClosed and obv >= basis ? 1 : na, title="Scr_AboveBasis", display=display.none) plot(nfi, title="Scr_NFI", display=display.none) // -------------------------------------------------------- // ALERTS // -------------------------------------------------------- alertcondition(isClosed and sig_cross_up, title="Plutus | CrossUp", message="Plutus Flow - OBV crossed ABOVE basis.") alertcondition(isClosed and sig_cross_down, title="Plutus | CrossDown", message="Plutus Flow - OBV crossed BELOW basis.") alertcondition(isClosed and breach_up, title="Plutus | Breach +2s", message="Plutus Flow - Flow BREACHED into +2s overbought zone.") alertcondition(isClosed and breach_down, title="Plutus | Breach -2s", message="Plutus Flow - Flow BREACHED into -2s oversold zone.") alertcondition(isClosed and exit_up, title="Plutus | Exit +2s", message="Plutus Flow - Flow EXITED +2s zone (potential reversal down).") alertcondition(isClosed and exit_down, title="Plutus | Exit -2s", message="Plutus Flow - Flow EXITED -2s zone (potential reversal up).") alertcondition(isClosed and bull_reg, title="Plutus | Bull Div", message="Plutus Flow - Regular Bullish Divergence detected.") alertcondition(isClosed and bear_reg, title="Plutus | Bear Div", message="Plutus Flow - Regular Bearish Divergence detected.") alertcondition(isClosed and bull_hid, title="Plutus | Bull Hid", message="Plutus Flow - Hidden Bullish Divergence detected.") alertcondition(isClosed and bear_hid, title="Plutus | Bear Hid", message="Plutus Flow - Hidden Bearish Divergence detected.") // ╔════════════════════════════════════════════════════════════════╗ // ║ END: Plutus Flow v1.0 ║ // ╚════════════════════════════════════════════════════════════════╝