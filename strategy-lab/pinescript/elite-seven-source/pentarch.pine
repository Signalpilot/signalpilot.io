// ═══════════════════════════════════════════════════════════════════════════
// SECTION 3: TIMEFRAME DETECTION & PARAMETER LOOKUP
// ═══════════════════════════════════════════════════════════════════════════
// ─────────────────────────── Timeframe Classification ──────────────────────
float tfSec = timeframe.in_seconds(timeframe.period)
int   TF    = int(math.round(tfSec / 60.0))
bool lowTF      = TF <= 5
bool midTF      = TF > 5 and TF <= 30
bool hiTF       = TF > 30 and TF < 240
bool hiPlus     = TF >= 240
bool positionTF = TF >= 4320
// ─────────────────────────── HTF Timeframe Selection ───────────────────────
// Determine HTF string for request.security
getHTFTimeframe() =>
result = "D"
if htfInput == "1H"
result := "60"
else if htfInput == "4H"
result := "240"
else if htfInput == "Daily"
result := "D"
else if htfInput == "Weekly"
result := "W"
else  // Auto
if TF <= 60
result := "240"    // 4H for charts ≤1H
else if TF <= 240
result := "D"      // Daily for 4H charts
else
result := "W"      // Weekly for Daily+
result
htfTimeframe = getHTFTimeframe()
// ─────────────────────────── Timeframe Index Mapping ───────────────────────
tfIndex() =>
switch TF
1      => 0
5      => 1
15     => 2
30     => 3
60     => 4
120    => 5
240    => 6
360    => 7
480    => 8
720    => 9
1440   => 10
4320   => 11
10080  => 12
20160  => 13
43200  => 14
129600 => 15
259200 => 16
525600 => 17
=> 4
