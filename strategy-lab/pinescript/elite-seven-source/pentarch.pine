// │  1. INPUTS / SETTINGS ................................. ~55    │
// │     ├── 1.1 Core Display                                       │
// │     ├── 1.2 Signal Filtering (Strict Mode, HTF Filter)         │
// │     ├── 1.3 Event Visibility                                   │
// │     ├── 1.4 Info Panel                                         │
// │     ├── 1.5 Additional Signals                                 │
// │     ├── 1.6 Colors                                             │
// │     └── 1.7 Alerts                                             │
// │  2. CONSTANTS ......................................... ~220   │
// │  3. TIMEFRAME PARAMETERS .............................. ~440   │
// │  4. CORE CALCULATIONS ................................. ~710   │
// │     ├── 4.1 Price Data                                         │
// │     ├── 4.2 EMAs & Pilot Line                                  │
// │     ├── 4.3 Stochastic                                         │
// │     ├── 4.4 ATR & Distance                                     │
// │     ├── 4.5 Regime Detection                                   │
// │     └── 4.6 HTF Data                                           │
// │  5. EVENT DETECTION ................................... ~860   │
// │  6. COOLDOWN & EXCLUSIVITY ............................ ~1070  │
// │  7. ADDITIONAL SIGNALS ................................ ~1100  │
// │  8. INFO PANEL ........................................ ~1150  │
// │  9. VISUALS ........................................... ~1280  │
// │  10. ALERTS ........................................... ~1350  │
// └────────────────────────────────────────────────────────────────┘
//
// Non-repainting • All signals confirmed on bar close • 13 alerts
//
// ┌────────────────────────────────────────────────────────────────┐
// │                      CYCLE EVENTS                              │
// ├────────────────────────────────────────────────────────────────┤
// │  TD  (Touchdown)  →  Accumulation phase detection              │
// │  IGN (Ignition)   →  Markup phase detection                    │
// │  WRN (Warning)    →  Distribution phase detection              │
// │  CAP (Climax)     →  Climax phase detection                    │
// │  BDN (Breakdown)  →  Decline phase detection                   │
// └────────────────────────────────────────────────────────────────┘
//
indicator("Pentarch - Cycle Phase Detection", overlay=true, shorttitle="Pentarch", max_labels_count=500)
// ═══════════════════════════════════════════════════════════════════════════
// SECTION 1: USER INPUTS
// ═══════════════════════════════════════════════════════════════════════════
// ─────────────────────────── Core Display ──────────────────────────────────
bool showPilotLine = input.bool(true, "Show Pilot Line", 
tooltip="The Pilot Line is a double-smoothed EMA34 that serves as the trend anchor. Color indicates slope direction: green = rising, red = falling, orange = flat/transitioning.",
group="Core Display")
bool showRegimeBar = input.bool(true, "Show Regime Bar Coloring", 
tooltip="Colors candles based on the current regime state. Green = bullish regime, Red = bearish regime. Event signals override this coloring when they fire.",
group="Core Display")
// ─────────────────────────── Signal Filtering ──────────────────────────────
bool strictMode = input.bool(false, "Strict Mode", 
tooltip="Makes all thresholds 1.5x stricter. Fewer signals fire, but only the highest-quality setups pass. Good for position traders or noisy lower timeframes.",
group="Signal Filtering")
bool useHTFFilter = input.bool(false, "HTF Trend Filter", 
tooltip="Filters signals against higher timeframe trend direction. When enabled: IGN requires HTF uptrend (don't go long against bigger downtrend). BDN requires HTF downtrend (don't go short against bigger uptrend). TD, WRN, CAP fire regardless of HTF.",
group="Signal Filtering")
string htfInput = input.string("Auto", "HTF Timeframe", 
options=["Auto", "1H", "4H", "Daily", "Weekly"],
tooltip="Which higher timeframe to check. 'Auto' selects: 4H for charts ≤1H, Daily for 4H charts, Weekly for Daily+ charts.",
group="Signal Filtering")
// ─────────────────────────── Event Visibility ──────────────────────────────
bool showTD = input.bool(true, "Show TD Labels", 
tooltip="TD (Touchdown) - Accumulation phase detection. Fires when price shows oversold conditions with momentum turning up.",
group="Event Visibility")
bool showIGN = input.bool(true, "Show IGN Labels", 
tooltip="IGN (Ignition) - Markup phase detection. Fires when momentum shifts bullish with structure confirmation.",
group="Event Visibility")
bool showWRN = input.bool(true, "Show WRN Labels", 
tooltip="WRN (Warning) - Distribution phase detection. Fires when price is extended with momentum fading.",
group="Event Visibility")
bool showCAP = input.bool(true, "Show CAP Labels", 
tooltip="CAP (Climax) - Climax phase detection. Fires at extreme price extension with exhaustion characteristics.",
group="Event Visibility")
bool showBDN = input.bool(true, "Show BDN Labels", 
tooltip="BDN (Breakdown) - Decline phase detection. Fires when structure breaks bearish after distribution or climax.",
group="Event Visibility")
string labelSizeInput = input.string("Tiny", "Label Size",
options=["Tiny", "Small", "Normal", "Large"],
tooltip="Size of cycle event labels. 'Tiny' = smallest, best for clean charts. 'Large' = most visible, good for screenshots.",
group="Event Visibility")
bool szTiny   = labelSizeInput == "Tiny"
bool szSmall  = labelSizeInput == "Small"
bool szNormal = labelSizeInput == "Normal"
bool szLarge  = labelSizeInput == "Large"
// ─────────────────────────── Info Panel ────────────────────────────────────
bool showInfoPanel = input.bool(true, "Show Info Panel", 
tooltip="Displays a compact status panel with key information at a glance.",
group="Info Panel")
string panelPosition = input.string("Top Right", "Panel Position",
options=["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left", "Top Center", "Bottom Center", "Middle Center"],
tooltip="Where to display the info panel on the chart.",
group="Info Panel")
bool showRowRegime = input.bool(true, "Row: Regime", 
tooltip="Show current timeframe regime (BULL/BEAR).",
group="Info Panel")
bool showRowLastEvent = input.bool(true, "Row: Last Event", 
tooltip="Show last event type and bars since it fired.",
group="Info Panel")
bool showRowQuality = input.bool(true, "Row: Quality", 
tooltip="Show quality rating of the last event (STRONG/GOOD/MODERATE/WEAK with stars).",
group="Info Panel")
bool showRowStoch = input.bool(true, "Row: Stoch", 
tooltip="Show stochastic zone with value and direction arrow.",
group="Info Panel")
bool showRowPLDist = input.bool(true, "Row: PL Distance", 
tooltip="Show distance from Pilot Line in ATR units.",
group="Info Panel")
bool showRowVolume = input.bool(true, "Row: Volume", 
tooltip="Show current volume relative to average (e.g., 1.4x AVG).",
group="Info Panel")
// ─────────────────────────── Additional Signals ────────────────────────────
bool showNanoFlow = input.bool(true, "Show NanoFlow Crosses", 
tooltip="NanoFlow shows micro trend alignment crosses. Appears below price when fast EMAs align bullish, above price when bearish.",
group="Additional Signals")
bool showBreakouts = input.bool(true, "Show Momentum Thrust Arrows", 
tooltip="Momentum Thrust arrows mark potential breakout points where price exceeds recent range with expanding ATR.",
group="Additional Signals")
// ─────────────────────────── Event Colors ──────────────────────────────────
color TD_COL  = input.color(color.rgb(153, 102, 204), "TD Color", group="Event Colors")
color IGN_COL = input.color(color.rgb(70, 180, 255), "IGN Color", group="Event Colors")
color WRN_COL = input.color(color.rgb(255, 160, 120), "WRN Color", group="Event Colors")
color CAP_COL = input.color(color.rgb(250, 90, 90), "CAP Color", group="Event Colors")
color BDN_COL = input.color(color.rgb(220, 120, 200), "BDN Color", group="Event Colors")
// ─────────────────────────── Signal Colors ─────────────────────────────────
color BO_UP = input.color(color.rgb(100, 255, 218), "Momentum Thrust Bull", group="Signal Colors")
color BO_DN = input.color(color.rgb(255, 82, 82), "Momentum Thrust Bear", group="Signal Colors")
color REGIME_BULL = input.color(color.rgb(0, 180, 100), "Regime Bull Candles", group="Signal Colors")
color REGIME_BEAR = input.color(color.rgb(200, 70, 70), "Regime Bear Candles", group="Signal Colors")
// ─────────────────────────── Alert Settings ────────────────────────────────
bool alertTD  = input.bool(true, "Alert: Touchdown (TD)", group="Alerts")
bool alertIGN = input.bool(true, "Alert: Ignition (IGN)", group="Alerts")
bool alertWRN = input.bool(true, "Alert: Warning (WRN)", group="Alerts")
bool alertCAP = input.bool(true, "Alert: Climax (CAP)", group="Alerts")
bool alertBDN = input.bool(true, "Alert: Breakdown (BDN)", group="Alerts")
