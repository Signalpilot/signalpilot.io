// ╔════════════════════════════════════════════════════════════════╗ // ║ HARMONIC OSCILLATOR - MULTI-COMPONENT MOMENTUM ║ // ║ v1.0 • 2026 ║ // ╚════════════════════════════════════════════════════════════════╝ // // ┌────────────────────────────────────────────────────────────────┐ // │ TABLE OF CONTENTS │ // ├────────────────────────────────────────────────────────────────┤ // │ SECTION LINE (approx) │ // │ │ // │ 1. INPUTS / SETTINGS ................................. ~47 │ // │ 2. CONSTANTS ......................................... ~61 │ // │ ├── 2.1 Color Palette │ // │ ├── 2.2 Stability Helpers │ // │ ├── 2.3 Timeframe Detection │ // │ └── 2.4 Core Constants │ // │ 3. HELPER FUNCTIONS .................................. ~109 │ // │ 4. HTF SECURITY CALLS ................................ ~138 │ // │ 5. CORE CALCULATIONS ................................. ~149 │ // │ ├── 5.1 MACD Component │ // │ ├── 5.2 RSI Component │ // │ ├── 5.3 Stochastic RSI Component │ // │ ├── 5.4 Trend & Momentum Votes │ // │ └── 5.5 Volume │ // │ 6. VOTING SYSTEM ..................................... ~216 │ // │ 7. COMPOSITE OSCILLATOR .............................. ~245 │ // │ 8. SIGNAL LOGIC ...................................... ~258 │ // │ ├── 8.1 Divergence Detection │ // │ ├── 8.2 Regime Detection │ // │ └── 8.3 Crossover / Extreme Detection │ // │ 9. VISUALS ........................................... ~315 │ // │ ├── 9.1 Zone Fills │ // │ ├── 9.2 Main Oscillator │ // │ ├── 9.3 Consensus Meter │ // │ ├── 9.4 Divergence Labels │ // │ └── 9.5 Status Panel │ // │ 10. SCREENER PLOTS ................................... ~502 │ // │ 11. ALERTS ........................................... ~511 │ // └────────────────────────────────────────────────────────────────┘ // // 7-component voting • Non-repainting • 14 alerts // //@version=6 indicator("Harmonic Oscillator - Multi-Component Momentum Consensus", shorttitle="Harmonic Oscillator", overlay=false, precision=2, max_lines_count=100, max_labels_count=100, max_boxes_count=100) // ───────────────────────────────────────────────── // INPUTS // ───────────────────────────────────────────────── sp_mode = input.string("Balanced", "Signal Mode", options=["Conservative", "Balanced", "Aggressive"], group="Core Settings", tooltip="Controls vote threshold for High Consensus alerts. Only affects alerts, no visual change. 'Conservative' = 6+ votes required, fewer alerts, higher quality. 'Balanced' = 5+ votes (default). 'Aggressive' = 4+ votes, more alerts, catches more moves.") sp_use_htf = input.bool(true, "Use Higher Timeframe Filter", group="Core Settings", tooltip="Filters divergence signals by higher timeframe trend direction. Reduces counter-trend signals. ON = bullish divergences only when HTF bullish, bearish only when HTF bearish (default). OFF = all divergences shown regardless of HTF trend.") sp_htf_tf = input.timeframe("240", "HTF Timeframe", group="Core Settings", tooltip="Timeframe used for HTF trend filter. Checks if price is above/below 50 EMA to determine trend. '60' = 1H on lower TFs. '240' = 4H (default). 'D' = daily for swing traders. 'W' = weekly for position traders.") sp_show_divs = input.bool(true, "Show Divergences", group="Display", tooltip="Displays bullish/bearish divergence labels when price and oscillator disagree. ON = show ▲ DIV and ▼ DIV labels at extreme zones (default). OFF = hide divergence labels, cleaner chart.") sp_show_consensus = input.bool(true, "Show Consensus Meter", group="Display", tooltip="Displays vote count bar at bottom of oscillator panel. Shows how many of 7 components agree on direction. ON = colored bar showing consensus strength (default). OFF = hide meter for cleaner oscillator view.") sp_show_table = input.bool(true, "Show Status Panel", group="Display", tooltip="Displays info table with regime, vote count, and component status. ON = show panel with TRENDING/BIAS/RANGING regime and 7 component arrows (default). OFF = hide panel for cleaner chart.") sp_table_size = input.string("Tiny", "Table Font Size", options=["Tiny", "Small", "Normal"], group="Display", tooltip="Font size for status panel text. 'Tiny' = smallest, best for small screens or multiple indicators (default). 'Small' = medium readability. 'Normal' = largest, best for presentations or screenshots.") sp_table_pos = input.string("Top Right", "Table Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group="Display", tooltip="Position of status panel on chart. 'Top Right' = default, out of the way. Use 'Bottom' positions if you have other indicators at top. Use 'Left' if price action is on right side of chart.") sp_table_layout = input.string("Vertical", "Table Layout", options=["Horizontal", "Vertical"], group="Display", tooltip="Layout orientation for status panel. 'Vertical' = compact stacked rows, best for mobile and small panels (default). 'Horizontal' = wide 2-row layout, best for desktop with space.") sp_show_zones = input.bool(true, "Show OB/OS Zone Fills", group="Display", tooltip="Displays colored background fills for extreme zones on the oscillator. ON = show red fill above 75 (overbought) and green fill below 25 (oversold) (default). OFF = hide zone fills for cleaner oscillator.") // ───────────────────────────────────────────────── // COLOR PALETTE (Soft Green/Red) // ───────────────────────────────────────────────── color sp_col_bull = #00c853 color sp_col_bear = #ef5350 color sp_col_neutral = #78909c color sp_col_signal = #42a5f5 color sp_col_orange = #ff9800 // ───────────────────────────────────────────────── // STABILITY HELPERS // ───────────────────────────────────────────────── isClosed = barstate.isconfirmed freezeFloat(series float v) => isClosed ? v : nz(v[1], v) freezeBool(series bool b) => isClosed ? b : (barstate.isfirst ? false : b[1]) // ───────────────────────────────────────────────── // TIMEFRAME DETECTION // ───────────────────────────────────────────────── int sp_tf_minutes = timeframe.in_seconds(timeframe.period) / 60 bool sp_is_position = sp_tf_minutes > 240 float sp_ob = 75.0 float sp_os = 25.0 float sp_ob_extreme = 85.0 float sp_os_extreme = 15.0 // Adaptive thresholds (position TF uses looser levels) float sp_ob_logic = sp_is_position ? 70.0 : 75.0 float sp_os_logic = sp_is_position ? 30.0 : 25.0 float sp_ob_extreme_logic = sp_is_position ? 80.0 : 85.0 float sp_os_extreme_logic = sp_is_position ? 20.0 : 15.0 int sp_consensus_min = 1 int sp_mode_threshold = sp_mode == "Conservative" ? 6 : sp_mode == "Aggressive" ? 4 : 5 // ───────────────────────────────────────────────── // CORE CONSTANTS // ───────────────────────────────────────────────── int sp_norm_len = 200 float sp_winsor_k = 3.0 int sp_smooth_len = 7 int sp_div_l = 3 int sp_div_r = 3 int sp_vol_avg_len = 20 // ───────────────────────────────────────────────── // HELPER FUNCTIONS // ───────────────────────────────────────────────── spRobustNorm(series float s, int len, float k) => float mu = ta.sma(s, len) float sd = ta.stdev(s, len) float lo = mu - k * sd float hi = mu + k * sd float clipped = math.min(math.max(s, lo), hi) float ll = ta.lowest(clipped, len) float hh = ta.highest(clipped, len) float rng = hh - ll float nzr = rng == 0.0 ? 1e-10 : rng 100.0 * (clipped - ll) / nzr spAdx(int _len) => float _up = high - nz(high[1]) float _down = nz(low[1]) - low float _plusDM = (_up > 0 and _up > _down) ? _up : 0.0 float _minusDM = (_down > 0 and _down > _up) ? _down : 0.0 float _tr = math.max(high - low, math.max(math.abs(high - nz(close[1])), math.abs(low - nz(close[1])))) float _trSm = ta.rma(_tr, _len) float _plusSm = ta.rma(_plusDM, _len) float _minusSm = ta.rma(_minusDM, _len) float _plusDI = 100.0 * _plusSm / nz(_trSm, 1e-10) float _minusDI = 100.0 * _minusSm / nz(_trSm, 1e-10) float _dx = 100.0 * math.abs(_plusDI - _minusDI) / nz(_plusDI + _minusDI, 1e-10) ta.rma(_dx, _len) // ───────────────────────────────────────────────── // HTF SECURITY CALLS // ───────────────────────────────────────────────── bool sp_htf_bull = true bool sp_htf_bear = true if sp_use_htf [htf_ema, htf_close] = request.security(syminfo.tickerid, sp_htf_tf, [ta.ema(close, 50)[1], close[1]], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off) sp_htf_bull := htf_close > htf_ema sp_htf_bear := htf_close < htf_ema // ───────────────────────────────────────────────── // CORE LOGIC - MACD // ───────────────────────────────────────────────── float sp_ema_fast = ta.ema(close, 12) float sp_ema_slow = ta.ema(close, 26) float sp_macd_line = sp_ema_fast - sp_ema_slow float sp_sig_line = ta.ema(sp_macd_line, 9) float sp_macd_hist = sp_macd_line - sp_sig_line float sp_adx_val = spAdx(14) float sp_d_hist = sp_macd_hist - nz(sp_macd_hist[1]) float sp_baseline = ta.ema(close, 200) bool sp_base_up = sp_baseline > nz(sp_baseline[1]) bool sp_base_dn = sp_baseline < nz(sp_baseline[1]) bool sp_macd_bull_q = freezeBool((sp_macd_hist > 0 and sp_d_hist > 0) or (sp_macd_hist < 0 and sp_d_hist > 0 and sp_d_hist > nz(sp_d_hist[1]))) bool sp_macd_bear_q = freezeBool((sp_macd_hist < 0 and sp_d_hist < 0) or (sp_macd_hist > 0 and sp_d_hist < 0 and sp_d_hist < nz(sp_d_hist[1]))) float sp_macd_n = freezeFloat(spRobustNorm(sp_macd_hist, sp_norm_len, sp_winsor_k)) // ───────────────────────────────────────────────── // CORE LOGIC - RSI // ───────────────────────────────────────────────── float sp_rsi_raw = ta.rsi(close, 14) float sp_rsi_b = ta.rma(sp_rsi_raw, 5) bool sp_sl_up = sp_rsi_b > sp_rsi_b[1] bool sp_sl_dn = sp_rsi_b < sp_rsi_b[1] bool sp_rsi_bull = freezeBool((sp_rsi_b > 50 and sp_sl_up) or (sp_rsi_b < 30 and sp_sl_up) or (sp_rsi_b > sp_rsi_b[2] + 3)) bool sp_rsi_bear = freezeBool((sp_rsi_b < 50 and sp_sl_dn) or (sp_rsi_b > 70 and sp_sl_dn) or (sp_rsi_b < sp_rsi_b[2] - 3)) float sp_rsi_n = freezeFloat(spRobustNorm(sp_rsi_b, sp_norm_len, sp_winsor_k)) // ───────────────────────────────────────────────── // CORE LOGIC - Stoch RSI // ───────────────────────────────────────────────── float sp_ll_r = ta.lowest(sp_rsi_raw, 14) float sp_hh_r = ta.highest(sp_rsi_raw, 14) float sp_k_raw = (sp_hh_r - sp_ll_r) != 0 ? 100.0 * (sp_rsi_raw - sp_ll_r) / (sp_hh_r - sp_ll_r) : 50.0 float sp_k_sm = ta.ema(sp_k_raw, 3) float sp_d_sm = ta.ema(sp_k_sm, 3) float sp_k_use = freezeFloat(sp_k_sm) float sp_d_use = freezeFloat(sp_d_sm) float sp_k_slope = ta.ema(sp_k_use - nz(sp_k_use[1]), 3) bool sp_srsi_bull_q = freezeBool((sp_k_use > sp_d_use and sp_k_slope > 0) or (sp_k_use < 30 and sp_k_slope > 0)) bool sp_srsi_bear_q = freezeBool((sp_k_use < sp_d_use and sp_k_slope < 0) or (sp_k_use > 70 and sp_k_slope < 0)) float sp_srsi_n = freezeFloat(spRobustNorm(sp_k_use, sp_norm_len, sp_winsor_k)) // ───────────────────────────────────────────────── // TREND & MOMENTUM VOTES // ───────────────────────────────────────────────── float sp_ema20 = ta.ema(close, 20) float sp_ema20_slope = sp_ema20 - nz(sp_ema20[1]) bool sp_trend_bull = close > sp_ema20 and sp_ema20_slope > 0 bool sp_trend_bear = close < sp_ema20 and sp_ema20_slope < 0 float sp_roc = ta.roc(close, 5) float sp_roc_smooth = ta.ema(sp_roc, 3) bool sp_mom_bull = sp_roc_smooth > 0 and sp_roc_smooth > nz(sp_roc_smooth[1]) bool sp_mom_bear = sp_roc_smooth < 0 and sp_roc_smooth < nz(sp_roc_smooth[1]) // ───────────────────────────────────────────────── // VOLUME // ───────────────────────────────────────────────── float sp_vol_current = volume float sp_vol_avg = ta.sma(volume, sp_vol_avg_len) float sp_vol_current_ratio = sp_vol_avg > 0 ? sp_vol_current / sp_vol_avg : 1.0 // ───────────────────────────────────────────────── // VOTING SYSTEM // ───────────────────────────────────────────────── int sp_votes_long = 0 int sp_votes_short = 0 sp_votes_long += sp_macd_bull_q ? 1 : 0 sp_votes_short += sp_macd_bear_q ? 1 : 0 sp_votes_long += sp_rsi_bull ? 1 : 0 sp_votes_short += sp_rsi_bear ? 1 : 0 sp_votes_long += sp_srsi_bull_q ? 1 : 0 sp_votes_short += sp_srsi_bear_q ? 1 : 0 sp_votes_long += sp_trend_bull ? 1 : 0 sp_votes_short += sp_trend_bear ? 1 : 0 sp_votes_long += sp_mom_bull ? 1 : 0 sp_votes_short += sp_mom_bear ? 1 : 0 bool sp_vol_confirms_bull = close > open and sp_vol_current_ratio >= 1.2 bool sp_vol_confirms_bear = close < open and sp_vol_current_ratio >= 1.2 sp_votes_long += sp_vol_confirms_bull ? 1 : 0 sp_votes_short += sp_vol_confirms_bear ? 1 : 0 bool sp_in_bear_div_zone = sp_k_use > sp_ob_extreme_logic and close < nz(close[sp_div_r]) bool sp_in_bull_div_zone = sp_k_use < sp_os_extreme_logic and close > nz(close[sp_div_r]) sp_votes_long += sp_in_bull_div_zone ? 1 : 0 sp_votes_short += sp_in_bear_div_zone ? 1 : 0 int sp_max_votes = 7 // ───────────────────────────────────────────────── // COMPOSITE OSCILLATOR // ───────────────────────────────────────────────── float sp_comp_raw = (sp_rsi_n + sp_srsi_n + sp_macd_n) / 3.0 float sp_comp = freezeFloat(ta.ema(sp_comp_raw, sp_smooth_len)) float sp_comp_s = freezeFloat(ta.ema(sp_comp, 3)) // ───────────────────────────────────────────────── // STRENGTH SCORE (Vote-based) // ───────────────────────────────────────────────── int sp_active_votes = math.max(sp_votes_long, sp_votes_short) float sp_strength = (float(sp_active_votes) / float(sp_max_votes)) * 100.0 // ───────────────────────────────────────────────── // DIVERGENCE DETECTION // ───────────────────────────────────────────────── bool sp_price_ll = low < ta.lowest(low[1], sp_div_l)[sp_div_r] bool sp_price_hh = high > ta.highest(high[1], sp_div_l)[sp_div_r] bool sp_osc_hl = sp_comp[sp_div_r] > ta.lowest(sp_comp[1], sp_div_l)[sp_div_r] bool sp_osc_lh = sp_comp[sp_div_r] < ta.highest(sp_comp[1], sp_div_l)[sp_div_r] bool sp_bull_div_raw = sp_price_ll and sp_osc_hl and sp_comp[sp_div_r] < sp_os_logic bool sp_bear_div_raw = sp_price_hh and sp_osc_lh and sp_comp[sp_div_r] > sp_ob_logic // HTF trend filter for divergences bool sp_htf_allows_bull = not sp_use_htf or sp_htf_bull bool sp_htf_allows_bear = not sp_use_htf or sp_htf_bear var int sp_last_bull_div_bar = 0 var int sp_last_bear_div_bar = 0 int sp_div_cooldown = 10 bool sp_bull_div_fresh = sp_bull_div_raw and sp_htf_allows_bull and (bar_index - sp_last_bull_div_bar >= sp_div_cooldown) bool sp_bear_div_fresh = sp_bear_div_raw and sp_htf_allows_bear and (bar_index - sp_last_bear_div_bar >= sp_div_cooldown) // ───────────────────────────────────────────────── // REGIME DETECTION // ───────────────────────────────────────────────── string sp_regime = "RANGING" if sp_comp_s > 65 and sp_base_up sp_regime := "TRENDING" else if sp_comp_s < 35 and sp_base_dn sp_regime := "TRENDING" else if sp_comp_s > 55 sp_regime := "BIAS" else if sp_comp_s < 45 sp_regime := "BIAS" bool sp_regime_bull = (sp_comp_s > 65 and sp_base_up) or sp_comp_s > 55 bool sp_regime_bear = (sp_comp_s < 35 and sp_base_dn) or sp_comp_s < 45 var string sp_prev_regime = "RANGE" bool sp_regime_changed = sp_regime != sp_prev_regime bool sp_regime_to_bull = sp_regime_changed and sp_regime_bull bool sp_regime_to_bear = sp_regime_changed and sp_regime_bear if isClosed sp_prev_regime := sp_regime // ───────────────────────────────────────────────── // CROSSOVER / EXTREME DETECTION // ───────────────────────────────────────────────── bool sp_bull_cross = ta.crossover(sp_comp, sp_comp_s) bool sp_bear_cross = ta.crossunder(sp_comp, sp_comp_s) bool sp_entered_extreme_ob = sp_comp >= sp_ob_extreme and sp_comp[1] < sp_ob_extreme bool sp_entered_extreme_os = sp_comp <= sp_os_extreme and sp_comp[1] > sp_os_extreme bool sp_exited_extreme_ob = sp_comp < sp_ob_extreme and sp_comp[1] >= sp_ob_extreme bool sp_exited_extreme_os = sp_comp > sp_os_extreme and sp_comp[1] <= sp_os_extreme bool sp_high_bull_consensus = sp_votes_long >= sp_mode_threshold and sp_votes_long[1] < sp_mode_threshold bool sp_high_bear_consensus = sp_votes_short >= sp_mode_threshold and sp_votes_short[1] < sp_mode_threshold // ───────────────────────────────────────────────── // VISUALS - ZONE FILLS // ───────────────────────────────────────────────── h_100 = hline(100, "", color=color.new(color.gray, 100)) h_ob_ex = hline(sp_ob_extreme, "", color=color.new(sp_col_bear, 80), linestyle=hline.style_dotted) h_ob = hline(sp_ob, "", color=color.new(sp_col_bear, 70), linestyle=hline.style_dashed) h_50 = hline(50, "", color=color.new(sp_col_neutral, 60), linestyle=hline.style_solid) h_os = hline(sp_os, "", color=color.new(sp_col_bull, 70), linestyle=hline.style_dashed) h_os_ex = hline(sp_os_extreme, "", color=color.new(sp_col_bull, 80), linestyle=hline.style_dotted) h_0 = hline(0, "", color=color.new(color.gray, 100)) fill(h_100, h_ob_ex, color=sp_show_zones ? color.new(sp_col_bear, 92) : na, title="Extreme OB Zone") fill(h_ob_ex, h_ob, color=sp_show_zones ? color.new(sp_col_bear, 95) : na, title="OB Zone") fill(h_os, h_os_ex, color=sp_show_zones ? color.new(sp_col_bull, 95) : na, title="OS Zone") fill(h_os_ex, h_0, color=sp_show_zones ? color.new(sp_col_bull, 92) : na, title="Extreme OS Zone") // ───────────────────────────────────────────────── // VISUALS - MAIN OSCILLATOR // ───────────────────────────────────────────────── color sp_comp_col = sp_comp > sp_comp_s ? sp_col_bull : sp_comp < sp_comp_s ? sp_col_bear : sp_col_neutral sp_p_comp = plot(sp_comp, "Harmonic Composite", color=sp_comp_col, linewidth=2) sp_p_sig = plot(sp_comp_s, "Signal EMA", color=color.new(sp_col_signal, 30), linewidth=1) fill(sp_p_comp, sp_p_sig, color=color.new(sp_comp > sp_comp_s ? sp_col_bull : sp_col_bear, 88)) // ───────────────────────────────────────────────── // VISUALS - CONSENSUS METER // ───────────────────────────────────────────────── bool sp_is_bullish = sp_votes_long > sp_votes_short float sp_conf_y = -15.0 bool sp_show_consensus_bar = sp_active_votes >= sp_consensus_min and sp_show_consensus float sp_transparency = sp_active_votes >= 5 ? 20 : sp_active_votes >= 3 ? 40 : 70 color sp_conf_color = color.new(sp_is_bullish ? sp_col_bull : sp_col_bear, sp_transparency) plot(sp_show_consensus_bar ? sp_conf_y : na, title="Consensus", color=sp_conf_color, linewidth=6, style=plot.style_histogram) var label sp_conf_label = na if barstate.islast and sp_show_consensus_bar if not na(sp_conf_label) label.delete(sp_conf_label) string conf_dir = sp_is_bullish ? "▲" : "▼" sp_conf_label := label.new(bar_index, sp_conf_y, str.format("{0}/7 {1}", sp_active_votes, conf_dir), style=label.style_none, textcolor=sp_is_bullish ? sp_col_bull : sp_col_bear, size=size.normal) // ───────────────────────────────────────────────── // VISUALS - DIVERGENCE LABELS // ───────────────────────────────────────────────── if sp_bull_div_fresh and isClosed and sp_show_divs sp_last_bull_div_bar := bar_index int div_bar = bar_index - sp_div_r float div_osc_value = sp_comp[sp_div_r] label.new(div_bar, div_osc_value - 6, "▲ DIV", style=label.style_none, textcolor=sp_col_bull, size=size.normal) if sp_bear_div_fresh and isClosed and sp_show_divs sp_last_bear_div_bar := bar_index int div_bar = bar_index - sp_div_r float div_osc_value = sp_comp[sp_div_r] label.new(div_bar, div_osc_value + 6, "▼ DIV", style=label.style_none, textcolor=sp_col_bear, size=size.normal) // ───────────────────────────────────────────────── // VISUALS - STATUS TABLE (Horizontal or Vertical) // ───────────────────────────────────────────────── var table sp_panel = na if barstate.islast and sp_show_table tablePos = switch sp_table_pos "Top Left" => position.top_left "Top Center" => position.top_center "Top Right" => position.top_right "Middle Left" => position.middle_left "Middle Center" => position.middle_center "Middle Right" => position.middle_right "Bottom Left" => position.bottom_left "Bottom Center" => position.bottom_center "Bottom Right" => position.bottom_right => position.top_right
color transparent = color.new(color.white, 100)  // Direction bool is_bull = sp_votes_long > sp_votes_short bool is_bear = sp_votes_short > sp_votes_long string dir_arrow = is_bull ? " ▲" : is_bear ? " ▼" : " —" color dir_col = is_bull ? sp_col_bull : is_bear ? sp_col_bear : sp_col_neutral  // Volume string vol_str = sp_vol_current_ratio >= 2.0 ? "HIGH" : sp_vol_current_ratio >= 1.2 ? "OK" : "LOW" color vol_col = sp_vol_current_ratio >= 2.0 ? sp_col_bull : sp_vol_current_ratio >= 1.2 ? sp_col_neutral : sp_col_bear  // ADX color color adx_col = sp_adx_val >= 25 ? sp_col_bull : sp_col_neutral  // Strength color color str_col = sp_strength >= 71 ? sp_col_bull : sp_strength >= 43 ? sp_col_orange : sp_col_bear  // Component arrows string rsi_arr = sp_rsi_bull ? " ▲" : sp_rsi_bear ? " ▼" : " —" string srsi_arr = sp_srsi_bull_q ? " ▲" : sp_srsi_bear_q ? " ▼" : " —" string macd_arr = sp_macd_bull_q ? " ▲" : sp_macd_bear_q ? " ▼" : " —" string mom_arr = sp_mom_bull ? " ▲" : sp_mom_bear ? " ▼" : " —" string trend_arr = sp_trend_bull ? " ▲" : sp_trend_bear ? " ▼" : " —"  color rsi_col = sp_rsi_bull ? sp_col_bull : sp_rsi_bear ? sp_col_bear : sp_col_neutral color srsi_col = sp_srsi_bull_q ? sp_col_bull : sp_srsi_bear_q ? sp_col_bear : sp_col_neutral color macd_col = sp_macd_bull_q ? sp_col_bull : sp_macd_bear_q ? sp_col_bear : sp_col_neutral color mom_col = sp_mom_bull ? sp_col_bull : sp_mom_bear ? sp_col_bear : sp_col_neutral color trend_col = sp_trend_bull ? sp_col_bull : sp_trend_bear ? sp_col_bear : sp_col_neutral  // Common text size string tsize = sp_table_size == "Tiny" ? size.tiny : sp_table_size == "Small" ? size.small : size.normal  if sp_table_layout == "Horizontal"     // HORIZONTAL LAYOUT (5 columns x 4 rows)     sp_panel := table.new(tablePos, 5, 4, frame_color=color.new(color.white, 100), frame_width=0, border_color=color.new(color.white, 100), border_width=0)          // Spacer rows     table.cell(sp_panel, 0, 0, "", bgcolor=transparent, text_size=tsize)     table.cell(sp_panel, 0, 1, "", bgcolor=transparent, text_size=tsize)          // Row 2: Stats     table.cell(sp_panel, 0, 2, str.format("{0}{1}│", sp_regime, dir_arrow), text_color=dir_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 2, str.format("{0}/7│", sp_active_votes), text_color=dir_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 2, 2, str.format("ADX {0}│", math.round(sp_adx_val)), text_color=adx_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 3, 2, str.format("VOL {0}│", vol_str), text_color=vol_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 4, 2, str.format("STR {0}%", math.round(sp_strength)), text_color=str_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)          // Row 3: Components     table.cell(sp_panel, 0, 3, str.format("RSI{0}│", rsi_arr), text_color=rsi_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 3, str.format("SRSI{0}│", srsi_arr), text_color=srsi_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 2, 3, str.format("MACD{0}│", macd_arr), text_color=macd_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 3, 3, str.format("MOM{0}│", mom_arr), text_color=mom_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 4, 3, str.format("EMA{0}", trend_arr), text_color=trend_col, bgcolor=transparent, text_size=tsize, text_halign=text.align_right)  else     // VERTICAL LAYOUT - Compact like Volume Oracle (7 rows, no gap)     color border_col = color.new(sp_col_neutral, 60)     sp_panel := table.new(tablePos, 2, 7, bgcolor=na, border_width=1, border_color=border_col, frame_width=0, frame_color=na)          color label_col = color.new(sp_col_neutral, 40)          // Arrows     string rsi_a = sp_rsi_bull ? "▲" : sp_rsi_bear ? "▼" : "—"     string srsi_a = sp_srsi_bull_q ? "▲" : sp_srsi_bear_q ? "▼" : "—"     string macd_a = sp_macd_bull_q ? "▲" : sp_macd_bear_q ? "▼" : "—"     string mom_a = sp_mom_bull ? "▲" : sp_mom_bear ? "▼" : "—"     string ema_a = sp_trend_bull ? "▲" : sp_trend_bear ? "▼" : "—"     string vol_a = sp_vol_confirms_bull ? "▲" : sp_vol_confirms_bear ? "▼" : "—"     string dir_a = is_bull ? "▲" : is_bear ? "▼" : "—"     color volu_col = sp_vol_confirms_bull ? sp_col_bull : sp_vol_confirms_bear ? sp_col_bear : sp_col_neutral          // Row 0: Regime     table.cell(sp_panel, 0, 0, "Regime", text_color=label_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 0, str.format("{0} {1}", sp_regime, dir_a), text_color=dir_col, bgcolor=na, text_size=tsize, text_halign=text.align_left)          // Row 1: Votes     table.cell(sp_panel, 0, 1, "Votes", text_color=label_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 1, str.format("{0}/7", sp_active_votes), text_color=dir_col, bgcolor=na, text_size=tsize, text_halign=text.align_left)          // Row 2: Volume     table.cell(sp_panel, 0, 2, "Volume", text_color=label_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 2, vol_str, text_color=vol_col, bgcolor=na, text_size=tsize, text_halign=text.align_left)          // Row 3: Strength     table.cell(sp_panel, 0, 3, "Strength", text_color=label_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 3, str.format("{0}%", math.round(sp_strength)), text_color=str_col, bgcolor=na, text_size=tsize, text_halign=text.align_left)          // Row 4: RSI + SRSI     table.cell(sp_panel, 0, 4, str.format("RSI {0}", rsi_a), text_color=rsi_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 4, str.format("SRSI {0}", srsi_a), text_color=srsi_col, bgcolor=na, text_size=tsize, text_halign=text.align_left)          // Row 5: MACD + MOM     table.cell(sp_panel, 0, 5, str.format("MACD {0}", macd_a), text_color=macd_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 5, str.format("MOM {0}", mom_a), text_color=mom_col, bgcolor=na, text_size=tsize, text_halign=text.align_left)          // Row 6: EMA + VOL     table.cell(sp_panel, 0, 6, str.format("EMA {0}", ema_a), text_color=trend_col, bgcolor=na, text_size=tsize, text_halign=text.align_right)     table.cell(sp_panel, 1, 6, str.format("VOL {0}", vol_a), text_color=volu_col, bgcolor=na, text_size=tsize, text_halign=text.align_left) 
// ───────────────────────────────────────────────── // SCREENER PLOTS // ───────────────────────────────────────────────── plot(sp_strength, title="Strength", display=display.data_window) plot(sp_votes_long, title="Long Votes", display=display.data_window) plot(sp_votes_short, title="Short Votes", display=display.data_window) plot(sp_bull_div_fresh ? 1 : 0, title="Bull Divergence", display=display.data_window) plot(sp_bear_div_fresh ? 1 : 0, title="Bear Divergence", display=display.data_window) // ───────────────────────────────────────────────── // ALERTS // ───────────────────────────────────────────────── alertcondition(sp_bull_div_fresh, title="Bullish Divergence", message="BULLISH DIVERGENCE on {{ticker}} at {{close}}") alertcondition(sp_bear_div_fresh, title="Bearish Divergence", message="BEARISH DIVERGENCE on {{ticker}} at {{close}}") alertcondition(sp_bull_cross, title="Bullish Crossover", message="BULLISH CROSSOVER on {{ticker}} at {{close}}") alertcondition(sp_bear_cross, title="Bearish Crossover", message="BEARISH CROSSOVER on {{ticker}} at {{close}}") alertcondition(sp_entered_extreme_ob, title="Extreme Overbought", message="EXTREME OVERBOUGHT on {{ticker}} at {{close}}") alertcondition(sp_entered_extreme_os, title="Extreme Oversold", message="EXTREME OVERSOLD on {{ticker}} at {{close}}") alertcondition(sp_exited_extreme_ob, title="Exit Overbought", message="Exited OVERBOUGHT on {{ticker}} at {{close}}") alertcondition(sp_exited_extreme_os, title="Exit Oversold", message="Exited OVERSOLD on {{ticker}} at {{close}}") alertcondition(sp_regime_to_bull, title="Regime to Bullish", message="REGIME to BULLISH on {{ticker}} at {{close}}") alertcondition(sp_regime_to_bear, title="Regime to Bearish", message="REGIME to BEARISH on {{ticker}} at {{close}}") alertcondition(sp_high_bull_consensus, title="High Bull Consensus", message="HIGH BULL CONSENSUS on {{ticker}} at {{close}}") alertcondition(sp_high_bear_consensus, title="High Bear Consensus", message="HIGH BEAR CONSENSUS on {{ticker}} at {{close}}") alertcondition(sp_bull_div_fresh or sp_bear_div_fresh, title="Any Divergence", message="DIVERGENCE on {{ticker}} at {{close}}") alertcondition(sp_bull_cross or sp_bear_cross, title="Any Crossover", message="CROSSOVER on {{ticker}} at {{close}}") // ╔════════════════════════════════════════════════════════════════╗ // ║ END: Harmonic Oscillator v1.0 ║ // ╚════════════════════════════════════════════════════════════════╝