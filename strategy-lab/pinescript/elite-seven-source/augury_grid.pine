// ─────────────────────────────────────────────────
// Crypto Majors (Binance) - Top 7 by market cap
c_bin_1 = "BINANCE:BTCUSDT.P", c_bin_2 = "BINANCE:ETHUSDT.P", c_bin_3 = "BINANCE:SOLUSDT.P", c_bin_4 = "BINANCE:BNBUSDT.P"
c_bin_5 = "BINANCE:XRPUSDT.P", c_bin_6 = "BINANCE:ADAUSDT.P", c_bin_7 = "BINANCE:AVAXUSDT.P"
// Crypto Majors (Bybit)
c_byb_1 = "BYBIT:BTCUSDT.P", c_byb_2 = "BYBIT:ETHUSDT.P", c_byb_3 = "BYBIT:SOLUSDT.P", c_byb_4 = "BYBIT:BNBUSDT.P"
c_byb_5 = "BYBIT:XRPUSDT.P", c_byb_6 = "BYBIT:ADAUSDT.P", c_byb_7 = "BYBIT:AVAXUSDT.P"
// Altcoins (Binance)
