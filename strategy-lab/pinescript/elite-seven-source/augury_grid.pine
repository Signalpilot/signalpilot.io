// Legacy alertcondition (for users who want simple triggers)
anyBull = e1t1 == 1 or e1t2 == 1 or e1t3 == 1 or e2t1 == 1 or e2t2 == 1 or e2t3 == 1 or e3t1 == 1 or e3t2 == 1 or e3t3 == 1 or e4t1 == 1 or e4t2 == 1 or e4t3 == 1 or e5t1 == 1 or e5t2 == 1 or e5t3 == 1 or e6t1 == 1 or e6t2 == 1 or e6t3 == 1 or e7t1 == 1 or e7t2 == 1 or e7t3 == 1
anyBear = e1t1 == -1 or e1t2 == -1 or e1t3 == -1 or e2t1 == -1 or e2t2 == -1 or e2t3 == -1 or e3t1 == -1 or e3t2 == -1 or e3t3 == -1 or e4t1 == -1 or e4t2 == -1 or e4t3 == -1 or e5t1 == -1 or e5t2 == -1 or e5t3 == -1 or e6t1 == -1 or e6t2 == -1 or e6t3 == -1 or e7t1 == -1 or e7t2 == -1 or e7t3 == -1
alertcondition(anyBull, title="🟢 Any Bullish (Simple)", message="Bullish signal - check Augury Grid for details")
alertcondition(anyBear, title="🔴 Any Bearish (Simple)", message="Bearish signal - check Augury Grid for details")
alertcondition(anyBull or anyBear, title="⚡ Any Signal (Simple)", message="New signal - check Augury Grid for details")
// =================================================================
//                    END: Augury Grid v1.0
// =================================================================