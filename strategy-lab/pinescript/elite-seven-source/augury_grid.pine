meme_1 = "BINANCE:DOGEUSDT.P", meme_2 = "BINANCE:1000SHIBUSDT.P", meme_3 = "BINANCE:1000PEPEUSDT.P", meme_4 = "BINANCE:1000FLOKIUSDT.P"
meme_5 = "BINANCE:1000LUNCUSDT.P", meme_6 = "BINANCE:PEOPLEUSDT.P", meme_7 = "BINANCE:WIFUSDT.P"
