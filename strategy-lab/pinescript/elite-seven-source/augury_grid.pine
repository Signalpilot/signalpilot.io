// =================================================================
//              AUGURY GRID - MULTI-TIMEFRAME SCANNER
//                        v1.0 - 2026
// =================================================================
//
// -----------------------------------------------------------------
//                      TABLE OF CONTENTS
// -----------------------------------------------------------------
//  SECTION                                         LINE (approx)
//
//  1. HELPER FUNCTIONS ................................... ~42
//  2. INPUTS / SETTINGS .................................. ~59
//     2.1 Display Presets
//     2.2 Colors
//     2.3 Filters & Signal Tuning
//     2.4 Targets & Timeframes
//     2.5 Symbol Presets
//  3. SYMBOL PRESET DEFINITIONS .......................... ~178
//  4. SIGNAL DETECTION FUNCTION .......................... ~228
//     4.1 Core Indicators (EMA, MACD, RSI, ADX)
//     4.2 Scoring System
//     4.3 Hard Filters
//     4.4 Blocker Detection
//     4.5 SL Hit = Signal Dead
//  5. MTF DATA RETRIEVAL (21 calls) ...................... ~400
//  6. DATA ARRAYS & RANKING .............................. ~431
//  7. CONFLUENCE DETECTION ............................... ~500
//  8. COLOR VARIABLES .................................... ~591
//  9. TABLE DISPLAY ...................................... ~609
//  10. ALERTS (45 total) ................................. ~747
//      10.1 Actionable Alerts (42)
//      10.2 Simple Alerts (3)
// -----------------------------------------------------------------
//
// 7 symbols x 3 TFs = 21 scans | Non-repainting | Bar close confirmed | 45 alerts
//
//@version=6
indicator("Augury Grid - Multi-Timeframe Scanner", shorttitle="Augury Grid", overlay=true)
// ─────────────────────────────────────────────────
// 1. HELPER FUNCTIONS
// ─────────────────────────────────────────────────
spFmtP(x) => 
    na(x) ? "—" : x < 1 ? str.tostring(x, "#.####") : x < 10 ? str.tostring(x, "#.###") : x < 1000 ? str.tostring(x, "#.##") : str.tostring(x, "#.#")
spAgo(ms) =>
    m = nz(ms, 0) / 60000.0
    m <= 0 ? "—" : m < 60 ? str.tostring(math.round(m)) + "m" : m < 1440 ? str.tostring(math.round(m/60)) + "h" : str.tostring(math.round(m/1440)) + "d"
spPosOf(_p) => _p == "Top Left" ? position.top_left : _p == "Top Center" ? position.top_center : _p == "Top Right" ? position.top_right : _p == "Middle Left" ? position.middle_left : _p == "Middle Center" ? position.middle_center : _p == "Middle Right" ? position.middle_right : _p == "Bottom Left" ? position.bottom_left : _p == "Bottom Center" ? position.bottom_center : position.bottom_right
spSize(_s) => _s == "Tiny" ? size.tiny : _s == "Small" ? size.small : _s == "Normal" ? size.normal : size.large
spQual(s) => s >= 95 ? "★★★" : s >= 85 ? "★★" : "★"
spTicker(sym) => str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(sym, "BINANCE:", ""), "BYBIT:", ""), "OANDA:", ""), "FX:", ""), "AMEX:", ""), "NASDAQ:", ""), "NYSE:", ""), "COMEX:", ""), "NYMEX:", ""), "CBOT:", ""), "USDT", ""), ".P", ""), "1000", "")
tfToStr(tf) => tf == "1" ? "1m" : tf == "3" ? "3m" : tf == "5" ? "5m" : tf == "15" ? "15m" : tf == "30" ? "30m" : tf == "60" ? "1H" : tf == "120" ? "2H" : tf == "240" ? "4H" : tf == "D" ? "D" : tf == "W" ? "W" : tf == "M" ? "M" : tf
// ─────────────────────────────────────────────────
// 2. INPUTS / SETTINGS
// ─────────────────────────────────────────────────
// 2.1 Display Presets
sp_g1 = "📱 Display"
sp_display_preset = input.string("Mobile", "Quick Preset", options=["Desktop", "Mobile", "Minimal"], group=sp_g1, tooltip="One-click display configuration. 'Desktop' = Normal text, Top Right, all 9 columns. 'Mobile' = Tiny text, Bottom Right, all columns (default). 'Minimal' = Small text, 5 columns only, 5 rows. Check 'Use Custom Settings' below to override.")
sp_use_custom = input.bool(false, "Use Custom Settings", group=sp_g1, tooltip="Override the Quick Preset with your own settings below. OFF = use preset above (default). ON = ignore preset, use Text Size/Position/etc below.")
// Custom settings (only used when Use Custom Settings = ON)
sp_size = input.string("Small", "├ Text Size", options=["Tiny", "Small", "Normal", "Large"], group=sp_g1, tooltip="Table text size. Only works when 'Use Custom Settings' is checked. 'Tiny' = smallest, best for phones. 'Small' = compact (default). 'Normal' = standard desktop. 'Large' = high visibility.")
sp_corner = input.string("Top Right", "├ Position", options=["Top Left", "Top Center", "Top Right", "Middle Left", "Middle Center", "Middle Right", "Bottom Left", "Bottom Center", "Bottom Right"], group=sp_g1, tooltip="Where to place the table on your chart. Only works when 'Use Custom Settings' is checked. 'Top Right' = default, out of the way. 'Bottom Right' = good for mobile. 'Middle Center' = maximum visibility.")
sp_abbrev = input.bool(true, "├ Abbreviate", group=sp_g1, tooltip="Shortens direction text to save space. Only works when 'Use Custom Settings' is checked. OFF = 'Bullish'/'Bearish'. ON = 'Bull'/'Bear' (default). Enable for smaller screens.")
sp_show_top_custom = input.int(7, "└ Show Rows", minval=1, maxval=7, group=sp_g1, tooltip="How many signal rows to display. Only works when 'Use Custom Settings' is checked. 1-3 = minimal, top signals only. 5 = balanced. 7 = all signals (default).")
sp_g1b = "📊 Columns (Custom Only)"
sp_show_rank = input.bool(true, "#", inline="cols1", group=sp_g1b, tooltip="Show rank position. Only works when 'Use Custom Settings' is checked.")
sp_show_sym = input.bool(true, "Sym", inline="cols1", group=sp_g1b, tooltip="Show symbol ticker. Only works when 'Use Custom Settings' is checked.")
sp_show_tf = input.bool(true, "TF", inline="cols1", group=sp_g1b, tooltip="Show timeframe. Only works when 'Use Custom Settings' is checked.")
sp_show_bias = input.bool(true, "Bias", inline="cols1", group=sp_g1b, tooltip="Show direction, stars, confluence. Only works when 'Use Custom Settings' is checked.")
sp_show_age = input.bool(true, "Age", inline="cols2", group=sp_g1b, tooltip="Show signal age. Only works when 'Use Custom Settings' is checked.")
sp_show_entry = input.bool(true, "Entry", inline="cols2", group=sp_g1b, tooltip="Show entry price. Only works when 'Use Custom Settings' is checked.")
sp_show_sl = input.bool(true, "SL", inline="cols2", group=sp_g1b, tooltip="Show stop loss. Only works when 'Use Custom Settings' is checked.")
sp_show_tp = input.bool(true, "TP", inline="cols2", group=sp_g1b, tooltip="Show take profit. Only works when 'Use Custom Settings' is checked.")
sp_show_pnl = input.bool(true, "P&L", inline="cols2", group=sp_g1b, tooltip="Show profit/loss %. Only works when 'Use Custom Settings' is checked.")
// ═══════════════════════════════════════════════
// PRESET LOGIC - Apply preset or custom
// ═══════════════════════════════════════════════
isDesktop = sp_display_preset == "Desktop"
isMobile = sp_display_preset == "Mobile"
isMinimal = sp_display_preset == "Minimal"
// Apply preset OR custom values based on checkbox
m_size = sp_use_custom ? sp_size : isDesktop ? "Normal" : isMobile ? "Tiny" : "Small"
m_corner = sp_use_custom ? sp_corner : isDesktop ? "Top Right" : isMobile ? "Bottom Right" : "Top Right"
m_abbrev = sp_use_custom ? sp_abbrev : isDesktop ? false : true
m_show_top = sp_use_custom ? sp_show_top_custom : isMinimal ? 5 : 7
// Column visibility: preset or custom
m_show_rank = sp_use_custom ? sp_show_rank : true
m_show_sym = sp_use_custom ? sp_show_sym : true
m_show_tf = sp_use_custom ? sp_show_tf : true
m_show_bias = sp_use_custom ? sp_show_bias : true
m_show_age = sp_use_custom ? sp_show_age : isMinimal ? false : true
m_show_entry = sp_use_custom ? sp_show_entry : true
m_show_sl = sp_use_custom ? sp_show_sl : isMinimal ? false : true
m_show_tp = sp_use_custom ? sp_show_tp : isMinimal ? false : true
m_show_pnl = sp_use_custom ? sp_show_pnl : isMinimal ? false : true
// ─────────────────────────────────────────────────
// 2.2 Colors
// ─────────────────────────────────────────────────
sp_g2 = "🎨 Colors"
sp_col_bull = input.color(color.rgb(0, 230, 118), "Bullish", group=sp_g2, tooltip="Color for bullish signals, positive P&L, and upward bias. Change to match your chart theme or improve visibility.")
sp_col_bear = input.color(color.rgb(255, 82, 82), "Bearish", group=sp_g2, tooltip="Color for bearish signals, negative P&L, and downward bias. Change to match your chart theme or improve visibility.")
sp_col_neutral = input.color(color.gray, "Neutral", group=sp_g2, tooltip="Color for empty cells and neutral states. Typically left as gray for contrast.")
sp_col_header_bg = input.color(color.rgb(30, 35, 45), "Header Background", group=sp_g2, tooltip="Background color for the header row. Darker colors help headers stand out from data rows.")
sp_col_header_txt = input.color(color.rgb(180, 190, 200), "Header Text", group=sp_g2, tooltip="Text color for column headers. Should contrast with header background for readability.")
sp_col_row_bg = input.color(color.rgb(20, 25, 35), "Row Background", group=sp_g2, tooltip="Background color for data rows. Slightly different from header helps distinguish sections.")
sp_col_row_txt = input.color(color.rgb(220, 225, 230), "Row Text", group=sp_g2, tooltip="Default text color for data cells. Should contrast with row background for readability.")
sp_col_entry = input.color(color.rgb(255, 235, 59), "Entry Price", group=sp_g2, tooltip="Color for entry price column. Yellow/gold draws attention to key trade level.")
sp_col_sl = input.color(color.rgb(255, 82, 82), "Stop Loss", group=sp_g2, tooltip="Color for stop loss column. Red signals caution/risk level.")
sp_col_tp = input.color(color.rgb(41, 182, 246), "Take Profit", group=sp_g2, tooltip="Color for take profit column. Blue distinguishes targets from entry/stop.")
sp_col_tf = input.color(color.rgb(255, 193, 7), "Timeframe", group=sp_g2, tooltip="Color for timeframe column. Amber/orange helps quickly identify which TF each signal is from.")
// ─────────────────────────────────────────────────
// 2.3 Filters
// ─────────────────────────────────────────────────
sp_g3 = "⚡ Filters"
sp_min_score = input.int(70, "Min Score", minval=0, maxval=100, group=sp_g3, tooltip="Minimum quality score required to display a signal. Higher scores mean more factors aligned (trend, volume, momentum). 0 = show all signals (noisy). 70 = balanced, shows ★ and above (default). 85 = strict, only ★★ and ★★★. 95 = very strict, only rare ★★★ signals.")
sp_show_top = input.int(7, "Show Top N", minval=1, maxval=7, group=sp_g3, tooltip="Maximum signals to display in the grid. Scanner finds up to 21 signals and ranks them by score. 1-3 = minimal, top picks only. 5 = balanced. 7 = show all qualifying signals (default). Note: Overridden by Display Preset except when 'Custom'.")
// ─────────────────────────────────────────────────
// 2.3b Signal Tuning
// ─────────────────────────────────────────────────
sp_g3b = "🔧 Signal Tuning"
sp_adx_min = input.int(20, "ADX Minimum", minval=10, maxval=40, group=sp_g3b, tooltip="Minimum ADX value required for a signal to fire. Measures trend strength. 15 = permissive, catches weaker trends (more signals). 20 = balanced (default). 25 = strict, strong trends only. 30+ = very strict, only powerful moves.")
sp_rsi_low = input.int(40, "RSI Range Low", minval=20, maxval=50, group=sp_g3b, tooltip="Lower bound of the RSI 'sweet spot' for bonus points. Signals with RSI in this range have room to run before hitting extremes. 30 = wider range, more bonuses. 40 = balanced (default). 45 = narrower range, fewer bonuses.")
sp_rsi_high = input.int(60, "RSI Range High", minval=50, maxval=80, group=sp_g3b, tooltip="Upper bound of the RSI 'sweet spot' for bonus points. Signals with RSI in this range have room to run before hitting extremes. 55 = narrower range, fewer bonuses. 60 = balanced (default). 70 = wider range, more bonuses.")
sp_vol_mult = input.float(1.3, "Volume Spike ×", minval=1.0, maxval=3.0, step=0.1, group=sp_g3b, tooltip="Volume must be at least this multiple of the 20-bar average to qualify. Ensures institutional participation. 1.0 = no filter, any volume (more signals). 1.3 = 30% above average (default). 2.0 = double average, strong volume only. 2.5+ = very strict.")
sp_ext_atr = input.float(2.5, "Extension ATR", minval=1.0, maxval=5.0, step=0.5, group=sp_g3b, tooltip="Maximum distance from EMA 21 (in ATR multiples) before signal is blocked. Prevents chasing extended moves. 2.0 = strict, blocks sooner. 2.5 = balanced (default). 3.5 = permissive, allows more extension. 5.0 = very loose.")
// ─────────────────────────────────────────────────
// 2.4 Targets
// ─────────────────────────────────────────────────
sp_g4 = "🎯 Targets"
sp_sl_mult = input.float(1.5, "SL ×ATR", minval=0.5, maxval=5.0, step=0.1, group=sp_g4, tooltip="Stop loss distance as ATR multiple. Determines when a signal is invalidated and removed from grid. 0.5 = tight stop, more stop-outs. 1.0 = small risk. 1.5 = balanced (default). 2.0+ = wide stop, fewer stop-outs but larger losses.")
sp_tp1_mult = input.float(2.0, "TP1 ×ATR", minval=0.5, maxval=5.0, step=0.1, group=sp_g4, tooltip="First take profit target as ATR multiple. Where to consider taking partial profits. 1.0 = quick target, 1:1 risk-reward. 2.0 = balanced, 1.3:1 R:R (default). 3.0 = extended target. Aim for TP1 ≥ SL for positive expectancy.")
sp_tp2_mult = input.float(3.0, "TP2 ×ATR", minval=0.5, maxval=5.0, step=0.1, group=sp_g4, tooltip="Second take profit target (runner) as ATR multiple. Where to close remaining position. 2.0 = conservative runner. 3.0 = balanced (default). 4.0+ = extended runner for trending markets.")
// ─────────────────────────────────────────────────
// 2.4b Timeframes
// ─────────────────────────────────────────────────
sp_g5 = "⏱️ Timeframes"
sp_tf1 = input.timeframe("15", "TF 1", group=sp_g5, tooltip="First timeframe to scan. Typically the fastest/shortest. '5' = scalping. '15' = intraday (default). '60' = swing day trading. Match to your trading style.")
sp_tf2 = input.timeframe("240", "TF 2", group=sp_g5, tooltip="Second timeframe to scan. Typically medium-term. '60' = hourly. '240' = 4-hour (default). 'D' = daily swing. Provides intermediate perspective.")
sp_tf3 = input.timeframe("D", "TF 3", group=sp_g5, tooltip="Third timeframe to scan. Typically the slowest/longest. '240' = 4-hour. 'D' = daily (default). 'W' = weekly position trading. Provides major trend context.")
// ─────────────────────────────────────────────────
// 2.5 Symbol Presets
// ─────────────────────────────────────────────────
sp_g6 = "📈 Symbol Preset"
sp_preset = input.string("Crypto Majors (Binance)", "Preset", options=["Crypto Majors (Binance)", "Crypto Majors (Bybit)", "Altcoins (Binance)", "Meme Coins (Binance)", "Forex Majors", "US Indices", "US Tech Giants", "Commodities", "Custom"], group=sp_g6, tooltip="Pre-configured watchlists with 7 symbols each. 'Crypto Majors' = BTC/ETH/SOL/BNB/XRP/ADA/AVAX (default). 'Altcoins' = mid-cap alts. 'Meme Coins' = DOGE/SHIB/PEPE etc. 'Forex' = major pairs. 'US Indices' = SPY/QQQ/DIA etc. 'Tech Giants' = AAPL/MSFT/GOOGL etc. 'Commodities' = Gold/Silver/Oil etc. 'Custom' = your own 7 symbols below.")
sp_g7 = "📝 Custom Symbols (only if Preset = Custom)"
sp_s1 = input.symbol("BINANCE:BTCUSDT.P", "1", group=sp_g7, tooltip="Custom symbol slot 1. Only used when Preset = 'Custom'. Use full symbol format (EXCHANGE:TICKER). Keep all 7 symbols from the same exchange to avoid memory errors.")
sp_s2 = input.symbol("BINANCE:ETHUSDT.P", "2", group=sp_g7, tooltip="Custom symbol slot 2. Only used when Preset = 'Custom'. Example: 'BINANCE:ETHUSDT.P' for Binance futures, 'NASDAQ:AAPL' for stocks.")
sp_s3 = input.symbol("BINANCE:SOLUSDT.P", "3", group=sp_g7, tooltip="Custom symbol slot 3. Only used when Preset = 'Custom'. Tip: Use perpetual contracts (.P) for 24/7 crypto markets.")
sp_s4 = input.symbol("BINANCE:BNBUSDT.P", "4", group=sp_g7, tooltip="Custom symbol slot 4. Only used when Preset = 'Custom'. Must have data available on TradingView for your selected timeframes.")
sp_s5 = input.symbol("BINANCE:XRPUSDT.P", "5", group=sp_g7, tooltip="Custom symbol slot 5. Only used when Preset = 'Custom'. Mixing exchanges (e.g., BINANCE + NASDAQ) may cause memory errors.")
sp_s6 = input.symbol("BINANCE:ADAUSDT.P", "6", group=sp_g7, tooltip="Custom symbol slot 6. Only used when Preset = 'Custom'. For forex, use 'OANDA:EURUSD' format.")
sp_s7 = input.symbol("BINANCE:AVAXUSDT.P", "7", group=sp_g7, tooltip="Custom symbol slot 7. Only used when Preset = 'Custom'. Scanner pulls data from all 7 symbols × 3 timeframes = 21 total scans.")
// ─────────────────────────────────────────────────
