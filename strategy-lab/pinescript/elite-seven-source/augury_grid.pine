// Commodities
cmd_1 = "COMEX:GC1!", cmd_2 = "COMEX:SI1!", cmd_3 = "NYMEX:CL1!", cmd_4 = "NYMEX:NG1!"
cmd_5 = "COMEX:HG1!", cmd_6 = "NYMEX:PL1!", cmd_7 = "NYMEX:PA1!"
// Symbol selection based on preset
sym1 = sp_preset == "Crypto Majors (Binance)" ? c_bin_1 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_1 : sp_preset == "Altcoins (Binance)" ? alt_1 : sp_preset == "Meme Coins (Binance)" ? meme_1 : sp_preset == "Forex Majors" ? fx_1 : sp_preset == "US Indices" ? idx_1 : sp_preset == "US Tech Giants" ? tech_1 : sp_preset == "Commodities" ? cmd_1 : sp_s1
sym2 = sp_preset == "Crypto Majors (Binance)" ? c_bin_2 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_2 : sp_preset == "Altcoins (Binance)" ? alt_2 : sp_preset == "Meme Coins (Binance)" ? meme_2 : sp_preset == "Forex Majors" ? fx_2 : sp_preset == "US Indices" ? idx_2 : sp_preset == "US Tech Giants" ? tech_2 : sp_preset == "Commodities" ? cmd_2 : sp_s2
sym3 = sp_preset == "Crypto Majors (Binance)" ? c_bin_3 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_3 : sp_preset == "Altcoins (Binance)" ? alt_3 : sp_preset == "Meme Coins (Binance)" ? meme_3 : sp_preset == "Forex Majors" ? fx_3 : sp_preset == "US Indices" ? idx_3 : sp_preset == "US Tech Giants" ? tech_3 : sp_preset == "Commodities" ? cmd_3 : sp_s3
sym4 = sp_preset == "Crypto Majors (Binance)" ? c_bin_4 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_4 : sp_preset == "Altcoins (Binance)" ? alt_4 : sp_preset == "Meme Coins (Binance)" ? meme_4 : sp_preset == "Forex Majors" ? fx_4 : sp_preset == "US Indices" ? idx_4 : sp_preset == "US Tech Giants" ? tech_4 : sp_preset == "Commodities" ? cmd_4 : sp_s4
sym5 = sp_preset == "Crypto Majors (Binance)" ? c_bin_5 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_5 : sp_preset == "Altcoins (Binance)" ? alt_5 : sp_preset == "Meme Coins (Binance)" ? meme_5 : sp_preset == "Forex Majors" ? fx_5 : sp_preset == "US Indices" ? idx_5 : sp_preset == "US Tech Giants" ? tech_5 : sp_preset == "Commodities" ? cmd_5 : sp_s5
sym6 = sp_preset == "Crypto Majors (Binance)" ? c_bin_6 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_6 : sp_preset == "Altcoins (Binance)" ? alt_6 : sp_preset == "Meme Coins (Binance)" ? meme_6 : sp_preset == "Forex Majors" ? fx_6 : sp_preset == "US Indices" ? idx_6 : sp_preset == "US Tech Giants" ? tech_6 : sp_preset == "Commodities" ? cmd_6 : sp_s6
sym7 = sp_preset == "Crypto Majors (Binance)" ? c_bin_7 : sp_preset == "Crypto Majors (Bybit)" ? c_byb_7 : sp_preset == "Altcoins (Binance)" ? alt_7 : sp_preset == "Meme Coins (Binance)" ? meme_7 : sp_preset == "Forex Majors" ? fx_7 : sp_preset == "US Indices" ? idx_7 : sp_preset == "US Tech Giants" ? tech_7 : sp_preset == "Commodities" ? cmd_7 : sp_s7
// ─────────────────────────────────────────────────
// 4. SIGNAL DETECTION FUNCTION
// Uses built-in ta.dmi() and ta.macd() for speed
// ─────────────────────────────────────────────────
f_scan() =>
    // EMAs
    emaF = ta.ema(close, 21)
    emaS = ta.ema(close, 55)
    ema200 = ta.ema(close, 200)
    
    // MACD - built-in is faster than manual
    [macdLine, sigLine, hist] = ta.macd(close, 12, 26, 9)
    
    // RSI & ATR
    rsi = ta.rsi(close, 14)
    atr = math.max(nz(ta.atr(14), close * 0.01), close * 0.002)
    
    // ADX - built-in is faster than manual
    [plusDI, minusDI, adx] = ta.dmi(14, 14)
    
    // Volume
    volSma = ta.sma(volume, 20)
    volSpike = volume >= volSma * sp_vol_mult
    
    // Trend
    trendUp = emaF > emaS
    trendDn = emaF < emaS
    
    // EMA 200 alignment
    majorBull = close > ema200
    majorBear = close < ema200
    
    // Histogram quality
    histAmp = (math.abs(hist[1]) + math.abs(hist[2]) + math.abs(hist[3])) / 3
    histNorm = histAmp / atr * 100
    histOK = histNorm > 0.5
    
    // RSI zones
    rsiOverbought = rsi > 70
    rsiOversold = rsi < 30
    
    // ADX filters (uses sp_adx_min input)
    adxMin = adx >= sp_adx_min
    adxRising = adx > adx[1] and adx[1] > adx[2]
    
    // RSI mid-range bonus (uses sp_rsi_low/high inputs)
    rsiMid = rsi >= sp_rsi_low and rsi <= sp_rsi_high
    
    // Histogram growing (bonus)
    histGrowing = math.abs(hist) > math.abs(hist[1])
    
    // Extension check (uses sp_ext_atr input)
    distFromEma = math.abs(close - emaF) / atr
    extended = distFromEma > sp_ext_atr
    
    // Momentum alignment
    bullMomentum = rsi > 50 and hist > hist[1]
    bearMomentum = rsi < 50 and hist < hist[1]
    
    // Structure check
    recentHigh = ta.highest(high, 10)
    recentLow = ta.lowest(low, 10)
    bullStructure = close > recentLow + (recentHigh - recentLow) * 0.5
    bearStructure = close < recentHigh - (recentHigh - recentLow) * 0.5
    
    // ═══════════════════════════════════════════════
    // SCORING - Simplified for v4.0
    // ═══════════════════════════════════════════════
    bullPts = (trendUp ? 10 : 0) + 
              (majorBull ? 15 : -25) +
              (adxMin ? 10 : -15) + 
              (adx >= 25 ? 8 : 0) +
              (adxRising ? 10 : 0) +
              (volSpike ? 10 : 0) + 
              (rsiMid ? 10 : 0) +
              (bullMomentum ? 12 : 0) +
              (histOK ? 8 : 0) + 
              (histGrowing ? 8 : 0) +
              (bullStructure ? 10 : 0) +
              (not extended ? 5 : -20)
              
    bearPts = (trendDn ? 10 : 0) + 
              (majorBear ? 15 : -25) +
              (adxMin ? 10 : -15) + 
              (adx >= 25 ? 8 : 0) +
              (adxRising ? 10 : 0) +
              (volSpike ? 10 : 0) + 
              (rsiMid ? 10 : 0) +
              (bearMomentum ? 12 : 0) +
              (histOK ? 8 : 0) + 
              (histGrowing ? 8 : 0) +
              (bearStructure ? 10 : 0) +
              (not extended ? 5 : -20)
    
    scoreL = math.max(0, math.min(100, bullPts))
    scoreS = math.max(0, math.min(100, bearPts))
    
    crossUp = hist > 0 and hist[1] <= 0
    crossDn = hist < 0 and hist[1] >= 0
    
    // ═══════════════════════════════════════════════
    // ★★★ HARD FILTERS - ALL MUST PASS ★★★
    // v4.0: Simplified, ADX Rising/RSI Mid/Hist Growing = BONUS points only
    // ═══════════════════════════════════════════════
    
    bullEvt = crossUp and trendUp and majorBull and adxMin and (not rsiOverbought) and (not extended) and volSpike and histOK and bullMomentum and scoreL >= 70
    bearEvt = crossDn and trendDn and majorBear and adxMin and (not rsiOversold) and (not extended) and volSpike and histOK and bearMomentum and scoreS >= 70
    sigEvt = bullEvt ? 1 : bearEvt ? -1 : 0
    
    // ═══════════════════════════════════════════════
    // ★★★ BLOCKER DETECTION - What's missing? ★★★
    // Returns code for the MAIN thing blocking a signal
    // ═══════════════════════════════════════════════
    // Note: ADX Rising, RSI Mid-Range, Hist Growing are BONUS only (not blockers)
    
    hasCross = crossUp or crossDn
    hasTrend = (crossUp and trendUp) or (crossDn and trendDn)
    has200 = (crossUp and majorBull) or (crossDn and majorBear)
    hasRSI = (crossUp and not rsiOverbought) or (crossDn and not rsiOversold)
    hasMom = (crossUp and bullMomentum) or (crossDn and bearMomentum)
    hasScore = (crossUp and scoreL >= 70) or (crossDn and scoreS >= 70)
    
    blocker = sigEvt != 0 ? 0 :        // 0 = has signal!
              not hasCross ? 1 :        // Need MACD cross
              not hasTrend ? 2 :        // Need trend alignment
              not has200 ? 3 :          // Need EMA 200
              not adxMin ? 4 :          // Need ADX ≥20
              not volSpike ? 7 :        // Need volume (actionable - wait for it!)
              not histOK ? 8 :          // Need histogram
              not hasRSI ? 5 :          // RSI extreme
              extended ? 6 :            // Price extended
              not hasMom ? 9 :          // Need momentum
              not hasScore ? 10 : 0     // Score too low
    
    // Get raw signal data
    rawSig = ta.valuewhen(sigEvt != 0, sigEvt, 0)
    rawPx = ta.valuewhen(sigEvt != 0, close, 0)
    rawTs = ta.valuewhen(sigEvt != 0, time, 0)
    rawAtr = ta.valuewhen(sigEvt != 0, atr, 0)
    rawScore = ta.valuewhen(sigEvt != 0, sigEvt == 1 ? scoreL : scoreS, 0)
    
    // ═══════════════════════════════════════════════
    // ★★★ SL HIT = TRADE DEAD = NO SIGNAL ★★★
    // If current price is past SL, trade is dead
    // ═══════════════════════════════════════════════
    slMult = sp_sl_mult  // Uses user's SL setting
    
    // Calculate SL from entry
    slLevel = rawSig == 1 ? rawPx - rawAtr * slMult : rawPx + rawAtr * slMult
    
    // Simple check: is current price past SL level?
    slHit = rawSig == 1 ? close < slLevel : rawSig == -1 ? close > slLevel : false
    
    // ═══════════════════════════════════════════════
    // ★★★ STALE SIGNAL = NO SIGNAL ★★★  
    // Signals older than 30 days are stale
    // ═══════════════════════════════════════════════
    maxAgeMs = 30 * 24 * 60 * 60 * 1000  // 30 days in ms
    isStale = (time - rawTs) > maxAgeMs
    
    // Update blocker if SL hit or stale
    finalBlocker = slHit ? 11 : isStale ? 12 : blocker
    
    // Final output: if SL hit or stale, return 0 (no active signal)
    lastSig = (slHit or isStale) ? 0.0 : rawSig
    lastPx = (slHit or isStale) ? 0.0 : rawPx
    lastTs = (slHit or isStale) ? 0 : rawTs
    lastAtr = (slHit or isStale) ? 0.0 : rawAtr
    lastScore = (slHit or isStale) ? 0.0 : rawScore
    
    [close, lastSig, lastPx, lastTs, lastAtr, lastScore, sigEvt, finalBlocker]
// ─────────────────────────────────────────────────
// 5. MTF DATA RETRIEVAL (21 calls)
// ─────────────────────────────────────────────────
[c1t1, s1t1, p1t1, ts1t1, a1t1, sc1t1, e1t1, b1t1] = request.security(sym1, sp_tf1, f_scan())
[c1t2, s1t2, p1t2, ts1t2, a1t2, sc1t2, e1t2, b1t2] = request.security(sym1, sp_tf2, f_scan())
[c1t3, s1t3, p1t3, ts1t3, a1t3, sc1t3, e1t3, b1t3] = request.security(sym1, sp_tf3, f_scan())
[c2t1, s2t1, p2t1, ts2t1, a2t1, sc2t1, e2t1, b2t1] = request.security(sym2, sp_tf1, f_scan())
[c2t2, s2t2, p2t2, ts2t2, a2t2, sc2t2, e2t2, b2t2] = request.security(sym2, sp_tf2, f_scan())
[c2t3, s2t3, p2t3, ts2t3, a2t3, sc2t3, e2t3, b2t3] = request.security(sym2, sp_tf3, f_scan())
[c3t1, s3t1, p3t1, ts3t1, a3t1, sc3t1, e3t1, b3t1] = request.security(sym3, sp_tf1, f_scan())
[c3t2, s3t2, p3t2, ts3t2, a3t2, sc3t2, e3t2, b3t2] = request.security(sym3, sp_tf2, f_scan())
[c3t3, s3t3, p3t3, ts3t3, a3t3, sc3t3, e3t3, b3t3] = request.security(sym3, sp_tf3, f_scan())
[c4t1, s4t1, p4t1, ts4t1, a4t1, sc4t1, e4t1, b4t1] = request.security(sym4, sp_tf1, f_scan())
[c4t2, s4t2, p4t2, ts4t2, a4t2, sc4t2, e4t2, b4t2] = request.security(sym4, sp_tf2, f_scan())
[c4t3, s4t3, p4t3, ts4t3, a4t3, sc4t3, e4t3, b4t3] = request.security(sym4, sp_tf3, f_scan())
[c5t1, s5t1, p5t1, ts5t1, a5t1, sc5t1, e5t1, b5t1] = request.security(sym5, sp_tf1, f_scan())
[c5t2, s5t2, p5t2, ts5t2, a5t2, sc5t2, e5t2, b5t2] = request.security(sym5, sp_tf2, f_scan())
[c5t3, s5t3, p5t3, ts5t3, a5t3, sc5t3, e5t3, b5t3] = request.security(sym5, sp_tf3, f_scan())
[c6t1, s6t1, p6t1, ts6t1, a6t1, sc6t1, e6t1, b6t1] = request.security(sym6, sp_tf1, f_scan())
[c6t2, s6t2, p6t2, ts6t2, a6t2, sc6t2, e6t2, b6t2] = request.security(sym6, sp_tf2, f_scan())
[c6t3, s6t3, p6t3, ts6t3, a6t3, sc6t3, e6t3, b6t3] = request.security(sym6, sp_tf3, f_scan())
[c7t1, s7t1, p7t1, ts7t1, a7t1, sc7t1, e7t1, b7t1] = request.security(sym7, sp_tf1, f_scan())
[c7t2, s7t2, p7t2, ts7t2, a7t2, sc7t2, e7t2, b7t2] = request.security(sym7, sp_tf2, f_scan())
[c7t3, s7t3, p7t3, ts7t3, a7t3, sc7t3, e7t3, b7t3] = request.security(sym7, sp_tf3, f_scan())
// ─────────────────────────────────────────────────
// 6. DATA ARRAYS & RANKING
// ─────────────────────────────────────────────────
var symIdx = array.new_int(21, 0)
var tfIdx = array.new_int(21, 0)
var scores = array.new_float(21, 0.0)
var sigs = array.new_int(21, 0)
var pxs = array.new_float(21, 0.0)
var tss = array.new_int(21, 0)
var atrs = array.new_float(21, 0.0)
var closes = array.new_float(21, 0.0)
var ranks = array.new_float(21, 0.0)
var blockers = array.new_int(21, 0)
var confluence = array.new_int(21, 0)  // Multi-TF confluence count
// Blocker code to text (short for mobile)
blockerTxt(code) =>
    switch code
        0 => ""
        1 => "⏳ MACD"
        2 => "⏳ Trend"
        3 => "⏳ EMA200"
        4 => "⏳ ADX"
        5 => "⚠️ RSI"
        6 => "⚠️ Extended"
        7 => "⏳ Volume"
        8 => "⏳ Hist"
        9 => "⏳ Momentum"
        10 => "⏳ Score"
        11 => "💀 SL Hit"
        12 => "💀 Stale"
        => "⏳ Scanning"
if barstate.islast
    // Symbol 1
    array.set(symIdx, 0, 1), array.set(tfIdx, 0, 1), array.set(scores, 0, sc1t1), array.set(sigs, 0, int(s1t1)), array.set(pxs, 0, p1t1), array.set(tss, 0, int(ts1t1)), array.set(atrs, 0, a1t1), array.set(closes, 0, c1t1), array.set(blockers, 0, int(b1t1))
    array.set(symIdx, 1, 1), array.set(tfIdx, 1, 2), array.set(scores, 1, sc1t2), array.set(sigs, 1, int(s1t2)), array.set(pxs, 1, p1t2), array.set(tss, 1, int(ts1t2)), array.set(atrs, 1, a1t2), array.set(closes, 1, c1t2), array.set(blockers, 1, int(b1t2))
    array.set(symIdx, 2, 1), array.set(tfIdx, 2, 3), array.set(scores, 2, sc1t3), array.set(sigs, 2, int(s1t3)), array.set(pxs, 2, p1t3), array.set(tss, 2, int(ts1t3)), array.set(atrs, 2, a1t3), array.set(closes, 2, c1t3), array.set(blockers, 2, int(b1t3))
    
    // Symbol 2
    array.set(symIdx, 3, 2), array.set(tfIdx, 3, 1), array.set(scores, 3, sc2t1), array.set(sigs, 3, int(s2t1)), array.set(pxs, 3, p2t1), array.set(tss, 3, int(ts2t1)), array.set(atrs, 3, a2t1), array.set(closes, 3, c2t1), array.set(blockers, 3, int(b2t1))
    array.set(symIdx, 4, 2), array.set(tfIdx, 4, 2), array.set(scores, 4, sc2t2), array.set(sigs, 4, int(s2t2)), array.set(pxs, 4, p2t2), array.set(tss, 4, int(ts2t2)), array.set(atrs, 4, a2t2), array.set(closes, 4, c2t2), array.set(blockers, 4, int(b2t2))
    array.set(symIdx, 5, 2), array.set(tfIdx, 5, 3), array.set(scores, 5, sc2t3), array.set(sigs, 5, int(s2t3)), array.set(pxs, 5, p2t3), array.set(tss, 5, int(ts2t3)), array.set(atrs, 5, a2t3), array.set(closes, 5, c2t3), array.set(blockers, 5, int(b2t3))
    
    // Symbol 3
    array.set(symIdx, 6, 3), array.set(tfIdx, 6, 1), array.set(scores, 6, sc3t1), array.set(sigs, 6, int(s3t1)), array.set(pxs, 6, p3t1), array.set(tss, 6, int(ts3t1)), array.set(atrs, 6, a3t1), array.set(closes, 6, c3t1), array.set(blockers, 6, int(b3t1))
    array.set(symIdx, 7, 3), array.set(tfIdx, 7, 2), array.set(scores, 7, sc3t2), array.set(sigs, 7, int(s3t2)), array.set(pxs, 7, p3t2), array.set(tss, 7, int(ts3t2)), array.set(atrs, 7, a3t2), array.set(closes, 7, c3t2), array.set(blockers, 7, int(b3t2))
    array.set(symIdx, 8, 3), array.set(tfIdx, 8, 3), array.set(scores, 8, sc3t3), array.set(sigs, 8, int(s3t3)), array.set(pxs, 8, p3t3), array.set(tss, 8, int(ts3t3)), array.set(atrs, 8, a3t3), array.set(closes, 8, c3t3), array.set(blockers, 8, int(b3t3))
    
    // Symbol 4
    array.set(symIdx, 9, 4), array.set(tfIdx, 9, 1), array.set(scores, 9, sc4t1), array.set(sigs, 9, int(s4t1)), array.set(pxs, 9, p4t1), array.set(tss, 9, int(ts4t1)), array.set(atrs, 9, a4t1), array.set(closes, 9, c4t1), array.set(blockers, 9, int(b4t1))
    array.set(symIdx, 10, 4), array.set(tfIdx, 10, 2), array.set(scores, 10, sc4t2), array.set(sigs, 10, int(s4t2)), array.set(pxs, 10, p4t2), array.set(tss, 10, int(ts4t2)), array.set(atrs, 10, a4t2), array.set(closes, 10, c4t2), array.set(blockers, 10, int(b4t2))
    array.set(symIdx, 11, 4), array.set(tfIdx, 11, 3), array.set(scores, 11, sc4t3), array.set(sigs, 11, int(s4t3)), array.set(pxs, 11, p4t3), array.set(tss, 11, int(ts4t3)), array.set(atrs, 11, a4t3), array.set(closes, 11, c4t3), array.set(blockers, 11, int(b4t3))
    
    // Symbol 5
    array.set(symIdx, 12, 5), array.set(tfIdx, 12, 1), array.set(scores, 12, sc5t1), array.set(sigs, 12, int(s5t1)), array.set(pxs, 12, p5t1), array.set(tss, 12, int(ts5t1)), array.set(atrs, 12, a5t1), array.set(closes, 12, c5t1), array.set(blockers, 12, int(b5t1))
    array.set(symIdx, 13, 5), array.set(tfIdx, 13, 2), array.set(scores, 13, sc5t2), array.set(sigs, 13, int(s5t2)), array.set(pxs, 13, p5t2), array.set(tss, 13, int(ts5t2)), array.set(atrs, 13, a5t2), array.set(closes, 13, c5t2), array.set(blockers, 13, int(b5t2))
    array.set(symIdx, 14, 5), array.set(tfIdx, 14, 3), array.set(scores, 14, sc5t3), array.set(sigs, 14, int(s5t3)), array.set(pxs, 14, p5t3), array.set(tss, 14, int(ts5t3)), array.set(atrs, 14, a5t3), array.set(closes, 14, c5t3), array.set(blockers, 14, int(b5t3))
    
    // Symbol 6
    array.set(symIdx, 15, 6), array.set(tfIdx, 15, 1), array.set(scores, 15, sc6t1), array.set(sigs, 15, int(s6t1)), array.set(pxs, 15, p6t1), array.set(tss, 15, int(ts6t1)), array.set(atrs, 15, a6t1), array.set(closes, 15, c6t1), array.set(blockers, 15, int(b6t1))
    array.set(symIdx, 16, 6), array.set(tfIdx, 16, 2), array.set(scores, 16, sc6t2), array.set(sigs, 16, int(s6t2)), array.set(pxs, 16, p6t2), array.set(tss, 16, int(ts6t2)), array.set(atrs, 16, a6t2), array.set(closes, 16, c6t2), array.set(blockers, 16, int(b6t2))
    array.set(symIdx, 17, 6), array.set(tfIdx, 17, 3), array.set(scores, 17, sc6t3), array.set(sigs, 17, int(s6t3)), array.set(pxs, 17, p6t3), array.set(tss, 17, int(ts6t3)), array.set(atrs, 17, a6t3), array.set(closes, 17, c6t3), array.set(blockers, 17, int(b6t3))
    
    // Symbol 7
    array.set(symIdx, 18, 7), array.set(tfIdx, 18, 1), array.set(scores, 18, sc7t1), array.set(sigs, 18, int(s7t1)), array.set(pxs, 18, p7t1), array.set(tss, 18, int(ts7t1)), array.set(atrs, 18, a7t1), array.set(closes, 18, c7t1), array.set(blockers, 18, int(b7t1))
    array.set(symIdx, 19, 7), array.set(tfIdx, 19, 2), array.set(scores, 19, sc7t2), array.set(sigs, 19, int(s7t2)), array.set(pxs, 19, p7t2), array.set(tss, 19, int(ts7t2)), array.set(atrs, 19, a7t2), array.set(closes, 19, c7t2), array.set(blockers, 19, int(b7t2))
    array.set(symIdx, 20, 7), array.set(tfIdx, 20, 3), array.set(scores, 20, sc7t3), array.set(sigs, 20, int(s7t3)), array.set(pxs, 20, p7t3), array.set(tss, 20, int(ts7t3)), array.set(atrs, 20, a7t3), array.set(closes, 20, c7t3), array.set(blockers, 20, int(b7t3))
    
    // ═══════════════════════════════════════════════
    // 7. MULTI-TF CONFLUENCE DETECTION
    // Same symbol agreeing across TFs = higher quality
    // ═══════════════════════════════════════════════
    for sym = 1 to 7
        // Get signals for this symbol across all 3 TFs
        idx1 = (sym - 1) * 3 + 0  // TF1
        idx2 = (sym - 1) * 3 + 1  // TF2
        idx3 = (sym - 1) * 3 + 2  // TF3
        
        sig1 = array.get(sigs, idx1)
        sig2 = array.get(sigs, idx2)
        sig3 = array.get(sigs, idx3)
        
        // Count how many TFs have same direction signal
        bullCount = (sig1 == 1 ? 1 : 0) + (sig2 == 1 ? 1 : 0) + (sig3 == 1 ? 1 : 0)
        bearCount = (sig1 == -1 ? 1 : 0) + (sig2 == -1 ? 1 : 0) + (sig3 == -1 ? 1 : 0)
        
        // Confluence bonus: 2 TFs = +15, 3 TFs = +30
        confBonus = math.max(bullCount, bearCount) >= 3 ? 30.0 : math.max(bullCount, bearCount) >= 2 ? 15.0 : 0.0
        
        // Apply bonus to scores (only for signals that match the confluence direction)
        if bullCount >= 2
            if sig1 == 1
                array.set(scores, idx1, array.get(scores, idx1) + confBonus)
            if sig2 == 1
                array.set(scores, idx2, array.get(scores, idx2) + confBonus)
            if sig3 == 1
                array.set(scores, idx3, array.get(scores, idx3) + confBonus)
        if bearCount >= 2
            if sig1 == -1
                array.set(scores, idx1, array.get(scores, idx1) + confBonus)
            if sig2 == -1
                array.set(scores, idx2, array.get(scores, idx2) + confBonus)
            if sig3 == -1
                array.set(scores, idx3, array.get(scores, idx3) + confBonus)
        
        // Store confluence count for display (DIRECTION-AWARE)
        // Bull signals show bullCount, bear signals show bearCount
        if sig1 == 1
            array.set(confluence, idx1, bullCount)
        else if sig1 == -1
            array.set(confluence, idx1, bearCount)
        else
            array.set(confluence, idx1, 0)
            
        if sig2 == 1
            array.set(confluence, idx2, bullCount)
        else if sig2 == -1
            array.set(confluence, idx2, bearCount)
        else
            array.set(confluence, idx2, 0)
            
        if sig3 == 1
            array.set(confluence, idx3, bullCount)
        else if sig3 == -1
            array.set(confluence, idx3, bearCount)
        else
            array.set(confluence, idx3, 0)
    
    // Calculate ranks (confluence bonus already in scores)
    for i = 0 to 20
        sc = array.get(scores, i)
        ts = array.get(tss, i)
        sg = array.get(sigs, i)
        px = array.get(pxs, i)
        valid = sg != 0 and px > 0 and sc >= sp_min_score
        rank = valid ? sc * 1000 - (timenow - ts) / 1000000.0 : -999999.0
        array.set(ranks, i, rank)
// Sort indices by rank
var sortedIdx = array.new_int(21, 0)
if barstate.islast
    for i = 0 to 20
        array.set(sortedIdx, i, i)
    for i = 0 to 19
        maxRank = array.get(ranks, array.get(sortedIdx, i))
        maxIdx = i
        for j = i + 1 to 20
            r = array.get(ranks, array.get(sortedIdx, j))
            if r > maxRank
                maxRank := r
                maxIdx := j
        if maxIdx != i
            tmp = array.get(sortedIdx, i)
            array.set(sortedIdx, i, array.get(sortedIdx, maxIdx))
            array.set(sortedIdx, maxIdx, tmp)
getSymbol(idx) => idx == 1 ? sym1 : idx == 2 ? sym2 : idx == 3 ? sym3 : idx == 4 ? sym4 : idx == 5 ? sym5 : idx == 6 ? sym6 : sym7
getTF(idx) => idx == 1 ? sp_tf1 : idx == 2 ? sp_tf2 : sp_tf3
// ─────────────────────────────────────────────────
// 8. COLOR VARIABLES
// ─────────────────────────────────────────────────
cBull = sp_col_bull
cBear = sp_col_bear
cNeut = sp_col_neutral
hdrBg = sp_col_header_bg
hdrTxt = sp_col_header_txt
rowBg = sp_col_row_bg
rowTxt = sp_col_row_txt
cEntry = sp_col_entry
cSL = sp_col_sl
cTP = sp_col_tp
cTF = sp_col_tf
bgBull = color.new(cBull, 85)
bgBear = color.new(cBear, 85)
txtSz = spSize(m_size)
// ─────────────────────────────────────────────────
// 9. TABLE DISPLAY
// ─────────────────────────────────────────────────
var table t = na
// Count visible columns (using mobile-aware vars)
numCols = (m_show_rank ? 1 : 0) + (m_show_sym ? 1 : 0) + (m_show_tf ? 1 : 0) + (m_show_bias ? 1 : 0) + (m_show_age ? 1 : 0) + (m_show_entry ? 1 : 0) + (m_show_sl ? 1 : 0) + (m_show_tp ? 1 : 0) + (m_show_pnl ? 1 : 0)
// Abbreviations
hdrRank = "#"
hdrSym = m_abbrev ? "Sym" : "Symbol"
hdrTF = "TF"
hdrBias = m_abbrev ? "Bias" : "Bias"
hdrAge = m_abbrev ? "Age" : "Age"
hdrEntry = m_abbrev ? "Ent" : "Entry"
hdrSL = "SL"
hdrTP = m_abbrev ? "TP" : "TP1/TP2"
hdrPnl = "P&L"
if barstate.islast
    t := table.new(spPosOf(m_corner), numCols, m_show_top + 1, border_width=1, frame_color=color.new(hdrTxt, 80), border_color=color.new(hdrTxt, 85), bgcolor=rowBg)
    
    // Headers - dynamic column index
    col = 0
    if m_show_rank
        table.cell(t, col, 0, hdrRank, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_sym
        table.cell(t, col, 0, hdrSym, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_tf
        table.cell(t, col, 0, hdrTF, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_bias
        table.cell(t, col, 0, hdrBias, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_age
        table.cell(t, col, 0, hdrAge, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_entry
        table.cell(t, col, 0, hdrEntry, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_sl
        table.cell(t, col, 0, hdrSL, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_tp
        table.cell(t, col, 0, hdrTP, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    if m_show_pnl
        table.cell(t, col, 0, hdrPnl, bgcolor=hdrBg, text_color=hdrTxt, text_size=txtSz)
        col += 1
    
    // Data rows
    for i = 0 to m_show_top - 1
        idx = array.get(sortedIdx, i)
        rSymIdx = array.get(symIdx, idx)
        rTfIdx = array.get(tfIdx, idx)
        rScore = array.get(scores, idx)
        rRank = array.get(ranks, idx)
        rSig = array.get(sigs, idx)
        rPx = array.get(pxs, idx)
        rTs = array.get(tss, idx)
        rAtr = array.get(atrs, idx)
        rClose = array.get(closes, idx)
        rBlocker = array.get(blockers, idx)
        rConf = array.get(confluence, idx)  // Multi-TF confluence count
        
        hasSignal = rRank > -999998
        sym = getSymbol(rSymIdx)
        tf = getTF(rTfIdx)
        
        age = rTs == 0 ? na : math.max(0.0, float(timenow - rTs))
        safePx = math.max(nz(rPx, 1.0), 0.0001)
        minAtr = safePx * 0.005
        effAtr = math.max(nz(rAtr, minAtr), minAtr)
        sl = rPx == 0 ? na : rPx + (rSig == 1 ? -1 : 1) * effAtr * sp_sl_mult
        tp1 = rPx == 0 ? na : rPx + (rSig == 1 ? 1 : -1) * effAtr * sp_tp1_mult
        tp2 = rPx == 0 ? na : rPx + (rSig == 1 ? 1 : -1) * effAtr * sp_tp2_mult
        
        // ★ P&L with SL/TP CAPPING - No more -60% nonsense!
        rawPnl = rPx == 0 or safePx == 0 ? na : rSig == 1 ? (nz(rClose, safePx)/safePx - 1) : (safePx/math.max(nz(rClose, safePx), 0.0001) - 1)
        slPct = effAtr * sp_sl_mult / safePx  // SL distance as decimal (e.g., 0.015 = 1.5%)
        tpPct = effAtr * sp_tp1_mult / safePx // TP distance as decimal
        // Cap: if past SL show SL loss, if past TP show TP gain
        pnl = na(rawPnl) ? na : rawPnl < -slPct ? -slPct : rawPnl > tpPct ? tpPct : rawPnl
        
        // Bias text (abbreviated or full) + confluence indicator
        bullTxt = m_abbrev ? "Bull" : "Bullish"
        bearTxt = m_abbrev ? "Bear" : "Bearish"
        confTxt = rConf >= 3 ? " 🔗🔗" : rConf >= 2 ? " 🔗" : ""  // 🔗 = confluence
        // Show blocker status for rows without signals
        blockTxt = blockerTxt(rBlocker)
        sTxt = hasSignal ? (rSig == 1 ? bullTxt : rSig == -1 ? bearTxt : blockTxt) : blockTxt
        sCol = hasSignal ? (rSig == 1 ? cBull : rSig == -1 ? cBear : cNeut) : color.rgb(150, 150, 150)
        bg = not hasSignal ? rowBg : rSig == 1 ? bgBull : rSig == -1 ? bgBear : rowBg
        
        pVal = na(pnl) ? 0.0 : pnl * 100
        // Add indicator if capped at SL/TP
        hitSL = not na(rawPnl) and rawPnl < -slPct
        hitTP = not na(rawPnl) and rawPnl > tpPct
        pSuffix = hitSL ? " ⛔" : hitTP ? " ✅" : ""
        pTxt = (not hasSignal or na(pnl)) ? "—" : (pVal >= 0 ? "+" : "") + str.tostring(pVal, "#.##") + "%" + pSuffix
        pCol = (not hasSignal or na(pnl)) ? cNeut : pnl >= 0 ? cBull : cBear
        
        qTxt = (not hasSignal or rPx == 0) ? "" : " " + spQual(int(rScore)) + confTxt
        tpTxt = m_abbrev ? (not hasSignal or na(tp1)) ? "—" : spFmtP(tp1) : (not hasSignal or na(tp1)) ? "—" : spFmtP(tp1) + "/" + spFmtP(tp2)
        
        row = i + 1
        col := 0
        
        if m_show_rank
            table.cell(t, col, row, str.tostring(row), bgcolor=bg, text_color=cTF, text_size=txtSz)
            col += 1
        if m_show_sym
            table.cell(t, col, row, spTicker(sym), bgcolor=bg, text_color=hasSignal ? rowTxt : color.rgb(100, 100, 100), text_size=txtSz)
            col += 1
        if m_show_tf
            table.cell(t, col, row, tfToStr(tf), bgcolor=bg, text_color=hasSignal ? cTF : color.rgb(100, 100, 100), text_size=txtSz)
            col += 1
        if m_show_bias
            table.cell(t, col, row, hasSignal ? sTxt + qTxt : blockTxt, bgcolor=bg, text_color=sCol, text_size=txtSz)
            col += 1
        if m_show_age
            table.cell(t, col, row, hasSignal ? spAgo(age) : "—", bgcolor=bg, text_color=rowTxt, text_size=txtSz)
            col += 1
        if m_show_entry
            table.cell(t, col, row, hasSignal ? spFmtP(rPx) : "—", bgcolor=bg, text_color=cEntry, text_size=txtSz)
            col += 1
        if m_show_sl
            table.cell(t, col, row, hasSignal ? spFmtP(sl) : "—", bgcolor=bg, text_color=cSL, text_size=txtSz)
            col += 1
        if m_show_tp
            table.cell(t, col, row, tpTxt, bgcolor=bg, text_color=cTP, text_size=txtSz)
            col += 1
        if m_show_pnl
            table.cell(t, col, row, pTxt, bgcolor=bg, text_color=pCol, text_size=txtSz)
            col += 1
// ─────────────────────────────────────────────────
// 10. ALERTS (45 total)
// ─────────────────────────────────────────────────
// Build alert messages with symbol/TF/direction
