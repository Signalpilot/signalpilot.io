//@version=5
strategy("RSI Divergence v1 — LTC H4", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, initial_capital=500)

// ══════════════════════════════════════════════════════════════════════
// RSI Divergence v1: Price vs RSI divergence with pivot detection
// Apply to LTCUSDT.P on 4H timeframe
// Same logic as STX version — just apply to LTC chart
// ══════════════════════════════════════════════════════════════════════

// ── Inputs ────────────────────────────────────────────────────────────
rsi_period   = input.int(14, "RSI Period", group="RSI")
pivot_left   = input.int(5, "Pivot Left Bars", group="Divergence")
pivot_right  = input.int(3, "Pivot Right Bars", group="Divergence")
div_lookback = input.int(50, "Divergence Lookback", group="Divergence")

atr_period   = input.int(14, "ATR Period", group="Risk")
atr_sl_mult  = input.float(1.2, "ATR SL Mult", group="Risk")
atr_tp_mult  = input.float(3.0, "ATR TP Mult", group="Risk")

adx_min      = input.int(15, "ADX Min", group="Filter")

// ── RSI ───────────────────────────────────────────────────────────────
rsi_val = ta.rsi(close, rsi_period)

// ── Pivot Detection ───────────────────────────────────────────────────
pivot_lo = ta.pivotlow(low, pivot_left, pivot_right)
pivot_hi = ta.pivothigh(high, pivot_left, pivot_right)

rsi_pivot_lo = ta.pivotlow(rsi_val, pivot_left, pivot_right)
rsi_pivot_hi = ta.pivothigh(rsi_val, pivot_left, pivot_right)

// ── Divergence Detection ──────────────────────────────────────────────
var float prev_price_low = na
var float prev_rsi_low = na
var int prev_low_bar = na
var float prev_price_high = na
var float prev_rsi_high = na
var int prev_high_bar = na

bull_div = false
if not na(pivot_lo)
    if not na(prev_price_low) and (bar_index - prev_low_bar) < div_lookback
        if low[pivot_right] < prev_price_low and rsi_val[pivot_right] > prev_rsi_low
            bull_div := true
    prev_price_low := low[pivot_right]
    prev_rsi_low := rsi_val[pivot_right]
    prev_low_bar := bar_index

bear_div = false
if not na(pivot_hi)
    if not na(prev_price_high) and (bar_index - prev_high_bar) < div_lookback
        if high[pivot_right] > prev_price_high and rsi_val[pivot_right] < prev_rsi_high
            bear_div := true
    prev_price_high := high[pivot_right]
    prev_rsi_high := rsi_val[pivot_right]
    prev_high_bar := bar_index

// ── Confirmation ──────────────────────────────────────────────────────
[diplus, diminus, adx_val] = ta.dmi(14, 14)
adx_ok = adx_val > adx_min

[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
macd_turning_up = hist > hist[1]
macd_turning_dn = hist < hist[1]

atr_val = ta.atr(atr_period)

atr_rank = ta.percentrank(atr_val, 100)
vol_ok = atr_rank >= 10 and atr_rank <= 95

// ── Signals ───────────────────────────────────────────────────────────
long_cond = bull_div and rsi_val > 30 and rsi_val < 55 and macd_turning_up and adx_ok and vol_ok

short_cond = bear_div and rsi_val > 45 and rsi_val < 70 and macd_turning_dn and adx_ok and vol_ok

if long_cond and strategy.position_size == 0
    sl = close - atr_sl_mult * atr_val
    tp = close + atr_tp_mult * atr_val
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)

if short_cond and strategy.position_size == 0
    sl = close + atr_sl_mult * atr_val
    tp = close - atr_tp_mult * atr_val
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)

// ── Plots ─────────────────────────────────────────────────────────────
plotshape(bull_div, "Bull Div", shape.diamond, location.belowbar, color.lime, size=size.small)
plotshape(bear_div, "Bear Div", shape.diamond, location.abovebar, color.fuchsia, size=size.small)
plotshape(long_cond, "Long", shape.triangleup, location.belowbar, color.green, size=size.normal)
plotshape(short_cond, "Short", shape.triangledown, location.abovebar, color.red, size=size.normal)
