//@version=5
strategy("StochRSI Momentum v1 — ARB H4", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.055, slippage=2, initial_capital=500)

// ══════════════════════════════════════════════════════════════════════
// StochRSI Momentum v1: Pullback entries in established trends
// Apply to ARBUSDT.P on 4H timeframe
// ══════════════════════════════════════════════════════════════════════

// ── Inputs ────────────────────────────────────────────────────────────
ema_fast     = input.int(9, "EMA Fast", group="Trend")
ema_slow     = input.int(21, "EMA Slow", group="Trend")
ema_trend    = input.int(50, "EMA Trend", group="Trend")

srsi_rsi     = input.int(14, "StochRSI RSI", group="StochRSI")
srsi_stoch   = input.int(14, "StochRSI Stoch", group="StochRSI")
srsi_k_sm    = input.int(3, "StochRSI K", group="StochRSI")
srsi_d_sm    = input.int(3, "StochRSI D", group="StochRSI")
srsi_os      = input.int(20, "Oversold", group="StochRSI")
srsi_ob      = input.int(80, "Overbought", group="StochRSI")

atr_period   = input.int(14, "ATR Period", group="Risk")
atr_sl_mult  = input.float(1.0, "ATR SL Mult", group="Risk")
atr_tp_mult  = input.float(2.5, "ATR TP Mult", group="Risk")

// ── Indicators ────────────────────────────────────────────────────────
// Trend
fast = ta.ema(close, ema_fast)
slow = ta.ema(close, ema_slow)
trend_line = ta.ema(close, ema_trend)
trend_up   = fast > slow and close > trend_line
trend_down = fast < slow and close < trend_line

// SuperTrend
[st_line, st_dir] = ta.supertrend(3.0, 10)
st_bull = st_dir == -1
st_bear = st_dir == 1

// ADX + DI
[diplus, diminus, adx_val] = ta.dmi(14, 14)
adx_ok = adx_val > 20

// MACD
[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
macd_bull = hist > 0
macd_bear = hist < 0

// StochRSI
rsi_val = ta.rsi(close, srsi_rsi)
stoch_k = ta.sma(ta.stoch(rsi_val, rsi_val, rsi_val, srsi_stoch), srsi_k_sm)
stoch_d = ta.sma(stoch_k, srsi_d_sm)

srsi_bull_cross = ta.crossover(stoch_k, stoch_d) and stoch_k[1] < srsi_os
srsi_bear_cross = ta.crossunder(stoch_k, stoch_d) and stoch_k[1] > srsi_ob

// RSI
rsi_h = ta.rsi(close, 14)

// ATR
atr_val = ta.atr(atr_period)

// Volatility filter
atr_rank = ta.percentrank(atr_val, 100)
vol_ok = atr_rank >= 10 and atr_rank <= 95

// ── Signals ───────────────────────────────────────────────────────────
long_cond = trend_up and st_bull and adx_ok and diplus > diminus and srsi_bull_cross and macd_bull and rsi_h > 35 and rsi_h < 70 and vol_ok

short_cond = trend_down and st_bear and adx_ok and diminus > diplus and srsi_bear_cross and macd_bear and rsi_h > 30 and rsi_h < 65 and vol_ok

if long_cond and strategy.position_size == 0
    sl = close - atr_sl_mult * atr_val
    tp = close + atr_tp_mult * atr_val
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)

if short_cond and strategy.position_size == 0
    sl = close + atr_sl_mult * atr_val
    tp = close - atr_tp_mult * atr_val
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)

// ── Plots ─────────────────────────────────────────────────────────────
plot(fast, "EMA 9", color.new(color.green, 50))
plot(slow, "EMA 21", color.new(color.red, 50))
plot(trend_line, "EMA 50", color.new(color.blue, 50), linewidth=2)

plotshape(long_cond, "Long", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(short_cond, "Short", shape.triangledown, location.abovebar, color.red, size=size.small)
