        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/:path*",
      "permanent": true
    },
    {
      "source": "/free",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://education.signalpilot.io/free/",
      "permanent": true
    },
    {
