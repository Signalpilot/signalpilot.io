{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "education.signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/education/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "docs.signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/docs/:path",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "blog.signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/blog/:path",
      "permanent": true
    },
    {
      "source": "/en",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/",
      "permanent": true
    },
    {
      "source": "/en/",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/",
      "permanent": true
    },
