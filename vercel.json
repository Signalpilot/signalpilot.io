{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/en",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/",
      "permanent": true
    },
    {
      "source": "/en/",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/:path*",
      "permanent": true
    },
    {
      "source": "/free",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://education.signalpilot.io/free/",
      "permanent": true
    },
    {
      "source": "/free/",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://education.signalpilot.io/free/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "signalpilot.io"
        }
      ],
      "destination": "https://www.signalpilot.io/:path*",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/free",
      "destination": "https://education.signalpilot.io/free/",
      "permanent": true
    },
    {
      "source": "/free/",
      "destination": "https://education.signalpilot.io/free/",
      "permanent": true
    },
    {
      "source": "/resources/faq",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/resources/faq/",
      "destination": "/faq.html",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/articles/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ar/articles/:path*",
      "destination": "/ar/",
      "permanent": true
    },
    {
      "source": "/de/articles/:path*",
      "destination": "/de/",
      "permanent": true
    },
    {
      "source": "/es/articles/:path*",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/fr/articles/:path*",
      "destination": "/fr/",
